# SPDX-License-Identifier: BSD-2-Clause
# The build configuration of wpa_supplicant (scripts/build.sh wifi copies it to
# wpa_supplicant/.config and adds the LibreSSL and libnl paths).  The Linux nl80211 driver
# through libnl, the control interface for wpa_cli and the wifi command, WPA2 and WPA3
# (SAE, OWE, management frame protection), 802.11r roaming, the usual enterprise EAP methods
# with TLS from LibreSSL, and access point mode (a hotspot); no D-Bus, no readline, no P2P.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_TLS=openssl
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_MD5=y
CONFIG_EAP_GTC=y
CONFIG_PKCS12=y
CONFIG_AP=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y

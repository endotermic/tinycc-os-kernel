# SPDX-License-Identifier: BSD-2-Clause
# The build configuration of hostapd (scripts/build.sh wifi copies it to hostapd/.config and
# adds the LibreSSL and libnl paths): an access point on the nl80211 driver with WPA2/WPA3
# (SAE, OWE) and the control interface for hostapd_cli.  The devices-test runs it on a
# mac80211_hwsim radio for wpa_supplicant to associate with; on real hardware it makes a hotspot.
CONFIG_DRIVER_HOSTAP=n
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_ELOOP=eloop
CONFIG_TLS=openssl
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211R=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y

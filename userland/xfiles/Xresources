! xmenu, the pop-up menu of xfiles' right click (xfilesctl): the same font and colours as
! JWM's menus (/etc/system.jwmrc).
XMenu.faceName:                 DejaVu Sans
XMenu.faceSize:                 11
XMenu.background:               #2b2b2b
XMenu.foreground:               #e0e0e0
XMenu.activeBackground:         #2a6fb0
XMenu.activeForeground:         #ffffff
XMenu.borderColor:              #1a1a1a
XMenu.borderWidth:              1
XMenu.separatorColor:           #555555
XMenu.shadowThickness:          0

! dmenu, the prompt xfiles embeds (Ctrl-L, renaming, new folders), has no resources:
! xfilesctl passes its font and colours on its command line (-fn, -nb, -nf, -sb, -sf).

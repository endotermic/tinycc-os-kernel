! /etc/X11/Xresources - the X resources of the graphical session.  startx (userland/startx.c)
! and xdm's Xsession (userland/xdm/Xsession.c) load this file into the server's
! RESOURCE_MANAGER property with "xrdb -nocpp -merge" before the window manager starts, then
! ~/.Xresources when the user has one (the same command adds or overrides entries; there is
! no C preprocessor in the image, so no #include or #ifdef here).  Fonts are fontconfig
! names: DejaVu Sans and DejaVu Sans Mono are in /usr/share/fonts/TTF, and glyphs they lack
! (Cyrillic and Greek are in DejaVu; CJK, Armenian, Georgian, ... are not) come from GNU
! Unifont (/usr/share/fonts/unifont), which fontconfig's 69-unifont.conf offers as the last
! fallback and which xfiles and xmenu look up per glyph.

! xfiles, the file manager: font and colours of the icon grid, the status bar and the
! selection, and which built-in icon a file gets (the patterns are shell globs on the name,
! "pattern/" matches directories; the icon names are those compiled into xfiles:
! file-app, file-archive, file-audio, file-code, file-config, file-core, file-gear,
! file-image, file-info, file-object, file-text, file-video, file, folder-apps,
! folder-book, folder-code, folder-db, folder-download, folder-game, folder-gear,
! folder-home, folder-image, folder-link, folder-mail, folder-meme, folder-mount,
! folder-music, folder-trash, folder-up, folder-video, folder).  The first matching
! pattern wins; xfiles' own patterns (xfiles' icons.c) apply after these.
XFiles.faceName:                DejaVu Sans
XFiles.faceSize:                11
XFiles.background:              #1e1e1e
XFiles.foreground:              #e0e0e0
XFiles.activeBackground:        #2a6fb0
XFiles.activeForeground:        #ffffff
XFiles.geometry:                760x520
! the desktop (xfiles -d, started by JWM: its resource name is xfiles-desktop): the
! colour of JWM's desktop background (userland/jwm/system.jwmrc)
xfiles-desktop.background:      #1e3a52
XFiles.fileIcons:                       \n\
	~/=folder-home                  \n\
	~/.cache/=folder-gear           \n\
	~/.local/share/Trash/files/=folder-trash \n\
	*.c=file-code                   \n\

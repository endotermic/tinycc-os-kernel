# /etc/X11/xdm/Xservers - the X servers xdm manages: display :0 on this machine, TinyX's
# Xfbdev on the framebuffer with its built-in fonts, pinned to virtual terminal 5 (tty1 is
# the console shell, tty2-tty4 the gettys); -br -nocursor: a black screen without the
# X-shaped pointer until Xsetup_0's wallpaper (which sets the arrow) is up, instead of
# the grey weave (-nocursor: patches/tinyx)
:0 local /usr/bin/Xfbdev :0 -fp built-ins -br -nocursor vt5

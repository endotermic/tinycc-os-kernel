# SPDX-License-Identifier: BSD-2-Clause
# gen_init_cpio manifest of the default image: a static busybox, /init (busybox-init.c,
# a C script that /usr/bin/tcc runs with -run), which mounts devtmpfs/proc/sysfs, brings the
# network up and runs an interactive shell on the serial console, the udhcpc script and the
# device test (C scripts too), /etc/passwd, /etc/group and /etc/shadow (userland/etc/: root
# without a password and the three proof-of-concept users ada, grace and dennis with the
# passwords the login manager's helper text shows; the consoles log in as ada with login -f,
# getty offers a login on tty2-tty4, xdm a graphical one) and their homes.  ${BUSYBOX}, ${BUSYBOX_INIT},
# ${UDHCPC_SCRIPT}, ${DEVICES_TEST} and ${ETC} are expanded by gen_init_cpio from the
# environment (scripts/build.sh exports them).  /dev/console must
# exist before devtmpfs is mounted so that PID 1 gets stdio.  scripts/build.sh appends the
# guest compiler tree and the staging trees of nnn, LibreSSL and links (userland/dir2list.sh)
# to this list: /init needs /usr/bin/tcc; nnn is the file manager (build/<arch>/nnn/stage),
# links the web browser (build/<arch>/links/stage), LibreSSL's tree holds the CA bundle
# /etc/ssl/cert.pem that links verifies servers against (build/<arch>/libressl/stage).
dir   /dev          0755 0 0
nod   /dev/console  0600 0 0 c 5 1
dir   /bin          0755 0 0
dir   /sbin         0755 0 0
dir   /usr          0755 0 0
dir   /usr/bin      0755 0 0
dir   /usr/sbin     0755 0 0
dir   /proc         0755 0 0
dir   /sys          0755 0 0
dir   /tmp          1777 0 0
dir   /root         0700 0 0
dir   /etc          0755 0 0
dir   /mnt          0755 0 0
dir   /usr/share    0755 0 0
dir   /usr/share/udhcpc 0755 0 0
# setuid root (CONFIG_FEATURE_SUID: only su, login and passwd keep the privilege, the
# other applets drop it): su gives the user a root shell, login switches to the user
file  /bin/busybox  ${BUSYBOX} 4755 0 0
slink /bin/sh       busybox 0777 0 0
file  /init         ${BUSYBOX_INIT} 0755 0 0
# the DHCP client's event script (udhcpc runs it; C, see udhcpc-script.c) and the device test
file  /usr/share/udhcpc/default.script ${UDHCPC_SCRIPT} 0755 0 0
file  /usr/bin/devices-test ${DEVICES_TEST} 0755 0 0
# the accounts: root (no password) and ada, grace, dennis (UID 1000-1002; passwords in
# shadow: lovelace, hopper, ritchie); login, su and xdm's greeter read them
file  /etc/passwd  ${ETC}/passwd 0644 0 0
file  /etc/group   ${ETC}/group 0644 0 0
file  /etc/shadow  ${ETC}/shadow 0600 0 0
dir   /home        0755 0 0
dir   /home/ada    0755 1000 1000
dir   /home/grace  0755 1001 1001
dir   /home/dennis 0755 1002 1002
# xdm's authorization directory (DisplayManager.authDir: the servers' cookie files)
dir   /var         0755 0 0
dir   /var/run     0755 0 0
dir   /var/run/xdm 0700 0 0

# SPDX-License-Identifier: BSD-2-Clause
# gen_init_cpio manifest of the default image: a static busybox, /init (busybox-init.c,
# a C script that /usr/bin/tcc runs with -run), which mounts devtmpfs/proc/sysfs, brings the
# network up and runs an interactive shell on the serial console, the udhcpc script and the
# device test (C scripts too).  ${BUSYBOX}, ${BUSYBOX_INIT}, ${UDHCPC_SCRIPT} and
# ${DEVICES_TEST} are expanded by gen_init_cpio from the environment (scripts/build.sh exports them).  /dev/console must
# exist before devtmpfs is mounted so that PID 1 gets stdio.  scripts/build.sh appends the
# guest compiler tree (userland/dir2list.sh) to this list: /init needs /usr/bin/tcc.
dir   /dev          0755 0 0
nod   /dev/console  0600 0 0 c 5 1
dir   /bin          0755 0 0
dir   /sbin         0755 0 0
dir   /usr          0755 0 0
dir   /usr/bin      0755 0 0
dir   /usr/sbin     0755 0 0
dir   /proc         0755 0 0
dir   /sys          0755 0 0
dir   /tmp          1777 0 0
dir   /root         0700 0 0
dir   /etc          0755 0 0
dir   /mnt          0755 0 0
dir   /usr/share    0755 0 0
dir   /usr/share/udhcpc 0755 0 0
file  /bin/busybox  ${BUSYBOX} 0755 0 0
slink /bin/sh       busybox 0777 0 0
file  /init         ${BUSYBOX_INIT} 0755 0 0
# the DHCP client's event script (udhcpc runs it; C, see udhcpc-script.c) and the device test
file  /usr/share/udhcpc/default.script ${UDHCPC_SCRIPT} 0755 0 0
file  /usr/bin/devices-test ${DEVICES_TEST} 0755 0 0

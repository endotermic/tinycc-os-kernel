#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# bison - stand-in for bison in the self-hosting image: Kbuild runs
# "$(YACC) -o <out>.tab.c --defines=<out>.tab.h -t -l <in>.y" for scripts/kconfig/parser.y; the
# generated parser was made on the host (bison) and shipped in $KCONFIG_PREGEN
# (/usr/share/tinycc-os-kernel/kconfig), so copy it.
D=${KCONFIG_PREGEN:-/usr/share/tinycc-os-kernel/kconfig}
out= defs= in= prev=
for a; do
    case $prev in -o) out=$a;; esac
    case $a in --version) echo "bison (GNU Bison) 3.8.2 (tinycc-os-kernel stand-in: pre-generated files from $D)"; exit 0;;
             --defines=*) defs=${a#--defines=};; -o|-t|-l) ;; -*) ;; *) in=$a;; esac
    prev=$a
done
[ -n "$out" ] && [ -n "$in" ] || { echo "bison (stand-in): expected -o <out>.tab.c --defines=<out>.tab.h <in>.y" >&2; exit 2; }
base=$D/$(basename "$in" .y).tab
[ -f "$base.c" ] && [ -f "$base.h" ] || { echo "bison (stand-in): no pre-generated $base.[ch]" >&2; exit 1; }
cp "$base.c" "$out" && { [ -z "$defs" ] || cp "$base.h" "$defs"; }

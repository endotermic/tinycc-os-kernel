#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# build-kernel - rebuild the Linux kernel from the pruned source tree shipped in this image
# (/usr/src/linux-*.tar.gz), with the toolchain installed here: tcc (every C and .S file, -S,
# -E), i386-tcc (-m16, the real-mode code), tld (ld, nm, objcopy, readelf, ar, strip), GNU
# make and busybox (sh, awk, sed, bc, tar, ...).  No gcc, no binutils, no flex/bison (the
# Kconfig lexer and parser come pre-generated, see /usr/bin/flex and /usr/bin/bison).
# It is the same make line as the kernel step of scripts/build.sh on the host.
#
# Usage: build-kernel [-j N] [make-target...]      (default target: bzImage + the modules dir)
#   The source is unpacked into $WORK/linux (a tmpfs mounted on /build in the guest, so that
#   df shows the usage and a full disk cannot take the whole RAM) and left there: a second run
#   is incremental.  The result is $WORK/linux/arch/x86/boot/bzImage; "send-file" copies it to
#   the host (run.sh --selfhost).
# Env: WORK (/build), JOBS (-j; default nproc), TCC (the tcc to use: /usr/local/bin/tcc when
#   build-toolchain made one, else /usr/bin/tcc), GEN (the generation number that becomes the
#   kernel's "#N" in uname -v; default: the running kernel's + 1), SELFHOST_SRC (/usr/src),
#   SELFHOST_SHARE (/usr/share/tinycc-os-kernel), SELFHOST_BIN (/usr/bin: the wrappers, tld,
#   flex, bison), NO_TMPFS=1 (do not mount anything; scripts/selfhost-test.sh host does that).
set -e
SRC=${SELFHOST_SRC:-/usr/src}
SHARE=${SELFHOST_SHARE:-/usr/share/tinycc-os-kernel}
BIN=${SELFHOST_BIN:-/usr/bin}
WORK=${WORK:-/build}
JOBS=${JOBS:-$(nproc 2>/dev/null || echo 1)}
while [ $# -gt 0 ]; do
    case $1 in -j) JOBS=$2; shift 2;; -j*) JOBS=${1#-j}; shift;; --) shift; break;; *) break;; esac
done
die() { echo "build-kernel: $*" >&2; exit 1; }
if [ -z "$TCC" ]; then
    if [ -x /usr/local/bin/tcc ]; then TCC=/usr/local/bin/tcc; else TCC=$(command -v tcc) || die "no tcc"; fi
fi
[ -x "$(dirname "$TCC")/i386-tcc" ] || die "no i386-tcc next to $TCC (tcc -m16 execs it for the real-mode code)"
for t in ld nm objcopy readelf ar strip tcc-kcc tcc-hostcc objtool-stub flex bison; do
    [ -x "$BIN/$t" ] || die "no $BIN/$t"
done
MAKE=$BIN/make; [ -x "$MAKE" ] || MAKE=make
tarball=$(ls "$SRC"/linux-*.tar.gz 2>/dev/null | head -1); [ -n "$tarball" ] || die "no $SRC/linux-*.tar.gz"
[ -f "$SHARE/minimal.config" ] && [ -f "$SHARE/tcc.config" ] || die "no Kconfig fragments in $SHARE"
[ -f "$SHARE/kconfig/lexer.lex.c" ] || die "no pre-generated Kconfig lexer in $SHARE/kconfig"
if [ -z "$GEN" ]; then
    GEN=$(uname -v | sed -n 's/^#\([0-9][0-9]*\).*/\1/p'); GEN=$(( ${GEN:-0} + 1 ))
fi

# the work directory: a tmpfs in the guest (85% of RAM at most; the tree needs ~70 MB, the
# build ~160 MB), nothing on the host (NO_TMPFS)
mkdir -p "$WORK"
if [ -z "$NO_TMPFS" ] && ! grep -q " $WORK " /proc/mounts 2>/dev/null; then
    mount -t tmpfs -o size=85% tmpfs "$WORK" 2>/dev/null \
        || echo "build-kernel: no tmpfs (CONFIG_TMPFS); building on the root filesystem (ramfs, no size limit)" >&2
fi
cd "$WORK"
t0=$(date +%s)
if [ ! -f linux/Makefile ]; then
    echo "== unpacking $(basename "$tarball") ($(ls -l "$tarball" | awk '{print $5}') bytes) into $WORK/linux"
    tar xzf "$tarball"
    [ -f linux/Makefile ] || die "the tarball has no linux/Makefile"
    echo "   $(find linux -type f | wc -l) files, $(du -sh linux | cut -f1)"
fi
cd linux
log=$WORK/build-kernel.log; : >"$log"
KCC_LOG=$WORK/kcc.log; : >"$KCC_LOG"
export TCC KCC_LOG KCONFIG_PREGEN=$SHARE/kconfig
# the same toolchain variables as scripts/build.sh step_kernel; LEX/YACC are the copies of the
# pre-generated files; the version string names the generation and the builder
set -- "$@"
case $(uname -m) in i?86) KARCH=i386; AFRAG=i386.config;; *) KARCH=x86; AFRAG=x86_64.config;; esac
MK="$MAKE ARCH=$KARCH CC=$BIN/tcc-kcc HOSTCC=$BIN/tcc-hostcc OBJTOOL=$BIN/objtool-stub \
LD=$BIN/ld NM=$BIN/nm OBJCOPY=$BIN/objcopy READELF=$BIN/readelf AR=$BIN/ar STRIP=$BIN/strip \
LEX=$BIN/flex YACC=$BIN/bison \
KBUILD_BUILD_VERSION=$GEN KBUILD_BUILD_USER=${KBUILD_BUILD_USER:-tcc} KBUILD_BUILD_HOST=${KBUILD_BUILD_HOST:-tinycc-os-guest}"
if [ ! -f .config ]; then
    echo "== configuring: tinyconfig + minimal.config + $AFRAG + tcc.config, olddefconfig"
    $MK -s tinyconfig >>"$log" 2>&1 || { tail -20 "$log"; die "tinyconfig failed (log: $log)"; }
fi
for f in minimal.config $AFRAG tcc.config; do
    KCONFIG_CONFIG=.config sh scripts/kconfig/merge_config.sh -m .config "$SHARE/$f" >>"$log" 2>&1
done
$MK -s olddefconfig >>"$log" 2>&1 || { tail -20 "$log"; die "olddefconfig failed (log: $log)"; }
echo "== building generation $GEN with $("$TCC" -v) and $("$BIN/ld" -v), make -j$JOBS $*"
echo "   (log: $log; one line per compiler run: $KCC_LOG)"
if $MK -j"$JOBS" "$@" >>"$log" 2>&1; then :; else
    grep -E ' error: |Error [0-9]|undefined reference' "$log" | head -20
    tail -5 "$log"
    die "kernel build failed (log: $log)"
fi
t1=$(date +%s); el=$((t1 - t0))
img=arch/x86/boot/bzImage
[ -f "$img" ] || die "no $img"
echo "== done in $((el / 60))m$((el % 60))s: $WORK/linux/$img ($(ls -l "$img" | awk '{print $5}') bytes)"
echo "   $(grep -c '^tcc ' "$KCC_LOG") tcc and $(grep -c '^gcc ' "$KCC_LOG") gcc compiler invocations, $(grep -c '^host-tcc ' "$KCC_LOG") host-tool compiles"
echo "   version: $(sed -n 's/^#define UTS_VERSION[[:space:]]*"\(.*\)"/\1/p' include/generated/utsversion.h 2>/dev/null) ($(sed -n 's/^#define LINUX_COMPILE_BY[[:space:]]*"\(.*\)"/\1/p' include/generated/compile.h 2>/dev/null)@$(sed -n 's/^#define LINUX_COMPILE_HOST[[:space:]]*"\(.*\)"/\1/p' include/generated/compile.h 2>/dev/null))"
if [ -r /proc/meminfo ]; then
    echo "   memory: $(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d MB total, %d MB available", t/1024, a/1024}' /proc/meminfo); $WORK: $(du -sh "$WORK" 2>/dev/null | cut -f1) used"
fi
if [ -x "$BIN/send-file" ] && [ -c /dev/ttyS1 ]; then
    echo "   to copy it to the host (run.sh --selfhost):  send-file $WORK/linux/$img"
fi

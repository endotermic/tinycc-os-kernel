From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Thu, 26 Nov 2026 15:16:13 +0200
Subject: [PATCH] kdrive/fbdev: KMS mode, the screen follows the display's size

The DRM drivers' fbdev emulation keeps the size it had at boot, so a
virtual machine's screen could not follow its window.  With -kms (the
default on vboxvideo, vmwgfx and virtio_gpu; -nokms turns it off) Xfbdev
takes /dev/dri/card0: the first connected connector's preferred mode, a
dumb buffer of that size on a CRTC (kms.c).  The fbdev fields the rest of
fbdev.c reads are filled from the buffer; the server draws in the shadow in
RAM and passes the damaged rectangles, clipped to the buffer, to
DRM_IOCTL_MODE_DIRTYFB.  A DRM hotplug uevent (the netlink socket) makes it
read the preferred mode again: a new size gets a new buffer and the screen
is resized through fbdevRandRSetConfig, RRGetInfo and RRScreenSizeNotify
(ConfigureNotify on the root, RRScreenChangeNotify), the size in
millimetres scaled from the first one, so that the resolution stays; the whole buffer is
marked dirty again 0.3 s and 1.5 s later (vboxvideo drops updates while
VirtualBox has VBVA off around the mode change).  Leaving the VT or
exiting drops DRM master, so the console gets the display back.  Real
hardware keeps the frame buffer device.
---
 kdrive/fbdev/fbdev.c  |  48 ++++-
 kdrive/fbdev/fbdev.h  |  18 ++
 kdrive/fbdev/fbinit.c |  15 ++
 kdrive/fbdev/kms.c    | 483 ++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 561 insertions(+), 3 deletions(-)
 create mode 100644 kdrive/fbdev/kms.c

diff --git a/kdrive/fbdev/fbdev.c b/kdrive/fbdev/fbdev.c
index cce940f..21692d0 100644
--- a/kdrive/fbdev/fbdev.c
+++ b/kdrive/fbdev/fbdev.c
@@ -83,6 +83,12 @@ static Bool fbdevInitialize(KdCardInfo * card, FbdevPriv * priv)
 {
 	unsigned long off;
 
+	/* a virtual GPU (or -kms): the screen in a DRM dumb buffer, which can
+	   change size (kms.c); always the shadow in RAM then */
+	if (kmsInitialize(priv)) {
+		fbdevShadow = TRUE;
+		return TRUE;
+	}
 	if (fbdevDevicePath == NULL)
 		fbdevDevicePath = "/dev/fb0";
 
@@ -130,7 +136,8 @@ Bool fbdevCardInit(KdCardInfo * card)
 {
 	FbdevPriv *priv;
 
-	priv = malloc(sizeof(FbdevPriv));
+	/* zeroed: the KMS fields (kms.c) must start cleared, also on a server reset */
+	priv = calloc(1, sizeof(FbdevPriv));
 	if (!priv)
 		return FALSE;
 
@@ -199,6 +206,16 @@ static Bool fbdevScreenInitialize(KdScreenInfo * screen, FbdevScrPriv * scrpriv)
 	const KdMonitorTiming *t;
 	int k;
 
+	if (priv->kms) {
+		/* the mode is the connector's preferred one (kms.c) */
+		screen->width = priv->var.xres;
+		screen->height = priv->var.yres;
+		screen->rate = 60;
+		screen->fb.depth = priv->var.bits_per_pixel;
+		depth = priv->var.bits_per_pixel;
+		gray = 0;
+		goto have_mode;
+	}
 	k = ioctl(priv->fd, FBIOGET_VSCREENINFO, &var);
 
 	if (!screen->width || !screen->height) {
@@ -251,6 +268,7 @@ static Bool fbdevScreenInitialize(KdScreenInfo * screen, FbdevScrPriv * scrpriv)
 	depth = priv->var.bits_per_pixel;
 	gray = priv->var.grayscale;
 
+ have_mode:
 	/* Calculate fix.line_length if it's zero */
 	if (!priv->fix.line_length)
 		priv->fix.line_length = (priv->var.xres_virtual * depth + 7) / 8;
@@ -478,6 +496,10 @@ static Bool fbdevSetShadow(ScreenPtr pScreen)
 			update = shadowUpdateRotatePacked;
 	else
 		update = shadowUpdatePacked;
+	/* KMS: the damage to the dumb buffer and DIRTYFB (kms.c; RandR offers no
+	   rotation there, and scrpriv->randr is RR_Rotate_0 = 1, not 0) */
+	if (priv->kms)
+		update = kmsUpdateProc();
 	return KdShadowSet(pScreen, scrpriv->randr, update, window);
 }
 
@@ -491,6 +513,8 @@ static Bool fbdevRandRGetInfo(ScreenPtr pScreen, Rotation * rotations)
 	int n;
 
 	*rotations = RR_Rotate_All | RR_Reflect_All;
+	if (((FbdevPriv *) pScreenPriv->card->driver)->kms)
+		*rotations = RR_Rotate_0;	/* DIRTYFB takes unrotated rectangles */
 
 	for (n = 0; n < pScreen->numDepths; n++)
 		if (pScreen->allowedDepths[n].numVids)
@@ -510,7 +534,7 @@ static Bool fbdevRandRGetInfo(ScreenPtr pScreen, Rotation * rotations)
 	return TRUE;
 }
 
-static Bool
+Bool
 fbdevRandRSetConfig(ScreenPtr pScreen,
 		    Rotation randr, int rate, RRScreenSizePtr pSize)
 {
@@ -663,6 +687,7 @@ Bool fbdevFinishInitScreen(ScreenPtr pScreen)
 	if (!fbdevRandRInit(pScreen))
 		return FALSE;
 
+	kmsWatch(pScreen);	/* KMS: follow the display's size */
 	return TRUE;
 }
 
@@ -695,6 +720,8 @@ Bool fbdevEnable(ScreenPtr pScreen)
 	FbdevPriv *priv = pScreenPriv->card->driver;
 	int k;
 
+	if (priv->kms)
+		return kmsShow(priv);
 	priv->var.activate = FB_ACTIVATE_NOW | FB_CHANGE_CMAP_VBL;
 
 	/* display it on the LCD */
@@ -730,7 +757,7 @@ Bool fbdevDPMS(ScreenPtr pScreen, int mode)
 	FbdevPriv *priv = pScreenPriv->card->driver;
 	static int oldmode = -1;
 
-	if (mode == oldmode)
+	if (mode == oldmode || priv->kms)
 		return TRUE;
 #ifdef FBIOPUT_POWERMODE
 	if (ioctl(priv->fd, FBIOPUT_POWERMODE, &mode) >= 0) {
@@ -753,6 +780,10 @@ void fbdevDisable(ScreenPtr pScreen)
 
 void fbdevRestore(KdCardInfo * card)
 {
+	FbdevPriv *priv = card->driver;
+
+	if (priv->kms)
+		kmsHide(priv);	/* the console gets the display back */
 }
 
 void fbdevScreenFini(KdScreenInfo * screen)
@@ -764,6 +795,13 @@ void fbdevCardFini(KdCardInfo * card)
 	FbdevPriv *priv = card->driver;
 
 	munmap(priv->fb_base, priv->fix.smem_len);
+	if (priv->kms) {
+		kmsFini();
+		if (priv->uevent >= 0) {
+			RemoveEnabledDevice(priv->uevent);
+			close(priv->uevent);
+		}
+	}
 	close(priv->fd);
 	free(priv);
 }
@@ -781,6 +819,8 @@ void fbdevGetColors(ScreenPtr pScreen, int n, xColorItem * pdefs)
 	int k;
 	int min, max;
 
+	if (priv->kms)
+		return;
 	min = 256;
 	max = 0;
 	for (k = 0; k < n; k++) {
@@ -819,6 +859,8 @@ void fbdevPutColors(ScreenPtr pScreen, int n, xColorItem * pdefs)
 	int p;
 	int min, max;
 
+	if (priv->kms)
+		return;
 	min = 256;
 	max = 0;
 	while (n--) {
diff --git a/kdrive/fbdev/fbdev.h b/kdrive/fbdev/fbdev.h
index aa3dc11..d099026 100644
--- a/kdrive/fbdev/fbdev.h
+++ b/kdrive/fbdev/fbdev.h
@@ -25,6 +25,8 @@
 #define _FBDEV_H_
 #include <stdio.h>

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@visma.com>
Date: Tue, 3 Nov 2026 17:50:12 +0200
Subject: [PATCH] control/font: do not destroy the patterns the XftFonts own

XftFontOpenPattern keeps the pattern in the font and XftFontClose destroys
it; ctrlfnt_free and the error paths of ctrlfnt_open and opennewfont destroyed
it a second time, a use after free that crashed at exit on i386 (SIGSEGV in
FcRefIsConst) once musl had unmapped the freed block.
---
 control/font.c | 20 +++++++++++---------
 1 file changed, 11 insertions(+), 9 deletions(-)

diff --git a/control/font.c b/control/font.c
index b90a6ac..3e55d9a 100644
--- a/control/font.c
+++ b/control/font.c
@@ -135,10 +135,10 @@ done:
 	return fontset;
 error:
 	free(s);
-	if (font.pattern != NULL)
-		FcPatternDestroy(font.pattern);
 	if (font.xftfont != NULL)
-		XftFontClose(display, font.xftfont);
+		XftFontClose(display, font.xftfont);	/* destroys its pattern */
+	else if (font.pattern != NULL)
+		FcPatternDestroy(font.pattern);
 	if (fontset != NULL)
 		free(fontset->fonts);
 	free(fontset);
@@ -269,10 +269,10 @@ done:
 		FcCharSetDestroy(fccharset);
 	if (fcpattern != NULL)
 		FcPatternDestroy(fcpattern);
-	if (font.pattern != NULL)
-		XftPatternDestroy(font.pattern);
 	if (font.xftfont != NULL)
-		XftFontClose(fontset->display, font.xftfont);
+		XftFontClose(fontset->display, font.xftfont);	/* destroys its pattern */
+	else if (font.pattern != NULL)
+		XftPatternDestroy(font.pattern);
 #endif /* CTRLFNT_NO_SEARCH */
 	(void)glyph;
 	return retfont;
@@ -748,13 +748,15 @@ ctrlfnt_free(ctrlfnt *fontset)
 		return;
 	if (fontset->xft_fontset != NULL) {
 		for (size_t i = 0; i < fontset->xft_fontset->nmemb; i++) {
+			/*
+			 * The XftFont owns its pattern (XftFontOpenPattern
+			 * keeps it, XftFontClose destroys it): destroying
+			 * it here too freed it twice.
+			 */
 			XftFontClose(
 				fontset->display,
 				fontset->xft_fontset->fonts[i].xftfont
 			);
-			FcPatternDestroy(
-				fontset->xft_fontset->fonts[i].pattern
-			);
 		}
 		free(fontset->xft_fontset->fonts);
 		free(fontset->xft_fontset);

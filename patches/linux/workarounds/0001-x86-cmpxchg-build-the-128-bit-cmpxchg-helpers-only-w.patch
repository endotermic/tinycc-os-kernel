From 632da49c49e10204209a4701e27c60f464992658 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:25:18 +0300
Subject: [PATCH] x86/cmpxchg: build the 128-bit cmpxchg helpers only with
 __SIZEOF_INT128__

<linux/types.h> defines u128 only when the compiler provides
__SIZEOF_INT128__.  A compiler without __int128 (tinycc) then fails on
union __u128_halves and the arch_cmpxchg128*() helpers although Kconfig
already reports CC_HAS_INT128=n and nothing else uses them.  Wrap the
block in #ifdef __SIZEOF_INT128__.

Assisted-by: LLM
---
 arch/x86/include/asm/cmpxchg_64.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/x86/include/asm/cmpxchg_64.h b/arch/x86/include/asm/cmpxchg_64.h
index 5afea056f..b217e27ae 100644
--- a/arch/x86/include/asm/cmpxchg_64.h
+++ b/arch/x86/include/asm/cmpxchg_64.h
@@ -26,6 +26,12 @@
 	arch_try_cmpxchg_local((ptr), (po), (n));			\
 })
 
+/*
+ * 128-bit cmpxchg needs the compiler's __int128: 'u128' only exists when
+ * __SIZEOF_INT128__ is defined (see <linux/types.h>).
+ */
+#ifdef __SIZEOF_INT128__
+
 union __u128_halves {
 	u128 full;
 	struct {
@@ -92,4 +98,6 @@ static __always_inline bool arch_try_cmpxchg128_local(volatile u128 *ptr, u128 *
 
 #define system_has_cmpxchg128()		boot_cpu_has(X86_FEATURE_CX16)
 
+#endif /* __SIZEOF_INT128__ */
+
 #endif /* _ASM_X86_CMPXCHG_64_H */

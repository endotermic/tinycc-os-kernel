From 69a75b9a79f79818569e2f7603bfa36dadc8e850 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:25:19 +0300
Subject: [PATCH] dma-direct: return early when CONFIG_DMA_COHERENT_POOL is
 disabled

dma_direct_alloc_from_pool() guards itself with
WARN_ON_ONCE(!IS_ENABLED(CONFIG_DMA_COHERENT_POOL)).  The constant does
not survive WARN_ON_ONCE()'s local, so a compiler without constant
propagation keeps the dma_alloc_from_pool() call that does not exist
without the option.  Test the option directly and warn inside the
branch.  No functional change.

Assisted-by: LLM
---
 kernel/dma/direct.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/kernel/dma/direct.c b/kernel/dma/direct.c
index 1615e9dc4..095b8c395 100644
--- a/kernel/dma/direct.c
+++ b/kernel/dma/direct.c
@@ -166,8 +166,10 @@ static struct page *dma_direct_alloc_from_pool(struct device *dev, size_t size,
 	struct page *page;
 	u64 phys_limit;
 
-	if (WARN_ON_ONCE(!IS_ENABLED(CONFIG_DMA_COHERENT_POOL)))
+	if (!IS_ENABLED(CONFIG_DMA_COHERENT_POOL)) {
+		WARN_ON_ONCE(1);
 		return NULL;
+	}
 
 	gfp |= dma_direct_optimal_gfp_mask(dev, &phys_limit);
 	page = dma_alloc_from_pool(dev, size, cpu_addr, gfp, attrs,

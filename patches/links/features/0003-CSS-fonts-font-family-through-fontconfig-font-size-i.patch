 {
@@ -965,14 +1022,6 @@ void css_apply_format(unsigned char *attr)
 		memcpy(&format_.fg, &rgb, sizeof(struct rgb));
 		if (!strcmp(cast_const_char n->tag, "A")) memcpy(&format_.clink, &rgb, sizeof(struct rgb));
 	}
-	if ((v = n->v[CP_FWEIGHT])) {
-		if (!strcmp(cast_const_char v, "bold") || !strcmp(cast_const_char v, "bolder") || atoi(cast_const_char v) >= 600) format_.attr |= AT_BOLD;
-		else if (!strcmp(cast_const_char v, "normal") || !strcmp(cast_const_char v, "lighter") || (atoi(cast_const_char v) > 0 && atoi(cast_const_char v) < 600)) format_.attr &= ~AT_BOLD;
-	}
-	if ((v = n->v[CP_FSTYLE])) {
-		if (!strncmp(cast_const_char v, "italic", 6) || !strncmp(cast_const_char v, "oblique", 7)) format_.attr |= AT_ITALIC;
-		else if (!strcmp(cast_const_char v, "normal")) format_.attr &= ~AT_ITALIC;
-	}
 	if ((v = n->v[CP_TDECO])) {
 		if (strstr(cast_const_char v, "underline")) format_.attr |= AT_UNDERLINE;
 		if (strstr(cast_const_char v, "line-through")) format_.attr |= AT_STRIKE;
@@ -984,10 +1033,60 @@ void css_apply_format(unsigned char *attr)
 		else if (!strcmp(cast_const_char v, "right") || !strcmp(cast_const_char v, "end")) par_format.align = AL_RIGHT;
 		else if (!strcmp(cast_const_char v, "left") || !strcmp(cast_const_char v, "start")) par_format.align = AL_LEFT;
 	}
-	if ((v = n->v[CP_FFAMILY])) {
-		unsigned char *p = stracpy(v), *q;
-		for (q = p; *q; q++) *q = (unsigned char)locase(*q);
-		if (strstr(cast_const_char p, "monospace") || strstr(cast_const_char p, "courier") || strstr(cast_const_char p, "mono,")) format_.attr |= AT_FIXED;
-		mem_free(p);
+	{
+		unsigned char *weight = n->v[CP_FWEIGHT], *style = n->v[CP_FSTYLE], *size = n->v[CP_FSIZE], *family = n->v[CP_FFAMILY];
+		unsigned char *sh = NULL;
+		if (n->v[CP_FONT]) {
+			/* the font shorthand: [style] [variant] [weight] size[/line-height] family; the longhands win */
+			unsigned char *s = sh = stracpy(n->v[CP_FONT]);
+			while (*s) {
+				unsigned char *e;
+				while (css_ws(*s)) s++;
+				if (!*s) break;
+				e = s;
+				while (*e && !css_ws(*e)) e++;
+				if ((*s >= '0' && *s <= '9') || *s == '.' || css_size_keyword(s, e - s)) {
+					unsigned char *slash = s;
+					while (slash < e && *slash != '/') slash++;
+					if (!size) size = s;
+					if (*e) *e++ = 0;
+					*slash = 0;
+					while (css_ws(*e)) e++;
+					if (*e && !family) family = e;
+					break;
+				}
+				if ((e - s == 6 && !strncmp(cast_const_char s, "italic", 6)) || (e - s == 7 && !strncmp(cast_const_char s, "oblique", 7))) {
+					if (!style) style = cast_uchar "italic";
+				} else if ((e - s == 4 && !strncmp(cast_const_char s, "bold", 4)) || (e - s == 6 && !strncmp(cast_const_char s, "bolder", 6))) {
+					if (!weight) weight = cast_uchar "bold";
+				}
+				s = e;
+			}
+			/* the shorthand resets what it does not name */
+			if (!weight) weight = cast_uchar "normal";
+			if (!style) style = cast_uchar "normal";
+		}
+		if (weight) {
+			if (!strcmp(cast_const_char weight, "bold") || !strcmp(cast_const_char weight, "bolder") || atoi(cast_const_char weight) >= 600) format_.attr |= AT_BOLD;
+			else if (!strcmp(cast_const_char weight, "normal") || !strcmp(cast_const_char weight, "lighter") || (atoi(cast_const_char weight) > 0 && atoi(cast_const_char weight) < 600)) format_.attr &= ~AT_BOLD;
+		}
+		if (style) {
+			if (!strncmp(cast_const_char style, "italic", 6) || !strncmp(cast_const_char style, "oblique", 7)) format_.attr |= AT_ITALIC;
+			else if (!strcmp(cast_const_char style, "normal")) format_.attr &= ~AT_ITALIC;
+		}
+		if (size && F) {
+			int px = css_font_px(size);
+			if (px > 0) format_.fontpx = px;
+		}
+		if (family && strcmp(cast_const_char family, "inherit")) {
+			unsigned char *p = stracpy(family), *q;
+			for (q = p; *q; q++) *q = (unsigned char)locase(*q);
+			if (strstr(cast_const_char p, "monospace") || strstr(cast_const_char p, "courier") || strstr(cast_const_char p, "mono,")) format_.attr |= AT_FIXED;
+			if (F) {
+				if (format_.fontface) mem_free(format_.fontface);
+				format_.fontface = p;
+			} else mem_free(p);
+		}
+		if (sh) mem_free(sh);
 	}
 }
diff --git a/fontconf.c b/fontconf.c
index 4a6f74f..95c3e1a 100644
--- a/fontconf.c
+++ b/fontconf.c
@@ -231,6 +231,94 @@ void fontconfig_free_fonts(struct list_of_fonts *fonts)
 	mem_free(fonts);
 }
 
+struct fc_file_cache {
+	struct fc_file_cache *next;
+	int flags;
+	unsigned char *file;		/* NULL: no scalable font */
+	unsigned char families[1];
+};
+
+static struct fc_file_cache *fc_files = NULL;
+
+static void fc_add_family(FcPattern *pat, unsigned char *f, size_t l)
+{
+	unsigned char *name;
+	while (l && (*f == ' ' || *f == '\t' || *f == '"' || *f == '\'')) f++, l--;
+	while (l && (f[l - 1] == ' ' || f[l - 1] == '\t' || f[l - 1] == '"' || f[l - 1] == '\'')) l--;
+	if (!l) return;
+	name = memacpy(f, l);
+	/* CSS generic names that fontconfig does not know */
+	if (!casestrcmp(name, cast_uchar "system-ui") || !casestrcmp(name, cast_uchar "-apple-system") ||
+	    !casestrcmp(name, cast_uchar "BlinkMacSystemFont") || !casestrcmp(name, cast_uchar "ui-sans-serif"))
+		mem_free(name), name = stracpy(cast_uchar "sans-serif");
+	else if (!casestrcmp(name, cast_uchar "ui-serif")) mem_free(name), name = stracpy(cast_uchar "serif");
+	else if (!casestrcmp(name, cast_uchar "ui-monospace")) mem_free(name), name = stracpy(cast_uchar "monospace");
+	FcPatternAddString(pat, FC_FAMILY, (FcChar8 *)name);
+	mem_free(name);
+}
+
+/* The font file fontconfig picks for a CSS font-family list (comma-separated, quoted or not),
+   bold and/or italic, as "path" or "path @index" (the form freetype_setup_font() takes); NULL
+   when it has no scalable font.  The answers are kept for the rest of the run. */
+unsigned char *fontconfig_font_file(unsigned char *families, int bold, int italic)
+{
+	struct fc_file_cache *c;
+	FcPattern *pat, *match;
+	FcResult res;
+	FcChar8 *file;
+	int idx, flags = !!bold | (!!italic << 1);
+	size_t sl;
+	unsigned char *p;
+	for (c = fc_files; c; c = c->next)
+		if (c->flags == flags && !strcmp(cast_const_char c->families, cast_const_char families)) return c->file;
+	sl = strlen(cast_const_char families);
+	if (sl > MAXINT - sizeof(struct fc_file_cache)) overalloc();
+	c = mem_alloc(sizeof(struct fc_file_cache) + sl);
+	strcpy(cast_char c->families, cast_const_char families);
+	c->flags = flags;
+	c->file = NULL;
+	c->next = fc_files;
+	fc_files = c;
+	wait_for_fontconfig();
+	if (!(pat = FcPatternCreate())) return NULL;
+	for (p = families; *p; ) {
+		unsigned char *e = cast_uchar strchr(cast_const_char p, ',');
+		if (!e) e = p + strlen(cast_const_char p);
+		fc_add_family(pat, p, e - p);
+		p = *e ? e + 1 : e;
+	}
+	FcPatternAddInteger(pat, FC_WEIGHT, bold ? FC_WEIGHT_BOLD : FC_WEIGHT_REGULAR);
+	FcPatternAddInteger(pat, FC_SLANT, italic ? FC_SLANT_ITALIC : FC_SLANT_ROMAN);
+	FcPatternAddBool(pat, FC_SCALABLE, FcTrue);
+	FcConfigSubstitute(NULL, pat, FcMatchPattern);
+	FcDefaultSubstitute(pat);
+	match = FcFontMatch(NULL, pat, &res);
+	FcPatternDestroy(pat);
+	if (!match) return NULL;
+	if (FcPatternGetString(match, FC_FILE, 0, &file) == FcResultMatch) {
+		unsigned char *f = init_str();
+		int fl = 0;
+		add_to_str(&f, &fl, (unsigned char *)file);
+		if (FcPatternGetInteger(match, FC_INDEX, 0, &idx) == FcResultMatch && idx > 0) {
+			add_to_str(&f, &fl, cast_uchar " @");
+			add_num_to_str(&f, &fl, idx);
+		}
+		c->file = f;
+	}
+	FcPatternDestroy(match);
+	return c->file;
+}
+
+void fontconfig_free_font_files(void)
+{
+	while (fc_files) {
+		struct fc_file_cache *c = fc_files;
+		fc_files = c->next;
+		if (c->file) mem_free(c->file);
+		mem_free(c);
+	}
+}
+
 void add_fontconfig_version(unsigned char **s, int *l)
 {
 	int fc_version;

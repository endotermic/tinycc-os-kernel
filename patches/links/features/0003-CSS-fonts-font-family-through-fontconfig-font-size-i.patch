 }
 
 unsigned char *freetype_get_allocated_font_name(struct style *st)
@@ -381,18 +392,26 @@ void freetype_init(void)
 	freetype_reload();
 }
 
+/* a face given in the options, else fontconfig's choice for the family: the built-in bitmap
+   fonts have no italic and only one proportional face */
+static void freetype_setup_default(struct freetype_face *face, unsigned char *option, char *family, int bold, int italic)
+{
+	if (option && *option) freetype_setup_font(face, option);
+	else freetype_setup_font(face, fontconfig_font_file(cast_uchar family, bold, italic));
+}
+
 void freetype_reload(void)
 {
-	freetype_setup_font(&faces[0], font_file);
-	freetype_setup_font(&faces[FF_BOLD], font_file_b);
-	freetype_setup_font(&faces[FF_MONOSPACED], font_file_m);
-	freetype_setup_font(&faces[FF_MONOSPACED | FF_BOLD], font_file_m_b);
+	freetype_setup_default(&faces[0], font_file, "serif", 0, 0);
+	freetype_setup_default(&faces[FF_BOLD], font_file_b, "serif", 1, 0);
+	freetype_setup_default(&faces[FF_MONOSPACED], font_file_m, "monospace", 0, 0);
+	freetype_setup_default(&faces[FF_MONOSPACED | FF_BOLD], font_file_m_b, "monospace", 1, 0);
 
 #ifdef USE_ITALIC
-	freetype_setup_font(&faces[FF_ITALIC], font_file_i);
-	freetype_setup_font(&faces[FF_ITALIC | FF_BOLD], font_file_i_b);
-	freetype_setup_font(&faces[FF_ITALIC | FF_MONOSPACED], font_file_i_m);
-	freetype_setup_font(&faces[FF_ITALIC | FF_MONOSPACED | FF_BOLD], font_file_i_m_b);
+	freetype_setup_default(&faces[FF_ITALIC], font_file_i, "serif", 0, 1);
+	freetype_setup_default(&faces[FF_ITALIC | FF_BOLD], font_file_i_b, "serif", 1, 1);
+	freetype_setup_default(&faces[FF_ITALIC | FF_MONOSPACED], font_file_i_m, "monospace", 0, 1);
+	freetype_setup_default(&faces[FF_ITALIC | FF_MONOSPACED | FF_BOLD], font_file_i_m_b, "monospace", 1, 1);
 #endif
 }
 
@@ -403,6 +422,13 @@ void freetype_done(void)
 
 	for (i = 0; i < FF_SHAPES; i++)
 		freetype_setup_font(&faces[i], NULL);
+	while (loaded_faces) {
+		struct freetype_face *f = loaded_faces;
+		loaded_faces = f->next_loaded;
+		cleanup_state(f);
+		mem_free(f);
+	}
+	fontconfig_free_font_files();
 
 	if (freetype_cache)
 		mem_free(freetype_cache), freetype_cache = NULL;

diff --git a/css.c b/css.c
index 304b4db..3dda022 100644
--- a/css.c
+++ b/css.c
@@ -34,12 +34,14 @@
 #define CP_DISPLAY	10
 #define CP_FFAMILY	11
 #define CP_FLOAT	12
-#define CP_N		13
+#define CP_FSIZE	13
+#define CP_FONT		14
+#define CP_N		15
 
 static const char * const css_prop_names[CP_N] = {
 	"width", "height", "vertical-align", "text-align", "background-color", "background",
 	"color", "font-weight", "font-style", "text-decoration", "display", "font-family",
-	"float"
+	"float", "font-size", "font"
 };
 
 struct css_decl {
@@ -954,6 +956,61 @@ int css_display_inline(unsigned char *attr)
 	return 0;
 }
 
+static int css_size_keyword(unsigned char *s, size_t l)
+{
+	static const char * const kw[] = { "xx-small", "x-small", "small", "medium", "large", "x-large", "xx-large", "xxx-large", "smaller", "larger", NULL };
+	int i;
+	for (i = 0; kw[i]; i++) if (strlen(kw[i]) == l && !strncmp(kw[i], cast_const_char s, l)) return 1;
+	return 0;
+}
+
+/* links' own size steps in pixels (html_gr.c get_real_font_size) */
+static int css_step_px(int size)
+{
+	static const int steps[7] = { 14, 15, 16, 19, 22, 25, 28 };
+	if (size < 1) size = 1;
+	if (size > 7) size = 7;
+	return (steps[size - 1] * d_opt->font_size) >> 4;
+}
+
+/* the size the element inherits: its parent's, in links pixels */
+static int css_parent_px(void)
+{
+	struct text_attrib *a = &format_;
+	if (html_top_->list_entry.next != &html_stack) a = &list_struct(html_top_->list_entry.next, struct html_element)->attr;
+	return a->fontpx > 0 ? a->fontpx : css_step_px(a->fontsize);
+}
+
+/* a CSS font-size in links pixels: CSS pixels are scaled by the user's font size against the
+   16 pixels browsers start from, so links' font size setting still zooms the page */
+static int css_font_px(unsigned char *v)
+{
+	double d, css;
+	char *end;
+	int parent = css_parent_px();
+	static const struct { const char *k; int px; } kw[] = {
+		{ "xx-small", 9 }, { "x-small", 10 }, { "small", 13 }, { "medium", 16 },
+		{ "large", 18 }, { "x-large", 24 }, { "xx-large", 32 }, { "xxx-large", 48 }, { NULL, 0 }
+	};
+	int i;
+	for (i = 0; kw[i].k; i++) if (!strcmp(cast_const_char v, kw[i].k)) return (kw[i].px * d_opt->font_size + 8) / 16;
+	if (!strcmp(cast_const_char v, "smaller")) return parent * 5 / 6;
+	if (!strcmp(cast_const_char v, "larger")) return parent * 6 / 5;
+	d = strtod(cast_const_char v, &end);
+	if ((unsigned char *)end == v || d <= 0) return 0;
+	if (!strcmp(end, "%")) return (int)(parent * d / 100 + 0.5);
+	if (!strcmp(end, "em")) return (int)(parent * d + 0.5);
+	if (!strcmp(end, "rem")) css = d * 16;
+	else if (!strcmp(end, "px") || !*end) css = d;
+	else if (!strcmp(end, "pt")) css = d * 4 / 3;
+	else if (!strcmp(end, "pc")) css = d * 16;
+	else if (!strcmp(end, "ex") || !strcmp(end, "ch")) return (int)(parent * d / 2 + 0.5);
+	else return 0;
+	if (css > 200) css = 200;
+	i = (int)(css * d_opt->font_size / 16 + 0.5);
+	return i < 6 ? 6 : i;
+}
+

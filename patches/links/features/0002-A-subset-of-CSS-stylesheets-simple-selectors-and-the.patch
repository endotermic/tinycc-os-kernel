+/* "[ label ]" as one unbreakable word (a button used to wrap at the spaces of its label),
+   centred in the CSS width of the button when it has one */
+static void put_button_label(unsigned char *a, unsigned char *label)
+{
+	int pad = 0, i;
+	unsigned char *p;
+	if (css_active) {
+		int w = css_field_chars(a);
+		int l = cp_len(d_opt->cp, label) + 4;
+		if (w > l) pad = w - l;
+	}
+	for (i = 0; i < pad / 2; i++) put_chrs(cast_uchar "&nbsp;", 6);
+	put_chrs(cast_uchar "[&nbsp;", 7);
+	for (p = label; *p; ) {
+		unsigned char *q = p;
+		while (*q && *q != ' ' && *q != '&') q++;
+		if (q > p) put_chrs(p, (int)(q - p));	/* a run, so that multibyte characters stay whole */
+		if (*q == ' ') put_chrs(cast_uchar "&nbsp;", 6);
+		else if (*q == '&') put_chrs(cast_uchar "&amp;", 5);
+		p = *q ? q + 1 : q;
+	}
+	put_chrs(cast_uchar "&nbsp;]", 7);
+	for (i = 0; i < pad - pad / 2; i++) put_chrs(cast_uchar "&nbsp;", 6);
+}

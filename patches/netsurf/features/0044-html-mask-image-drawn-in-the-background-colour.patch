 netsurf/content/handlers/html/box_construct.c |  19 ++
 .../content/handlers/html/box_manipulate.c    |   1 +
 netsurf/content/handlers/html/html.h          |   1 +
 netsurf/content/handlers/html/object.c        |  56 ++++-
 netsurf/content/handlers/html/object.h        |  11 +
 netsurf/content/handlers/html/redraw.c        | 227 +++++++++++++++++-
 7 files changed, 311 insertions(+), 10 deletions(-)


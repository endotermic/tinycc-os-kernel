+
 
 	/**
 	 * Object in this box (usually an image), or NULL if none.
diff --git a/netsurf/content/handlers/html/box_construct.c b/netsurf/content/handlers/html/box_construct.c
index cf286a1..6aaa6e4 100644
--- a/netsurf/content/handlers/html/box_construct.c
+++ b/netsurf/content/handlers/html/box_construct.c
@@ -478,6 +478,7 @@ box_construct_element(struct box_construct_ctx *ctx, bool *convert_children)
 	struct box *box = NULL, *old_box;
 	css_select_results *styles = NULL;
 	lwc_string *bgimage_uri;
+	lwc_string *mask_uri;
 	dom_exception err;
 	struct box_construct_props props;
 	const css_computed_style *root_style = NULL;
@@ -708,6 +709,24 @@ box_construct_element(struct box_construct_ctx *ctx, bool *convert_children)
 		}
 	}
 
+	/* and for a mask image (drawn in the background colour) */
+	if (css_computed_mask_image(box->style, &mask_uri) ==
+			CSS_MASK_IMAGE_IMAGE && mask_uri != NULL &&
+			nsoption_bool(background_images) == true) {
+		nsurl *url;
+		nserror error;
+
+		error = nsurl_create(lwc_string_data(mask_uri), &url);
+		if (error == NSERROR_OK) {
+			if (html_fetch_mask(ctx->content, url, box,
+					image_types) == false) {
+				nsurl_unref(url);
+				return false;
+			}
+			nsurl_unref(url);
+		}
+	}
+
 	if (*convert_children)
 		box->flags |= CONVERT_CHILDREN;
 

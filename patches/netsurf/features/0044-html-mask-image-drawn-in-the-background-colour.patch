@@ -205,7 +211,7 @@ html_object_callback(hlcache_handle *object,
 			event_node = dom_node_ref(box->node);
 			event_type = corestring_dom_load;
 		}
-		html_object_done(box, object, o->background);
+		html_object_done(box, object, o->background, o->mask);
 
 		if (c->base.status != CONTENT_STATUS_LOADING &&
 				box->flags & REPLACE_DIM) {
@@ -258,7 +264,15 @@ html_object_callback(hlcache_handle *object,
 
 			box_coords(box, &x, &y);
 
-			if (object == box->background) {

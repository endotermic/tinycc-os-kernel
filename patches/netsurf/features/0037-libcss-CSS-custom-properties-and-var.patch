diff --git a/libcss/src/parse/language.c b/libcss/src/parse/language.c
index 936ab3d..ea404cb 100644
--- a/libcss/src/parse/language.c
+++ b/libcss/src/parse/language.c
@@ -7,6 +7,7 @@
 
 #include <assert.h>
 #include <string.h>
+#include <strings.h>
 
 #include <parserutils/utils/stack.h>
 
@@ -1842,6 +1843,182 @@ css_error parseSelectorList(css_language *c, const parserutils_vector *vector,
  * Property parsing functions						      *
  ******************************************************************************/
 
+/* NetSurf: custom properties and declarations using var() ********/
+
+/* append bytes to a growing buffer; false on memory exhaustion */
+static bool text_append(char **buf, size_t *len, size_t *cap,
+		const void *data, size_t n)
+{
+	if (*len + n + 1 > *cap) {
+		size_t ncap = (*cap == 0 ? 64 : *cap * 2);
+		char *nb;
+		while (ncap < *len + n + 1)
+			ncap *= 2;
+		nb = realloc(*buf, ncap);
+		if (nb == NULL)
+			return false;
+		*buf = nb;
+		*cap = ncap;
+	}
+	memcpy(*buf + *len, data, n);
+	*len += n;
+	(*buf)[*len] = '\0';
+	return true;
+}
+
+/**
+ * The value tokens of a declaration as text, and whether it ends in
+ * !important (left out of the text).  Whitespace runs become one space;
+ * leading and trailing whitespace and comments are dropped.
+ */
+static css_error declaration_text(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		lwc_string **text, bool *important)
+{
+	int32_t start = *ctx, end, total, i, last = -1, bang = -1;
+	const css_token *t;
+	char *buf = NULL;
+	size_t len = 0, cap = 0;
+	bool space = false;
+	css_error error = CSS_OK;
+
+	(void) c;
+	*important = false;
+	/* the end, and the last two significant tokens */
+	for (end = start; (t = parserutils_vector_peek(vector, end)) != NULL;
+			end++) {
+		if (t->type == CSS_TOKEN_S || t->type == CSS_TOKEN_COMMENT)
+			continue;
+		bang = last;
+		last = end;
+	}
+	total = end;
+	if (last >= 0 && bang >= 0) {
+		const css_token *lt = parserutils_vector_peek(vector, last);
+		const css_token *bt = parserutils_vector_peek(vector, bang);
+		bool match = false;
+		if (lt->type == CSS_TOKEN_IDENT && bt->type == CSS_TOKEN_CHAR &&
+				bt->data.len == 1 && bt->data.data[0] == '!' &&
+				lwc_string_caseless_isequal(lt->idata,
+					c->strings[IMPORTANT], &match) ==
+					lwc_error_ok && match) {
+			*important = true;
+			end = bang;
+		}
+	}
+	for (i = start; i < end; i++) {
+		bool ok = true;
+		t = parserutils_vector_peek(vector, i);
+		if (t->type == CSS_TOKEN_COMMENT)
+			continue;
+		if (t->type == CSS_TOKEN_S) {
+			space = (len > 0);
+			continue;
+		}
+		if (space) {
+			ok = text_append(&buf, &len, &cap, " ", 1);
+			space = false;
+		}
+		switch (t->type) {
+		case CSS_TOKEN_STRING:
+			ok = ok && text_append(&buf, &len, &cap, "\"", 1) &&
+				text_append(&buf, &len, &cap,
+					t->data.data, t->data.len) &&
+				text_append(&buf, &len, &cap, "\"", 1);
+			break;
+		case CSS_TOKEN_URI:
+			ok = ok && text_append(&buf, &len, &cap, "url(", 4) &&
+				text_append(&buf, &len, &cap,
+					t->data.data, t->data.len) &&
+				text_append(&buf, &len, &cap, ")", 1);
+			break;
+		case CSS_TOKEN_HASH:
+			ok = ok && text_append(&buf, &len, &cap, "#", 1) &&
+				text_append(&buf, &len, &cap,
+					t->data.data, t->data.len);
+			break;
+		case CSS_TOKEN_PERCENTAGE:
+			ok = ok && text_append(&buf, &len, &cap,
+					t->data.data, t->data.len) &&
+				text_append(&buf, &len, &cap, "%", 1);
+			break;
+		case CSS_TOKEN_FUNCTION:
+			ok = ok && text_append(&buf, &len, &cap,
+					t->data.data, t->data.len) &&
+				text_append(&buf, &len, &cap, "(", 1);
+			break;
+		case CSS_TOKEN_ATKEYWORD:
+			ok = ok && text_append(&buf, &len, &cap, "@", 1) &&
+				text_append(&buf, &len, &cap,
+					t->data.data, t->data.len);
+			break;
+		case CSS_TOKEN_UNICODE_RANGE:
+			ok = ok && text_append(&buf, &len, &cap, "U+", 2) &&
+				text_append(&buf, &len, &cap,
+					t->data.data, t->data.len);
+			break;
+		default:
+			if (t->data.data != NULL)
+				ok = ok && text_append(&buf, &len, &cap,
+						t->data.data, t->data.len);
+			break;
+		}
+		if (!ok) {
+			free(buf);
+			return CSS_NOMEM;
+		}
+	}
+	if (lwc_intern_string(buf != NULL ? buf : "", len, text) !=
+			lwc_error_ok)
+		error = CSS_NOMEM;
+	free(buf);
+	/* the whole declaration is consumed */
+	*ctx = total;
+	return error;
+}
+
+/* whether a declaration's value uses var() */
+static bool declaration_uses_var(css_language *c,
+		const parserutils_vector *vector, int32_t ctx)
+{
+	const css_token *t;
+	(void) c;
+	for (; (t = parserutils_vector_peek(vector, ctx)) != NULL; ctx++) {
+		if (t->type == CSS_TOKEN_FUNCTION && t->data.len == 3 &&
+				strncasecmp((const char *) t->data.data,
+					"var", 3) == 0)
+			return true;
+	}
+	return false;
+}
+
+/* append a custom property or var() declaration to a rule: OPV, a, b */
+static css_error append_text_declaration(css_language *c, css_rule *rule,
+		opcode_t op, bool important, uint32_t a, lwc_string *value)
+{
+	css_error error;
+	css_style *style = NULL;
+	uint32_t vnum;
+
+	error = css__stylesheet_string_add(c->sheet, value, &vnum);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_create(c->sheet, &style);
+	if (error != CSS_OK)
+		return error;
+	error = css__stylesheet_style_append(style,
+			buildOPV(op, important ? FLAG_IMPORTANT : 0, 0));
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(style, a);
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(style, vnum);
+	if (error == CSS_OK)
+		error = css__stylesheet_rule_append_style(c->sheet, rule, style);
+	if (error != CSS_OK)
+		css__stylesheet_style_destroy(style);
+	return error;
+}
+
 css_error parseProperty(css_language *c, const css_token *property,
 		const parserutils_vector *vector, int32_t *ctx, css_rule *rule)
 {
@@ -1861,8 +2038,44 @@ css_error parseProperty(css_language *c, const css_token *property,
 				&match) == lwc_error_ok && match)
 			break;
 	}
-	if (i == LAST_PROP + 1)
+	if (i == LAST_PROP + 1) {
+		/* a custom property: --name: any tokens */
+		if (property->data.len > 2 && property->data.data[0] == '-' &&
+				property->data.data[1] == '-') {
+			lwc_string *name = NULL, *value = NULL;
+			uint32_t nnum;
+			bool important;
+			if (lwc_intern_string((const char *) property->data.data,
+					property->data.len, &name) !=
+					lwc_error_ok)
+				return CSS_NOMEM;
+			error = css__stylesheet_string_add(c->sheet, name, &nnum);
+			if (error != CSS_OK)
+				return error;
+			consumeWhitespace(vector, ctx);
+			error = declaration_text(c, vector, ctx, &value,
+					&important);
+			if (error != CSS_OK)
+				return error;
+			return append_text_declaration(c, rule,
+					CSS_OP_CUSTOM_PROPERTY, important,
+					nnum, value);
+		}
 		return CSS_INVALID;
+	}
+
+	/* a value using var(): kept as text, resolved at selection */
+	if (declaration_uses_var(c, vector, *ctx)) {
+		lwc_string *value = NULL;
+		bool important;
+		consumeWhitespace(vector, ctx);
+		error = declaration_text(c, vector, ctx, &value, &important);
+		if (error != CSS_OK)
+			return error;
+		return append_text_declaration(c, rule,
+				CSS_OP_VAR_DECLARATION, important,
+				(uint32_t) i, value);
+	}
 
 	/* Get handler */
 	handler = property_handlers[i - FIRST_PROP];

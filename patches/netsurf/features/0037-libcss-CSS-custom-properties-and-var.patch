diff --git a/libcss/src/bytecode/bytecode.h b/libcss/src/bytecode/bytecode.h
index ccfdcac..de8f335 100644
--- a/libcss/src/bytecode/bytecode.h
+++ b/libcss/src/bytecode/bytecode.h
@@ -119,6 +119,15 @@ static inline bool hasFlagValue(css_code_t OPV)
 	return getFlagValue(OPV) != FLAG_VALUE__NONE;
 }
 
+/* NetSurf: CSS custom properties and var().  Two opcodes past the
+ * properties (the opcode field has 10 bits):
+ *   CSS_OP_CUSTOM_PROPERTY  OPV, name (string number), value (string number)
+ *   CSS_OP_VAR_DECLARATION  OPV, property (index in the parser's property
+ *                           strings), value text with var() (string number)
+ * Both are kept as text and resolved when a node's style is selected. */
+#define CSS_OP_CUSTOM_PROPERTY ((opcode_t) 0x3fe)
+#define CSS_OP_VAR_DECLARATION ((opcode_t) 0x3fd)
+
 static inline bool isInherit(css_code_t OPV)
 {
 	return getFlagValue(OPV) == FLAG_VALUE_INHERIT;

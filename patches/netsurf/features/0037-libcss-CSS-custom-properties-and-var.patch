+ * Copyright 2026 Nikolajs Agafonovs
+ */
+
+/* CSS custom properties (--name: value) and var() */
+
+#ifndef css_select_custom_h_
+#define css_select_custom_h_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <libwapcaplet/libwapcaplet.h>
+#include <libcss/errors.h>
+
+#include "bytecode/bytecode.h"
+
+struct css_select_state;
+struct css_stylesheet;
+struct css_style;
+
+/**
+ * The custom properties of a computed style: inherited by every child that
+ * declares none of its own (the pointer is shared), names sorted by pointer
+ * (they are interned), values fully substituted.
+ */
+typedef struct css_custom_props {
+	uint32_t refcnt;
+	uint32_t n;
+	lwc_string **names;
+	lwc_string **values;
+} css_custom_props;
+
+/** A custom property or var() declaration met while cascading */
+typedef struct css_pending_decl {
+	opcode_t op;			/**< CSS_OP_CUSTOM_PROPERTY or _VAR_ */
+	uint32_t prop;			/**< var(): index of the property name */
+	lwc_string *name;		/**< custom: its name (a reference) */
+	lwc_string *value;		/**< the text (a reference) */
+	const struct css_stylesheet *sheet;	/**< for re-parsing */
+	uint32_t specificity;
+	uint32_t seq;			/**< order among the declarations */
+	uint8_t origin;
+	uint8_t pseudo;
+	bool important;
+} css_pending_decl;
+
+/** Parsed declarations after var() substitution, per selection context */
+struct css_var_cache;
+
+void css__custom_props_ref(css_custom_props *p);
+void css__custom_props_unref(css_custom_props *p);
+
+css_error css__custom_collect(struct css_select_state *state,
+		const struct css_style *style, css_code_t opv,
+		uint32_t a, uint32_t b);
+css_error css__custom_resolve(struct css_var_cache **cache,
+		struct css_select_state *state, void *parent);
+void css__custom_pending_free(struct css_select_state *state);
+void css__var_cache_destroy(struct css_var_cache *cache);
+
+#endif

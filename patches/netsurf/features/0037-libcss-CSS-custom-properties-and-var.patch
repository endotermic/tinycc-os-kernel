diff --git a/libcss/src/select/custom.c b/libcss/src/select/custom.c
new file mode 100644
index 0000000..3e8a8ae
--- /dev/null
+++ b/libcss/src/select/custom.c
@@ -0,0 +1,725 @@
+/*
+ * This file is part of LibCSS
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 Nikolajs Agafonovs
+ */
+
+/*
+ * CSS custom properties (--name: value) and var().
+ *
+ * The parser keeps both as text (CSS_OP_CUSTOM_PROPERTY,
+ * CSS_OP_VAR_DECLARATION).  While a node's style is cascaded they are
+ * collected with their origin, importance, specificity and order; once the
+ * node's ordinary declarations are cascaded:
+ *
+ * 1. the node's custom properties are its parent's (taken from the parent's
+ *    partial style) with its own winning declarations on top, their var()
+ *    references substituted (a cycle or a missing name without fallback
+ *    makes a property invalid, i.e. undefined); the result is kept on the
+ *    computed style for the children;
+ * 2. each var() declaration's text is substituted, parsed as an inline
+ *    style "property: text" (cached per selection context) and cascaded
+ *    with the declaration's own origin, importance and specificity; an
+ *    ordinary declaration of equal weight that came later still wins.  A
+ *    declaration that fails to substitute or parse is "unset".
+ */
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <libcss/stylesheet.h>
+
+#include "select/custom.h"
+#include "select/select.h"
+#include "select/computed.h"
+#include "select/dispatch.h"
+#include "parse/propstrings.h"
+#include "stylesheet.h"
+
+/* --- the map ------------------------------------------------------------ */
+
+void css__custom_props_ref(css_custom_props *p)
+{
+	if (p != NULL)
+		p->refcnt++;
+}
+
+void css__custom_props_unref(css_custom_props *p)
+{
+	uint32_t i;
+
+	if (p == NULL || --p->refcnt > 0)
+		return;
+	for (i = 0; i < p->n; i++) {
+		lwc_string_unref(p->names[i]);
+		lwc_string_unref(p->values[i]);
+	}
+	free(p->names);
+	free(p->values);
+	free(p);
+}
+
+static int ptr_cmp(const void *a, const void *b)
+{
+	uintptr_t x = (uintptr_t) *(lwc_string * const *) a;
+	uintptr_t y = (uintptr_t) *(lwc_string * const *) b;
+	return x < y ? -1 : x > y ? 1 : 0;
+}
+
+/* index of name in a pointer-sorted array, or -1 */
+static int32_t find_name(lwc_string *const *names, uint32_t n,
+		lwc_string *name)
+{
+	int32_t lo = 0, hi = (int32_t) n - 1;
+	while (lo <= hi) {
+		int32_t mid = (lo + hi) / 2;
+		if (names[mid] == name)
+			return mid;
+		if ((uintptr_t) names[mid] < (uintptr_t) name)
+			lo = mid + 1;
+		else
+			hi = mid - 1;
+	}
+	return -1;
+}
+
+static lwc_string *props_get(const css_custom_props *p, lwc_string *name)
+{
+	int32_t i;
+	if (p == NULL)
+		return NULL;
+	i = find_name(p->names, p->n, name);
+	return i < 0 ? NULL : p->values[i];
+}
+
+/* --- collecting ----------------------------------------------------------- */
+
+css_error css__custom_collect(css_select_state *state, const css_style *style,
+		css_code_t opv, uint32_t a, uint32_t b)
+{
+	css_pending_decl *d;
+	lwc_string *s = NULL;
+
+	if (state->n_pending == state->pending_alloc) {
+		uint32_t n = state->pending_alloc ? state->pending_alloc * 2 : 16;
+		css_pending_decl *p = realloc(state->pending, n * sizeof(*p));
+		if (p == NULL)
+			return CSS_NOMEM;
+		state->pending = p;
+		state->pending_alloc = n;
+	}
+	d = &state->pending[state->n_pending];
+	memset(d, 0, sizeof(*d));
+	d->op = getOpcode(opv);
+	d->important = isImportant(opv);
+	d->origin = state->current_origin;
+	d->specificity = state->current_specificity;
+	d->pseudo = state->current_pseudo;
+	d->seq = ++state->seq;
+	d->sheet = style->sheet;
+	if (d->op == CSS_OP_CUSTOM_PROPERTY) {
+		if (css__stylesheet_string_get(style->sheet, a, &s) != CSS_OK)
+			return CSS_OK;
+		d->name = lwc_string_ref(s);
+	} else {
+		d->prop = a;
+	}
+	if (css__stylesheet_string_get(style->sheet, b, &s) != CSS_OK) {
+		if (d->name != NULL)
+			lwc_string_unref(d->name);
+		return CSS_OK;
+	}
+	d->value = lwc_string_ref(s);
+	state->n_pending++;
+	return CSS_OK;
+}
+
+void css__custom_pending_free(css_select_state *state)
+{
+	uint32_t i;
+	for (i = 0; i < state->n_pending; i++) {
+		if (state->pending[i].name != NULL)
+			lwc_string_unref(state->pending[i].name);
+		if (state->pending[i].value != NULL)
+			lwc_string_unref(state->pending[i].value);
+	}
+	free(state->pending);
+	state->pending = NULL;
+	state->n_pending = state->pending_alloc = 0;
+}
+
+/* the cascade's order of origin and importance (css__outranks_existing) */
+static int decl_rank(const css_pending_decl *d)
+{
+	if (d->origin == CSS_ORIGIN_UA)
+		return 0;
+	if (d->origin == CSS_ORIGIN_USER)
+		return d->important ? 4 : 1;
+	return d->important ? 3 : 2;
+}
+
+/* whether a outranks b */
+static bool decl_beats(const css_pending_decl *a, const css_pending_decl *b)
+{
+	int ra = decl_rank(a), rb = decl_rank(b);
+	if (ra != rb)
+		return ra > rb;
+	if (a->specificity != b->specificity)
+		return a->specificity > b->specificity;
+	return a->seq > b->seq;
+}
+
+/* --- substitution --------------------------------------------------------- */
+
+struct buf {
+	char *data;
+	size_t len, cap;
+};
+
+static bool buf_add(struct buf *b, const char *s, size_t n)
+{
+	if (b->len + n + 1 > b->cap) {
+		size_t cap = b->cap ? b->cap * 2 : 128;
+		char *d;
+		while (cap < b->len + n + 1)
+			cap *= 2;
+		d = realloc(b->data, cap);
+		if (d == NULL)
+			return false;
+		b->data = d;
+		b->cap = cap;
+	}
+	memcpy(b->data + b->len, s, n);
+	b->len += n;
+	b->data[b->len] = '\0';
+	return true;
+}
+
+/* the node's own custom properties while they are resolved */
+struct resolver {
+	const css_custom_props *parent;	/* inherited, resolved */
+	const css_custom_props *map;	/* or: a finished map (var() pass) */
+	uint32_t n;
+	lwc_string **names;		/* own winners, pointer-sorted */
+	lwc_string **raw;
+	lwc_string **out;
+	uint8_t *st;			/* 0 new, 1 resolving, 2 done, 3 invalid */
+};
+
+static bool subst(struct resolver *r, const char *s, size_t len,
+		struct buf *out, int depth);
+
+static lwc_string *resolve_name(struct resolver *r, lwc_string *name,
+		int depth)
+{
+	int32_t i;
+	struct buf b = { NULL, 0, 0 };
+	const char *raw;
+	size_t rlen;
+
+	if (r->map != NULL)
+		return props_get(r->map, name);
+	i = find_name(r->names, r->n, name);
+	if (i < 0)
+		return props_get(r->parent, name);
+	switch (r->st[i]) {
+	case 2:
+		return r->out[i];
+	case 1:		/* a cycle */
+	case 3:
+		r->st[i] = 3;
+		return NULL;
+	}
+	raw = lwc_string_data(r->raw[i]);
+	rlen = lwc_string_length(r->raw[i]);
+	if (rlen == 7 && strncasecmp(raw, "inherit", 7) == 0)
+		raw = NULL;
+	else if (rlen == 5 && strncasecmp(raw, "unset", 5) == 0)
+		raw = NULL;
+	if (raw == NULL) {
+		lwc_string *v = props_get(r->parent, name);
+		r->out[i] = v != NULL ? lwc_string_ref(v) : NULL;
+		r->st[i] = v != NULL ? 2 : 3;
+		return v;
+	}
+	if (rlen == 7 && strncasecmp(raw, "initial", 7) == 0) {
+		r->st[i] = 3;
+		return NULL;
+	}
+	r->st[i] = 1;
+	if (subst(r, raw, rlen, &b, depth + 1) &&
+			lwc_intern_string(b.data != NULL ? b.data : "", b.len,
+				&r->out[i]) == lwc_error_ok &&
+			r->st[i] == 1) {
+		r->st[i] = 2;
+	} else {
+		if (r->out[i] != NULL) {
+			lwc_string_unref(r->out[i]);
+			r->out[i] = NULL;
+		}
+		r->st[i] = 3;
+	}
+	free(b.data);
+	return r->st[i] == 2 ? r->out[i] : NULL;
+}
+
+static bool name_char(char c)
+{
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+		(c >= '0' && c <= '9') || c == '-' || c == '_' ||
+		(unsigned char) c >= 0x80;
+}
+
+/* the end of a quoted string starting at s[i] */
+static size_t skip_string(const char *s, size_t len, size_t i)
+{
+	char q = s[i++];
+	while (i < len && s[i] != q) {
+		if (s[i] == '\\' && i + 1 < len)
+			i++;
+		i++;
+	}
+	return i < len ? i + 1 : len;
+}
+
+/* append s with every var() substituted; false when one is invalid */
+static bool subst(struct resolver *r, const char *s, size_t len,
+		struct buf *out, int depth)
+{
+	size_t i = 0, start = 0;
+
+	if (depth > 32)
+		return false;
+	while (i < len) {
+		size_t j, nstart, fstart = 0, fend = 0;
+		bool fallback = false;
+		lwc_string *name, *v;
+		int paren;
+
+		if (s[i] == '"' || s[i] == '\'') {
+			i = skip_string(s, len, i);
+			continue;
+		}
+		if (i + 4 > len || strncasecmp(s + i, "var(", 4) != 0 ||
+				(i > 0 && name_char(s[i - 1]))) {
+			i++;
+			continue;
+		}
+		if (!buf_add(out, s + start, i - start))
+			return false;
+		j = i + 4;
+		while (j < len && (s[j] == ' ' || s[j] == '\t'))
+			j++;
+		nstart = j;
+		while (j < len && name_char(s[j]))
+			j++;
+		if (j - nstart < 3 || s[nstart] != '-' || s[nstart + 1] != '-')
+			return false;
+		if (lwc_intern_string(s + nstart, j - nstart, &name) !=
+				lwc_error_ok)
+			return false;
+		while (j < len && (s[j] == ' ' || s[j] == '\t'))
+			j++;
+		if (j < len && s[j] == ',') {
+			fallback = true;
+			fstart = ++j;
+			for (paren = 0; j < len; ) {
+				if (s[j] == '"' || s[j] == '\'') {
+					j = skip_string(s, len, j);
+					continue;
+				}
+				if (s[j] == '(')
+					paren++;
+				else if (s[j] == ')' && paren-- == 0)
+					break;
+				j++;
+			}
+			fend = j;
+		}
+		if (j >= len || s[j] != ')') {
+			lwc_string_unref(name);
+			return false;
+		}
+		j++;
+		v = resolve_name(r, name, depth);
+		lwc_string_unref(name);
+		if (v != NULL) {
+			if (!buf_add(out, lwc_string_data(v),
+					lwc_string_length(v)))
+				return false;
+		} else if (fallback) {
+			while (fstart < fend && (s[fstart] == ' ' ||
+					s[fstart] == '\t'))
+				fstart++;
+			while (fend > fstart && (s[fend - 1] == ' ' ||
+					s[fend - 1] == '\t'))
+				fend--;
+			if (!subst(r, s + fstart, fend - fstart, out,
+					depth + 1))
+				return false;
+		} else {
+			return false;
+		}
+		i = start = j;
+	}
+	return buf_add(out, s + start, len - start);
+}
+
+/* --- the node's map --------------------------------------------------- */
+
+static css_custom_props *parent_props(css_select_state *state, void *parent)
+{
+	struct css_node_data *nd = NULL;
+	css_computed_style *ps;
+
+	if (parent == NULL || state->handler->get_libcss_node_data(state->pw,
+			parent, (void **) &nd) != CSS_OK || nd == NULL)
+		return NULL;
+	ps = nd->partial.styles[CSS_PSEUDO_ELEMENT_NONE];
+	return ps != NULL ? ps->custom_properties : NULL;
+}
+
+static css_error build_props(css_select_state *state, void *parent,
+		css_custom_props **result)
+{
+	css_custom_props *inherited = parent_props(state, parent), *p;
+	const css_pending_decl **win = NULL;
+	struct resolver r;
+	uint32_t i, j, k, n = 0, total;
+	css_error error = CSS_NOMEM;
+
+	*result = NULL;
+	memset(&r, 0, sizeof(r));
+	/* the winning declaration of each name (base element only) */
+	for (i = 0; i < state->n_pending; i++) {
+		const css_pending_decl *d = &state->pending[i];
+		if (d->op != CSS_OP_CUSTOM_PROPERTY ||
+				d->pseudo != CSS_PSEUDO_ELEMENT_NONE)
+			continue;
+		if (win == NULL) {
+			win = calloc(state->n_pending, sizeof(*win));
+			if (win == NULL)
+				return CSS_NOMEM;
+		}
+		for (j = 0; j < n; j++)
+			if (win[j]->name == d->name)
+				break;
+		if (j == n)
+			win[n++] = d;
+		else if (decl_beats(d, win[j]))
+			win[j] = d;
+	}
+	if (n == 0) {
+		css__custom_props_ref(inherited);
+		*result = inherited;
+		return CSS_OK;
+	}
+
+	r.parent = inherited;
+	r.n = n;
+	r.names = calloc(n, sizeof(*r.names));
+	r.raw = calloc(n, sizeof(*r.raw));
+	r.out = calloc(n, sizeof(*r.out));
+	r.st = calloc(n, 1);
+	if (r.names == NULL || r.raw == NULL || r.out == NULL || r.st == NULL)
+		goto out;
+	for (i = 0; i < n; i++)
+		r.names[i] = win[i]->name;
+	qsort(r.names, n, sizeof(*r.names), ptr_cmp);
+	for (i = 0; i < n; i++)
+		for (j = 0; j < n; j++)
+			if (win[j]->name == r.names[i])
+				r.raw[i] = win[j]->value;
+	for (i = 0; i < n; i++)
+		resolve_name(&r, r.names[i], 0);
+
+	/* the map: inherited names, own ones replacing or removing them */
+	total = (inherited != NULL ? inherited->n : 0) + n;
+	p = calloc(1, sizeof(*p));
+	if (p == NULL)
+		goto out;
+	p->refcnt = 1;
+	p->names = calloc(total ? total : 1, sizeof(*p->names));
+	p->values = calloc(total ? total : 1, sizeof(*p->values));
+	if (p->names == NULL || p->values == NULL) {
+		free(p->names);
+		free(p->values);
+		free(p);
+		goto out;
+	}
+	/* merge two pointer-sorted lists */
+	i = j = k = 0;
+	while ((inherited != NULL && i < inherited->n) || j < n) {
+		bool take_own;
+		if (inherited == NULL || i >= inherited->n)
+			take_own = true;
+		else if (j >= n)
+			take_own = false;
+		else
+			take_own = (uintptr_t) r.names[j] <=
+					(uintptr_t) inherited->names[i];
+		if (take_own) {
+			if (inherited != NULL && i < inherited->n &&
+					inherited->names[i] == r.names[j])
+				i++;	/* replaced (or removed) */
+			if (r.st[j] == 2) {
+				p->names[k] = lwc_string_ref(r.names[j]);
+				p->values[k++] = lwc_string_ref(r.out[j]);
+			}
+			j++;
+		} else {
+			p->names[k] = lwc_string_ref(inherited->names[i]);
+			p->values[k++] = lwc_string_ref(inherited->values[i]);
+			i++;
+		}
+	}
+	p->n = k;
+	*result = p;
+	error = CSS_OK;
+out:
+	if (r.out != NULL)
+		for (i = 0; i < n; i++)
+			if (r.out[i] != NULL)
+				lwc_string_unref(r.out[i]);
+	free(r.names);
+	free(r.raw);
+	free(r.out);
+	free(r.st);
+	free(win);
+	return error;
+}
+
+/* --- parsed declarations ---------------------------------------------- */
+
+struct var_entry {
+	lwc_string *key;		/* url, U+0001, declaration text */
+	css_stylesheet *sheet;		/* the parsed inline style */
+	struct var_entry *next;
+};
+
+#define VAR_BINS 1024
+
+struct css_var_cache {
+	struct var_entry *bins[VAR_BINS];
+};
+
+void css__var_cache_destroy(struct css_var_cache *cache)
+{
+	uint32_t i;
+	if (cache == NULL)
+		return;
+	for (i = 0; i < VAR_BINS; i++) {
+		struct var_entry *e = cache->bins[i], *next;
+		for (; e != NULL; e = next) {
+			next = e->next;
+			lwc_string_unref(e->key);
+			css_stylesheet_destroy(e->sheet);
+			free(e);
+		}
+	}
+	free(cache);
+}
+
+static css_error parse_inline(const css_stylesheet *from, const char *text,
+		size_t len, css_stylesheet **sheet)
+{
+	css_stylesheet_params params;
+	css_error error;
+
+	memset(&params, 0, sizeof(params));
+	params.params_version = CSS_STYLESHEET_PARAMS_VERSION_1;
+	params.level = from->level;
+	params.charset = "UTF-8";
+	params.url = from->url != NULL ? from->url : "";
+	params.allow_quirks = false;
+	params.inline_style = true;
+	params.resolve = from->resolve;
+	params.resolve_pw = from->resolve_pw;
+	params.color = from->color;
+	params.color_pw = from->color_pw;
+	params.font = from->font;
+	params.font_pw = from->font_pw;
+	error = css_stylesheet_create(&params, sheet);
+	if (error != CSS_OK)
+		return error;
+	error = css_stylesheet_append_data(*sheet, (const uint8_t *) text,
+			len);
+	if (error == CSS_OK || error == CSS_NEEDDATA)
+		error = css_stylesheet_data_done(*sheet);
+	if (error != CSS_OK) {
+		css_stylesheet_destroy(*sheet);
+		*sheet = NULL;
+	}
+	return error;
+}
+
+/* the parsed style of "property: text", or NULL if it does not parse */
+static const css_style *parsed_style(struct css_var_cache **cache,
+		const css_stylesheet *from, const char *decl, size_t len)
+{
+	struct buf key = { NULL, 0, 0 };
+	lwc_string *k = NULL;
+	struct var_entry *e;
+	uint32_t bin;
+	const char *url = from->url != NULL ? from->url : "";
+	css_rule_selector *sel;
+
+	if (*cache == NULL) {
+		*cache = calloc(1, sizeof(**cache));
+		if (*cache == NULL)
+			return NULL;
+	}
+	if (!buf_add(&key, url, strlen(url)) || !buf_add(&key, "\1", 1) ||
+			!buf_add(&key, decl, len) ||
+			lwc_intern_string(key.data, key.len, &k) !=
+				lwc_error_ok) {
+		free(key.data);
+		return NULL;
+	}
+	free(key.data);
+	bin = (uint32_t) (((uintptr_t) k >> 4) % VAR_BINS);
+	for (e = (*cache)->bins[bin]; e != NULL; e = e->next)
+		if (e->key == k)
+			break;
+	if (e == NULL) {
+		e = calloc(1, sizeof(*e));
+		if (e == NULL || parse_inline(from, decl, len, &e->sheet) !=
+				CSS_OK) {
+			free(e);
+			lwc_string_unref(k);
+			return NULL;
+		}
+		e->key = k;
+		e->next = (*cache)->bins[bin];
+		(*cache)->bins[bin] = e;
+	} else {
+		lwc_string_unref(k);
+	}
+	sel = (css_rule_selector *) e->sheet->rule_list;
+	if (sel == NULL || e->sheet->rule_list->type != CSS_RULE_SELECTOR)
+		return NULL;
+	return sel->style;
+}
+
+/* cascade a parsed style with the weight of declaration d */
+static css_error apply_style(css_select_state *state,
+		const css_pending_decl *d, const css_style *style)
+{
+	css_style s = *style;
+	css_origin origin = state->current_origin;
+	uint32_t specificity = state->current_specificity;
+	css_error error = CSS_OK;
+
+	state->current_origin = d->origin;
+	state->current_specificity = d->specificity;
+	while (s.used > 0 && error == CSS_OK) {
+		css_code_t opv = *s.bytecode;
+		opcode_t op = getOpcode(opv);
+		prop_state *ps, saved;
+		bool wins;
+
+		advance_bytecode(&s, sizeof(opv));
+		if (op >= CSS_N_PROPERTIES)
+			break;
+		ps = &state->props[op][d->pseudo];
+		saved = *ps;
+		if (ps->set && ps->origin == d->origin &&
+				ps->important == isImportant(opv) &&
+				ps->specificity == d->specificity &&
+				state->prop_seq[op][d->pseudo] > d->seq) {
+			/* an equal declaration came later: it stays; the
+			 * cascade function still consumes the value */
+			ps->set = 1;
+			ps->origin = CSS_ORIGIN_USER;
+			ps->important = 1;
+			error = prop_dispatch[op].cascade(opv, &s, state);
+			*ps = saved;
+			continue;
+		}
+		wins = css__outranks_existing(op, isImportant(opv), state,
+				getFlagValue(opv));
+		*ps = saved;
+		error = prop_dispatch[op].cascade(opv, &s, state);
+		if (wins)
+			state->prop_seq[op][d->pseudo] = d->seq;
+	}
+	state->current_origin = origin;
+	state->current_specificity = specificity;
+	return error;
+}
+
+css_error css__custom_resolve(struct css_var_cache **cache,
+		css_select_state *state, void *parent)
+{
+	css_computed_style *base = state->results->styles[
+			CSS_PSEUDO_ELEMENT_NONE];
+	css_custom_props *props = NULL;
+	lwc_string **strings = NULL;
+	struct resolver r;
+	css_pseudo_element pseudo = state->current_pseudo;
+	css_computed_style *computed = state->computed;
+	uint32_t i;
+	css_error error;
+
+	error = build_props(state, parent, &props);
+	if (error != CSS_OK)
+		return error;
+	if (base != NULL) {
+		css__custom_props_unref(base->custom_properties);
+		base->custom_properties = props;
+	} else {
+		css__custom_props_unref(props);
+	}
+
+	for (i = 0; i < state->n_pending; i++) {
+		const css_pending_decl *d = &state->pending[i];
+		struct buf b = { NULL, 0, 0 };
+		const css_style *style;
+		const char *name;
+		size_t nlen;
+		bool ok;
+
+		if (d->op != CSS_OP_VAR_DECLARATION ||
+				state->results->styles[d->pseudo] == NULL)
+			continue;
+		if (strings == NULL && css__propstrings_get(&strings) != CSS_OK)
+			break;
+		name = lwc_string_data(strings[d->prop]);
+		nlen = lwc_string_length(strings[d->prop]);
+		memset(&r, 0, sizeof(r));
+		r.map = props;
+		ok = buf_add(&b, name, nlen) && buf_add(&b, ":", 1) &&
+			subst(&r, lwc_string_data(d->value),
+				lwc_string_length(d->value), &b, 0) &&
+			(!d->important || buf_add(&b, " !important", 11));
+		style = ok ? parsed_style(cache, d->sheet, b.data, b.len) :
+				NULL;
+		if (style == NULL) {
+			/* invalid at computed-value time: unset */
+			b.len = 0;
+			if (buf_add(&b, name, nlen) &&
+					buf_add(&b, ":unset", 6) &&
+					(!d->important ||
+					 buf_add(&b, " !important", 11)))
+				style = parsed_style(cache, d->sheet,
+						b.data, b.len);
+		}
+		if (style != NULL) {
+			state->current_pseudo = d->pseudo;
+			state->computed = state->results->styles[d->pseudo];
+			error = apply_style(state, d, style);
+		}
+		free(b.data);
+		if (error != CSS_OK)
+			break;
+	}
+	if (strings != NULL)
+		css__propstrings_unref();
+	state->current_pseudo = pseudo;
+	state->computed = computed;
+	return error;
+}

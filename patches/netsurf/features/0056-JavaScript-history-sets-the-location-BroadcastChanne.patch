+		duk_push_string(ctx, "");
+	} else if (url_s[0] == '?') {
+		duk_push_lstring(ctx, url_s, url_l);
+	} else {
+		duk_push_string(ctx, "?");
+		duk_push_lstring(ctx, url_s, url_l);
+		duk_concat(ctx, 2);

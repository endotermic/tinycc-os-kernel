+/* ------------------------------------------------------------------ */
+/* MutationObserver                                                    */
+/*
+ * The records come from libdom's mutation events: N.observeMutations(node,
+ * hook) puts capturing listeners on each observed node, and hook() is called
+ * for every insertion, removal (before it happens), attribute change and
+ * text change at the node or under it.  A mutation reaches every observed
+ * ancestor; only the topmost one handles it.  Records go out as a microtask
+ * when a script made the change, and from a 0 ms timer when the parser did
+ * (the parser runs outside any script, between its insertions there is no
+ * point where a microtask would run in a browser either).
+ * Multi-node operations of this file (innerHTML, textContent, append, a
+ * fragment's insertion...) run as a batch: their childList records on one
+ * parent merge into one record, as a browser makes them.
+ */
+
+function moState() {
+    var s = state();
+    if (!s.mo) {
+        s.mo = { hooked: new Set(), regs: new WeakMap(), observers: [], ids: 0,
+                 micro: false, timer: 0, batch: null, depth: 0 };
+    }
+    return s.mo;
+}
+
+function isAncestorOf(a, n) {
+    for (n = n.parentNode; n; n = n.parentNode) if (n === a) return true;
+    return false;
+}
+
+/* run fn(), merging its childList records per parent */
+function moBatch(fn) {
+    var m = moState();
+    if (m.depth++ === 0) m.batch = {};
+    try { return fn(); }
+    finally { if (--m.depth === 0) m.batch = null; }
+}
+
+function MutationRecord() { throw new TypeError("Illegal constructor"); }
+function makeRecord(type, target) {
+    var r = Object.create(MutationRecord.prototype);
+    r.type = type; r.target = target;
+    r._added = []; r._removed = [];
+    r.previousSibling = null; r.nextSibling = null;
+    r.attributeName = null; r.attributeNamespace = null; r.oldValue = null;
+    return r;
+}
+function finishRecord(r) {
+    if (r._added) {
+        r.addedNodes = staticList(r._added);
+        r.removedNodes = staticList(r._removed);
+        delete r._added; delete r._removed; delete r._batch;
+    }
+    return r;
+}
+
+function moDeliver() {
+    var m = moState();
+    m.micro = false;
+    if (m.timer) { G.clearTimeout(m.timer); m.timer = 0; }
+    for (var guard = 0; guard < 100; guard++) {
+        var list = m.observers.filter(function (o) { return o._queue.length; });
+        if (!list.length) return;
+        list.sort(function (a, b) { return a._id - b._id; });
+        list.forEach(function (o) {
+            var recs = o._queue.splice(0).map(finishRecord);
+            if (!recs.length) return;
+            try { o._cb.call(o, recs, o); } catch (e) { report(e); }
+        });
+    }
+}
+
+function moSchedule(nested) {
+    var m = moState();
+    if (nested) {
+        if (!m.micro) {
+            m.micro = true;
+            Promise.resolve().then(moDeliver);
+        }
+    } else if (!m.micro && !m.timer) {
+        m.timer = G.setTimeout(function () { m.timer = 0; moDeliver(); }, 0);
+    }
+}
+
+/* queue a record for every interested observer (the spec's "queue a
+ * mutation record"); fill(record) sets the type-specific members */
+function moQueue(type, target, name, oldValue, merge, fill) {
+    var m = moState(), interested = new Map();
+    for (var n = target; n; n = n.parentNode) {
+        var regs = m.regs.get(n);
+        if (!regs) continue;
+        for (var i = 0; i < regs.length; i++) {
+            var o = regs[i].options;
+            if (n !== target && !o.subtree) continue;
+            if (type === "attributes" && (!o.attributes ||
+                (o.attributeFilter && o.attributeFilter.indexOf(name) < 0))) continue;
+            if (type === "characterData" && !o.characterData) continue;
+            if (type === "childList" && !o.childList) continue;
+            var ob = regs[i].observer;
+            if (!interested.has(ob)) interested.set(ob, null);
+            if ((type === "attributes" && o.attributeOldValue) ||
+                (type === "characterData" && o.characterDataOldValue))
+                interested.set(ob, oldValue);
+        }
+    }
+    interested.forEach(function (old, ob) {
+        var q = ob._queue, last = q[q.length - 1];
+        if (merge && m.batch && last && last._batch === m.batch && last.target === target) {
+            merge(last);
+            return;
+        }
+        var r = makeRecord(type, target);
+        if (type === "attributes") r.attributeName = name;
+        r.oldValue = old;
+        if (m.batch && type === "childList") r._batch = m.batch;
+        fill(r);
+        q.push(r);
+    });
+    return interested.size > 0;
+}
+
+function mutationHook(kind, target, current, related, name, prev, now, change, nested) {
+    var m = moState(), queued = false;
+    /* handled once, at the topmost observed node */
+    if (m.hooked.size > 1) {
+        for (var a = current.parentNode; a; a = a.parentNode)
+            if (m.hooked.has(a)) return;
+    }
+    if (kind === 1 || kind === 2) {
+        var parent = related || target.parentNode;
+        if (!parent) return;
+        var ps = target.previousSibling, ns = target.nextSibling;
+        queued = moQueue("childList", parent, null, null, function (r) {
+            (kind === 1 ? r._added : r._removed).push(target);
+            r.nextSibling = ns;
+        }, function (r) {
+            (kind === 1 ? r._added : r._removed).push(target);
+            r.previousSibling = ps;
+            r.nextSibling = ns;
+        });
+    } else if (kind === 3) {
+        queued = moQueue("attributes", target, name, change === 2 ? null : prev, null,
+                         function () {});
+    } else if (kind === 4) {
+        queued = moQueue("characterData", target, null, prev, null, function () {});
+    }
+    if (queued) moSchedule(nested);
+}
+
+function MutationObserver(callback) {
+    if (!new.target) throw new TypeError("Constructor MutationObserver requires 'new'");
+    if (typeof callback !== "function")
+        throw new TypeError("MutationObserver: the callback is not a function");
+    var m = moState();
+    this._cb = callback;
+    this._queue = [];
+    this._nodes = [];
+    this._id = ++m.ids;
+    m.observers.push(this);
+}
+def(MutationObserver.prototype, "observe", function (target, options) {
+    if (!target || typeof target.nodeType !== "number")
+        throw new TypeError("MutationObserver.observe: target is not a Node");
+    options = options || {};
+    var o = {
+        childList: !!options.childList,
+        attributes: options.attributes,
+        characterData: options.characterData,
+        subtree: !!options.subtree,
+        attributeOldValue: options.attributeOldValue,
+        characterDataOldValue: options.characterDataOldValue,
+        attributeFilter: options.attributeFilter
+    };
+    if ((o.attributeOldValue !== undefined || o.attributeFilter !== undefined) &&
+        o.attributes === undefined) o.attributes = true;
+    if (o.characterDataOldValue !== undefined && o.characterData === undefined)
+        o.characterData = true;
+    o.attributes = !!o.attributes;
+    o.characterData = !!o.characterData;
+    if (!o.childList && !o.attributes && !o.characterData)
+        throw new TypeError("MutationObserver.observe: one of childList, attributes or characterData must be true");
+    if (o.attributeOldValue && !o.attributes)
+        throw new TypeError("MutationObserver.observe: attributeOldValue without attributes");
+    if (o.attributeFilter !== undefined && !o.attributes)
+        throw new TypeError("MutationObserver.observe: attributeFilter without attributes");
+    if (o.characterDataOldValue && !o.characterData)
+        throw new TypeError("MutationObserver.observe: characterDataOldValue without characterData");
+    o.attributeOldValue = !!o.attributeOldValue;
+    o.characterDataOldValue = !!o.characterDataOldValue;
+    o.attributeFilter = o.attributeFilter === undefined ? null :
+        Array.prototype.map.call(o.attributeFilter, String);
+    var m = moState(), regs = m.regs.get(target);
+    if (!regs) { regs = []; m.regs.set(target, regs); }
+    for (var i = 0; i < regs.length; i++) {
+        if (regs[i].observer === this) { regs[i].options = o; return; }
+    }
+    regs.push({ observer: this, options: o });
+    this._nodes.push(target);
+    if (!m.hooked.has(target) && N.observeMutations) {
+        N.observeMutations(target, mutationHook);
+        m.hooked.add(target);
+    }
+});
+def(MutationObserver.prototype, "disconnect", function () {
+    var m = moState(), self = this;
+    this._nodes.forEach(function (n) {
+        var regs = m.regs.get(n);
+        if (regs) m.regs.set(n, regs.filter(function (r) { return r.observer !== self; }));
+    });
+    this._nodes = [];
+    this._queue = [];
+});
+def(MutationObserver.prototype, "takeRecords", function () {
+    return this._queue.splice(0).map(finishRecord);
+});
+G.MutationObserver = MutationObserver;
+G.WebKitMutationObserver = MutationObserver;
+G.MutationRecord = MutationRecord;
+
+/* the multi-node operations as batches */
+(function () {
+    function batched(o, name) {
+        if (!o || typeof o[name] !== "function") return;
+        wrap(o, name, function (orig) {
+            return function () {
+                var self = this, args = arguments;
+                return moBatch(function () { return orig.apply(self, args); });
+            };
+        });
+    }
+    function batchedIfFragment(o, name) {
+        if (!o || typeof o[name] !== "function") return;
+        wrap(o, name, function (orig) {
+            return function (node) {
+                var self = this, args = arguments;
+                if (!node || node.nodeType !== 11) return orig.apply(self, args);
+                return moBatch(function () { return orig.apply(self, args); });
+            };
+        });
+    }
+    function batchedSetter(o, name) {
+        var d = o && Object.getOwnPropertyDescriptor(o, name);
+        if (!d || !d.set) return;
+        var set = d.set.nsOriginal || d.set;
+        var f = function (v) { var self = this; moBatch(function () { set.call(self, v); }); };
+        f.nsOriginal = set;
+        acc(o, name, d.get, f);
+    }
+    [DocumentP, ElementP, FragmentP].forEach(function (p) {
+        ["append", "prepend", "replaceChildren"].forEach(function (k) { batched(p, k); });
+    });
+    [ElementP, CharDataP, proto("DocumentType")].forEach(function (p) {
+        ["before", "after", "replaceWith"].forEach(function (k) { batched(p, k); });
+    });
+    batched(ElementP, "insertAdjacentHTML");
+    ["appendChild", "insertBefore", "replaceChild"].forEach(function (k) { batchedIfFragment(NodeP, k); });
+    batchedSetter(ElementP, "outerHTML");
+    batchedSetter(NodeP, "textContent");
+})();
+
+/* ------------------------------------------------------------------ */
+/* IntersectionObserver and ResizeObserver                             */
+/*
+ * Both compare the last layout's boxes (N.box) with what they reported
+ * before: once soon after observe() and then every 100 ms while anything
+ * is observed (NetSurf tells scripts of no reflow and no scrolling).
+ * IntersectionObserver: the root is the viewport or an element's border
+ * box; rootMargin in px or % (of the root); clipping by scrolling
+ * ancestors is not looked at.
+ */
+
+function geoState() {
+    var s = state();
+    if (!s.geo) s.geo = { observers: [], timer: 0, soon: 0 };
+    return s.geo;
+}
+function geoActive() {
+    return geoState().observers.some(function (o) { return o._targets.length; });
+}
+function geoCheck() {

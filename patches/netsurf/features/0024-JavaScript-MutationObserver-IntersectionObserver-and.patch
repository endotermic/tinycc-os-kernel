+/*
+ * MutationObserver support: observeMutations(node, hook) adds capturing
+ * libdom listeners for the mutation events (DOMNodeInserted, DOMNodeRemoved,
+ * DOMAttrModified, DOMCharacterDataModified) to node; each event at node or
+ * under it calls
+ *   hook(kind, target, current, related, attrName, prevValue, newValue,
+ *        attrChange, nested)
+ * kind 1 inserted, 2 removed (before the removal), 3 attribute, 4 character
+ * data; current is node; nested is true when a script is running (records
+ * then go out as a microtask, else from the scheduler: the parser's
+ * insertions).  The hook is kept on the global object (one per page).
+ */
+#define MUTATION_HOOK MAGIC(MutationHook)
+
+static void native_push_string_or_null(duk_context *ctx, dom_string *s)
+{
+	if (s == NULL)
+		duk_push_null(ctx);
+	else
+		duk_push_lstring(ctx, dom_string_data(s), dom_string_length(s));
+}
+
+static void native_mutation_event(dom_event *evt, void *pw)
+{
+	duk_context *ctx = pw;
+	dom_string *type = NULL, *name = NULL, *prev = NULL, *now = NULL;
+	dom_event_target *target = NULL, *current = NULL;
+	dom_node *related = NULL;
+	dom_node_type ntype;
+	unsigned short change = 0;
+	int kind = 0;
+	duk_idx_t top;
+
+	if (dom_event_get_type(evt, &type) != DOM_NO_ERR || type == NULL)
+		return;
+	if (dom_string_isequal(type, corestring_dom_DOMNodeInserted))
+		kind = 1;
+	else if (dom_string_isequal(type, corestring_dom_DOMNodeRemoved))
+		kind = 2;
+	else if (dom_string_isequal(type, corestring_dom_DOMAttrModified))
+		kind = 3;
+	else if (dom_string_isequal(type, corestring_dom_DOMCharacterDataModified))
+		kind = 4;
+	dom_string_unref(type);
+	if (kind == 0)
+		return;
+	if (dom_event_get_target(evt, &target) != DOM_NO_ERR || target == NULL)
+		return;
+	if (dom_event_get_current_target(evt, &current) != DOM_NO_ERR ||
+	    current == NULL)
+		goto out;
+	/* an attribute node inserted into or removed from its element is
+	 * reported as the attribute change */
+	if (kind <= 2 && (dom_node_get_node_type((dom_node *)target, &ntype)
+			  != DOM_NO_ERR || ntype == DOM_ATTRIBUTE_NODE))
+		goto out;
+	dom_mutation_event_get_related_node(evt, &related);
+	dom_mutation_event_get_attr_name(evt, &name);
+	dom_mutation_event_get_prev_value(evt, &prev);
+	dom_mutation_event_get_new_value(evt, &now);
+	dom_mutation_event_get_attr_change(evt, &change);
+
+	top = duk_get_top(ctx);
+	duk_push_global_object(ctx);
+	duk_get_prop_string(ctx, -1, MUTATION_HOOK);
+	if (duk_is_object(ctx, -1) &&
+	    dukky_push_node(ctx, (dom_node *)target) &&
+	    dukky_push_node(ctx, (dom_node *)current)) {
+		duk_int_t depth = duk_netsurf_call_depth(ctx);
+		duk_push_int(ctx, kind);
+		duk_insert(ctx, -3);
+		if (related == NULL)
+			duk_push_null(ctx);
+		else if (!dukky_push_node(ctx, related))
+			duk_push_null(ctx);
+		native_push_string_or_null(ctx, name);
+		native_push_string_or_null(ctx, prev);
+		native_push_string_or_null(ctx, now);
+		duk_push_int(ctx, change);
+		duk_push_boolean(ctx, depth > 0);
+		dukky_pcall(ctx, 9, false);
+	}
+	duk_set_top(ctx, top);
+out:
+	if (related != NULL) dom_node_unref(related);
+	if (name != NULL) dom_string_unref(name);
+	if (prev != NULL) dom_string_unref(prev);
+	if (now != NULL) dom_string_unref(now);
+	if (current != NULL) dom_node_unref(current);
+	dom_node_unref(target);
+}
+
+static duk_ret_t native_observe_mutations(duk_context *ctx)
+{
+	static dom_string **const types[] = {
+		&corestring_dom_DOMNodeInserted,
+		&corestring_dom_DOMNodeRemoved,
+		&corestring_dom_DOMAttrModified,
+		&corestring_dom_DOMCharacterDataModified,
+	};
+	node_private_t *np;
+	size_t i;
+
+	if (!duk_is_object(ctx, 0) || !duk_is_object(ctx, 1))
+		return 0;
+	duk_get_prop_string(ctx, 0, PRIVATE_MAGIC);
+	np = duk_get_pointer(ctx, -1);
+	duk_pop(ctx);
+	if (np == NULL || np->node == NULL)
+		return 0;
+	duk_push_global_object(ctx);
+	duk_dup(ctx, 1);
+	duk_put_prop_string(ctx, -2, MUTATION_HOOK);
+	duk_pop(ctx);
+	for (i = 0; i < sizeof types / sizeof types[0]; i++) {
+		dom_event_listener *listen = NULL;
+		if (dom_event_listener_create(native_mutation_event, ctx,
+					      &listen) != DOM_NO_ERR)
+			return 0;
+		dom_event_target_add_event_listener(np->node, *types[i],
+						    listen, true);
+		dom_event_listener_unref(listen);
+	}
+	duk_push_boolean(ctx, true);
+	return 1;
+}
+
 static void native_put(duk_context *ctx, const char *name,
 		       duk_c_function fn, duk_idx_t nargs)
 {

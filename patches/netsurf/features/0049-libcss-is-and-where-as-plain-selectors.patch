From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Mon, 23 Nov 2026 17:50:41 +0200
Subject: [PATCH] libcss: :is() and :where() as plain selectors

Selectors with :is(), :where(), :matches(), :-webkit-any() or :-moz-any()
are expanded when parsed: "A:is(X, Y) B" becomes the selector list
"A X B, A Y B" (up to 64 selectors, nesting allowed), as libcss's
selectors have no lists inside them.  An argument with combinators inside
a compound selector is joined to it, and :where() has its argument's
specificity, as :is() has.  YouTube sizes its icons with
:where(.ytIconWrapperHost) { width: ...; height: ... }.
---
 libcss/src/parse/language.c | 293 +++++++++++++++++++++++++++++++++++-
 1 file changed, 291 insertions(+), 2 deletions(-)

diff --git a/libcss/src/parse/language.c b/libcss/src/parse/language.c
index ea404cb..aa3f285 100644
--- a/libcss/src/parse/language.c
+++ b/libcss/src/parse/language.c
@@ -6,6 +6,7 @@
  */
 
 #include <assert.h>
+#include <stdlib.h>
 #include <string.h>
 #include <strings.h>
 
@@ -1780,8 +1781,277 @@ css_error parseSelector(css_language *c, const parserutils_vector *vector,
 	return CSS_OK;
 }
 
-css_error parseSelectorList(css_language *c, const parserutils_vector *vector,
-		css_rule *rule)
+/* NetSurf: :is() and :where() ********************************************/
+
+#define ISWHERE_MAX_SELECTORS 64
+
+/** a selector as a range of tokens, possibly with one range replaced */
+typedef struct iswhere_sel {
+	const css_token **tok;
+	size_t n;
+} iswhere_sel;
+
+static bool iswhere_is_function(const css_token *t)
+{
+	static const char *const names[] = { "is", "where", "matches",
+		"-webkit-any", "-moz-any", NULL };
+	int i;
+
+	if (t->type != CSS_TOKEN_FUNCTION || t->idata == NULL)
+		return false;
+	for (i = 0; names[i] != NULL; i++)
+		if (lwc_string_length(t->idata) == strlen(names[i]) &&
+				strncasecmp(lwc_string_data(t->idata),
+					names[i], strlen(names[i])) == 0)
+			return true;
+	return false;
+}
+
+static bool iswhere_opens(const css_token *t)
+{
+	return t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '(') ||
+			tokenIsChar(t, '[');
+}
+
+static bool iswhere_closes(const css_token *t)
+{
+	return tokenIsChar(t, ')') || tokenIsChar(t, ']');
+}
+
+/**
+ * Expand :is() and :where() (and :matches(), :-webkit-any(), :-moz-any())
+ * into plain selectors: "A:is(X, Y) B" is the selector list "A X B, A Y B".
+ * libcss's selectors have no lists inside them.  Arguments are put in place
+ * of the pseudo-class as they are, so an argument with combinators inside a
+ * compound selector is joined to it (not as the spec matches it), and
+ * :where() has the specificity of its argument, as :is() has.
+ *
+ * \param vector  the rule's selector tokens
+ * \param out     receives a new vector of the expanded tokens (shallow
+ *                copies, plus the interned comma \a comma), or NULL if
+ *                there is nothing to expand
+ */
+static css_error expandIsWhere(const parserutils_vector *vector,
+		parserutils_vector **out, lwc_string **comma)
+{
+	const css_token **all = NULL;
+	iswhere_sel *list = NULL, *next = NULL;
+	const css_token ***pool = NULL;
+	size_t n = 0, nlist = 0, nnext = 0, npool = 0, i, k;
+	int32_t ctx = 0;
+	const css_token *t;
+	bool found = false;
+	css_token comma_token;
+	css_error error = CSS_OK;
+	int round;
+
+	*out = NULL;
+	*comma = NULL;
+
+	while ((t = parserutils_vector_iterate(vector, &ctx)) != NULL) {
+		if (iswhere_is_function(t))
+			found = true;
+		n++;
+	}
+	if (!found)
+		return CSS_OK;
+
+	all = malloc(n * sizeof(*all));
+	list = malloc(ISWHERE_MAX_SELECTORS * sizeof(*list));
+	next = malloc(ISWHERE_MAX_SELECTORS * sizeof(*next));
+	pool = malloc(8 * ISWHERE_MAX_SELECTORS * sizeof(*pool));
+	if (all == NULL || list == NULL || next == NULL || pool == NULL) {
+		error = CSS_NOMEM;
+		goto out;
+	}
+	ctx = 0;
+	for (i = 0; i < n; i++)
+		all[i] = parserutils_vector_iterate(vector, &ctx);
+
+	/* the selector list, split at top-level commas */
+	{
+		size_t start = 0;
+		int depth = 0;
+		for (i = 0; i <= n; i++) {
+			if (i < n && iswhere_opens(all[i]))
+				depth++;
+			else if (i < n && iswhere_closes(all[i]) && depth > 0)
+				depth--;
+			if (i == n || (depth == 0 && tokenIsChar(all[i], ','))) {
+				if (nlist == ISWHERE_MAX_SELECTORS) {
+					error = CSS_INVALID;
+					goto out;
+				}
+				list[nlist].tok = all + start;
+				list[nlist].n = i - start;
+				nlist++;
+				start = i + 1;
+			}
+		}
+	}
+
+	/* replace the first top-level :is() of each selector by each of its
+	 * arguments until there are none (arguments may hold more) */
+	for (round = 0; round < 8 && found; round++) {
+		found = false;
+		nnext = 0;
+		for (k = 0; k < nlist; k++) {
+			const css_token **tok = list[k].tok;
+			size_t len = list[k].n, f, f0, e, a;
+			int depth = 0;
+
+			for (f = 0; f < len; f++) {
+				if (depth == 0 && iswhere_is_function(tok[f]))
+					break;
+				if (iswhere_opens(tok[f]))
+					depth++;
+				else if (iswhere_closes(tok[f]) && depth > 0)
+					depth--;
+			}
+			if (f == len) {
+				if (nnext == ISWHERE_MAX_SELECTORS) {
+					error = CSS_INVALID;
+					goto out;
+				}
+				next[nnext++] = list[k];
+				continue;
+			}
+			found = true;
+
+			/* its closing bracket */
+			depth = 0;
+			for (e = f + 1; e < len; e++) {
+				if (iswhere_opens(tok[e]))
+					depth++;
+				else if (iswhere_closes(tok[e])) {
+					if (depth == 0)
+						break;
+					depth--;
+				}
+			}
+			if (e == len) {
+				error = CSS_INVALID;
+				goto out;
+			}
+
+			/* one selector per argument; the copies leave out the
+			 * pseudo-class's colon, a token of its own (f0 is
+			 * where the prefix ends) */
+			a = f + 1;
+			f0 = (f > 0 && tokenIsChar(tok[f - 1], ':')) ? f - 1 : f;
+			while (a <= e) {
+				size_t b = a, m, j, from, to;
+				const css_token **copy;
+				depth = 0;
+				for (; b < e; b++) {
+					if (iswhere_opens(tok[b]))
+						depth++;
+					else if (iswhere_closes(tok[b]) &&
+							depth > 0)
+						depth--;
+					else if (depth == 0 &&
+							tokenIsChar(tok[b], ','))
+						break;
+				}
+				/* the argument without surrounding spaces */
+				from = a;
+				to = b;
+				while (from < to && tok[from]->type ==
+						CSS_TOKEN_S)
+					from++;
+				while (to > from && tok[to - 1]->type ==
+						CSS_TOKEN_S)
+					to--;
+				if (from == to) {
+					/* an empty argument */
+					error = CSS_INVALID;
+					goto out;
+				}
+				m = f0 + (to - from) + (len - e - 1);
+				copy = malloc((m ? m : 1) * sizeof(*copy));
+				if (copy == NULL) {
+					error = CSS_NOMEM;
+					goto out;
+				}
+				/* (at most one per selector per round) */
+				pool[npool++] = copy;
+				for (j = 0; j < f0; j++)
+					copy[j] = tok[j];
+				for (j = from; j < to; j++)
+					copy[f0 + j - from] = tok[j];
+				for (j = e + 1; j < len; j++)
+					copy[f0 + (to - from) + j - e - 1] = tok[j];
+				if (nnext == ISWHERE_MAX_SELECTORS) {
+					/* (the pool frees it) */
+					error = CSS_INVALID;
+					goto out;
+				}
+				next[nnext].tok = copy;
+				next[nnext].n = m;
+				nnext++;
+				a = b + 1;
+			}
+		}
+		{
+			iswhere_sel *tmp = list;
+			list = next;
+			next = tmp;
+			nlist = nnext;
+		}
+	}
+
+	/* the new token vector: the selectors joined by commas */
+	if (lwc_intern_string(",", 1, comma) != lwc_error_ok) {
+		error = CSS_NOMEM;
+		goto out;
+	}
+	memset(&comma_token, 0, sizeof(comma_token));
+	comma_token.type = CSS_TOKEN_CHAR;
+	comma_token.data.data = (uint8_t *) ",";
+	comma_token.data.len = 1;
+	comma_token.idata = *comma;
+
+	if (parserutils_vector_create(sizeof(css_token), 64, out) !=
+			PARSERUTILS_OK) {
+		error = CSS_NOMEM;
+		goto out;
+	}
+	for (k = 0; k < nlist; k++) {
+		if (k > 0 && parserutils_vector_append(*out, &comma_token) !=
+				PARSERUTILS_OK) {
+			error = CSS_NOMEM;
+			goto out;
+		}
+		for (i = 0; i < list[k].n; i++)
+			if (parserutils_vector_append(*out,
+					(void *) list[k].tok[i]) !=
+					PARSERUTILS_OK) {
+				error = CSS_NOMEM;
+				goto out;
+			}
+	}
+
+out:
+	if (error != CSS_OK && *out != NULL) {
+		parserutils_vector_destroy(*out);
+		*out = NULL;
+	}
+	if (error != CSS_OK && *comma != NULL) {
+		lwc_string_unref(*comma);
+		*comma = NULL;
+	}
+	/* the copies made, all rounds */
+	for (k = 0; k < npool; k++)
+		free((void *) pool[k]);
+	free(pool);
+	free(list);
+	free(next);
+	free(all);
+	return error;
+}
+
+static css_error parseSelectorListTokens(css_language *c,
+		const parserutils_vector *vector, css_rule *rule)
 {
 	css_error error;
 	const css_token *token = NULL;
@@ -1839,6 +2109,25 @@ css_error parseSelectorList(css_language *c, const parserutils_vector *vector,
 	return CSS_OK;
 }
 
+css_error parseSelectorList(css_language *c, const parserutils_vector *vector,
+		css_rule *rule)
+{
+	parserutils_vector *expanded = NULL;
+	lwc_string *comma = NULL;
+	css_error error;
+
+	error = expandIsWhere(vector, &expanded, &comma);
+	if (error != CSS_OK)
+		return error;
+	if (expanded == NULL)
+		return parseSelectorListTokens(c, vector, rule);
+
+	error = parseSelectorListTokens(c, expanded, rule);
+	parserutils_vector_destroy(expanded);
+	lwc_string_unref(comma);
+	return error;
+}
+
 /******************************************************************************
  * Property parsing functions						      *
  ******************************************************************************/

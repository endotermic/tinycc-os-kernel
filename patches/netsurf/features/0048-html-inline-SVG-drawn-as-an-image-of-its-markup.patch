From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Mon, 23 Nov 2026 17:50:41 +0200
Subject: [PATCH] html: inline SVG drawn as an image of its markup

An <svg> element in an HTML document (in the SVG namespace, not inside
another) gets a replaced box whose object is its subtree written out as
SVG markup and fetched as a data: URL of type image/svg+xml, drawn by the
SVG image handler; its children make no boxes.  Attribute and element
names the HTML parser lower-cased (markup set through innerHTML: viewbox)
are written in SVG's case, currentColor becomes the element's CSS colour,
and the root gets that colour as its fill when it has none (icons are
drawn with fill: currentcolor; libcss has no fill).  The markup is written
again whenever the box tree is rebuilt.
---
 netsurf/content/handlers/html/box_special.c | 340 ++++++++++++++++++++
 1 file changed, 340 insertions(+)

diff --git a/netsurf/content/handlers/html/box_special.c b/netsurf/content/handlers/html/box_special.c
index f1d5ed5..c3bc7ea 100644
--- a/netsurf/content/handlers/html/box_special.c
+++ b/netsurf/content/handlers/html/box_special.c
@@ -27,8 +27,10 @@
  */
 
 #include <string.h>
+#include <strings.h>
 #include <stdbool.h>
 #include <dom/dom.h>
+#include <nsutils/base64.h>
 
 #include "utils/nsoption.h"
 #include "utils/corestrings.h"
@@ -1857,6 +1859,341 @@ static bool box_textarea(dom_node *n,
 
 
 /* exported interface documented in html/box_special.h */
+
+/*
+ * Inline SVG.
+ *
+ * An <svg> element in an HTML document (in the SVG namespace, not inside
+ * another one) is shown like an image of itself: its subtree is written out
+ * as SVG markup, which is fetched as a data: URL of type image/svg+xml and
+ * drawn by the SVG image handler into a replaced box.  Its children make no
+ * boxes.  The markup is written again whenever the box tree is rebuilt, so
+ * changes made by scripts show after the next rebuild.
+ */
+
+/** markup being written */
+struct svg_buf {
+	char *data;
+	size_t len, alloc;
+	bool ok;
+	char colour[8];	/* the svg element's CSS colour, "#rrggbb" */
+};
+
+static void svg_buf_add(struct svg_buf *b, const char *s, size_t n)
+{
+	if (!b->ok)
+		return;
+	if (b->len + n + 1 > b->alloc) {
+		size_t alloc = b->alloc ? b->alloc : 1024;
+		char *d;
+		while (b->len + n + 1 > alloc)
+			alloc *= 2;
+		d = realloc(b->data, alloc);
+		if (d == NULL) {
+			b->ok = false;
+			return;
+		}
+		b->data = d;
+		b->alloc = alloc;
+	}
+	memcpy(b->data + b->len, s, n);
+	b->len += n;
+	b->data[b->len] = '\0';
+}
+
+static void svg_buf_str(struct svg_buf *b, const char *s)
+{
+	svg_buf_add(b, s, strlen(s));
+}
+
+/** text with &, <, > and " escaped */
+static void svg_buf_escaped(struct svg_buf *b, const char *s, size_t n)
+{
+	size_t i, start = 0;
+	for (i = 0; i < n; i++) {
+		const char *e = NULL;
+		switch (s[i]) {
+		case '&': e = "&amp;"; break;
+		case '<': e = "&lt;"; break;
+		case '>': e = "&gt;"; break;
+		case '"': e = "&quot;"; break;
+		default: break;
+		}
+		if (e != NULL) {
+			svg_buf_add(b, s + start, i - start);
+			svg_buf_str(b, e);
+			start = i + 1;
+		}
+	}
+	svg_buf_add(b, s + start, n - start);
+}
+
+/**
+ * SVG attribute names the HTML parser lower-cases (when it does not adjust
+ * them, as in markup set through innerHTML); SVG's are case-sensitive
+ */
+static const char *svg_attr_name(const char *name)
+{
+	static const char *const names[] = {
+		"attributeName", "attributeType", "baseFrequency",
+		"clipPathUnits", "diffuseConstant", "edgeMode",
+		"filterUnits", "gradientTransform", "gradientUnits",
+		"kernelMatrix", "kernelUnitLength", "keyPoints", "keySplines",
+		"keyTimes", "lengthAdjust", "limitingConeAngle", "markerHeight",
+		"markerUnits", "markerWidth", "maskContentUnits", "maskUnits",
+		"numOctaves", "pathLength", "patternContentUnits",
+		"patternTransform", "patternUnits", "pointsAtX", "pointsAtY",
+		"pointsAtZ", "preserveAlpha", "preserveAspectRatio",
+		"primitiveUnits", "refX", "refY", "repeatCount", "repeatDur",
+		"requiredExtensions", "requiredFeatures", "specularConstant",
+		"specularExponent", "spreadMethod", "startOffset",
+		"stdDeviation", "stitchTiles", "surfaceScale", "systemLanguage",
+		"tableValues", "targetX", "targetY", "textLength", "viewBox",
+		"viewTarget", "xChannelSelector", "yChannelSelector",
+		"zoomAndPan", NULL
+	};
+	int i;
+	for (i = 0; names[i] != NULL; i++)
+		if (strcasecmp(names[i], name) == 0)
+			return names[i];
+	return name;
+}
+
+/** element names likewise (foreignObject, linearGradient, ...) */
+static const char *svg_element_name(const char *name)
+{
+	static const char *const names[] = {
+		"altGlyph", "altGlyphDef", "altGlyphItem", "animateColor",
+		"animateMotion", "animateTransform", "clipPath", "feBlend",
+		"feColorMatrix", "feComponentTransfer", "feComposite",
+		"feConvolveMatrix", "feDiffuseLighting", "feDisplacementMap",
+		"feDistantLight", "feDropShadow", "feFlood", "feFuncA",
+		"feFuncB", "feFuncG", "feFuncR", "feGaussianBlur", "feImage",
+		"feMerge", "feMergeNode", "feMorphology", "feOffset",
+		"fePointLight", "feSpecularLighting", "feSpotLight", "feTile",
+		"feTurbulence", "foreignObject", "glyphRef", "linearGradient",
+		"radialGradient", "textPath", NULL
+	};
+	int i;
+	for (i = 0; names[i] != NULL; i++)
+		if (strcasecmp(names[i], name) == 0)
+			return names[i];
+	return name;
+}
+
+static void svg_write_node(struct svg_buf *b, dom_node *node, bool root)
+{
+	dom_node_type type;
+	dom_exception err;
+
+	if (!b->ok)
+		return;
+	err = dom_node_get_node_type(node, &type);
+	if (err != DOM_NO_ERR)
+		return;
+
+	if (type == DOM_TEXT_NODE || type == DOM_CDATA_SECTION_NODE) {
+		dom_string *text = NULL;
+		err = dom_node_get_node_value(node, &text);
+		if (err == DOM_NO_ERR && text != NULL) {
+			svg_buf_escaped(b, dom_string_data(text),
+					dom_string_byte_length(text));
+			dom_string_unref(text);
+		}
+		return;
+	}
+
+	if (type == DOM_ELEMENT_NODE) {
+		dom_string *name = NULL;
+		dom_namednodemap *attrs = NULL;
+		dom_node *child = NULL, *next;
+		const char *tag;
+		bool has_fill = false, has_xmlns = false;
+		uint32_t n = 0, i;
+
+		err = dom_node_get_local_name(node, &name);
+		if (err != DOM_NO_ERR || name == NULL)
+			return;
+		tag = svg_element_name(dom_string_data(name));
+
+		svg_buf_str(b, "<");
+		svg_buf_str(b, tag);
+
+		err = dom_node_get_attributes(node, &attrs);
+		if (err == DOM_NO_ERR && attrs != NULL) {
+			dom_namednodemap_get_length(attrs, &n);
+			for (i = 0; i < n; i++) {
+				dom_attr *attr = NULL;
+				dom_string *an = NULL, *av = NULL;
+				const char *a, *v;
+				err = dom_namednodemap_item(attrs, i,
+						(void *) &attr);
+				if (err != DOM_NO_ERR || attr == NULL)
+					continue;
+				if (dom_attr_get_name(attr, &an) == DOM_NO_ERR &&
+						an != NULL &&
+						dom_attr_get_value(attr, &av) ==
+						DOM_NO_ERR && av != NULL) {
+					a = svg_attr_name(dom_string_data(an));
+					v = dom_string_data(av);
+					if (strcmp(a, "fill") == 0)
+						has_fill = true;
+					if (strcmp(a, "xmlns") == 0)
+						has_xmlns = true;
+					svg_buf_str(b, " ");
+					svg_buf_str(b, a);
+					svg_buf_str(b, "=\"");
+					/* currentColor is the svg element's
+					 * colour */
+					if (strcasecmp(v, "currentcolor") == 0)
+						svg_buf_str(b, b->colour);
+					else
+						svg_buf_escaped(b, v,
+							dom_string_byte_length(
+								av));
+					svg_buf_str(b, "\"");
+				}
+				if (an != NULL)
+					dom_string_unref(an);
+				if (av != NULL)
+					dom_string_unref(av);
+				dom_node_unref(attr);
+			}
+			dom_namednodemap_unref(attrs);
+		}
+		if (root) {
+			if (!has_xmlns)
+				svg_buf_str(b, " xmlns=\"http://www.w3.org/2000/svg\"");
+			svg_buf_str(b, " xmlns:xlink=\"http://www.w3.org/1999/xlink\"");
+			/* icons are drawn with fill: currentcolor set on the
+			 * page (the svg element or its parents); libcss has
+			 * no fill property, so the colour is the default */
+			if (!has_fill) {
+				svg_buf_str(b, " fill=\"");
+				svg_buf_str(b, b->colour);
+				svg_buf_str(b, "\"");
+			}
+		}
+		svg_buf_str(b, ">");
+
+		err = dom_node_get_first_child(node, &child);
+		while (err == DOM_NO_ERR && child != NULL) {
+			svg_write_node(b, child, false);
+			err = dom_node_get_next_sibling(child, &next);
+			dom_node_unref(child);
+			child = next;
+		}
+
+		svg_buf_str(b, "</");
+		svg_buf_str(b, tag);
+		svg_buf_str(b, ">");
+		dom_string_unref(name);
+	}
+}
+
+/** whether an element is the top <svg> element of an inline SVG */
+static bool box_is_inline_svg(dom_node *n)
+{
+	dom_string *ns = NULL, *name = NULL;
+	dom_node *parent = NULL;
+	bool svg = false;
+
+	if (dom_node_get_namespace(n, &ns) != DOM_NO_ERR || ns == NULL)
+		return false;
+	if (dom_string_isequal(ns, corestring_dom_svg_namespace) &&
+			dom_node_get_local_name(n, &name) == DOM_NO_ERR &&
+			name != NULL &&
+			strcasecmp(dom_string_data(name), "svg") == 0) {
+		svg = true;
+		/* not inside another svg element */
+		if (dom_node_get_parent_node(n, &parent) == DOM_NO_ERR &&
+				parent != NULL) {
+			dom_string *pns = NULL;
+			if (dom_node_get_namespace(parent, &pns) ==
+					DOM_NO_ERR && pns != NULL) {
+				if (dom_string_isequal(pns,
+						corestring_dom_svg_namespace))
+					svg = false;
+				dom_string_unref(pns);
+			}
+			dom_node_unref(parent);
+		}
+	}
+	if (name != NULL)
+		dom_string_unref(name);
+	dom_string_unref(ns);
+	return svg;
+}
+
+/**
+ * Inline SVG element: drawn as an image of its own markup.
+ */
+static bool
+box_svg(dom_node *n,
+	html_content *content,
+	struct box *box,
+	bool *convert_children)
+{
+	struct svg_buf b = { NULL, 0, 0, true, "#000000" };
+	uint8_t *b64 = NULL;
+	size_t b64len = 0;
+	char *urlstr;
+	nsurl *url;
+	nserror error;
+	css_color colour;
+	bool ok = true;
+
+	/* its children are markup for the image, not boxes */
+	if (convert_children)
+		*convert_children = false;
+
+	if (box->style == NULL || ns_computed_display(box->style,
+			box_is_root(n)) == CSS_DISPLAY_NONE)
+		return true;
+	if (nsoption_bool(foreground_images) == false)
+		return true;
+
+	if (css_computed_color(box->style, &colour) == CSS_COLOR_COLOR)
+		snprintf(b.colour, sizeof b.colour, "#%02x%02x%02x",
+				(unsigned) ((colour >> 16) & 0xff),
+				(unsigned) ((colour >> 8) & 0xff),
+				(unsigned) (colour & 0xff));
+
+	svg_write_node(&b, n, true);
+	if (!b.ok || b.data == NULL) {
+		free(b.data);
+		return b.ok;
+	}
+
+	if (nsu_base64_encode_alloc((const uint8_t *) b.data, b.len,
+			&b64, &b64len) != NSUERROR_OK) {
+		free(b.data);
+		return false;
+	}
+	free(b.data);
+
+	urlstr = malloc(b64len + 40);
+	if (urlstr == NULL) {
+		free(b64);
+		return false;
+	}
+	memcpy(urlstr, "data:image/svg+xml;base64,", 26);
+	memcpy(urlstr + 26, b64, b64len);
+	urlstr[26 + b64len] = '\0';
+	free(b64);
+
+	error = nsurl_create(urlstr, &url);
+	free(urlstr);
+	if (error != NSERROR_OK)
+		return error != NSERROR_NOMEM;
+
+	box->flags |= IS_REPLACED;
+	ok = html_fetch_object(content, url, box, image_types, false);
+	nsurl_unref(url);
+
+	return ok;
+}
+
 bool
 convert_special_elements(dom_node *node,
 			 html_content *content,
@@ -1935,6 +2272,9 @@ convert_special_elements(dom_node *node,
 
 	default:
 		res = true;
+		if (tag_type == DOM_HTML_ELEMENT_TYPE__UNKNOWN &&
+				box_is_inline_svg(node))
+			res = box_svg(node, content, box, convert_children);
 	}
 
 	return res;

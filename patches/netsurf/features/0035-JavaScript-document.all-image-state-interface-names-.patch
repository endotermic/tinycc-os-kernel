+/* <img>: complete, naturalWidth, naturalHeight from the image NetSurf
+ * fetched for the element's box (no box: not fetched, not complete unless
+ * there is no src) */
+(function () {
+    var IP = proto("HTMLImageElement");
+    if (!IP || !N.imageState) return;
+    function st(el) { return N.imageState(el) || [false, 0, 0]; }
+    acc(IP, "complete", function () { return !this.getAttribute("src") || st(this)[0]; });
+    acc(IP, "naturalWidth", function () { return st(this)[1]; });
+    acc(IP, "naturalHeight", function () { return st(this)[2]; });
+})();
+
 /* <script>: src is the resolved URL or "" (the binding gave null without
  * the attribute); async and nonce reflect their attributes */

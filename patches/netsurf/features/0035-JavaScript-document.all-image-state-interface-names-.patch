+/* imageState(img): [complete, naturalWidth, naturalHeight] of an image
+ * element from its box's object; [false, 0, 0] without one */
+static duk_ret_t native_image_state(duk_context *ctx)
+{
+	struct box *box = native_box(ctx, 0);
+	int done = 0, w = 0, h = 0;
+	if (box != NULL && box->object != NULL) {
+		content_status st = content_get_status(box->object);
+		done = (st == CONTENT_STATUS_DONE || st == CONTENT_STATUS_ERROR);
+		if (st == CONTENT_STATUS_READY || st == CONTENT_STATUS_DONE) {
+			w = content_get_width(box->object);
+			h = content_get_height(box->object);
+		}
+	}
+	duk_push_array(ctx);
+	duk_push_boolean(ctx, done);
+	duk_put_prop_index(ctx, -2, 0);
+	duk_push_int(ctx, w);
+	duk_put_prop_index(ctx, -2, 1);
+	duk_push_int(ctx, h);
+	duk_put_prop_index(ctx, -2, 2);
+	return 1;
+}

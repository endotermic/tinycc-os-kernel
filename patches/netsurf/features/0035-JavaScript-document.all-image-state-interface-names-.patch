+/* document.all: every element, indexable, callable, item() and namedItem(),
+ * with the [[IsHTMLDDA]] behaviour browsers give it (falsy, typeof
+ * "undefined", == null).  It was a stub returning undefined, so code testing
+ * "x === document.all" took undefined for it (YouTube's sanitizer then
+ * replaced undefined binding values with "zClosurez", hiding its results) */
+if (DocumentP) {
+    (function () {
+        var ALL = Symbol("netsurf.all");
+        function make(d) {
+            function list() { return d.getElementsByTagName("*"); }
+            function named(name) {
+                name = String(name);
+                var l = list(), i, e, found = [];
+                for (i = 0; i < l.length; i++) {
+                    e = l.item(i);
+                    if (e.id === name || e.getAttribute("name") === name) found.push(e);
+                }
+                return found.length === 0 ? null : found.length === 1 ? found[0] : staticList(found);
+            }
+            function item(i) {
+                if (i === undefined) return null;
+                var n = Number(i);
+                if (String(i) !== "" && n >>> 0 === n) return list().item(n);
+                return named(i);
+            }
+            var methods = { item: item, namedItem: named };
+            var target = function () { return item(arguments[0]); };
+            var p = new Proxy(target, {
+                apply: function (t, self, args) { return item(args[0]); },
+                get: function (t, k) {
+                    if (typeof k === "symbol") return k === Symbol.iterator ? function () { return listIterator(list()); } : undefined;
+                    if (k === "length") return list().length;
+                    if (own(methods, k)) return methods[k];
+                    if (/^(0|[1-9][0-9]*)$/.test(k)) return list().item(Number(k));
+                    if (k === "toString") return function () { return "[object HTMLAllCollection]"; };
+                    return named(k) || undefined;
+                },
+                has: function (t, k) {
+                    return typeof k === "string" && (k === "length" || own(methods, k) ||
+                        (/^(0|[1-9][0-9]*)$/.test(k) ? Number(k) < list().length : !!named(k)));
+                }
+            });
+            if (N.markHTMLDDA) N.markHTMLDDA(p);
+            return p;
+        }
+        acc(DocumentP, "all", function () {
+            if (!own(this, ALL)) Object.defineProperty(this, ALL, { value: make(this), configurable: true });
+            return this[ALL];
+        });
+    })();
+}

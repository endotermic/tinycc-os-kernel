 	}
 
 	while (c != NULL) {
diff --git a/netsurf/content/handlers/html/box_textarea.c b/netsurf/content/handlers/html/box_textarea.c
index d086600..867a9b8 100644
--- a/netsurf/content/handlers/html/box_textarea.c
+++ b/netsurf/content/handlers/html/box_textarea.c
@@ -279,6 +279,12 @@ bool box_textarea_create_textarea(html_content *html,
 			gadget->type == GADGET_TEXTBOX ||
 			gadget->type == GADGET_PASSWORD);
 
+	if (gadget->data.text.ta != NULL) {

diff --git a/netsurf/content/handlers/html/html.c b/netsurf/content/handlers/html/html.c
index 82f5f13..2c099c7 100644
--- a/netsurf/content/handlers/html/html.c
+++ b/netsurf/content/handlers/html/html.c
@@ -57,6 +57,7 @@
 #include "javascript/js.h"
 #include "desktop/gui_internal.h"
 
+#include "css/select.h"
 #include "html/html.h"
 #include "html/private.h"
 #include "html/dom_event.h"
@@ -1138,6 +1139,167 @@ void html__redraw_a_box(struct html_content *html, struct box *box)
 			box->padding[TOP] + box->height + box->padding[BOTTOM]);
 }
 
+/**
+ * Walk a box tree: point each node's box data at its box and each gadget at
+ * its box (relink), or forget the node data that still points into this tree
+ * (unlink, before the tree is freed).
+ */
+static void html_rebox_walk(struct box *box, bool relink)
+{
+	struct box *child;
+
+	for (; box != NULL; box = box->next) {
+		if (box->node != NULL) {
+			void *old = NULL;
+			if (relink) {
+				dom_node_set_user_data(box->node,
+					corestring_dom___ns_key_box_node_data,
+					box, NULL, &old);
+			} else if (box_for_node(box->node) == box) {
+				dom_node_set_user_data(box->node,
+					corestring_dom___ns_key_box_node_data,
+					NULL, NULL, &old);
+			}
+		}
+		if (relink && box->gadget != NULL) {
+			box->gadget->box = box;
+		}
+		for (child = box->children; child != NULL; child = child->next) {
+			html_rebox_walk(child, relink);
+		}
+	}
+}
+
+static void html_rebox_done(html_content *c, bool success)
+{
+	c->rebox_ok = success;
+}
+
+/**
+ * Rebuild the box tree from the DOM, lay it out again and redraw.
+ *
+ * NetSurf builds the box tree once, when the document has been parsed, so
+ * changes that scripts make to the DOM later (timers, events, promises) were
+ * never shown.  The tree is now rebuilt in one go: form controls keep their
+ * gadgets (and what was typed into them), images and other objects are
+ * fetched again (from the cache) before the old ones are released, and the
+ * focus, selection and drag, which point into the old tree, are reset.
+ * Documents with frames or iframes are left alone: their child windows hang
+ * off the boxes.
+ */
+static void html_rebox(void *p)
+{
+	html_content *c = p;
+	struct box *old_layout;
+	int *old_bctx;
+	struct content_html_object *old_objects, *new_objects;
+	unsigned int old_num_objects;
+	dom_node *html;
+	dom_exception exc;
+	nserror err;
+	uint64_t ms_before, ms_after;
+	union html_drag_owner drag_owner = { .no_owner = true };
+	union html_selection_owner sel_owner = { .none = true };
+	union html_focus_owner focus_owner = { .self = true };
+
+	c->rebox_pending = false;
+	if (c->layout == NULL || c->aborted || c->box_conversion_context != NULL ||
+	    c->iframe != NULL || c->frameset != NULL) {
+		return;
+	}
+	if (c->base.locked ||
+	    content__get_status(&c->base) != CONTENT_STATUS_DONE) {
+		/* still loading objects (or busy): try again later */
+		c->rebox_pending = true;
+		guit->misc->schedule(100, html_rebox, c);
+		return;
+	}
+
+	exc = dom_document_get_document_element(c->document, (void *) &html);
+	if ((exc != DOM_NO_ERR) || (html == NULL)) {
+		return;
+	}
+
+	nsu_getmonotonic_ms(&ms_before);
+	NSLOG(netsurf, INFO, "DOM changed after layout: rebuilding the box tree (%p)", c);
+
+	/* nothing may keep pointing into the old tree */
+	html_set_drag_type(c, HTML_DRAG_NONE, drag_owner, NULL);
+	html_set_selection(c, HTML_SELECTION_NONE, sel_owner, true);
+	html_set_focus(c, HTML_FOCUS_SELF, focus_owner, true, 0, 0, 0, NULL);
+	selection_clear(c->sel, false);
+
+	old_layout = c->layout;
+	old_bctx = c->bctx;
+	old_objects = c->object_list;
+	old_num_objects = c->num_objects;
+	c->layout = NULL;
+	c->bctx = NULL;
+	c->object_list = NULL;
+	c->num_objects = 0;
+
+	/* libcss keeps selection data on the nodes, which knows nothing of
+	 * the changes: select every style afresh */
+	nscss_reset_node_data(html);
+
+	c->rebox_running = true;
+	c->rebox_ok = false;
+	err = dom_to_box_sync(html, c, html_rebox_done);
+	c->rebox_running = false;
+	dom_node_unref(html);
+
+	if (err != NSERROR_OK || c->rebox_ok == false || c->layout == NULL) {
+		/* keep the old tree */
+		NSLOG(netsurf, WARNING, "box tree rebuild failed: keeping the old layout");
+		html_object_free_objects(c);
+		if (c->bctx != NULL) {
+			talloc_free(c->bctx);
+		}
+		c->layout = old_layout;
+		c->bctx = old_bctx;
+		c->object_list = old_objects;
+		c->num_objects = old_num_objects;
+		html_rebox_walk(c->layout, true);
+		return;
+	}
+
+	/* image maps come from the DOM, and the old ones from the old tree */
+	imagemap_destroy(c);
+	if (imagemap_extract(c) != NSERROR_OK) {
+		NSLOG(netsurf, INFO, "imagemap extraction failed");
+	}
+
+	/* release the old objects (the new ones hold the cached contents) and
+	 * the old boxes, after forgetting the node data that points at them */
+	new_objects = c->object_list;
+	c->object_list = old_objects;
+	html_object_free_objects(c);
+	c->object_list = new_objects;
+	html_rebox_walk(old_layout, false);
+	talloc_free(old_bctx);
+
+	content__reformat(&c->base, false, c->base.available_width,
+			  c->base.available_height);
+	content__request_redraw(&c->base, 0, 0, c->base.width, c->base.height);
+
+	/* pages that change often: wait at least three times what this took */
+	nsu_getmonotonic_ms(&ms_after);
+	c->rebox_delay = (ms_after - ms_before) * 3;
+	NSLOG(netsurf, INFO, "box tree rebuilt in %u ms", (unsigned)(ms_after - ms_before));
+}
+
+/* exported interface documented in html/private.h */
+void html_schedule_rebox(html_content *htmlc)
+{
+	if (htmlc->layout == NULL || htmlc->rebox_running ||
+	    htmlc->rebox_pending || htmlc->box_conversion_context != NULL) {
+		return;
+	}
+	htmlc->rebox_pending = true;
+	guit->misc->schedule(htmlc->rebox_delay > 20 ? htmlc->rebox_delay : 20,
+			     html_rebox, htmlc);
+}
+
 static void html_destroy_frameset(struct content_html_frames *frameset)
 {
 	int i;
@@ -1206,6 +1368,9 @@ static void html_destroy(struct content *c)
 
 	NSLOG(netsurf, INFO, "content %p", c);
 
+	/* A rebuild of the box tree may be scheduled */
+	guit->misc->schedule(-1, html_rebox, html);
+
 	/* If we're still converting a layout, cancel it */
 	if (html->box_conversion_context != NULL) {
 		if (cancel_dom_to_box(html->box_conversion_context) != NSERROR_OK) {
diff --git a/netsurf/content/handlers/html/private.h b/netsurf/content/handlers/html/private.h
index 56cd957..53d9059 100644
--- a/netsurf/content/handlers/html/private.h
+++ b/netsurf/content/handlers/html/private.h
@@ -124,6 +124,15 @@ typedef struct html_content {
 	/** Whether an initial layout has been done */
 	bool had_initial_layout;
 
+	/** A rebuild of the box tree after a DOM change is scheduled */
+	bool rebox_pending;
+	/** The box tree is being rebuilt */
+	bool rebox_running;
+	/** The last rebuild's conversion succeeded */
+	bool rebox_ok;
+	/** Minimum delay before the next rebuild, in ms */
+	unsigned int rebox_delay;
+
 	/** Whether scripts are enabled for this content */
 	bool enable_scripting;
 
@@ -228,6 +237,14 @@ extern bool html_redraw_debug;
  */
 void html__redraw_a_box(html_content *htmlc, struct box *box);
 
+/**
+ * Rebuild the box tree and layout soon, because the DOM changed after the
+ * document was laid out (by a script, typically).
+ *
+ * \param htmlc The HTML content
+ */
+void html_schedule_rebox(html_content *htmlc);
+
 
 /**
  * Complete conversion of an HTML document

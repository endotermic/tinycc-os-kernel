From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 20 Nov 2026 17:53:58 +0200
Subject: [PATCH] html: show DOM changes made after layout (rebuild the box
 tree)

NetSurf builds the box tree once, when the document has been parsed, and
documents were static after that: what scripts changed later (in timers,
event handlers, promise callbacks) ran but never reached the screen.

A DOMSubtreeModified on a rendered node now schedules a rebuild
(html_schedule_rebox; debounced, at least three times the last rebuild's
duration apart, and only once the content is DONE).  html_rebox() resets
the focus, selection and drag, forgets libcss's cached node data
(nscss_reset_node_data: it is never told of DOM changes), builds a new
box tree in one go (dom_to_box_sync) in a talloc context of its own,
extracts the image maps again, releases the old objects after the new
ones have taken the cached contents, clears the node data that still
points into the old tree, frees it, and reformats and redraws.  Form
gadgets keep their text area (box_textarea_create_textarea) and select
options (box_select), and so what the user typed and chose.  Documents
with frames or iframes are left as they were; changes inside form
controls, options, title, script and head do not trigger a rebuild.
---
 netsurf/content/handlers/css/select.c         |  42 +++++
 netsurf/content/handlers/css/select.h         |   8 +
 netsurf/content/handlers/html/box_construct.c |  38 +++-
 netsurf/content/handlers/html/box_construct.h |  13 ++
 netsurf/content/handlers/html/box_special.c   |  14 +-
 netsurf/content/handlers/html/box_textarea.c  |   6 +
 netsurf/content/handlers/html/dom_event.c     |  15 ++
 netsurf/content/handlers/html/html.c          | 165 ++++++++++++++++++
 netsurf/content/handlers/html/private.h       |  17 ++
 9 files changed, 313 insertions(+), 5 deletions(-)

diff --git a/netsurf/content/handlers/css/select.c b/netsurf/content/handlers/css/select.c
index c77644b..fc8cca9 100644
--- a/netsurf/content/handlers/css/select.c
+++ b/netsurf/content/handlers/css/select.c
@@ -1749,6 +1749,48 @@ css_error set_libcss_node_data(void *pw, void *node, void *libcss_node_data)
 	return CSS_OK;
 }
 
+/* exported function documented in css/select.h */
+void nscss_reset_node_data(dom_node *root)
+{
+	dom_node *n = dom_node_ref(root), *next;
+	dom_exception err;
+
+	/* depth first, without recursion */
+	while (n != NULL) {
+		void *data = NULL;
+
+		err = dom_node_set_user_data(n,
+				corestring_dom___ns_key_libcss_node_data,
+				NULL, NULL, &data);
+		if (err == DOM_NO_ERR && data != NULL) {
+			css_libcss_node_data_handler(&selection_handler,
+					CSS_NODE_DELETED, NULL, n, NULL, data);
+		}
+
+		/* the next node: first child, else next sibling of this node
+		 * or of the nearest ancestor below root that has one */
+		next = NULL;
+		err = dom_node_get_first_child(n, &next);
+		if (err != DOM_NO_ERR)
+			next = NULL;
+		while (next == NULL && n != root) {
+			dom_node *parent = NULL;
+			err = dom_node_get_next_sibling(n, &next);
+			if (err != DOM_NO_ERR)
+				next = NULL;
+			if (next != NULL)
+				break;
+			err = dom_node_get_parent_node(n, &parent);
+			if (err != DOM_NO_ERR || parent == NULL)
+				break;
+			dom_node_unref(n);
+			n = parent;
+		}
+		dom_node_unref(n);
+		n = next;
+	}
+}
+
 css_error get_libcss_node_data(void *pw, void *node, void **libcss_node_data)
 {
 	dom_node *n = node;
diff --git a/netsurf/content/handlers/css/select.h b/netsurf/content/handlers/css/select.h
index c17caad..2cc096b 100644
--- a/netsurf/content/handlers/css/select.h
+++ b/netsurf/content/handlers/css/select.h
@@ -59,4 +59,12 @@ css_error named_ancestor_node(void *pw, void *node,
 
 css_error node_is_visited(void *pw, void *node, bool *match);
 
+/**
+ * Forget libcss's cached selection data of every node under root, so that
+ * styles are selected afresh after the document changed.
+ *
+ * \param root  The node to start at (e.g. the document element)
+ */
+void nscss_reset_node_data(dom_node *root);
+
 #endif
diff --git a/netsurf/content/handlers/html/box_construct.c b/netsurf/content/handlers/html/box_construct.c
index 8519c2b..cf286a1 100644
--- a/netsurf/content/handlers/html/box_construct.c
+++ b/netsurf/content/handlers/html/box_construct.c
@@ -61,6 +61,8 @@ struct box_construct_ctx {
 	box_construct_complete_cb cb;	/**< Callback to invoke on completion */
 
 	int *bctx;			/**< talloc context */
+
+	bool sync;			/**< Convert in one go, without yielding */
 };
 
 /**
@@ -1305,7 +1307,7 @@ static void convert_xml_to_box(struct box_construct_ctx *ctx)
 			free(ctx);
 			return;
 		}
-	} while (++num_processed < max_processed_before_yield);
+	} while (ctx->sync || ++num_processed < max_processed_before_yield);
 
 	/* More work to do: schedule a continuation */
 	guit->misc->schedule(0, (void *)convert_xml_to_box, ctx);
@@ -1341,6 +1343,7 @@ dom_to_box(dom_node *n,
 	ctx->root_box = NULL;
 	ctx->cb = cb;
 	ctx->bctx = c->bctx;
+	ctx->sync = false;
 
 	*box_conversion_context = ctx;
 
@@ -1348,6 +1351,39 @@ dom_to_box(dom_node *n,
 }
 
 
+/* exported function documented in html/box_construct.h */
+nserror
+dom_to_box_sync(dom_node *n, html_content *c, box_construct_complete_cb cb)
+{
+	struct box_construct_ctx *ctx;
+
+	if (c->bctx == NULL) {
+		/* create a context allocation for this box tree */
+		c->bctx = talloc_zero(0, int);
+		if (c->bctx == NULL) {
+			return NSERROR_NOMEM;
+		}
+	}
+
+	ctx = malloc(sizeof(*ctx));
+	if (ctx == NULL) {
+		return NSERROR_NOMEM;
+	}
+
+	ctx->content = c;
+	ctx->n = dom_node_ref(n);
+	ctx->root_box = NULL;
+	ctx->cb = cb;
+	ctx->bctx = c->bctx;
+	ctx->sync = true;
+
+	/* runs to completion: cb has been called when this returns */
+	convert_xml_to_box(ctx);
+
+	return NSERROR_OK;
+}
+
+
 /* exported function documented in html/box_construct.h */
 nserror cancel_dom_to_box(void *box_conversion_context)
 {
diff --git a/netsurf/content/handlers/html/box_construct.h b/netsurf/content/handlers/html/box_construct.h
index f4bd119..9bf8b48 100644
--- a/netsurf/content/handlers/html/box_construct.h
+++ b/netsurf/content/handlers/html/box_construct.h
@@ -89,6 +89,19 @@ nserror dom_to_box(struct dom_node *n, struct html_content *c, box_construct_com
  */
 nserror cancel_dom_to_box(void *box_conversion_context);
 
+/**
+ * Construct a box tree from a DOM tree at once, without yielding.
+ *
+ * Used to rebuild the box tree of a document that changed after it was
+ * laid out (html_schedule_rebox); cb has been called when this returns.
+ *
+ * \param n   dom tree
+ * \param c   content of type CONTENT_HTML that is being processed
+ * \param cb  callback to report conversion completion
+ * \return netsurf error code indicating status of call
+ */
+nserror dom_to_box_sync(struct dom_node *n, struct html_content *c, box_construct_complete_cb cb);
+
 
 /**
  * Retrieve the box for a dom node, if there is one
diff --git a/netsurf/content/handlers/html/box_special.c b/netsurf/content/handlers/html/box_special.c
index db3c412..f1d5ed5 100644
--- a/netsurf/content/handlers/html/box_special.c
+++ b/netsurf/content/handlers/html/box_special.c
@@ -1677,10 +1677,16 @@ box_select(dom_node *n,
 		return false;
 
 	gadget->html = content;
-	err = dom_node_get_first_child(n, &c);
-	if (err != DOM_NO_ERR) {
-		form_free_control(gadget);
-		return false;
+	if (gadget->data.select.items != NULL) {

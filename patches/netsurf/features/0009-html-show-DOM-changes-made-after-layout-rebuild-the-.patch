diff --git a/netsurf/content/handlers/html/dom_event.c b/netsurf/content/handlers/html/dom_event.c
index d389a21..c1503bd 100644
--- a/netsurf/content/handlers/html/dom_event.c
+++ b/netsurf/content/handlers/html/dom_event.c
@@ -740,9 +740,24 @@ dom_default_action_DOMSubtreeModified_cb(struct dom_event *evt, void *pw)
 			case DOM_HTML_ELEMENT_TYPE_TEXTAREA:
 			case DOM_HTML_ELEMENT_TYPE_INPUT:
 				html_texty_element_update(htmlc, (dom_node *)node);
+				break;
+			case DOM_HTML_ELEMENT_TYPE_SELECT:
+			case DOM_HTML_ELEMENT_TYPE_OPTION:
+			case DOM_HTML_ELEMENT_TYPE_TITLE:
+			case DOM_HTML_ELEMENT_TYPE_SCRIPT:
+			case DOM_HTML_ELEMENT_TYPE_HEAD:
+				/* gadgets keep themselves in step; the
+				 * others are not rendered */
+				break;
 			default:
+				/* a change to the rendered document after it
+				 * was laid out: build its boxes again */
+				html_schedule_rebox(htmlc);
 				break;
 			}
+		} else if ((exc == DOM_NO_ERR) &&

+/** \file
+ * The subset of the Duktape 2 C API that NetSurf's JavaScript bindings use,
+ * implemented on QuickJS (duk_quickjs.c).
+ *
+ * duktape.h includes this header instead of Duktape's own when
+ * NETSURF_JS_QUICKJS is defined, so that dukky.c, the binding files and the
+ * C that nsgenbind generates from them compile unchanged against QuickJS, a
+ * JavaScript engine with ES2023 (classes, arrow functions, let/const,
+ * async/await, modules, Map/Set, Promise, Proxy, BigInt, ...) where Duktape
+ * has ES5.1.  The semantics are Duktape's: a value stack per context, index 0
+ * the first argument of the running C function, negative indices from the
+ * top, errors thrown with longjmp to the nearest protected call, hidden
+ * properties (keys starting with byte 0xFF) invisible to scripts, and
+ * finalizers inherited through the prototype chain.
+ */
+
+#ifndef DUK_QUICKJS_H
+#define DUK_QUICKJS_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+
+#define DUK_VERSION 20700L	/* the API level these bindings were written for */
+
+typedef struct duk_hthread duk_context;
+
+typedef int duk_idx_t;
+typedef int duk_int_t;
+typedef unsigned int duk_uint_t;
+typedef int duk_int32_t;
+typedef unsigned int duk_uint32_t;
+typedef int duk_small_int_t;
+typedef unsigned int duk_small_uint_t;
+typedef int duk_bool_t;
+typedef int duk_ret_t;
+typedef int duk_errcode_t;
+typedef size_t duk_size_t;
+typedef unsigned int duk_uarridx_t;
+typedef double duk_double_t;
+typedef unsigned int duk_ucodepoint_t;
+
+typedef duk_ret_t (*duk_c_function)(duk_context *ctx);
+typedef duk_ret_t (*duk_safe_call_function)(duk_context *ctx, void *udata);
+typedef void *(*duk_alloc_function)(void *udata, duk_size_t size);
+typedef void *(*duk_realloc_function)(void *udata, void *ptr, duk_size_t size);
+typedef void (*duk_free_function)(void *udata, void *ptr);
+typedef void (*duk_fatal_function)(void *udata, const char *msg);
+
+typedef struct duk_memory_functions {
+	duk_alloc_function alloc_func;
+	duk_realloc_function realloc_func;
+	duk_free_function free_func;
+	void *udata;
+} duk_memory_functions;
+
+#define DUK_VARARGS			((duk_int_t) (-1))
+#define DUK_INVALID_INDEX		((duk_idx_t) (-0x7fffffff - 1))
+
+/* value types (duk_get_type) */
+#define DUK_TYPE_NONE			0
+#define DUK_TYPE_UNDEFINED		1
+#define DUK_TYPE_NULL			2
+#define DUK_TYPE_BOOLEAN		3
+#define DUK_TYPE_NUMBER			4
+#define DUK_TYPE_STRING			5
+#define DUK_TYPE_OBJECT			6
+#define DUK_TYPE_BUFFER			7
+#define DUK_TYPE_POINTER		8
+#define DUK_TYPE_LIGHTFUNC		9
+
+/* error codes; a C function returns their negation to throw */
+#define DUK_ERR_NONE			0
+#define DUK_ERR_ERROR			1
+#define DUK_ERR_EVAL_ERROR		2
+#define DUK_ERR_RANGE_ERROR		3
+#define DUK_ERR_REFERENCE_ERROR		4
+#define DUK_ERR_SYNTAX_ERROR		5
+#define DUK_ERR_TYPE_ERROR		6
+#define DUK_ERR_URI_ERROR		7
+#define DUK_RET_ERROR			(-DUK_ERR_ERROR)
+#define DUK_RET_EVAL_ERROR		(-DUK_ERR_EVAL_ERROR)
+#define DUK_RET_RANGE_ERROR		(-DUK_ERR_RANGE_ERROR)
+#define DUK_RET_REFERENCE_ERROR		(-DUK_ERR_REFERENCE_ERROR)
+#define DUK_RET_SYNTAX_ERROR		(-DUK_ERR_SYNTAX_ERROR)
+#define DUK_RET_TYPE_ERROR		(-DUK_ERR_TYPE_ERROR)
+#define DUK_RET_URI_ERROR		(-DUK_ERR_URI_ERROR)
+
+/* results of the protected calls */
+#define DUK_EXEC_SUCCESS		0
+#define DUK_EXEC_ERROR			1
+
+/* duk_pcompile flags */
+#define DUK_COMPILE_EVAL		(1U << 3)
+#define DUK_COMPILE_FUNCTION		(1U << 4)
+#define DUK_COMPILE_STRICT		(1U << 5)
+
+/* duk_def_prop flags */
+#define DUK_DEFPROP_WRITABLE		(1U << 0)
+#define DUK_DEFPROP_ENUMERABLE		(1U << 1)

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 20 Nov 2026 17:16:05 +0200
Subject: [PATCH] JavaScript: run the Duktape bindings on QuickJS
 (NETSURF_USE_QUICKJS)

The JavaScript bindings (dukky.c, the .bnd files and the C nsgenbind
generates from them) use 93 functions of the Duktape C API.
duk_quickjs.c implements them on QuickJS, an ES2023 engine (classes,
arrow functions, let/const, destructuring, async/await, Promise, Map/Set,
Proxy, BigInt, optional chaining, ...), where Duktape has ES5.1 and
modern site scripts stop at their first SyntaxError.  The bindings
compile unchanged: duktape.h includes duk_quickjs.h when
NETSURF_JS_QUICKJS is defined.

NETSURF_USE_QUICKJS := YES and NETSURF_QUICKJS_DIR (a QuickJS source tree)
select it; duk_quickjs.c compiles quickjs.c in, the qjs_*.c files the
rest of QuickJS.  The model: one runtime and context per heap, every
Duktape thread a global object of its own swapped into the context when
used (a real QuickJS global object with the built-ins and the window
object's properties), a value stack per thread, pointers as BigInts,
hidden keys as private symbols, errors thrown with longjmp to the
nearest protected call, and finalizers (set on the prototypes) queued
when QuickJS frees an object and run later on a stand-in carrying the
object's hidden pointers, since QuickJS frees the properties first and
allows no calls during collection.  Promise jobs run after each
top-level call.
---
 netsurf/Makefile                              |    1 +
 netsurf/Makefile.defaults                     |    7 +
 .../handlers/javascript/duktape/Makefile      |   11 +
 .../handlers/javascript/duktape/duk_quickjs.c | 2050 +++++++++++++++++
 .../handlers/javascript/duktape/duk_quickjs.h |  263 +++
 .../handlers/javascript/duktape/duktape.h     |    5 +-
 .../handlers/javascript/duktape/qjs_cutils.c  |    4 +
 .../handlers/javascript/duktape/qjs_dtoa.c    |    4 +
 .../javascript/duktape/qjs_libregexp.c        |    4 +
 .../javascript/duktape/qjs_libunicode.c       |    4 +
 10 files changed, 2352 insertions(+), 1 deletion(-)
 create mode 100644 netsurf/content/handlers/javascript/duktape/duk_quickjs.c
 create mode 100644 netsurf/content/handlers/javascript/duktape/duk_quickjs.h
 create mode 100644 netsurf/content/handlers/javascript/duktape/qjs_cutils.c
 create mode 100644 netsurf/content/handlers/javascript/duktape/qjs_dtoa.c
 create mode 100644 netsurf/content/handlers/javascript/duktape/qjs_libregexp.c
 create mode 100644 netsurf/content/handlers/javascript/duktape/qjs_libunicode.c

diff --git a/netsurf/Makefile b/netsurf/Makefile
index fc0ae70..d8f5194 100644
--- a/netsurf/Makefile
+++ b/netsurf/Makefile
@@ -140,6 +140,7 @@ $(eval $(call feature_switch,JPEG,JPEG (libjpeg),-DWITH_JPEG,-ljpeg,-UWITH_JPEG,
 $(eval $(call feature_switch,HARU_PDF,PDF export (haru),-DWITH_PDF_EXPORT,-lhpdf -lpng,-UWITH_PDF_EXPORT,))
 $(eval $(call feature_switch,LIBICONV_PLUG,glibc internal iconv,-DLIBICONV_PLUG,,-ULIBICONV_PLUG,-liconv))
 $(eval $(call feature_switch,DUKTAPE,Javascript (Duktape),,,,,))
+$(eval $(call feature_switch,QUICKJS,Javascript engine QuickJS,,,,,))
 
 # Common libraries with pkgconfig
 $(eval $(call pkg_config_find_and_add,libcss,CSS))
diff --git a/netsurf/Makefile.defaults b/netsurf/Makefile.defaults
index bbff688..9ec3168 100644
--- a/netsurf/Makefile.defaults
+++ b/netsurf/Makefile.defaults
@@ -71,6 +71,13 @@ NETSURF_USE_WEBP := AUTO
 # Valid options: YES, NO
 NETSURF_USE_DUKTAPE := YES
 
+# Run the javascript bindings on QuickJS (ES2023) instead of the bundled
+# Duktape (ES5.1); NETSURF_QUICKJS_DIR is a QuickJS source tree (quickjs.c,
+# libregexp.c, ...), which is compiled into NetSurf.  Needs NETSURF_USE_DUKTAPE.
+# Valid options: YES, NO
+NETSURF_USE_QUICKJS := NO
+NETSURF_QUICKJS_DIR :=
+
 # Enable NetSurf's use of libharu for PDF export and GTK printing support.
 # There is no auto-detection available for this, as it does not have a
 # pkg-config file.
diff --git a/netsurf/content/handlers/javascript/duktape/Makefile b/netsurf/content/handlers/javascript/duktape/Makefile
index 638ca44..45ab15a 100644
--- a/netsurf/content/handlers/javascript/duktape/Makefile
+++ b/netsurf/content/handlers/javascript/duktape/Makefile
@@ -55,6 +55,17 @@ S_JAVASCRIPT_BINDING:=$(addprefix $(OBJROOT)/duktape/,$(NSGENBIND_SOURCES))
 
 $(S_JAVASCRIPT_BINDING): $(BINDINGS)
 
+ifeq ($(NETSURF_USE_QUICKJS),YES)
+# the bindings on QuickJS: duk_quickjs.c implements the Duktape API they use
+# and compiles quickjs.c in; the qjs_*.c files are QuickJS's other sources
+S_JAVASCRIPT += content.c duktape/dukky.c duktape/duk_quickjs.c \
+	duktape/qjs_cutils.c duktape/qjs_dtoa.c duktape/qjs_libregexp.c \
+	duktape/qjs_libunicode.c
+CFLAGS += -DNETSURF_JS_QUICKJS -I$(NETSURF_QUICKJS_DIR) \
+	-DCONFIG_VERSION=\"$(shell cat $(NETSURF_QUICKJS_DIR)/VERSION 2>/dev/null)\"
+LDFLAGS += -lm
+else
 S_JAVASCRIPT += content.c duktape/dukky.c duktape/duktape.c
+endif
 
 CFLAGS += -DDUK_OPT_HAVE_CUSTOM_H
diff --git a/netsurf/content/handlers/javascript/duktape/duk_quickjs.c b/netsurf/content/handlers/javascript/duktape/duk_quickjs.c
new file mode 100644
index 0000000..f3aa799
--- /dev/null
+++ b/netsurf/content/handlers/javascript/duktape/duk_quickjs.c
@@ -0,0 +1,2050 @@

+
+/*
+ * Web APIs written in JavaScript.
+ *
+ * Loaded into every page's script thread after polyfill.js, once the
+ * Window exists.  It fills in what the WebIDL bindings leave as stubs
+ * (nsgenbind makes their members writable and configurable) and adds the
+ * small APIs scripts expect of every browser: selectors, the DOM's
+ * convenience methods, element styles and geometry, event constructors,
+ * timers for animation, storage, URL, text encoding.
+ *
+ * The prototypes are shared by every page of a browser window (one heap),
+ * and this file runs once per page: per-page state lives on the window
+ * object, and a replaced native function is remembered as nsOriginal so
+ * that a second run does not wrap the wrapper.
+ *
+ * window.__netsurf_native holds the helpers only the browser can answer
+ * (Window.bnd): box(el), viewport(), style(el), storageRead/Write().
+ */
+
+(function (G) {
+"use strict";
+
+var N = G.__netsurf_native || {};
+var STATE = Symbol("netsurf");
+var STYLE = Symbol("netsurf.style");
+
+function doc() { return G.document; }
+
+/* the window a method was called on: called bare (requestAnimationFrame(f))
+ * it has no this in strict code */
+function W(t) { return (t !== null && typeof t === "object") ? t : G; }
+
+function own(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }
+
+/* per-page state, on the window */
+function state(win) {
+    win = win || G;
+    var s = win[STATE];
+    if (!s) {
+        s = {};
+        Object.defineProperty(win, STATE, { value: s, configurable: true });
+    }
+    return s;
+}
+
+function def(o, name, value) {
+    if (o) {
+        Object.defineProperty(o, name, {
+            value: value, writable: true, configurable: true, enumerable: false
+        });
+    }
+}
+
+function acc(o, name, get, set) {
+    if (o) {
+        Object.defineProperty(o, name, {
+            get: get, set: set, configurable: true, enumerable: true
+        });
+    }
+}
+
+/* replace o[name], keeping the native function for make(native) */
+function wrap(o, name, make) {
+    if (!o) return;
+    var cur = o[name];
+    var orig = (cur && cur.nsOriginal) || cur;
+    var f = make(orig);
+    f.nsOriginal = orig;
+    def(o, name, f);
+}
+
+function proto(name) {
+    var c = G[name];
+    return (c && c.prototype) || null;
+}
+
+/* report an error from a callback without stopping the caller */
+function report(e) {
+    G.setTimeout(function () { throw e; }, 0);
+}
+
+var ElementP = proto("Element"), NodeP = proto("Node");
+var DocumentP = proto("Document"), FragmentP = proto("DocumentFragment");
+var CharDataP = proto("CharacterData"), HTMLElementP = proto("HTMLElement");
+var EventP = proto("Event"), NodeListP = proto("NodeList");
+var CollectionP = proto("HTMLCollection"), NavigatorP = proto("Navigator");
+var WindowP = Object.getPrototypeOf(G);
+
+/* ------------------------------------------------------------------ */
+/* DOMException                                                        */
+
+if (typeof G.DOMException !== "function" || !(function () {
+    try { return new G.DOMException("x", "SyntaxError").name === "SyntaxError"; }
+    catch (e) { return false; }
+})()) {
+    var codes = {
+        IndexSizeError: 1, HierarchyRequestError: 3, WrongDocumentError: 4,
+        InvalidCharacterError: 5, NoModificationAllowedError: 7,
+        NotFoundError: 8, NotSupportedError: 9, InvalidStateError: 11,
+        SyntaxError: 12, InvalidModificationError: 13, NamespaceError: 14,
+        InvalidAccessError: 15, TypeMismatchError: 17, SecurityError: 18,
+        NetworkError: 19, AbortError: 20, URLMismatchError: 21,
+        QuotaExceededError: 22, TimeoutError: 23, InvalidNodeTypeError: 24,
+        DataCloneError: 25
+    };
+    var DOMException = function DOMException(message, name) {
+        var e = Error.call(this, message === undefined ? "" : String(message));
+        var self = (this instanceof DOMException) ? this : Object.create(DOMException.prototype);
+        def(self, "message", e.message);
+        def(self, "name", name === undefined ? "Error" : String(name));
+        def(self, "stack", e.stack);
+        return self;
+    };
+    DOMException.prototype = Object.create(Error.prototype);
+    def(DOMException.prototype, "constructor", DOMException);
+    acc(DOMException.prototype, "code", function () { return codes[this.name] || 0; });
+    Object.keys(codes).forEach(function (k) {
+        var c = k.replace(/Error$/, "").replace(/([a-z])([A-Z])/g, "$1_$2").toUpperCase() + "_ERR";
+        DOMException[c] = codes[k];
+    });
+    G.DOMException = DOMException;
+}
+
+function domError(name, message) {
+    return new G.DOMException(message || name, name);
+}
+
+/* ------------------------------------------------------------------ */
+/* Window                                                              */
+
+["self", "frames"].forEach(function (k) {

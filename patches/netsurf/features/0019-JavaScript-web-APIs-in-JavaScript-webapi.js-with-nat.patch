 .../handlers/javascript/duktape/Window.bnd    |  286 ++
 .../handlers/javascript/duktape/dukky.c       |   16 +
 .../handlers/javascript/duktape/webapi.js     | 2461 +++++++++++++++++
 4 files changed, 2772 insertions(+), 1 deletion(-)
 create mode 100644 netsurf/content/handlers/javascript/duktape/webapi.js


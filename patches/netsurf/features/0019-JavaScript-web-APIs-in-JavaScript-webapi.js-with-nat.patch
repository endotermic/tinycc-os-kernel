diff --git a/netsurf/content/handlers/javascript/duktape/Window.bnd b/netsurf/content/handlers/javascript/duktape/Window.bnd
index f7d143f..de404e9 100644
--- a/netsurf/content/handlers/javascript/duktape/Window.bnd
+++ b/netsurf/content/handlers/javascript/duktape/Window.bnd
@@ -24,12 +24,283 @@ class Window {
 #include "netsurf/misc.h"
 #include "utils/ring.h"
 #include "netsurf/inttypes.h"
+#include "desktop/browser_private.h"
+#include "netsurf/window.h"
+#include "html/box.h"
+#include "html/box_inspect.h"
+#include <errno.h>
+#include <stdio.h>
+#include <sys/stat.h>
 
 #define WINDOW_CALLBACKS MAGIC(WindowCallbacks)
 #define HANDLER_MAGIC MAGIC(HANDLER_MAP)
 
 static size_t next_handle = 0;
 
+/*
+ * The native helpers of polyfill.js (window.__netsurf_native, set on the
+ * Window prototype): what the browser knows and a script cannot compute.
+ */
+
+/* the Window's private data: the global object is the Window */
+static window_private_t *native_window(duk_context *ctx)
+{
+	window_private_t *w;
+	duk_push_global_object(ctx);
+	duk_get_prop_string(ctx, -1, PRIVATE_MAGIC);
+	w = duk_get_pointer(ctx, -1);
+	duk_pop_2(ctx);
+	return w;
+}
+
+/* the layout box of the element wrapper at idx, or NULL */
+static struct box *native_box(duk_context *ctx, duk_idx_t idx)
+{
+	node_private_t *np;
+	void *box = NULL;
+	if (!duk_is_object(ctx, idx))
+		return NULL;
+	duk_get_prop_string(ctx, idx, PRIVATE_MAGIC);
+	np = duk_get_pointer(ctx, -1);
+	duk_pop(ctx);
+	if (np == NULL || np->node == NULL)
+		return NULL;
+	if (dom_node_get_user_data(np->node,
+			corestring_dom___ns_key_box_node_data,
+			&box) != DOM_NO_ERR)
+		return NULL;
+	return box;
+}
+
+/* box(el): [x, y, width, height] of the border box in page coordinates,
+ * then [width, height] of the padding box, or null without a box */
+static duk_ret_t native_box_geometry(duk_context *ctx)
+{
+	struct box *box = native_box(ctx, 0);
+	int x, y, pw, ph;
+	if (box == NULL) {
+		duk_push_null(ctx);
+		return 1;
+	}
+	box_coords(box, &x, &y);
+	pw = box->padding[LEFT] + box->width + box->padding[RIGHT];
+	ph = box->padding[TOP] + box->height + box->padding[BOTTOM];
+	duk_push_array(ctx);
+	duk_push_int(ctx, x - box->border[LEFT].width);
+	duk_put_prop_index(ctx, -2, 0);
+	duk_push_int(ctx, y - box->border[TOP].width);
+	duk_put_prop_index(ctx, -2, 1);
+	duk_push_int(ctx, pw + box->border[LEFT].width + box->border[RIGHT].width);
+	duk_put_prop_index(ctx, -2, 2);
+	duk_push_int(ctx, ph + box->border[TOP].width + box->border[BOTTOM].width);
+	duk_put_prop_index(ctx, -2, 3);
+	duk_push_int(ctx, pw);
+	duk_put_prop_index(ctx, -2, 4);
+	duk_push_int(ctx, ph);
+	duk_put_prop_index(ctx, -2, 5);
+	return 1;
+}
+
+/* viewport(): [width, height, scrollX, scrollY] of the browser window */
+static duk_ret_t native_viewport(duk_context *ctx)
+{
+	window_private_t *w = native_window(ctx);
+	int width = 1024, height = 768, sx = 0, sy = 0;
+	if (w != NULL && w->win != NULL) {
+		browser_window_get_dimensions(w->win, &width, &height);
+		if (w->win->window != NULL && guit->window->get_scroll != NULL)
+			guit->window->get_scroll(w->win->window, &sx, &sy);
+	}
+	duk_push_array(ctx);
+	duk_push_int(ctx, width);
+	duk_put_prop_index(ctx, -2, 0);
+	duk_push_int(ctx, height);
+	duk_put_prop_index(ctx, -2, 1);
+	duk_push_int(ctx, sx);
+	duk_put_prop_index(ctx, -2, 2);
+	duk_push_int(ctx, sy);
+	duk_put_prop_index(ctx, -2, 3);
+	return 1;
+}
+
+static void native_put_colour(duk_context *ctx, const char *name, css_color c)
+{
+	char buf[48];
+	unsigned a = (c >> 24) & 0xff;
+	if (a == 0xff)
+		snprintf(buf, sizeof buf, "rgb(%u, %u, %u)",
+			 (unsigned)(c >> 16) & 0xff, (unsigned)(c >> 8) & 0xff,
+			 (unsigned)c & 0xff);
+	else
+		snprintf(buf, sizeof buf, "rgba(%u, %u, %u, %g)",
+			 (unsigned)(c >> 16) & 0xff, (unsigned)(c >> 8) & 0xff,
+			 (unsigned)c & 0xff, a / 255.0);
+	duk_push_string(ctx, buf);
+	duk_put_prop_string(ctx, -2, name);
+}
+
+/* style(el): some computed values of the element's box as CSS strings,
+ * or null without a box (display: none, or no layout yet) */
+static duk_ret_t native_computed_style(duk_context *ctx)
+{
+	static const char *const displays[] = {
+		"inline", "inline", "block", "list-item", "run-in",
+		"inline-block", "table", "inline-table", "table-row-group",
+		"table-header-group", "table-footer-group", "table-row",
+		"table-column-group", "table-column", "table-cell",
+		"table-caption", "none", "flex", "inline-flex", "grid",
+		"inline-grid" };
+	static const char *const positions[] = {
+		"static", "static", "relative", "absolute", "fixed", "sticky" };
+	static const char *const visibilities[] = {
+		"visible", "visible", "hidden", "collapse" };
+	struct box *box = native_box(ctx, 0);
+	const css_computed_style *st;
+	char buf[32];
+	css_color colour;
+	css_fixed fix;
+	css_unit unit;
+	int32_t z;
+	uint8_t v;
+
+	if (box == NULL || box->style == NULL) {
+		duk_push_null(ctx);
+		return 1;
+	}
+	st = box->style;
+	duk_push_object(ctx);
+	v = css_computed_display(st, false);
+	duk_push_string(ctx, v < sizeof displays / sizeof displays[0] ?
+			displays[v] : "block");
+	duk_put_prop_string(ctx, -2, "display");
+	v = css_computed_position(st);
+	duk_push_string(ctx, v < 6 ? positions[v] : "static");
+	duk_put_prop_string(ctx, -2, "position");
+	v = css_computed_visibility(st);
+	duk_push_string(ctx, v < 4 ? visibilities[v] : "visible");
+	duk_put_prop_string(ctx, -2, "visibility");
+	fix = INTTOFIX(1);
+	css_computed_opacity(st, &fix);
+	snprintf(buf, sizeof buf, "%g", FIXTOFLT(fix));
+	duk_push_string(ctx, buf);
+	duk_put_prop_string(ctx, -2, "opacity");
+	if (css_computed_color(st, &colour) == CSS_COLOR_COLOR)
+		native_put_colour(ctx, "color", colour);
+	if (css_computed_background_color(st, &colour) == CSS_BACKGROUND_COLOR_COLOR)
+		native_put_colour(ctx, "backgroundColor", colour);
+	if (css_computed_font_size(st, &fix, &unit) != 0) {
+		double px = FIXTOFLT(fix);
+		if (unit == CSS_UNIT_PT)
+			px = px * 4 / 3;
+		snprintf(buf, sizeof buf, "%gpx", px);
+		duk_push_string(ctx, buf);
+		duk_put_prop_string(ctx, -2, "fontSize");
+	}
+	if (css_computed_z_index(st, &z) == CSS_Z_INDEX_SET)
+		snprintf(buf, sizeof buf, "%d", (int)z);
+	else
+		snprintf(buf, sizeof buf, "auto");
+	duk_push_string(ctx, buf);
+	duk_put_prop_string(ctx, -2, "zIndex");
+	snprintf(buf, sizeof buf, "%dpx", box->width);
+	duk_push_string(ctx, buf);
+	duk_put_prop_string(ctx, -2, "width");
+	snprintf(buf, sizeof buf, "%dpx", box->height);
+	duk_push_string(ctx, buf);
+	duk_put_prop_string(ctx, -2, "height");
+	return 1;
+}
+
+/* the file of the page's localStorage: $HOME/.netsurf/storage/<origin> */
+static bool native_storage_path(duk_context *ctx, char *path, size_t len,
+				bool create)
+{
+	window_private_t *w = native_window(ctx);
+	const char *home = getenv("HOME");
+	char *origin = NULL;
+	size_t olen = 0, i;
+	int n;
+	if (w == NULL || w->htmlc == NULL || home == NULL || *home == '\0')
+		return false;
+	if (nsurl_get(content_get_url(&w->htmlc->base),
+		      NSURL_SCHEME | NSURL_HOST | NSURL_PORT,
+		      &origin, &olen) != NSERROR_OK)
+		return false;
+	for (i = 0; i < olen; i++) {
+		char c = origin[i];
+		if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+		      (c >= '0' && c <= '9') || c == '.' || c == '-'))
+			origin[i] = '_';
+	}
+	if (create) {
+		snprintf(path, len, "%s/.netsurf", home);
+		mkdir(path, 0700);
+		snprintf(path, len, "%s/.netsurf/storage", home);
+		mkdir(path, 0700);
+	}
+	n = snprintf(path, len, "%s/.netsurf/storage/%s", home, origin);
+	free(origin);
+	return n > 0 && (size_t)n < len;
+}
+
+/* storageRead(): the saved localStorage of the page's origin (a JSON
+ * string), or "" */
+static duk_ret_t native_storage_read(duk_context *ctx)
+{
+	char path[PATH_MAX];
+	FILE *f;
+	char *buf;
+	long size;
+	if (!native_storage_path(ctx, path, sizeof path, false) ||
+	    (f = fopen(path, "rb")) == NULL) {
+		duk_push_string(ctx, "");
+		return 1;
+	}
+	fseek(f, 0, SEEK_END);
+	size = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	if (size <= 0 || size > 6 * 1024 * 1024 ||
+	    (buf = malloc(size)) == NULL) {
+		fclose(f);
+		duk_push_string(ctx, "");
+		return 1;
+	}
+	size = fread(buf, 1, size, f);
+	fclose(f);
+	duk_push_lstring(ctx, buf, size);
+	free(buf);
+	return 1;
+}
+
+/* storageWrite(json): save the page's localStorage; true on success */
+static duk_ret_t native_storage_write(duk_context *ctx)
+{
+	char path[PATH_MAX], tmp[PATH_MAX + 8];
+	duk_size_t len;
+	const char *data = duk_safe_to_lstring(ctx, 0, &len);
+	FILE *f;
+	bool ok = false;
+	if (native_storage_path(ctx, path, sizeof path, true)) {
+		snprintf(tmp, sizeof tmp, "%s.tmp", path);
+		if ((f = fopen(tmp, "wb")) != NULL) {
+			ok = fwrite(data, 1, len, f) == len;
+			ok = (fclose(f) == 0) && ok;
+			ok = ok && rename(tmp, path) == 0;
+			if (!ok)
+				remove(tmp);
+		}
+	}
+	duk_push_boolean(ctx, ok);
+	return 1;
+}
+
+static void native_put(duk_context *ctx, const char *name,
+		       duk_c_function fn, duk_idx_t nargs)
+{
+	duk_push_c_function(ctx, fn, nargs);
+	duk_put_prop_string(ctx, -2, name);
+}
+
 typedef struct window_schedule_s {
 	window_private_t *owner;
 	duk_context *ctx;
@@ -397,6 +668,21 @@ prototype Window()
 	/* ** WebAssembly */
 	/* As yet, Duktape lacks WA */
 #undef EXPOSE
+	/* The native helpers of polyfill.js (not enumerable) */
+	duk_dup(ctx, 0);
+	duk_push_string(ctx, "__netsurf_native");
+	duk_push_object(ctx);
+	native_put(ctx, "box", native_box_geometry, 1);
+	native_put(ctx, "viewport", native_viewport, 0);
+	native_put(ctx, "style", native_computed_style, 1);
+	native_put(ctx, "storageRead", native_storage_read, 0);
+	native_put(ctx, "storageWrite", native_storage_write, 1);
+	duk_def_prop(ctx, -3,
+		     DUK_DEFPROP_HAVE_VALUE |
+		     DUK_DEFPROP_HAVE_WRITABLE |
+		     DUK_DEFPROP_HAVE_ENUMERABLE |
+		     DUK_DEFPROP_HAVE_CONFIGURABLE | DUK_DEFPROP_CONFIGURABLE);
+	duk_pop(ctx);
 	/* Add s3kr1t method to close the JS thread (browsing context) */
 	duk_dup(ctx, 0);
 	duk_push_string(ctx, MAGIC(closedownThread));
diff --git a/netsurf/content/handlers/javascript/duktape/dukky.c b/netsurf/content/handlers/javascript/duktape/dukky.c
index 79cd265..44c93ef 100644
--- a/netsurf/content/handlers/javascript/duktape/dukky.c
+++ b/netsurf/content/handlers/javascript/duktape/dukky.c
@@ -43,6 +43,7 @@
 #include "duktape/binding.h"
 #include "duktape/generics.js.inc"
 #include "duktape/polyfill.js.inc"
+#include "duktape/webapi.js.inc"
 
 #include "duktape.h"
 #include "dukky.h"
@@ -722,6 +723,21 @@ nserror js_newthread(jsheap *heap, void *win_priv, void *doc_priv, jsthread **th
 	duk_pop(CTX);
 	/* ... */
 
+	/* The web APIs written in JavaScript (webapi.js); a failure there
+	 * leaves the page without them but runs it */
+	duk_push_string(CTX, "webapi.js");
+	if (duk_pcompile_lstring_filename(CTX, DUK_COMPILE_EVAL,
+					  (const char *)webapi_js, webapi_js_len) != 0) {
+		NSLOG(jserrors, WARNING, "Unable to compile webapi.js: %s",

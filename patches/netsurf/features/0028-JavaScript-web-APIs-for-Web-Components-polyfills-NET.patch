 	/* ... */
 
+	/* A debugging aid: NETSURF_JS_PROBE names a script file run in every
+	 * page after the web APIs (tests/netsurf/run.sh --probe) */
+	{
+		const char *probe = getenv("NETSURF_JS_PROBE");
+		FILE *f = (probe != NULL && *probe != 0) ? fopen(probe, "rb") : NULL;
+		if (f != NULL) {
+			char *buf = NULL;
+			size_t len = 0, got;
+			char chunk[4096];
+			while ((got = fread(chunk, 1, sizeof chunk, f)) > 0) {
+				char *nb = realloc(buf, len + got);
+				if (nb == NULL)
+					break;
+				buf = nb;
+				memcpy(buf + len, chunk, got);
+				len += got;
+			}
+			fclose(f);
+			if (buf != NULL) {
+				duk_push_string(CTX, "probe.js");
+				if (duk_pcompile_lstring_filename(CTX, DUK_COMPILE_EVAL,
+						buf, len) != 0) {
+					dukky_dump_error(CTX);
+				} else if (dukky_pcall(CTX, 0, true) != 0) {
+					/* dukky_pcall reported it */
+				}
+				duk_pop(CTX);
+				free(buf);
+			}
+		}
+	}
+
 	dukky_log_stack_frame(CTX, "New thread created");
 	NSLOG(dukky, DEBUG, "New thread is %p in heap %p", thread, heap);
 	*thread = ret;

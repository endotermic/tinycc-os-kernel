+/* currentScript(): the script element running (its source is executing),
+ * or null */
+static duk_ret_t native_current_script(duk_context *ctx)
+{
+	window_private_t *w = native_window(ctx);
+	if (w == NULL || w->htmlc == NULL || w->htmlc->current_script == NULL ||
+	    !dukky_push_node(ctx, w->htmlc->current_script))
+		duk_push_null(ctx);
+	return 1;
+}
+

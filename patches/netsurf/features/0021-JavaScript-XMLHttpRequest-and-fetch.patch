From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Sat, 21 Nov 2026 14:14:45 +0200
Subject: [PATCH] JavaScript: XMLHttpRequest and fetch

Window.bnd's native request() starts a request through the fetch layer
(any method, the script's headers, a text body), follows redirects (303,
and 301/302 after POST, become GET; at most 20), and calls back once with
the status, status text, response headers, final URL and the body as an
ArrayBuffer, or with an error; abortRequest() cancels one, and a page's
requests end with its script thread.  webapi.js builds on it:
XMLHttpRequest (asynchronous only: readyState events, timeouts, abort,
responseType text/json/arraybuffer/blob, charset from Content-Type),
fetch with Headers, Request, Response and AbortSignal, Blob, File,
FormData (sent URL-encoded) and navigator.sendBeacon.  Cross-origin
responses are exposed when Access-Control-Allow-Origin allows the page
(no preflight); pages from file: read anything.
---
 .../handlers/javascript/duktape/Window.bnd    | 361 ++++++++++++
 .../handlers/javascript/duktape/webapi.js     | 527 ++++++++++++++++++
 2 files changed, 888 insertions(+)

diff --git a/netsurf/content/handlers/javascript/duktape/Window.bnd b/netsurf/content/handlers/javascript/duktape/Window.bnd
index de404e9..0a2068a 100644
--- a/netsurf/content/handlers/javascript/duktape/Window.bnd
+++ b/netsurf/content/handlers/javascript/duktape/Window.bnd
@@ -12,6 +12,7 @@ class Window {
 	private struct browser_window * win;
 	private struct html_content * htmlc;
 	private struct window_schedule_s * schedule_ring;
+	private struct window_request_s * request_ring;
 	private bool closed_down;
 	prologue %{
 #include "utils/corestrings.h"
@@ -28,12 +29,14 @@ class Window {
 #include "netsurf/window.h"
 #include "html/box.h"
 #include "html/box_inspect.h"
+#include "content/fetch.h"
 #include <errno.h>
 #include <stdio.h>
 #include <sys/stat.h>
 
 #define WINDOW_CALLBACKS MAGIC(WindowCallbacks)
 #define HANDLER_MAGIC MAGIC(HANDLER_MAP)
+#define WINDOW_REQUESTS MAGIC(WindowRequests)
 
 static size_t next_handle = 0;
 
@@ -294,6 +297,359 @@ static duk_ret_t native_storage_write(duk_context *ctx)
 	return 1;
 }
 
+/*
+ * Requests made by scripts (webapi.js's XMLHttpRequest and fetch):
+ * request(method, url, headers, body, callback) starts one through the
+ * fetch layer (not the cache: every request goes out), follows redirects,
+ * and calls back once, from the fetch poll:
+ *   callback(status, statusText, headers, finalURL, body) with the response
+ *   headers as "name: value\r\n" lines and the body as an ArrayBuffer, or
+ *   callback(0, errorMessage) when no response came.
+ * abortRequest(handle) cancels one; a page's requests end with it.
+ */
+typedef struct window_request_s {
+	window_private_t *owner;
+	duk_context *ctx;
+	struct window_request_s *r_next;
+	struct window_request_s *r_prev;
+	size_t handle;
+	struct fetch *fetch;	/* NULL once the fetch is over */
+	nsurl *url;
+	char *method;
+	char *body;
+	char **headers;		/* "Name: value", NULL-terminated */
+	int redirects;
+	char *status_text;
+	char *resp_headers;
+	size_t resp_headers_len;
+	uint8_t *data;
+	size_t data_len;
+	size_t data_alloc;
+} window_request_t;
+
+static size_t next_request = 1;
+
+static void window_request_free(window_request_t *req)
+{
+	char **h;
+	if (req->headers != NULL) {
+		for (h = req->headers; *h != NULL; h++)
+			free(*h);
+		free(req->headers);
+	}
+	if (req->url != NULL)
+		nsurl_unref(req->url);
+	free(req->method);
+	free(req->body);
+	free(req->status_text);
+	free(req->resp_headers);
+	free(req->data);
+	free(req);
+}
+
+/* forget the script callback of a request */
+static void window_request_forget(duk_context *ctx, size_t handle)
+{
+	duk_push_global_object(ctx);
+	duk_get_prop_string(ctx, -1, WINDOW_REQUESTS);
+	if (duk_is_object(ctx, -1)) {
+		duk_push_int(ctx, (duk_int_t)handle);
+		duk_del_prop(ctx, -2);
+	}
+	duk_pop_2(ctx);
+}
+
+/* stop a request: abort its fetch (no callback follows), drop it */
+static void window_request_cancel(window_private_t *w, window_request_t *req)
+{
+	if (req->fetch != NULL) {
+		fetch_abort(req->fetch);
+		req->fetch = NULL;
+	}
+	RING_REMOVE(w->request_ring, req);
+	window_request_forget(req->ctx, req->handle);
+	window_request_free(req);
+}
+
+/* hand the result to the script and drop the request */
+static void window_request_deliver(window_request_t *req, long status,
+				   const char *error)
+{
+	duk_context *ctx = req->ctx;
+	window_private_t *w = req->owner;
+	int nargs;
+
+	RING_REMOVE(w->request_ring, req);
+	if (w->closed_down) {
+		window_request_free(req);
+		return;
+	}
+	duk_push_global_object(ctx);
+	duk_get_prop_string(ctx, -1, WINDOW_REQUESTS);
+	duk_push_int(ctx, (duk_int_t)req->handle);
+	duk_get_prop(ctx, -2);
+	/* ..., win, requests, callback */
+	duk_push_int(ctx, (duk_int_t)req->handle);
+	duk_del_prop(ctx, -3);
+	if (duk_get_type(ctx, -1) != DUK_TYPE_OBJECT) {
+		duk_pop_3(ctx);
+		window_request_free(req);
+		return;
+	}
+	if (error != NULL) {
+		duk_push_int(ctx, 0);
+		duk_push_string(ctx, error);
+		nargs = 2;
+	} else {
+		void *buf;
+		duk_push_int(ctx, (duk_int_t)status);
+		duk_push_string(ctx, req->status_text != NULL ? req->status_text : "");
+		duk_push_lstring(ctx, req->resp_headers != NULL ? req->resp_headers : "",
+				 req->resp_headers_len);
+		duk_push_string(ctx, nsurl_access(req->url));
+		buf = duk_push_buffer(ctx, req->data_len, false);
+		if (req->data_len > 0)
+			memcpy(buf, req->data, req->data_len);
+		nargs = 5;
+	}
+	window_request_free(req);
+	(void) dukky_pcall(ctx, nargs, true);
+	duk_pop_3(ctx);
+}
+
+static void window_request_fetch_cb(const fetch_msg *msg, void *p);
+
+static nserror window_request_start(window_request_t *req)
+{
+	const char *headers[66];
+	char method_line[64];
+	const char *body = NULL;
+	nsurl *referer = NULL;
+	int n = 0;
+	char **h;
+
+	for (h = req->headers; h != NULL && *h != NULL && n < 64; h++)
+		headers[n++] = *h;
+	if (strcmp(req->method, "GET") != 0 && strcmp(req->method, "POST") != 0) {
+		snprintf(method_line, sizeof method_line, "%s %s",
+			 FETCH_METHOD_HEADER, req->method);
+		headers[n++] = method_line;
+	}
+	headers[n] = NULL;
+	if (req->body != NULL && strcmp(req->method, "GET") != 0 &&
+	    strcmp(req->method, "HEAD") != 0)
+		body = req->body;
+	else if (strcmp(req->method, "POST") == 0)
+		body = "";
+	if (req->owner->htmlc != NULL)
+		referer = content_get_url(&req->owner->htmlc->base);
+
+	free(req->status_text);
+	req->status_text = NULL;
+	free(req->resp_headers);
+	req->resp_headers = NULL;
+	req->resp_headers_len = 0;
+	req->data_len = 0;
+	return fetch_start(req->url, referer, window_request_fetch_cb, req,
+			   false, body, NULL, true, false, headers, &req->fetch);
+}
+
+static void window_request_fetch_cb(const fetch_msg *msg, void *p)
+{
+	window_request_t *req = p;
+	const char *line;
+	size_t len;
+	long code;
+
+	switch (msg->type) {
+	case FETCH_HEADER:
+		line = (const char *)msg->data.header_or_data.buf;
+		len = msg->data.header_or_data.len;
+		while (len > 0 && (line[len - 1] == '\r' || line[len - 1] == '\n' ||
+				   line[len - 1] == ' '))
+			len--;
+		if (len == 0)
+			break;
+		if (len > 5 && strncmp(line, "HTTP/", 5) == 0) {
+			/* a status line: a new response (redirect, 100) */
+			const char *t = memchr(line, ' ', len);
+			if (t != NULL)
+				t = memchr(t + 1, ' ', len - (t + 1 - line));
+			free(req->status_text);
+			req->status_text = (t != NULL) ?
+				strndup(t + 1, len - (t + 1 - line)) : NULL;
+			req->resp_headers_len = 0;
+			break;
+		} else {
+			char *nh = realloc(req->resp_headers,
+					   req->resp_headers_len + len + 3);
+			if (nh == NULL)
+				break;
+			memcpy(nh + req->resp_headers_len, line, len);
+			memcpy(nh + req->resp_headers_len + len, "\r\n", 3);
+			req->resp_headers = nh;
+			req->resp_headers_len += len + 2;
+		}
+		break;
+
+	case FETCH_DATA:
+		len = msg->data.header_or_data.len;
+		if (req->data_len + len > req->data_alloc) {
+			size_t na = (req->data_len + len) * 2 + 4096;
+			uint8_t *nd = realloc(req->data, na);
+			if (nd == NULL)
+				break;
+			req->data = nd;
+			req->data_alloc = na;
+		}
+		memcpy(req->data + req->data_len, msg->data.header_or_data.buf, len);
+		req->data_len += len;
+		break;
+
+	case FETCH_FINISHED:
+	case FETCH_NOTMODIFIED:
+	case FETCH_AUTH:
+		code = fetch_http_code(req->fetch);
+		req->fetch = NULL;
+		if (code == 0 && msg->type == FETCH_FINISHED)
+			code = 200; /* file:, data:, resource: */
+		if (msg->type == FETCH_NOTMODIFIED && code == 0)
+			code = 304;
+		window_request_deliver(req, code, NULL);
+		break;
+
+	case FETCH_REDIRECT: {
+		nsurl *to = NULL;
+		code = fetch_http_code(req->fetch);
+		req->fetch = NULL;
+		if (++req->redirects > 20 ||
+		    nsurl_join(req->url, msg->data.redirect, &to) != NSERROR_OK) {
+			window_request_deliver(req, 0, "too many redirects or a bad redirect");
+			break;
+		}
+		nsurl_unref(req->url);
+		req->url = to;
+		if (code == 303 || ((code == 301 || code == 302) &&
+				    strcmp(req->method, "POST") == 0)) {
+			free(req->method);
+			req->method = strdup("GET");
+			free(req->body);
+			req->body = NULL;
+		}
+		if (req->method == NULL || window_request_start(req) != NSERROR_OK)
+			window_request_deliver(req, 0, "redirect failed");
+		break;
+	}
+
+	case FETCH_ERROR:
+	case FETCH_TIMEDOUT:
+	case FETCH_CERT_ERR:
+	case FETCH_SSL_ERR:
+		req->fetch = NULL;
+		window_request_deliver(req,  0,
+			msg->type == FETCH_TIMEDOUT ? "timed out" :
+			msg->type == FETCH_ERROR && msg->data.error != NULL ?
+			msg->data.error : "network error");
+		break;
+
+	default:
+		break;
+	}
+}
+
+/* request(method, url, headers[], body or null, callback) -> handle, or
+ * throws for a URL the browser can not fetch */
+static duk_ret_t native_request(duk_context *ctx)
+{
+	window_private_t *w = native_window(ctx);
+	window_request_t *req;
+	duk_size_t n, i;
+	nsurl *url;
+
+	if (w == NULL || w->closed_down)
+		return duk_error(ctx, DUK_ERR_ERROR, "no window");
+	if (nsurl_create(duk_safe_to_string(ctx, 1), &url) != NSERROR_OK ||
+	    !fetch_can_fetch(url)) {
+		if (url != NULL)
+			nsurl_unref(url);
+		return duk_error(ctx, DUK_ERR_TYPE_ERROR, "can not fetch that URL");
+	}
+	req = calloc(1, sizeof *req);
+	if (req == NULL) {
+		nsurl_unref(url);
+		return duk_error(ctx, DUK_ERR_ERROR, "out of memory");
+	}
+	req->owner = w;
+	req->ctx = ctx;
+	req->url = url;
+	req->handle = next_request++;
+	req->method = strdup(duk_safe_to_string(ctx, 0));
+	if (duk_get_type(ctx, 3) != DUK_TYPE_NULL &&
+	    duk_get_type(ctx, 3) != DUK_TYPE_UNDEFINED)
+		req->body = strdup(duk_safe_to_string(ctx, 3));
+	n = duk_is_object(ctx, 2) ? duk_get_length(ctx, 2) : 0;
+	if (n > 64)
+		n = 64;
+	req->headers = calloc(n + 1, sizeof (char *));
+	for (i = 0; req->headers != NULL && i < n; i++) {
+		duk_get_prop_index(ctx, 2, i);
+		req->headers[i] = strdup(duk_safe_to_string(ctx, -1));
+		duk_pop(ctx);
+	}
+	if (req->method == NULL || req->headers == NULL) {
+		window_request_free(req);
+		return duk_error(ctx, DUK_ERR_ERROR, "out of memory");
+	}
+
+	/* the callback, by handle */
+	duk_push_global_object(ctx);
+	duk_get_prop_string(ctx, -1, WINDOW_REQUESTS);
+	if (!duk_is_object(ctx, -1)) {
+		duk_pop(ctx);
+		duk_push_object(ctx);
+		duk_dup(ctx, -1);
+		duk_put_prop_string(ctx, -3, WINDOW_REQUESTS);
+	}
+	duk_push_int(ctx, (duk_int_t)req->handle);
+	duk_dup(ctx, 4);
+	duk_put_prop(ctx, -3);
+	duk_pop_2(ctx);
+
+	RING_INSERT(w->request_ring, req);
+	if (window_request_start(req) != NSERROR_OK) {
+		window_request_cancel(w, req);
+		return duk_error(ctx, DUK_ERR_TYPE_ERROR, "the request could not start");
+	}
+	duk_push_int(ctx, (duk_int_t)req->handle);
+	return 1;
+}
+
+/* abortRequest(handle) */
+static duk_ret_t native_abort_request(duk_context *ctx)
+{
+	window_private_t *w = native_window(ctx);
+	size_t handle = duk_to_uint(ctx, 0);
+	window_request_t *found = NULL;
+	if (w == NULL)
+		return 0;
+	RING_ITERATE_START(window_request_t, w->request_ring, req) {
+		if (req->handle == handle) {
+			found = req;
+			RING_ITERATE_STOP(w->request_ring, req);
+		}
+	} RING_ITERATE_END(w->request_ring, req);
+	if (found != NULL)
+		window_request_cancel(w, found);
+	return 0;
+}
+
+/* end every request of a page */
+static void window_requests_end(window_private_t *w)
+{
+	while (w->request_ring != NULL)
+		window_request_cancel(w, w->request_ring);
+}
+
 static void native_put(duk_context *ctx, const char *name,
 		       duk_c_function fn, duk_idx_t nargs)
 {
@@ -503,6 +859,7 @@ static duk_ret_t dukky_window_closedown_thread(duk_context *ctx)
 	}
 
 	priv->closed_down = true;
+	window_requests_end(priv);
 
 	NSLOG(dukky, DEEPDEBUG, "Closing down thread");
 	while (priv->schedule_ring != NULL) {
@@ -555,6 +912,7 @@ init Window(struct browser_window *win, struct html_content *htmlc)
 	priv->win = win;
 	priv->htmlc = htmlc;
 	priv->schedule_ring = NULL;
+	priv->request_ring = NULL;
 	priv->closed_down = false;
 	NSLOG(netsurf, DEEPDEBUG, "win=%p htmlc=%p", priv->win, priv->htmlc);
 
@@ -571,6 +929,7 @@ fini Window()
 	while (priv->schedule_ring != NULL) {
 		window_remove_callback_by_handle(ctx, priv, priv->schedule_ring->handle);
 	}
+	window_requests_end(priv);
 %}
 
 prototype Window()
@@ -677,6 +1036,8 @@ prototype Window()
 	native_put(ctx, "style", native_computed_style, 1);
 	native_put(ctx, "storageRead", native_storage_read, 0);
 	native_put(ctx, "storageWrite", native_storage_write, 1);
+	native_put(ctx, "request", native_request, 5);
+	native_put(ctx, "abortRequest", native_abort_request, 1);
 	duk_def_prop(ctx, -3,
 		     DUK_DEFPROP_HAVE_VALUE |
 		     DUK_DEFPROP_HAVE_WRITABLE |
diff --git a/netsurf/content/handlers/javascript/duktape/webapi.js b/netsurf/content/handlers/javascript/duktape/webapi.js
index ad32c08..8367d73 100644
--- a/netsurf/content/handlers/javascript/duktape/webapi.js
+++ b/netsurf/content/handlers/javascript/duktape/webapi.js
@@ -2458,4 +2458,531 @@ if (typeof G.TextEncoder !== "function" || G.TextEncoder.nsOriginal !== undefine
     G.TextDecoder = TextDecoder;
 }
 
+
+/* ------------------------------------------------------------------ */
+/* Networking: Blob, FormData, Headers, XMLHttpRequest, fetch          */
+/* (one native request() under all of them, Window.bnd)               */
+
+var utf8 = new TextEncoder();
+
+/* bytes of a body or blob part */
+function bytesOf(x) {
+    if (x instanceof Blob) return x._bytes;
+    if (x instanceof ArrayBuffer) return new Uint8Array(x.slice(0));
+    if (ArrayBuffer.isView(x)) return new Uint8Array(x.buffer.slice(x.byteOffset, x.byteOffset + x.byteLength));
+    return utf8.encode(String(x));
+}
+function concatBytes(list) {
+    var n = 0, i;
+    for (i = 0; i < list.length; i++) n += list[i].length;
+    var out = new Uint8Array(n), o = 0;
+    for (i = 0; i < list.length; i++) { out.set(list[i], o); o += list[i].length; }
+    return out;
+}
+
+function Blob(parts, opts) {
+    if (!new.target) throw new TypeError("Blob: use new");
+    def(this, "_bytes", concatBytes(Array.from(parts || []).map(bytesOf)));
+    def(this, "_type", opts && opts.type ? String(opts.type).toLowerCase() : "");
+}
+acc(Blob.prototype, "size", function () { return this._bytes.length; });
+acc(Blob.prototype, "type", function () { return this._type; });
+def(Blob.prototype, "arrayBuffer", function () { return Promise.resolve(this._bytes.slice().buffer); });
+def(Blob.prototype, "bytes", function () { return Promise.resolve(this._bytes.slice()); });
+def(Blob.prototype, "text", function () { return Promise.resolve(new TextDecoder().decode(this._bytes)); });
+def(Blob.prototype, "slice", function (start, end, type) {
+    var b = Object.create(Blob.prototype);
+    def(b, "_bytes", this._bytes.slice(start, end));
+    def(b, "_type", type ? String(type).toLowerCase() : "");
+    return b;
+});
+def(Blob.prototype, Symbol.toStringTag, "Blob");
+function File(parts, name, opts) {
+    if (!new.target) throw new TypeError("File: use new");
+    var f = Reflect.construct(Blob, [parts, opts], new.target);
+    def(f, "name", String(name));
+    def(f, "lastModified", (opts && opts.lastModified) || Date.now());
+    return f;
+}
+File.prototype = Object.create(Blob.prototype);
+def(File.prototype, "constructor", File);
+G.Blob = Blob;
+G.File = File;
+
+/* FormData: names and values; sent URL-encoded (no multipart bodies) */
+function FormData(form) {
+    if (!new.target) throw new TypeError("FormData: use new");
+    def(this, "_list", []);
+    var list = this._list;
+    if (form && form.querySelectorAll) {
+        Array.prototype.forEach.call(form.querySelectorAll("input, select, textarea"), function (el) {
+            var name = el.getAttribute("name"), type = (el.getAttribute("type") || "").toLowerCase();
+            if (!name || el.hasAttribute("disabled")) return;
+            if ((type === "checkbox" || type === "radio") && !el.checked) return;
+            if (type === "submit" || type === "button" || type === "file" || type === "reset") return;
+            list.push([name, String(el.value === undefined ? "" : el.value)]);
+        });
+    }
+}
+var fdMethods = {
+    append: function (k, v, name) { this._list.push([String(k), v instanceof Blob ? v : String(v)]); },
+    delete: function (k) {
+        k = String(k);
+        var keep = this._list.filter(function (p) { return p[0] !== k; });
+        this._list.length = 0;
+        Array.prototype.push.apply(this._list, keep);
+    },
+    get: function (k) { k = String(k); for (var i = 0; i < this._list.length; i++) if (this._list[i][0] === k) return this._list[i][1]; return null; },
+    getAll: function (k) { k = String(k); return this._list.filter(function (p) { return p[0] === k; }).map(function (p) { return p[1]; }); },
+    has: function (k) { k = String(k); return this._list.some(function (p) { return p[0] === k; }); },
+    set: function (k, v) { this.delete(k); this.append(k, v); },
+    forEach: function (cb, thisArg) { var self = this; this._list.forEach(function (p) { cb.call(thisArg, p[1], p[0], self); }); },
+    entries: function () { return this._list.map(function (p) { return [p[0], p[1]]; })[Symbol.iterator](); },
+    keys: function () { return this._list.map(function (p) { return p[0]; })[Symbol.iterator](); },
+    values: function () { return this._list.map(function (p) { return p[1]; })[Symbol.iterator](); }
+};
+Object.keys(fdMethods).forEach(function (k) { def(FormData.prototype, k, fdMethods[k]); });
+def(FormData.prototype, Symbol.iterator, FormData.prototype.entries);
+G.FormData = FormData;
+
+/* the request body as text for the native request, and its default type */
+function encodeBody(body) {
+    if (body === null || body === undefined) return { text: null, type: null };
+    if (body instanceof URLSearchParams)
+        return { text: body.toString(), type: "application/x-www-form-urlencoded;charset=UTF-8" };
+    if (body instanceof FormData) {
+        var sp = new URLSearchParams();
+        body._list.forEach(function (p) { sp.append(p[0], p[1] instanceof Blob ? (p[1].name || "blob") : p[1]); });
+        return { text: sp.toString(), type: "application/x-www-form-urlencoded;charset=UTF-8" };
+    }
+    if (body instanceof Blob)

diff --git a/libcss/src/parse/properties/mask.c b/libcss/src/parse/properties/mask.c
new file mode 100644
index 0000000..887545b
--- /dev/null
+++ b/libcss/src/parse/properties/mask.c
@@ -0,0 +1,108 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ * Copyright 2026 Nikolajs Agafonovs
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/**
+ * Parse the mask (and -webkit-mask) shorthand
+ *
+ * Only mask-image is kept: the first layer's url(), or none.  The layer's
+ * other values (repeat, position / size, origin, clip, composite, mode) and
+ * any further layers are read past; a layer that is a gradient sets
+ * mask-image to none, as libcss has no gradients.
+ *
+ * \param c	  Parsing context
+ * \param vector  Vector of tokens to process
+ * \param ctx	  Pointer to vector iteration context
+ * \param result  Pointer to location to receive resulting style
+ * \return CSS_OK on success,
+ *	   CSS_INVALID if the input is not valid
+ *
+ * Post condition: \a *ctx is updated with the next token to process
+ *		   If the input is invalid, then \a *ctx remains unchanged.
+ */
+css_error css__parse_mask(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result)
+{
+	int32_t orig_ctx = *ctx;
+	int32_t i = *ctx;
+	const css_token *token;
+	css_error error;
+	int depth = 0;
+
+	consumeWhitespace(vector, &i);
+	token = parserutils_vector_peek(vector, i);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	/* inherit, initial, unset and revert: as mask-image (none is a
+	 * layer without url(), below) */
+	if (get_css_flag_value(c, token) != FLAG_VALUE__NONE) {
+		*ctx = i;
+		error = css__parse_mask_image(c, vector, ctx, result);
+		if (error != CSS_OK)
+			*ctx = orig_ctx;
+		return error;
+	}
+
+	/* the first layer's url() */
+	for (; (token = parserutils_vector_peek(vector, i)) != NULL; i++) {
+		if (token->type == CSS_TOKEN_FUNCTION) {
+			depth++;
+		} else if (tokenIsChar(token, '(')) {
+			depth++;
+		} else if (tokenIsChar(token, ')')) {
+			if (depth > 0)
+				depth--;
+		} else if (depth == 0 && (tokenIsChar(token, ',') ||
+				tokenIsChar(token, '!'))) {
+			break;
+		} else if (depth == 0 && token->type == CSS_TOKEN_URI) {
+			int32_t at = i;
+
+			error = css__parse_mask_image(c, vector, &at, result);
+			if (error != CSS_OK) {
+				*ctx = orig_ctx;
+				return error;
+			}
+			break;
+		}
+	}
+
+	if (token == NULL || token->type != CSS_TOKEN_URI) {
+		/* no url() in the first layer */
+		error = css__stylesheet_style_appendOPV(result,
+				CSS_PROP_MASK_IMAGE, 0, MASK_IMAGE_NONE);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+
+	/* read past the rest, up to !important */
+	i = *ctx;
+	depth = 0;
+	while ((token = parserutils_vector_peek(vector, i)) != NULL) {
+		if (token->type == CSS_TOKEN_FUNCTION || tokenIsChar(token, '('))
+			depth++;
+		else if (tokenIsChar(token, ')') && depth > 0)
+			depth--;
+		else if (depth == 0 && tokenIsChar(token, '!'))
+			break;
+		i++;
+	}
+	*ctx = i;
+
+	return CSS_OK;
+}

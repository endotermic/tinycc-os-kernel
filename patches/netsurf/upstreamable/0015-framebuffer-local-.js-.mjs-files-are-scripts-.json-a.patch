From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Sat, 21 Nov 2026 11:30:54 +0200
Subject: [PATCH] framebuffer: local .js/.mjs files are scripts, .json and .txt
 are not HTML

---
 netsurf/frontends/framebuffer/fetch.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/netsurf/frontends/framebuffer/fetch.c b/netsurf/frontends/framebuffer/fetch.c
index 23cbb4f..57c52dd 100644
--- a/netsurf/frontends/framebuffer/fetch.c
+++ b/netsurf/frontends/framebuffer/fetch.c
@@ -87,6 +87,16 @@ static const char *fetch_filetype(const char *unix_path)
 		return "image/svg";
 	if (2 < l && strcasecmp(unix_path + l - 3, "bmp") == 0)
 		return "image/bmp";
+	/* scripts: without this a local page's <script src> is refused
+	 * (UnacceptableType: text/html is no script type) */
+	if (3 < l && strcasecmp(unix_path + l - 3, ".js") == 0)
+		return "application/javascript";
+	if (4 < l && strcasecmp(unix_path + l - 4, ".mjs") == 0)
+		return "application/javascript";
+	if (5 < l && strcasecmp(unix_path + l - 5, ".json") == 0)
+		return "application/json";
+	if (4 < l && strcasecmp(unix_path + l - 4, ".txt") == 0)
+		return "text/plain";
 	return "text/html";
 }
 

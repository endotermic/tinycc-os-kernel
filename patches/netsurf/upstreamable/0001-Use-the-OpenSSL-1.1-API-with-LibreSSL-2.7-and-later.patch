From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 20 Nov 2026 15:50:40 +0200
Subject: [PATCH] Use the OpenSSL 1.1 API with LibreSSL 2.7 and later

The certificate viewer and the curl fetcher treated every LibreSSL as
OpenSSL 1.0.x and reached into X509 and RSA structures directly.  LibreSSL
2.7.0 added the OpenSSL 1.1 accessors (X509_up_ref, RSA_get0_n, ...) and
LibreSSL 3.x made those structures opaque, so with a current LibreSSL the
1.0.x code no longer compiles ("dereferencing incomplete type x509_st").
Take the 1.0.x path only for LibreSSL before 2.7; later versions report
OPENSSL_VERSION_NUMBER 0x20000000 and use the 1.1.1 code.
---
 netsurf/content/fetchers/about/certificate.c | 6 +++---
 netsurf/content/fetchers/curl.c              | 4 ++--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/netsurf/content/fetchers/about/certificate.c b/netsurf/content/fetchers/about/certificate.c
index 554f06e..92115ad 100644
--- a/netsurf/content/fetchers/about/certificate.c
+++ b/netsurf/content/fetchers/about/certificate.c
@@ -135,12 +135,12 @@ static nserror free_ns_cert_info(struct ns_cert_info *cinfo)
 #include <openssl/x509v3.h>
 
 /* OpenSSL 1.0.x, 1.0.2, 1.1.0 and 1.1.1 API all changed
- * LibreSSL declares its OpenSSL version as 2.1 but only supports 1.0.x API
+ * LibreSSL declares its OpenSSL version as 2.0; before 2.7 it only supported the 1.0.x API
  */
-#if (defined(LIBRESSL_VERSION_NUMBER) || (OPENSSL_VERSION_NUMBER < 0x1010000fL))
+#if ((defined(LIBRESSL_VERSION_NUMBER) && LIBRESSL_VERSION_NUMBER < 0x2070000fL) || (OPENSSL_VERSION_NUMBER < 0x1010000fL))
 /* 1.0.x */
 
-#if (defined(LIBRESSL_VERSION_NUMBER) || (OPENSSL_VERSION_NUMBER < 0x1000200fL))
+#if ((defined(LIBRESSL_VERSION_NUMBER) && LIBRESSL_VERSION_NUMBER < 0x2070000fL) || (OPENSSL_VERSION_NUMBER < 0x1000200fL))
 /* pre 1.0.2 */
 static int ns_X509_get_signature_nid(X509 *cert)
 {
diff --git a/netsurf/content/fetchers/curl.c b/netsurf/content/fetchers/curl.c
index 83d70a7..40a5c36 100644
--- a/netsurf/content/fetchers/curl.c
+++ b/netsurf/content/fetchers/curl.c
@@ -96,9 +96,9 @@
 #include <openssl/x509v3.h>
 
 /* OpenSSL 1.0.x to 1.1.0 certificate reference counting changed
- * LibreSSL declares its OpenSSL version as 2.1 but only supports the old way
+ * LibreSSL declares its OpenSSL version as 2.0; before 2.7 it only supported the old way
  */
-#if (defined(LIBRESSL_VERSION_NUMBER) || (OPENSSL_VERSION_NUMBER < 0x1010000fL))
+#if ((defined(LIBRESSL_VERSION_NUMBER) && LIBRESSL_VERSION_NUMBER < 0x2070000fL) || (OPENSSL_VERSION_NUMBER < 0x1010000fL))
 static int ns_X509_up_ref(X509 *cert)
 {
 	cert->references++;

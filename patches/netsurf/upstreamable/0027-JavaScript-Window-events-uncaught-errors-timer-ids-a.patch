 };
 
 static JSClassID duk_obj_class_id;
@@ -497,6 +502,80 @@ static JSClassDef duk__thread_class = {
  * finalizers and promise jobs
  */
 
+static void duk__rejection_tracker(JSContext *ctx, JSValueConst promise,
+				   JSValueConst reason, JS_BOOL is_handled,
+				   void *opaque)
+{
+	duk_heap *heap = opaque;
+	int i;
+
+	if (is_handled) {
+		for (i = 0; i < heap->nrej; i++) {
+			if (JS_VALUE_GET_PTR(heap->rej_promise[i]) ==
+			    JS_VALUE_GET_PTR(promise)) {
+				JS_FreeValue(ctx, heap->rej_promise[i]);
+				JS_FreeValue(ctx, heap->rej_reason[i]);
+				heap->nrej--;
+				heap->rej_promise[i] = heap->rej_promise[heap->nrej];
+				heap->rej_reason[i] = heap->rej_reason[heap->nrej];
+				return;
+			}
+		}
+		return;
+	}
+	if (heap->nrej < 32) {
+		heap->rej_promise[heap->nrej] = JS_DupValue(ctx, promise);
+		heap->rej_reason[heap->nrej] = JS_DupValue(ctx, reason);
+		heap->nrej++;
+	}
+}
+
+/* report (when a handler is set) and forget the unhandled rejections */
+static void duk__report_rejections(duk_heap *heap, int report)
+{
+	JSContext *ctx = heap->ctx;
+	int i;
+
+	for (i = 0; i < heap->nrej; i++) {
+		JSValue r = heap->rej_reason[i];
+		if (report && heap->rej_fn != NULL) {
+			const char *msg = JS_ToCString(ctx, r);
+			const char *stack = NULL;
+			JSValue st = JS_UNDEFINED;
+			char *buf;
+			size_t len;
+			if (msg == NULL)
+				JS_FreeValue(ctx, JS_GetException(ctx));
+			if (JS_IsObject(r)) {
+				st = JS_GetPropertyStr(ctx, r, "stack");
+				if (JS_IsString(st))
+					stack = JS_ToCString(ctx, st);
+			}
+			len = (msg ? strlen(msg) : 0) + (stack ? strlen(stack) : 0) + 32;
+			buf = malloc(len);
+			if (buf != NULL) {
+				snprintf(buf, len, "(in promise) %s%s%s",
+					 msg ? msg : "?", stack ? "\n" : "",
+					 stack ? stack : "");
+				heap->rej_fn(heap->udata, buf);
+				free(buf);
+			}
+			if (stack) JS_FreeCString(ctx, stack);
+			if (msg) JS_FreeCString(ctx, msg);
+			JS_FreeValue(ctx, st);
+		}
+		JS_FreeValue(ctx, heap->rej_promise[i]);
+		JS_FreeValue(ctx, r);
+	}
+	heap->nrej = 0;
+}
+
+void duk_netsurf_rejection_handler(duk_context *ctx,
+				   void (*fn)(void *udata, const char *msg))
+{
+	ctx->heap->rej_fn = fn;
+}

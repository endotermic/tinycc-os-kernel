+method Document::createComment()
+%{
+	dom_comment *newnode;
+	dom_exception err;
+	duk_size_t text_len;
+	const char *text = duk_safe_to_lstring(ctx, 0, &text_len);
+	dom_string *text_str;
+
+	err = dom_string_create((const uint8_t*)text, text_len, &text_str);
+	if (err != DOM_NO_ERR) return 0;
+	err = dom_document_create_comment(priv->parent.node, text_str, &newnode);
+	dom_string_unref(text_str);
+	if (err != DOM_NO_ERR) return 0;
+	dukky_push_node(ctx, (dom_node *)newnode);
+	dom_node_unref(newnode);
+	return 1;
+%}
+
+method Document::createProcessingInstruction()
+%{
+	dom_processing_instruction *newnode;
+	dom_exception err;
+	duk_size_t target_len, data_len;
+	const char *target = duk_safe_to_lstring(ctx, 0, &target_len);
+	const char *data = duk_safe_to_lstring(ctx, 1, &data_len);
+	dom_string *target_str, *data_str;
+
+	err = dom_string_create((const uint8_t*)target, target_len, &target_str);
+	if (err != DOM_NO_ERR) return 0;
+	err = dom_string_create((const uint8_t*)data, data_len, &data_str);
+	if (err != DOM_NO_ERR) {
+		dom_string_unref(target_str);
+		return 0;
+	}
+	err = dom_document_create_processing_instruction(priv->parent.node,
+			target_str, data_str, &newnode);
+	dom_string_unref(target_str);
+	dom_string_unref(data_str);
+	if (err != DOM_NO_ERR) return 0;
+	dukky_push_node(ctx, (dom_node *)newnode);
+	dom_node_unref(newnode);
+	return 1;
+%}

+/* run a script with its element as document.currentScript */
+static void run_script(html_content *c, dom_node *node,
+		       script_handler_t *script_handler,
+		       const uint8_t *data, size_t size, const char *name)
+{
+	dom_node *saved = c->current_script;
+	c->current_script = node;
+	script_handler(c->jsthread, data, size, name);
+	c->current_script = saved;
+}
+
+/* the load or error event of an external script's element (script
+ * loaders wait for it) */
+static void script_element_event(dom_node *node, dom_string *type)
+{
+	dom_string *src = NULL;
+	if (node == NULL)
+		return;
+	if (dom_element_get_attribute(node, corestring_dom_src, &src) !=
+	    DOM_NO_ERR || src == NULL)
+		return;
+	dom_string_unref(src);
+	fire_generic_dom_event(type, node, false, false);

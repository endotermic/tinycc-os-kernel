 		dom_string *dcl;
 		if (dom_string_create((const uint8_t *)"DOMContentLoaded",
 				SLEN("DOMContentLoaded"), &dcl) == DOM_NO_ERR) {
diff --git a/netsurf/content/handlers/javascript/WebIDL/dom.idl b/netsurf/content/handlers/javascript/WebIDL/dom.idl

diff --git a/netsurf/content/handlers/javascript/duktape/dukky.c b/netsurf/content/handlers/javascript/duktape/dukky.c
index bf921e6..e877917 100644
--- a/netsurf/content/handlers/javascript/duktape/dukky.c
+++ b/netsurf/content/handlers/javascript/duktape/dukky.c
@@ -483,6 +483,8 @@ dukky_push_node_klass(duk_context *ctx, struct dom_node *node)
 		duk_push_string(ctx, PROTO_NAME(DOCUMENTTYPE));
 		break;
 	case DOM_ATTRIBUTE_NODE:
+		duk_push_string(ctx, PROTO_NAME(ATTR));
+		break;
 	case DOM_PROCESSING_INSTRUCTION_NODE:
 		/* (not libdom character data: CharacterData's members would
 		 * not work on it) */
@@ -1210,7 +1212,12 @@ bool dukky_get_current_value_of_event_handler(duk_context *ctx,
 		duk_pop(ctx);
 		/* ... handler node */
 	}
-	/* ... handler node */
+	/* ... handler node: a handler that is not callable (el.onload set
+	 * to an object) is ignored; it was called ("not a function") */
+	if (!duk_is_callable(ctx, -2)) {
+		duk_pop_2(ctx);
+		return false;
+	}
 	return true;
 }
 
@@ -1625,6 +1632,20 @@ void dukky_dispatch_to_object(duk_context *ctx, duk_idx_t obj_idx,
 		duk_def_prop(ctx, -3, DUK_DEFPROP_HAVE_VALUE |
 			     DUK_DEFPROP_HAVE_CONFIGURABLE |
 			     DUK_DEFPROP_CONFIGURABLE);
+		/* eventPhase: at the target when it is the object, else
+		 * bubbling (DOMContentLoaded and load come from the
+		 * Document); libdom's phase is unset for these */
+		{
+			duk_bool_t at_target;
+			duk_push_string(ctx, "eventPhase");
+			duk_get_prop_string(ctx, -2, "target");
+			at_target = duk_strict_equals(ctx, -1, obj_idx);
+			duk_pop(ctx);
+			duk_push_int(ctx, at_target ? 2 : 3);
+			duk_def_prop(ctx, -3, DUK_DEFPROP_HAVE_VALUE |
+				     DUK_DEFPROP_HAVE_CONFIGURABLE |
+				     DUK_DEFPROP_CONFIGURABLE);
+		}
 		duk_pop(ctx);
 	}
 	/* ... sublisteners: copy them (a listener may add or remove

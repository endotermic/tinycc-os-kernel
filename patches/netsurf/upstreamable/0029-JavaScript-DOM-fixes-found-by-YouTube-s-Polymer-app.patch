diff --git a/netsurf/content/handlers/javascript/duktape/Attr.bnd b/netsurf/content/handlers/javascript/duktape/Attr.bnd
new file mode 100644
index 0000000..7abb5d9
--- /dev/null
+++ b/netsurf/content/handlers/javascript/duktape/Attr.bnd
@@ -0,0 +1,105 @@
+/* Attr binding for browser using duktape and libdom
+ *
+ * Copyright 2026 Nikolajs Agafonovs
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * Released under the terms of the MIT License,
+ *         http://www.opensource.org/licenses/mit-license
+ */
+
+/* An attribute node (element.attributes, getAttributeNode): name, value
+ * and the rest over libdom's attr calls (attribute nodes had Node's
+ * prototype only, so attr.name and attr.value were undefined) */
+
+class Attr {
+	prologue %{
+static duk_ret_t attr_push_string(duk_context *ctx, dom_string *s, bool null_ok)
+{
+	if (s == NULL) {
+		if (null_ok)
+			duk_push_null(ctx);
+		else
+			duk_push_string(ctx, "");
+		return 1;
+	}
+	duk_push_lstring(ctx, dom_string_data(s), dom_string_length(s));
+	dom_string_unref(s);
+	return 1;
+}
+%};
+};
+
+getter Attr::name()
+%{
+	dom_string *s = NULL;
+	if (dom_attr_get_name((struct dom_attr *)priv->parent.node, &s) != DOM_NO_ERR)
+		return 0;
+	return attr_push_string(ctx, s, false);
+%}
+
+getter Attr::localName()
+%{
+	dom_string *s = NULL;
+	if (dom_node_get_local_name(priv->parent.node, &s) != DOM_NO_ERR)
+		return 0;
+	if (s == NULL &&
+	    dom_attr_get_name((struct dom_attr *)priv->parent.node, &s) != DOM_NO_ERR)
+		return 0;
+	return attr_push_string(ctx, s, false);
+%}
+
+getter Attr::namespaceURI()
+%{
+	dom_string *s = NULL;
+	if (dom_node_get_namespace(priv->parent.node, &s) != DOM_NO_ERR)
+		return 0;
+	return attr_push_string(ctx, s, true);
+%}
+
+getter Attr::prefix()
+%{
+	dom_string *s = NULL;
+	if (dom_node_get_prefix(priv->parent.node, &s) != DOM_NO_ERR)
+		return 0;
+	return attr_push_string(ctx, s, true);
+%}
+
+getter Attr::value()
+%{
+	dom_string *s = NULL;
+	if (dom_attr_get_value((struct dom_attr *)priv->parent.node, &s) != DOM_NO_ERR)
+		return 0;
+	return attr_push_string(ctx, s, false);
+%}
+
+setter Attr::value()
+%{
+	dom_string *s = NULL;
+	duk_size_t slen;
+	const char *str = duk_safe_to_lstring(ctx, 0, &slen);
+	if (dom_string_create((const uint8_t *)str, slen, &s) != DOM_NO_ERR)
+		return 0;
+	dom_attr_set_value((struct dom_attr *)priv->parent.node, s);
+	dom_string_unref(s);
+	return 0;
+%}
+
+getter Attr::ownerElement()
+%{
+	struct dom_element *e = NULL;
+	if (dom_attr_get_owner_element((struct dom_attr *)priv->parent.node, &e) != DOM_NO_ERR ||
+	    e == NULL) {
+		duk_push_null(ctx);
+		return 1;
+	}
+	dukky_push_node(ctx, (struct dom_node *)e);
+	dom_node_unref(e);
+	return 1;
+%}
+
+getter Attr::specified()
+%{
+	duk_push_boolean(ctx, true);
+	return 1;
+%}
diff --git a/netsurf/content/handlers/javascript/duktape/Element.bnd b/netsurf/content/handlers/javascript/duktape/Element.bnd
index cbb392d..f8887e5 100644
--- a/netsurf/content/handlers/javascript/duktape/Element.bnd
+++ b/netsurf/content/handlers/javascript/duktape/Element.bnd
@@ -512,6 +512,35 @@ setter Element::innerHTML()
 	 */
 	exc = dom_node_get_first_child(fragment, &html);
 	if (exc != DOM_NO_ERR) goto out;
+	/* comments at the start of the markup come before that element (the
+	 * parser's initial insertion mode puts them in the fragment): they
+	 * are the first nodes of the result.  Looking only at the first child
+	 * gave nothing at all for markup starting with a comment (every
+	 * Polymer template of YouTube) */
+	while (html != NULL) {
+		dom_node_type type;
+		struct dom_node *next = NULL, *cref;
+		exc = dom_node_get_node_type(html, &type);
+		if (exc != DOM_NO_ERR) goto out;
+		if (type == DOM_ELEMENT_NODE)
+			break;
+		exc = dom_node_get_next_sibling(html, &next);
+		if (exc != DOM_NO_ERR) goto out;
+		if (type == DOM_COMMENT_NODE) {
+			exc = dom_node_remove_child(fragment, html, &cref);
+			if (exc == DOM_NO_ERR) {
+				dom_node_unref(cref);
+				exc = dom_node_append_child(priv->parent.node,
+							    html, &cref);
+				if (exc == DOM_NO_ERR)
+					dom_node_unref(cref);
+			}
+		}
+		dom_node_unref(html);
+		html = next;
+		if (exc != DOM_NO_ERR) goto out;
+	}
+	if (html == NULL) goto out;
 
 	/* We can then ask that HTML element to give us its body */
 	exc = dom_element_get_elements_by_tag_name(html, corestring_dom_BODY, &bodies);
diff --git a/netsurf/content/handlers/javascript/duktape/Node.bnd b/netsurf/content/handlers/javascript/duktape/Node.bnd
index 8cd0794..65aa93a 100644
--- a/netsurf/content/handlers/javascript/duktape/Node.bnd
+++ b/netsurf/content/handlers/javascript/duktape/Node.bnd
@@ -240,7 +240,18 @@ getter Node::textContent()
 		dom_string_unref(content);
 		return 1;
 	}
-	return 0;
+	/* no text: "" for an element, fragment, attribute or character data
+	 * (it was undefined, so an empty element looked as if it had text),
+	 * null for a document or doctype */
+	{
+		dom_node_type type;
+		if (dom_node_get_node_type(priv->node, &type) == DOM_NO_ERR &&
+		    (type == DOM_DOCUMENT_NODE || type == DOM_DOCUMENT_TYPE_NODE))
+			duk_push_null(ctx);
+		else
+			duk_push_string(ctx, "");
+	}
+	return 1;
 %}
 
 setter Node::textContent()
diff --git a/netsurf/content/handlers/javascript/duktape/duk_quickjs.c b/netsurf/content/handlers/javascript/duktape/duk_quickjs.c
index bf7af09..5810a18 100644
--- a/netsurf/content/handlers/javascript/duktape/duk_quickjs.c
+++ b/netsurf/content/handlers/javascript/duktape/duk_quickjs.c
@@ -61,6 +61,7 @@
 #undef realloc
 
 #include <setjmp.h>
+#include <sys/resource.h>
 
 extern duk_bool_t dukky_check_timeout(void *udata);
 
@@ -691,6 +692,24 @@ duk_context *duk_create_heap(duk_alloc_function alloc_func,
 	}
 	JS_SetRuntimeOpaque(heap->rt, heap);
 	JS_SetHostPromiseRejectionTracker(heap->rt, duk__rejection_tracker, heap);
+	/* QuickJS lets scripts use 1 MB of the C stack; component frameworks
+	 * nest deeper (YouTube's Polymer elements, each constructor a chain
+	 * of mixins, create their children from their constructors: "stack
+	 * overflow").  Allow the process's stack less a margin for NetSurf's
+	 * own frames, at most 8 MB */
+	{
+		struct rlimit rl;
+		size_t want = 8u << 20;
+		if (getrlimit(RLIMIT_STACK, &rl) == 0 && rl.rlim_cur != RLIM_INFINITY) {
+			if (rl.rlim_cur > (3u << 19) + JS_DEFAULT_STACK_SIZE)
+				want = (size_t)rl.rlim_cur - (3u << 19);
+			else
+				want = JS_DEFAULT_STACK_SIZE;
+			if (want > (8u << 20))
+				want = 8u << 20;
+		}
+		JS_SetMaxStackSize(heap->rt, want);
+	}
 	if (duk_obj_class_id == 0)
 		JS_NewClassID(&duk_obj_class_id);
 	if (duk_thread_class_id == 0)
@@ -1297,6 +1316,11 @@ duk_bool_t duk_is_string(duk_context *ctx, duk_idx_t idx)
 	return duk_get_type(ctx, idx) == DUK_TYPE_STRING;
 }
 
+duk_bool_t duk_is_callable(duk_context *ctx, duk_idx_t idx)
+{
+	return JS_IsFunction(ctx->heap->ctx, duk__val(ctx, idx));
+}
+
 duk_bool_t duk_is_object(duk_context *ctx, duk_idx_t idx)
 {
 	return duk_get_type(ctx, idx) == DUK_TYPE_OBJECT;

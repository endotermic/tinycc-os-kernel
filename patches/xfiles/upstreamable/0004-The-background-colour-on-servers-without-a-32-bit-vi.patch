-	);
+	clearpict(widget, widget->layers[LAYER_STATUSBAR].pict, 0, 0, widget->winw, STATUSBAR_HEIGHT(widget));
 
 	/* draw item counter */
 	(void)snprintf(
@@ -589,15 +609,7 @@ drawstatusbar(Widget *widget)
 	}
 
 	/* clear content below right side of statusbar */

-		&(XRenderColor){ 0 },
-		widget->winw - rightwid, 0,
-		rightwid,
-		STATUSBAR_HEIGHT(widget)
-	);
+	clearpict(widget, widget->layers[LAYER_STATUSBAR].pict, widget->winw - rightwid, 0, rightwid, STATUSBAR_HEIGHT(widget));
 
 	/* draw percentage */
 	ctrlfnt_draw(
@@ -796,13 +808,7 @@ isbreakable(char c)

 	int saveargc, force_refresh;
+	int named = 0;
 	int nresources = 0;
 	int exitval = EXIT_SUCCESS;
 	const char *resources[MAX_RESOURCES];
@@ -1057,13 +1060,17 @@ main(int argc, char *argv[])
 	fm.ngrps = getgroups(NGROUPS_MAX, fm.grps);
 	if ((fm.opener = getenv("OPENER")) == NULL)
 		fm.opener = DEF_OPENER;
-	while ((ch = getopt(argc, argv, "aN:X:")) != -1) {
+	while ((ch = getopt(argc, argv, "adN:X:")) != -1) {
 		switch (ch) {
 		case 'a':
 			hide = 0;
 			break;
+		case 'd':
+			desktop = 1;
+			break;
 		case 'N':
 			name = optarg;
+			named = 1;
 			break;
 		case 'X':
 			if (nresources < MAX_RESOURCES - 1)
@@ -1081,8 +1088,27 @@ main(int argc, char *argv[])
 		usage();
 	else if (argc == 1)
 		path = *argv;
+	if (desktop) {
+		/*
+		 * -d: the desktop, by default ~/Desktop (made when missing).
+		 * XFILES_DESKTOP tells the control script, whose menu on
+		 * the background then has the session's entries.
+		 */
+		if (path == NULL && home != NULL) {
+			static char deskpath[PATH_MAX];
+			(void)snprintf(deskpath, sizeof(deskpath), "%s/Desktop", home);
+			if (mkdir(deskpath, 0755) == -1 && errno != EEXIST)
+				warn("%s", deskpath);
+			path = deskpath;
+		}
+		if (setenv("XFILES_DESKTOP", "1", 1) == -1)
+			warn("setenv");
+		/* its own resource name, for resources that differ from a window's */
+		if (!named)
+			name = "xfiles-desktop";
+	}
 	initthumbnailer(&fm);
-	if ((fm.widget = widget_create(APPCLASS, name, saveargc, saveargv, resources)) == NULL)
+	if ((fm.widget = widget_create(APPCLASS, name, saveargc, saveargv, resources, desktop)) == NULL)
 		exit(EXIT_FAILURE);
 	fm.widgetfd = widget_fd(fm.widget);
 #if __OpenBSD__
@@ -1135,7 +1161,7 @@ main(int argc, char *argv[])
 				break;
 			if (fm.selitems[0] < 0 || fm.selitems[0] >= fm.nentries)
 				break;
-			if (isdir(&fm.entries[fm.selitems[0]])) {
+			if (isdir(&fm.entries[fm.selitems[0]]) && !desktop) {
 				if (changedir(&fm, fm.entries[fm.selitems[0]].fullname, false) == RETURN_FAILURE) {
 					exitval = EXIT_FAILURE;
 					goto done;
@@ -1211,6 +1237,13 @@ main(int argc, char *argv[])
 				goto done;
 			}
 			break;
+		case WIDGET_NONE:
+			/* the desktop's idle tick: re-read the folder if it changed */
+			if (desktop && changedir(&fm, fm.cwd->path, false) == RETURN_FAILURE) {
+				exitval = EXIT_FAILURE;

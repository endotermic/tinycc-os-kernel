 	}
 }
 
+/*
+ * The main loop's next event.  On the desktop it also returns TimeoutNotify
+ * once the user has been idle for DESKTOP_IDLE milliseconds with no mouse
+ * button held, so that xfiles can re-read the folder (files that other
+ * windows put there); never in the middle of a click, a double click or a
+ * drag.
+ */
+#define DESKTOP_IDLE 1500
+static int
+mainevent(Widget *widget, XEvent *ev, struct timespec *lastev)
+{
+	struct timespec now;
+	Window rootw, childw;
+	int rx, ry, wx, wy, type;
+	unsigned int mask;
+	long idle;
+
+	for (;;) {
+		type = nextevent(widget, ev, widget->desktop ? 500 : 0);
+		if (type != TimeoutNotify) {
+			(void)clock_gettime(CLOCK_MONOTONIC, lastev);
+			return type;
+		}
+		if (clock_gettime(CLOCK_MONOTONIC, &now) == -1)
+			continue;
+		idle = (now.tv_sec - lastev->tv_sec) * 1000 + (now.tv_nsec - lastev->tv_nsec) / 1000000;
+		if (idle < DESKTOP_IDLE)
+			continue;
+		if (XQueryPointer(widget->display, widget->window, &rootw, &childw, &rx, &ry, &wx, &wy, &mask) &&
+		    (mask & (Button1Mask | Button2Mask | Button3Mask)))
+			continue;
+		*lastev = now;
+		return TimeoutNotify;
+	}
+}
+
 static WidgetEvent
 mainmode(Widget *widget, int *selitems, int *nitems, char **text)
 {
+	struct timespec lastev;
 	XEvent ev;
 	Time lasttime = 0;
 	int clickx = 0;
@@ -2869,7 +2908,10 @@ mainmode(Widget *widget, int *selitems, int *nitems, char **text)
 	WidgetEvent event;
 	struct ctrldnd_drop drop;
 
-	for (;;) switch (nextevent(widget, &ev, 0)) {
+	(void)clock_gettime(CLOCK_MONOTONIC, &lastev);
+	for (;;) switch (mainevent(widget, &ev, &lastev)) {
+	case TimeoutNotify:
+		return WIDGET_NONE;     /* the desktop's idle tick: xfiles re-reads the folder */
 	case CloseNotify:
 		return WIDGET_CLOSE;
 	case PropertyNotify:
@@ -3093,6 +3135,15 @@ initwindow(Widget *widget, struct Options *options)
 	char buf[16]; /* 16: enough for digits in 32-bit number + final '\0' */
 
 	sizehints = getgeometry(widget, &geometry);
+	if (widget->desktop) {
+		/* the desktop covers the whole screen; the window manager keeps it below */
+		geometry = (XRectangle){
+			.x = 0, .y = 0,
+			.width = DisplayWidth(widget->display, widget->screen),
+			.height = DisplayHeight(widget->display, widget->screen),
+		};
+		sizehints = USPosition | USSize;
+	}
 	widget->winw = geometry.width,
 	widget->winh = geometry.height,
 	widget->window = createwindow(
@@ -3162,7 +3213,7 @@ initwindow(Widget *widget, struct Options *options)
 		XA_ATOM,
 		32,
 		PropModeReplace,
-		(unsigned char *)&atoms[_NET_WM_WINDOW_TYPE_NORMAL],
+		(unsigned char *)&atoms[widget->desktop ? _NET_WM_WINDOW_TYPE_DESKTOP : _NET_WM_WINDOW_TYPE_NORMAL],
 		1
 	);
 	(void)XChangeProperty(
@@ -3442,7 +3493,7 @@ widget_free(Widget *widget)
 }
 

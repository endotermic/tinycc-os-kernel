 	size_t i;
@@ -3482,6 +3533,7 @@ widget_create(const char *class, const char *name, int argc, char *argv[], const
 		.highlight = -1,
 		.itemw = ITEM_WIDTH,
 		.cliresources = resources,
+		.desktop = desktop,
 	};
 	for (i = 0; i < LEN(initsteps); i++) {
 		if ((*initsteps[i])(widget, &options) == RETURN_FAILURE) {

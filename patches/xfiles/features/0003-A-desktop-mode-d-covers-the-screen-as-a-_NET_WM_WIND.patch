diff --git a/xfiles.1 b/xfiles.1
index 07510ac..ba5ab3e 100644
--- a/xfiles.1
+++ b/xfiles.1
@@ -8,7 +8,7 @@
 .Nd X11 file manager
 .Sh SYNOPSIS
 .Nm xfiles
-.Op Fl a
+.Op Fl ad
 .Op Fl N Ar name
 .Op Fl X Ar resources
 .Op Ar directory
@@ -29,6 +29,28 @@ The options are as follows:
 .Bl -tag -width Ds
 .It Fl a
 Include directory entries whose name begin with a dot.
+.It Fl d
+Run as the desktop: the window covers the whole screen and is marked
+.Ic _NET_WM_WINDOW_TYPE_DESKTOP ,
+so that the window manager keeps it below the other windows, without a frame,
+on every virtual desktop.
+Its directory defaults to
+.Pa ~/Desktop ,
+which is created when missing, and its resource name (see
+.Fl N )
+to
+.Ic xfiles-desktop ,
+so that resources such as
+.Ic xfiles-desktop.background
+can set the desktop apart from the windows.
+It shows no entry for the parent directory.
+Directories open in a new window (through the opener) instead of in place,
+the directory is re-read when it changes (checked after a short idle time),
+and the environment variable
+.Ev XFILES_DESKTOP
+is set to 1 for the programs it runs, so that
+.Nm xfilesctl
+can offer the session's entries in its menu.
 .It Fl N Ar name
 Specify the
 .Ic res_name
diff --git a/xfiles.c b/xfiles.c
index 9ffe1ca..0116a2e 100644
--- a/xfiles.c
+++ b/xfiles.c
@@ -83,6 +83,7 @@ struct FM {
 };
 
 static int hide = 1;

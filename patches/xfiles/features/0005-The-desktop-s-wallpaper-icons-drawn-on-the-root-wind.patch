 	Pixmap namepix;                 /* temporary pixmap for the labels */
 	Pixmap namepict;
 
+	/*
+	 * The desktop's wallpaper: the root window's background pixmap
+	 * (_XROOTPMAP_ID), drawn under the icons; None when there is none
+	 * or this is not the desktop.  wallydiff: the scroll offset the
+	 * icon layer was drawn for (its background is cut from the wallpaper

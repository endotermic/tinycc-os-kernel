 	XRenderComposite(
 		widget->display,
 		PictOpOver,
@@ -1159,7 +1325,17 @@ commitdraw(Widget *widget)
 			widget->winw, STATUSBAR_HEIGHT(widget)
 		);
 	}
-	XRenderFillRectangle(
+	if (widget->wallpict != None && widget->depth == 32) XRenderComposite(

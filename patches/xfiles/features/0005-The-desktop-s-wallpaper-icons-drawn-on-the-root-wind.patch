+	 * shadow colour on the wallpaper.
+	 */
+	Picture wallpict;
+	Picture shadowpict;
+	int wallydiff;
+
 	struct clipboard {
 		unsigned char *buf;
 		size_t size;
@@ -385,6 +398,126 @@ clearpict(Widget *widget, Picture pict, int x, int y, unsigned int w, unsigned i
 	);
 }
 
+/*
+ * The desktop's wallpaper under a part of a picture: (x, y, w, h) of pict
+ * gets the wallpaper at (wx, wy) of the window (the desktop's window is at
+ * the screen's origin, so that is the place on the root window).  On a
+ * 32-bit visual the layers stay transparent and commitdraw() puts the
+ * wallpaper under everything; elsewhere the layers are opaque and carry
+ * their piece of it.  Without a wallpaper: clearpict().
+ */
+static void
+clearwall(Widget *widget, Picture pict, int x, int y, unsigned int w, unsigned int h, int wx, int wy)
+{
+	if (widget->wallpict == None || widget->depth == 32) {
+		clearpict(widget, pict, x, y, w, h);
+		return;
+	}
+	XRenderComposite(
+		widget->display,
+		PictOpSrc,
+		widget->wallpict,
+		None,
+		pict,
+		wx, wy,
+		0, 0,
+		x, y,
+		w, h
+	);
+}
+
+/* the icon layer's point (x, y) shows at the window's (x + x0, y - ydiff + MARGIN) */
+static void
+clearicons(Widget *widget, int x, int y, unsigned int w, unsigned int h)
+{
+	clearwall(
+		widget, widget->layers[LAYER_ICONS].pict, x, y, w, h,
+		x + widget->x0, y - widget->ydiff + MARGIN
+	);
+}
+
+static int wallerror;
+
+static int
+wallerror_handler(Display *display, XErrorEvent *error)
+{
+	(void)display;
+	(void)error;
+	wallerror = 1;
+	return 0;
+}
+
+/*
+ * (Re)read the wallpaper of the desktop from the root window's
+ * _XROOTPMAP_ID property (set by the program that draws the root window's
+ * background: the wallpaper program, or JWM for its colour and image
+ * backgrounds); a pixmap smaller than the screen (JWM's 1x1 for a colour)
+ * repeats.  The pixmap belongs to another client and may be gone already:
+ * errors are caught here, and then the desktop has no wallpaper.
+ */
+static void
+loadwallpaper(Widget *widget)
+{
+	XRenderPictFormat *format;
+	Atom type;
+	int fmt, (*handler)(Display *, XErrorEvent *);
+	unsigned long n, after;
+	unsigned char *data = NULL;
+	Pixmap pix = None;
+	Window root;
+	int x, y;
+	unsigned int w, h, border, depth;
+
+	if (widget->wallpict != None)
+		XRenderFreePicture(widget->display, widget->wallpict);
+	widget->wallpict = None;
+	if (!widget->desktop)
+		return;
+	if (XGetWindowProperty(
+		widget->display, widget->root, atoms[_XROOTPMAP_ID],
+		0, 1, False, XA_PIXMAP, &type, &fmt, &n, &after, &data
+	) == Success && type == XA_PIXMAP && fmt == 32 && n == 1)
+		pix = *(Pixmap *)data;
+	if (data != NULL)
+		XFree(data);
+	if (pix == None)
+		return;
+	format = XRenderFindVisualFormat(
+		widget->display,
+		DefaultVisual(widget->display, widget->screen)
+	);
+	if (format == NULL)
+		return;
+	XSync(widget->display, False);
+	wallerror = 0;
+	handler = XSetErrorHandler(wallerror_handler);
+	if (!XGetGeometry(widget->display, pix, &root, &x, &y, &w, &h, &border, &depth) ||
+	    depth != (unsigned int)DefaultDepth(widget->display, widget->screen))
+		wallerror = 1;
+	if (!wallerror) {
+		widget->wallpict = XRenderCreatePicture(
+			widget->display, pix, format, CPRepeat,
+			&(XRenderPictureAttributes){ .repeat = RepeatNormal }
+		);
+		XSync(widget->display, False);
+	}
+	(void)XSetErrorHandler(handler);
+	if (wallerror)
+		widget->wallpict = None;        /* a failed creation leaves no picture */
+	if (widget->wallpict != None && widget->shadowpict == None) {
+		Pixmap spix = XCreatePixmap(widget->display, widget->window, 1, 1, widget->depth);
+		widget->shadowpict = XRenderCreatePicture(
+			widget->display, spix, widget->format, CPRepeat,
+			&(XRenderPictureAttributes){ .repeat = RepeatNormal }
+		);
+		XRenderFillRectangle(
+			widget->display, PictOpSrc, widget->shadowpict,
+			&(XRenderColor){ .alpha = 0xFFFF }, 0, 0, 1, 1
+		);
+		XFreePixmap(widget->display, spix);
+	}
+}
+
 static void
 resetlayer(Widget *widget, enum Layer layer, int width, int height)
 {

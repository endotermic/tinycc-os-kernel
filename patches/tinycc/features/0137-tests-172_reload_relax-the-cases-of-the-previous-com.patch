From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Tue, 10 Nov 2026 16:06:05 +0200
Subject: [PATCH] tests: 172_reload_relax, the cases of the previous commit

Relaxation in functions with inline asm (forward references inside one
statement and across statements, a label's address taken as an immediate
and stored in .data, a `.long 1f - .` word in .data as the kernel's exception table
has, a backward reference, a label difference, .align,
asm goto, a value read back from .data), the fixed point with backward
jumps around 128 bytes, jumps to the next instruction, and the reload of
a just-stored local in every form (widths, union punning, overlapping
stores, labels, loops, asm outputs in memory, spills, regparm saves,
float/int punning, a narrower reload into the register followed by the
full-width one).  Expected output from gcc; passes with tcc on
x86_64 and with i386-tcc against the tcc-built musl, with and without
-mregparm=3.
---
 tests/tests2/172_reload_relax.c      | 363 +++++++++++++++++++++++++++
 tests/tests2/172_reload_relax.expect |  71 ++++++
 2 files changed, 434 insertions(+)
 create mode 100644 tests/tests2/172_reload_relax.c
 create mode 100644 tests/tests2/172_reload_relax.expect

diff --git a/tests/tests2/172_reload_relax.c b/tests/tests2/172_reload_relax.c
new file mode 100644
index 0000000..4ddd5c9
--- /dev/null
+++ b/tests/tests2/172_reload_relax.c
@@ -0,0 +1,363 @@
+/* Fix 130: the i386 code-size work that lets the kernel's real-mode setup
+   keep its video mode code (kernel patch 0011 dropped).  Jump relaxation in
+   functions with inline asm (the assembler's forward references leave
+   relocations and symbols, patched like the compiler's own; a displacement
+   or label difference it folds, an .align or .org in the function's section
+   switch it off, and the code must be right either way), the relaxation's
+   target mapping during its fixed-point iteration (backward jumps around
+   128 bytes), jumps to the next instruction removed, and a local loaded
+   right after it was stored taken from the register (every width, a
+   narrower load of a wider store, overlapping stores, volatile, labels,
+   loops, asm outputs in memory, spills, the regparm prologue's saves, type
+   punning through unions).  The 16-bit absolute addresses of -m16 code are
+   checked by tests/m16-check.sh.  Expected output from gcc. */
+#include <stdio.h>
+
+#if defined __i386__
+#define RP3 __attribute__((regparm(3)))
+#else
+#define RP3
+#endif
+#if defined __i386__ || defined __x86_64__
+#define X86 1
+#else
+#define X86 0
+#endif
+
+static void p(const char *name, long long v) { printf("%s: %lld\n", name, v); }
+#define P(e) p(#e, (long long)(e))
+
+/* ---- relaxation with inline asm ---- */
+static int asm_fwd(int n)          /* a forward reference inside the asm: relocation */
+{
+    int i, s = 0;
+    for (i = 0; i < n; i++) {
+        int t = i;
+#if X86
+        __asm__("testl %0,%0; jz 1f; addl $2,%0; 1:" : "+r"(t));
+#else
+        if (t) t += 2;
+#endif
+        s += t;
+        if (s > 100) s -= 100;
+        if (s & 1) s += 3;
+    }
+    return s;
+}
+
+static int asm_back(int n)         /* a backward reference: folded, no relaxation */
+{
+    int i, s = 0;
+    for (i = 0; i < n; i++) {
+        int t = i;
+#if X86
+        __asm__("1: incl %0; cmpl $5,%0; jl 1b" : "+r"(t));
+#else
+        do t++; while (t < 5);
+#endif
+        s += t;
+        if (s > 50) s -= 7;
+    }
+    return s;
+}
+
+static int asm_diff(int n)         /* a label difference as an immediate: folded */
+{
+    int d, i, s = 0;
+    for (i = 0; i < n; i++) {
+#if X86
+        __asm__("1: nop; nop; nop\n2: movl $(2b-1b),%0" : "=r"(d));
+#else
+        d = 3;
+#endif
+        s += d;
+        if (s & 1) s++;
+    }
+    return s;
+}
+
+static int asm_align(int n)        /* an alignment in the function's text */
+{
+    int i, s = 1;
+    for (i = 0; i < n; i++) {
+#if X86
+        __asm__(".align 8; nop");
+#endif
+        s = s * 3 + i;
+        if (s > 1000) s %= 1000;
+    }
+    return s;
+}
+
+static int asm_cross(int n, int x)  /* a label of a later asm statement, over relaxed jumps */
+{
+    int i, s = 0, d;
+    for (i = 0; i < n; i++) {
+#if X86
+        __asm__("jmp 7f" ::: "memory");
+        if (x & 1) d = 1; else d = 2;  /* jumped over: never run, d unused */
+        __asm__("7:" ::: "memory");
+#endif
+        s += i + (x & 2);
+        if (s > 10) s -= 10;
+    }
+    (void)d;
+    return s;
+}
+
+static int asm_addr(int n)         /* a label's address as an immediate and in .data */
+{
+    int i, s = 0;
+    for (i = 0; i < n; i++) {
+        unsigned long a = 1, b = 1;
+#if defined __i386__
+        __asm__("movl $1f,%0\n.pushsection .data\n9: .long 1f\n.popsection\nmovl 9b,%1\n1:" : "=r"(a), "=r"(b));
+#elif defined __x86_64__
+        __asm__("leaq 1f(%%rip),%0\n.pushsection .data\n9: .quad 1f\n.popsection\nmovq 9b(%%rip),%1\n1:" : "=r"(a), "=r"(b));
+#endif
+        s += (a == b) + i;
+        if (s & 1) s += 2;
+    }
+    return s;
+}
+
+static int asm_pcrel(int n)        /* `.long 1b - .` in .data, as the kernel's exception table */
+{
+    int i, s = 0;
+    for (i = 0; i < n; i++) {
+        long a = 1, b = 1, d = 0;
+#if defined __i386__
+        __asm__("movl $1f,%0\n.pushsection .data\n9: .long 1f - .\n.popsection\nmovl $9b,%1\nmovl 9b,%2\n1:" : "=r"(a), "=r"(b), "=r"(d));
+#elif defined __x86_64__
+        __asm__("leaq 1f(%%rip),%0\n.pushsection .data\n9: .long 1f - .\n.popsection\nleaq 9b(%%rip),%1\nmovslq 9b(%%rip),%2\n1:" : "=r"(a), "=r"(b), "=r"(d));
+#endif
+        s += (a == b + d) + i;
+        if (s & 1) s += 2;
+    }
+    return s;
+}
+
+static int asm_goto(int x)
+{
+#if X86
+    __asm__ goto("testl %0,%0; jnz %l1" :: "r"(x) :: nz);
+    return 10;
+nz:
+    return 20;
+#else
+    return x ? 20 : 10;
+#endif
+}
+
+static int asm_section(int n)      /* a value in another section, read back */
+{
+    int i, s = 0, v;
+    for (i = 0; i < n; i++) {
+#if defined __i386__
+        __asm__("1: nop; nop\n2:\n.pushsection .data\n3: .long 2b-1b\n.popsection\nmovl 3b,%0" : "=r"(v));
+#else
+        v = 2;
+#endif
+        s += v + i;
+        if (s > 20) s -= 5;
+    }
+    return s;
+}
+
+/* ---- the fixed point: backward jumps near 128 bytes, with forward jumps in the body ---- */
+#define BODY(k) if (x & (1 << (k))) s += (k) + 1; else s ^= (k);
+#define LOOP(N, ...) static int loop##N(int x, int n) { int s = 0, i = 0; do { __VA_ARGS__ i++; } while (i < n); return s; }
+LOOP(1, BODY(0))
+LOOP(2, BODY(0) BODY(1))
+LOOP(3, BODY(0) BODY(1) BODY(2))
+LOOP(4, BODY(0) BODY(1) BODY(2) BODY(3))
+LOOP(5, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4))
+LOOP(6, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5))
+LOOP(7, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6))
+LOOP(8, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6) BODY(7))
+LOOP(9, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6) BODY(7) BODY(8))
+LOOP(10, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6) BODY(7) BODY(8) BODY(9))
+LOOP(12, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6) BODY(7) BODY(8) BODY(9) BODY(10) BODY(11))
+LOOP(14, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6) BODY(7) BODY(8) BODY(9) BODY(10) BODY(11) BODY(12) BODY(13))
+LOOP(16, BODY(0) BODY(1) BODY(2) BODY(3) BODY(4) BODY(5) BODY(6) BODY(7) BODY(8) BODY(9) BODY(10) BODY(11) BODY(12) BODY(13) BODY(14) BODY(15))
+
+/* ---- jumps to the next instruction ---- */
+static int next_jmp(int v)
+{
+    int s = 0, i;
+    switch (v) {
+    case 1: s += 1; break;
+    case 2: s += 2; break;
+    default: s += 3; break;
+    }
+    for (i = 0; i < 3; i++) {
+        if (i == v) { s += 10; continue; }
+        s++;
+    }
+    while (s < 20) { s += 7; continue; }
+    if (v > 5) { s += 100; } else { }
+    return s;
+}
+
+/* ---- a local loaded right after its store ---- */
+static int reuse_int(int a, int b)
+{
+    int x, y;
+    x = a + b;
+    y = x * 3;
+    x = y - a;
+    y = x ? x : b;
+    return x + y;
+}
+
+static int reuse_widths(int a)
+{
+    char c; unsigned char u; short s; unsigned short us; long long ll;
+    c = a; u = a; s = a; us = a; ll = a;
+    ll += c; ll *= 3;
+    return c + u * 3 + s * 5 + us * 7 + (int)(ll >> 1) + (int)ll;
+}
+
+static int reuse_union(int a, int b)
+{
+    union { int i; unsigned char c; short s; unsigned char b[4]; } u, w;
+    int r;
+    u.i = a;
+    r = u.c + u.s * 2;              /* narrower loads of the wider store */
+    w.i = 0;
+    w.c = b;                        /* overlapping store: the int reloads from memory */
+    r += w.i * 4;
+    w.s = b;
+    w.b[1] = a;
+    r += w.i;
+    return r;
+}
+
+static int reuse_label(int a)
+{
+    int x = a;
+lab:
+    x += 1;
+    if (x < 5) goto lab;
+    while (x < 10) x += 3;
+    return x;
+}
+
+static int reuse_cond(int c, int a, int b)
+{
+    int x = c ? a : b;
+    int y = x;
+    return x + y * (c ? 1 : 2);
+}
+
+static volatile int gvol;
+static int reuse_volatile(int a)
+{
+    volatile int v;
+    v = a;
+    gvol = v;
+    return v + gvol;
+}
+
+static int reuse_asm(int a)
+{
+    int x = a, y = a;
+#if X86
+    __asm__("movl $7,%0" : "=m"(x));
+    __asm__("" : "+m"(y));
+#else
+    x = 7;
+#endif
+    return x * 10 + y;
+}
+
+static int reuse_spill(int a, int b, int c, int d, int e, int f, int g, int h)
+{
+    int x = a * b, y = c * d, z = e * f, w = g * h;
+    return (x + y) * (z + w) + (x - y) * (z - w) + x + y + z + w;
+}
+
+static RP3 int rp_narrow(unsigned short a, signed char b, unsigned char c)
+{
+    return a * 2 + b + c;           /* the prologue saves 4 bytes, the loads are narrower */
+}
+
+static RP3 int rp_use(int a, int b, int c)
+{
+    int d = a;
+    return d + b * c + a;
+}
+
+static int reuse_float(int a)
+{
+    union { float f; int i; } u;
+    float g;
+    u.i = a;
+    g = u.f;
+    u.f = 1.5f;
+    return u.i + (int)(g * 0) + (int)(u.f * 2);
+}
+
+static int reuse_struct(int a)
+{
+    struct { short s; char c; int i; } st;
+    st.s = a; st.c = a; st.i = a;
+    return st.s + st.c * 2 + st.i * 4;
+}
+
+static int reuse_ptr(int *p, int a)
+{
+    int *q = p;
+    *q = a;
+    q = p + 1;
+    *q = a + 1;
+    return p[0] * 10 + p[1] + *q;
+}
+
+static int reuse_narrow_then_wide(int a)   /* tcc's own gjmp_addr(): r == (signed char)r */
+{
+    int r = a, s;
+    if (r == (signed char)r)
+        return 1000 + r;
+    s = a;
+    if ((unsigned char)s == s)
+        return 2000 + s;
+    s = a;
+    if ((short)s != s && s == a)
+        return 3000;
+    return 0;
+}
+
+static int reuse_short_label(short a)
+{
+    short s = a;
+    unsigned short u;
+    if (s < 0) s = -s;
+    u = s;
+    return u + s;
+}
+
+int main(void)
+{
+    int i, arr[2];
+    for (i = 0; i < 9; i += 4) {
+        P(asm_fwd(i)); P(asm_back(i)); P(asm_diff(i)); P(asm_align(i)); P(asm_cross(i, 1)); P(asm_cross(i, 2)); P(asm_section(i)); P(asm_addr(i)); P(asm_pcrel(i));
+    }
+    P(asm_goto(0)); P(asm_goto(3));
+    for (i = 0; i < 4; i++) {
+        int x = i == 0 ? 0 : i == 1 ? 0x5555 : i == 2 ? 0xaaaa : 0xffff, n = i + 1;
+        printf("loops %d: %d %d %d %d %d %d %d %d %d %d %d %d %d\n", i, loop1(x, n), loop2(x, n), loop3(x, n),
+               loop4(x, n), loop5(x, n), loop6(x, n), loop7(x, n), loop8(x, n), loop9(x, n), loop10(x, n),
+               loop12(x, n), loop14(x, n), loop16(x, n));
+    }
+    for (i = 0; i < 8; i++)
+        printf("next %d: %d\n", i, next_jmp(i));
+    P(reuse_int(3, 4)); P(reuse_int(-3, 3)); P(reuse_widths(300)); P(reuse_widths(-70000)); P(reuse_widths(0x12345678));
+    P(reuse_union(0x01020304, 0x55)); P(reuse_union(-1, 2)); P(reuse_label(0)); P(reuse_label(7));
+    P(reuse_cond(1, 3, 4)); P(reuse_cond(0, 3, 4)); P(reuse_volatile(5)); P(reuse_asm(3));
+    P(reuse_spill(1, 2, 3, 4, 5, 6, 7, 8)); P(reuse_spill(8, 7, 6, 5, 4, 3, 2, 1));
+    P(rp_narrow(70000, -1, 255)); P(rp_narrow(5, 100, 200)); P(rp_use(1, 2, 3));
+    P(reuse_float(0x3fc00000)); P(reuse_float(0)); P(reuse_struct(70000)); P(reuse_struct(-2));
+    P(reuse_ptr(arr, 5)); P(reuse_narrow_then_wide(5)); P(reuse_narrow_then_wide(200)); P(reuse_narrow_then_wide(300)); P(reuse_narrow_then_wide(70000)); P(reuse_narrow_then_wide(-5)); P(reuse_short_label(-40000)); P(reuse_short_label(123));
+    return 0;
+}

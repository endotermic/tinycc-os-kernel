+       whole function).  A jmp to the next instruction goes away. */
+    relax_saved = 1;
     do {
         changed = 0;
         for (i = 0, k = 0; i < n; i++)
@@ -303,10 +413,12 @@ static void relax_function(int frame)
             rj = &rjumps[i];
             if (rj->kind != RJ_JMP && rj->kind != RJ_JCC)
                 continue;
-            if (rj->nlen == 2)
-                continue;
+            if (rj->nlen != rj->len)
+                continue; /* already short */
             rj->nlen = 2, rj_disp(rj, &disp);
-            if (disp == (signed char)disp)
+            if (rj->kind == RJ_JMP && disp == 0)
+                rj->nlen = 0, changed = 1;
+            else if (disp == (signed char)disp)
                 changed = 1;
             else
                 rj->nlen = rj->len;
@@ -314,16 +426,16 @@ static void relax_function(int frame)
     } while (changed);
     for (i = 0, k = 0; i < n; i++)
         rjumps[i].saved = k, k += rjumps[i].len - rjumps[i].nlen;
+    relax_saved = k;
     if (k == 0)
         return;
-    relax_saved = k;
     /* every short jump still reaches its target (it does: the distances
        only shrank) */
     for (i = 0; i < n; i++) {
         rj = &rjumps[i];
-        if (rj->kind != RJ_SUB && rj->nlen == 2) {
+        if (rj->kind != RJ_SUB && rj->nlen <= 2) {

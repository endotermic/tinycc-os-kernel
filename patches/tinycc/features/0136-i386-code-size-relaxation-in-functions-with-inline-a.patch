diff --git a/i386-gen.c b/i386-gen.c
index b20ce16..d844124 100644
--- a/i386-gen.c
+++ b/i386-gen.c
@@ -153,6 +153,83 @@ static int gen_opsize16(int opc)
     return opc;
 }
 
+/* Code size: the value a register was just stored to a local with
+   (`mov %eax,-4(%ebp)`) is still in the register when the next
+   instruction loads that local, which tccgen emits for `x = e; ... x
+   ...`, for a value spilled and used at once and for the register
+   arguments the prologue of a regparm function saves: load() then emits
+   nothing, or a `mov` from that register (3 bytes instead of 5 with
+   -m16; a 1- or 2-byte local becomes a movzx/movsx from it).  The stores
+   emitted since the last other instruction are noted with the position
+   they hold at; a label (gind(), a gsym_addr() at ind: code arrives from
+   elsewhere), an asm statement and the prologue of the next function
+   forget them (gen_sync()). */
+typedef struct StoreNote { int off, reg, size; } StoreNote;
+static StoreNote st_notes[4];
+static int nb_st_notes, st_notes_ind = -1;
+
+ST_FUNC void gen_sync(void)
+{
+    nb_st_notes = 0, st_notes_ind = -1;
+}
+
+/* a store of 'size' bytes of register 'reg' to the local at 'off' was
+   emitted from 'before' to ind */
+static void st_note(int before, int reg, int off, int size)
+{
+    int i;
+    if (before == ind || size == 0)
+        return; /* nothing emitted (nocode_wanted), or not a plain store */
+    if (before != st_notes_ind)
+        nb_st_notes = 0;
+    for (i = 0; i < nb_st_notes; i++)
+        if (st_notes[i].off < off + size && off < st_notes[i].off + st_notes[i].size)
+            st_notes[i--] = st_notes[--nb_st_notes]; /* overlapping slot: the new store counts */
+    if (nb_st_notes == sizeof st_notes / sizeof st_notes[0])
+        memmove(st_notes, st_notes + 1, --nb_st_notes * sizeof st_notes[0]);
+    st_notes[nb_st_notes].off = off;
+    st_notes[nb_st_notes].reg = reg;
+    st_notes[nb_st_notes++].size = size;
+    st_notes_ind = ind;
+}
+
+/* the load of 'size' bytes of the local at 'off' into register 'r' with
+   the opcode 'opc' (0x8b, or a movzx/movsx), done from the register that
+   holds the value when one does (a wider store serves a narrower load at
+   the same offset: little endian): returns 1 then */
+static int st_reuse(int r, int off, int size, int opc)
+{
+    int i, j, k, reg;
+    if (ind != st_notes_ind || size == 0)
+        return 0;
+    for (i = 0; i < nb_st_notes; i++) {
+        if (st_notes[i].off != off || st_notes[i].size < size)
+            continue;
+        reg = st_notes[i].reg;
+        if (reg == r && size == 4)
+            return 1; /* the register still holds it */
+        opc = gen_opsize16(opc);
+        o(opc);
+        o(0xc0 | r << 3 | reg); /* mov/movzx/movsx reg, r */
+        /* the slots stored from r hold its old value now, except this
+           one: the extension of r's own low bytes leaves them as they
+           are, but only those (`r == (signed char)r` with r just stored:
+           the full-width load of r that follows must not take r) */
+        for (j = k = 0; j < nb_st_notes; j++) {
+            if (j == i) {
+                if (reg == r && size < st_notes[j].size)
+                    st_notes[j].size = size;
+                st_notes[k++] = st_notes[j];
+            } else if (st_notes[j].reg != r)
+                st_notes[k++] = st_notes[j];
+        }
+        nb_st_notes = k;
+        st_notes_ind = ind;
+        return 1;
+    }
+    return 0;
+}
+
 /* Code size: the jumps of a function are relaxed to their short forms
    when the function is complete (gfunc_epilog).  gjmp()/gjmp_cond() emit
    the rel32 forms (5/6 bytes, one more with -m16), since the target of a
@@ -164,9 +241,17 @@ static int gen_opsize16(int opc)
    displacement fits once the ones before them have shrunk, moves the code,
    and patches the displacements, the relocations and the symbols inside the
    function.  tccdbg.c maps its line and scope addresses through
-   gen_relax_map().  Not done when the function has inline asm (the
-   assembler resolves its own displacements and defines its own symbols:
-   func_asm_seen) or bounds checking (fixed offsets patched later). */
+   gen_relax_map().  An asm statement of the function leaves relocations
+   and symbols for its forward references, patched like the compiler's
+   own (a local label keeps its symbol until the end of the file while
+   its function may still be relaxed: gen_relax_active(), asked by
+   asm_fixup_local_label_relocs() before it makes the relocation
+   section-relative); when the assembler instead folds an address of the function's section
+   into the code (a displacement to a label it has already defined, the
+   difference of two labels, .org) or aligns in it, the bytes moved
+   would make it wrong, so tccasm.c and i386-asm.c report that
+   (gen_relax_asm_fixed()) and the function is not relaxed; nor is one
+   with bounds checking (fixed offsets patched later). */
 enum { RJ_JMP, RJ_JCC, RJ_SHORT, RJ_SUB };
 typedef struct RelaxJump {
     int pos;    /* offset of the instruction (prefix included) */
@@ -180,13 +265,16 @@ typedef struct RelaxJump {
 static RelaxJump *rjumps;
 static int nb_rjumps, nb_rjumps_alloc;
 static int relax_off;      /* no relaxation for this function */
+static Section *relax_sec; /* the section of the function being compiled */
 static int relax_start, relax_end, relax_saved; /* of the last relaxed function */
 
 static void rj_reset(void)
 {
     nb_rjumps = 0;
     relax_saved = 0;
-    relax_off = func_asm_seen;
+    relax_off = 0;
+    relax_sec = cur_text_section;
+    gen_sync();
 #ifdef CONFIG_TCC_BCHECK
     if (tcc_state->do_bounds_check)
         relax_off = 1;
@@ -220,6 +308,21 @@ ST_FUNC void gen_relax_free(void)
     nb_rjumps = nb_rjumps_alloc = 0;
 }
 
+/* the assembler wrote an address of section sh_num into the code that
+   relax_function() would move (see above) */
+ST_FUNC void gen_relax_asm_fixed(int sh_num)
+{
+    if (relax_sec && sh_num == relax_sec->sh_num)
+        relax_off = 1;
+}
+
+/* whether a label of section sh_num may still move: the function being
+   compiled into it is relaxed at its end */
+ST_FUNC int gen_relax_active(int sh_num)
+{
+    return relax_sec && sh_num == relax_sec->sh_num && !relax_off;
+}
+
 /* the offset 'off' of the function before its relaxation, after it (the
    identity outside the function, or when nothing was relaxed) */
 ST_FUNC int gen_relax_map(int off)
@@ -270,7 +373,8 @@ static void relax_function(int frame)
     ElfW(Sym) *sym, *sym_end;
 
     relax_start = start, relax_end = end, relax_saved = 0;
-    if (relax_off || func_asm_seen || n == 0 || nocode_wanted)
+    relax_sec = NULL;
+    if (relax_off || n == 0 || nocode_wanted)
         return;
     for (i = 0; i < n; i++) {
         rj = &rjumps[i];
@@ -294,7 +398,13 @@ static void relax_function(int frame)
     }
     /* a long jump shrinks when its displacement fits rel8; what the ones
        before it save moves its target closer, hence the iteration (the
-       displacements only ever shrink, so the result is a fixed point) */
+       displacements only ever shrink, so the result is a fixed point).
+       gen_relax_map() maps the targets by the current nlen/saved once
+       relax_saved is set (the count is final below; until 2026-11-10 it
+       was 0 here, the targets stayed unmapped, backward jumps looked

-            if (disp != (signed char)disp) {
+            if (rj->nlen == 0 ? disp != 0 : disp != (signed char)disp) {
                 relax_saved = 0;
                 return;
             }
@@ -351,7 +463,9 @@ static void relax_function(int frame)
         } else {
             rj_disp(rj, &disp);
             k = dst;
-            if (rj->nlen == 2) {
+            if (rj->nlen == 0) {
+                /* removed */
+            } else if (rj->nlen == 2) {
                 d[k++] = rj->kind == RJ_JCC ? rj->cc - 0x10 : 0xeb;
                 d[k++] = disp;
             } else {
@@ -432,6 +546,8 @@ ST_FUNC void gen_le32(int c)
 /* output a symbol and patch all calls to it */
 ST_FUNC void gsym_addr(int t, int a)
 {
+    if (t && a == ind)
+        gen_sync(); /* a jump arrives here */
     while (t) {
         unsigned char *ptr = cur_text_section->data + t;
         uint32_t n = read32le(ptr); /* next value */
@@ -520,9 +636,19 @@ ST_FUNC void gen_addrpc32(int r, Sym *sym, int c)
    opcode bits */
 static void gen_modrm(int opc, int op_r2, int r, Sym *sym, int c)
 {
-    int op_reg = REG_VALUE(op_r2) << 3;
-
-    o67(); /* all memory operands use 32-bit addressing */
+    int op_reg = REG_VALUE(op_r2) << 3, abs16 = 0;
+
+    /* -m16: memory operands use 32-bit addressing (0x67), except an
+       absolute address, which takes the 16-bit form (modrm 0x06, an
+       R_386_16 relocation) as GNU as's .code16gcc gives it: such code
+       is linked below 64 KB (the kernel's real-mode setup) */
+    if (M16 && (r & (VT_VALMASK | VT_SYM)) == (VT_CONST | VT_SYM)
+        && !(sym->type.t & VT_TLS) && !PIC)
+        abs16 = 1;
+    else if (M16 && (r & VT_VALMASK) == VT_CONST && (unsigned)c <= 0xffff)
+        abs16 = 1;
+    else
+        o67();
     opc = gen_opsize16(opc);
     if ((r & VT_SYM) && (sym->type.t & VT_TLS)) {
 #ifdef TCC_TARGET_PE
@@ -566,6 +692,11 @@ static void gen_modrm(int opc, int op_r2, int r, Sym *sym, int c)
         if (PIC && (r & VT_SYM)) {
             o(0x83 | op_reg); /* sym@GOTOFF(%ebx) */
             gen_gotoff32(sym, c);
+        } else if (abs16) {
+            o(0x06 | op_reg);
+            if (r & VT_SYM)
+                greloc(cur_text_section, sym, ind, R_386_16);
+            gen_le16(c);
         } else {

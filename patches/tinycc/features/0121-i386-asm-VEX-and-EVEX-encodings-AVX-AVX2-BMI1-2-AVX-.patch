--- a/x86_64-asm.h
+++ b/x86_64-asm.h
@@ -708,6 +708,251 @@ ALT(DEF_ASM_OP2(invpcid, 0x6682, 0, OPC_MODRM | OPC_0F38, OPT_EA, OPT_REG32))
     DEF_ASM_OP3(pclmulqdq, 0x6644, 0, OPC_MODRM | OPC_0F3A, OPT_IM8, OPT_EA | OPT_SSE, OPT_SSE)

 #define TOK_ASM_first TOK_ASM_clc
 #define TOK_ASM_last TOK_ASM_emms
-#define TOK_ASM_alllast TOK_ASM_subps
+#define TOK_ASM_alllast TOK_ASM_endbr32 /* the last entry of x86_64-asm.h */
 
 #define OPC_B          0x01  /* only used with OPC_WL */
 #define OPC_WL         0x02  /* accepts w, l or no suffix */
@@ -55,6 +55,12 @@
 /* code-mode restrictions (checked against TCCState.seg_size at match time) */
 #define OPC_NO64    0x10000 /* not encodable in 64-bit mode */
 #define OPC_ONLY64  0x20000 /* needs 64-bit mode (also implied by OPC_48) */
+/* AVX: VEX- and EVEX-encoded entries (asm_vex_prefix) */
+#define OPC_VEX     0x40000 /* VEX prefix (2- or 3-byte form) instead of 0x66/0xf3/0xf2, REX, 0x0f */
+#define OPC_EVEX    0x80000 /* 4-byte EVEX prefix (AVX-512VL, no masking/broadcast) */
+#define OPC_NDD    0x100000 /* VEX.vvvv is the destination, ModRM.reg the group (shift by imm8) */
+#define OPC_VEXL   0x200000 /* VEX.L = 1 without a ymm operand (vzeroall) */
+#define OPC_VEXW   0x400000 /* VEX.W = 1 in every mode (OPC_48 means W too, 64-bit mode only) */
 
 #define OPC_GROUP_SHIFT 13
 
@@ -103,15 +109,17 @@ enum {
     OPT_DX,     /* %dx register */
     OPT_ADDR,   /* OP_EA with only offset */
     OPT_INDIR,  /* *(expr) */
-    /* composite types */
+    OPT_YMM,    /* %ymm0-15 (AVX; the 256-bit form of an xmm register) */
+    /* composite types (the 5-bit template field holds values up to 31) */
     OPT_COMPOSITE_FIRST,
-    OPT_IM,     /* IM8 | IM16 | IM32 */
+    OPT_IM = OPT_COMPOSITE_FIRST, /* IM8 | IM16 | IM32 */
     OPT_REG,    /* REG8 | REG16 | REG32 | REG64 */
     OPT_REGW,   /* REG16 | REG32 | REG64 */
     OPT_IMW,    /* IM16 | IM32 */
     OPT_MMXSSE, /* MMX | SSE */
     OPT_DISP,   /* Like OPT_ADDR, but emitted as displacement (for jumps) */
     OPT_DISP8,  /* Like OPT_ADDR, but only 8bit (short jumps) */
+    OPT_VEC,    /* SSE | YMM: an xmm or ymm register (VEX.L from the operand) */
     /* can be ored with any OPT_xxx */
     OPT_EA = 0x80
 };
@@ -121,6 +129,7 @@ enum {
 #define OP_REG32  (1 << OPT_REG32)
 #define OP_MMX    (1 << OPT_MMX)
 #define OP_SSE    (1 << OPT_SSE)
+#define OP_YMM    (1 << OPT_YMM)
 #define OP_CR     (1 << OPT_CR)
 #define OP_TR     (1 << OPT_TR)
 #define OP_DB     (1 << OPT_DB)
@@ -239,6 +248,7 @@ static const ASMInstr asm_instrs[] = {
 #define DEF_ASM_OP1(name, opcode, group, instr_type, op0) { TOK_ASM_ ## name, O(opcode), T(opcode, instr_type, group), 1, { op0 }},
 #define DEF_ASM_OP2(name, opcode, group, instr_type, op0, op1) { TOK_ASM_ ## name, O(opcode), T(opcode, instr_type, group), 2, { op0, op1 }},
 #define DEF_ASM_OP3(name, opcode, group, instr_type, op0, op1, op2) { TOK_ASM_ ## name, O(opcode), T(opcode, instr_type, group), 3, { op0, op1, op2 }},
+#define DEF_ASM_OP4(name, opcode, group, instr_type, op0, op1, op2, op3) { TOK_ASM_ ## name, O(opcode), T(opcode, instr_type, group), 4, { op0, op1, op2, op3 }},
 # include "x86_64-asm.h"
     /* last operation */
     { 0, },
@@ -251,6 +261,7 @@ static const uint16_t op0_codes[] = {
 #define DEF_ASM_OP1(name, opcode, group, instr_type, op0)
 #define DEF_ASM_OP2(name, opcode, group, instr_type, op0, op1)
 #define DEF_ASM_OP3(name, opcode, group, instr_type, op0, op1, op2)
+#define DEF_ASM_OP4(name, opcode, group, instr_type, op0, op1, op2, op3)
 # include "x86_64-asm.h"
 };
 
@@ -476,6 +487,11 @@ static void parse_operand(TCCState *s1, Operand *op)
             op->type = OP_SSE;
             op->reg = 8 + tok - TOK_ASM_xmm8;
             check_reg64(tok);
+        } else if (tok >= TOK_ASM_ymm0 && tok <= TOK_ASM_ymm15) {
+            op->type = OP_YMM;
+            op->reg = tok - TOK_ASM_ymm0;
+            if (op->reg >= 8)
+                check_reg64(tok);
         } else if ((op->reg = asm_parse_numeric_reg(tok, &op->type)) >= 0) {
             check_reg64(tok);
         } else {
@@ -704,12 +720,30 @@ static void gen_disp32(ExprValue *pe)
     }
 }
 
+/* EVEX scales an 8-bit displacement by the memory operand's size N
+   (disp8*N; set around asm_modrm by asm_opcode, 0 for every other
+   encoding): the short form applies when the displacement is a multiple
+   of N whose quotient fits a byte */
+static int evex_disp8_n;
+
+static int disp8_fits(uint64_t v, int *d8)
+{
+    int64_t d = v;
+    if (evex_disp8_n) {
+        if (d % evex_disp8_n)
+            return 0;
+        d /= evex_disp8_n;
+    }
+    *d8 = d;
+    return d == (int8_t)d;
+}
+
 /* generate the modrm operand */
 static inline int asm_modrm(int reg, Operand *op)
 {
-    int mod, reg1, reg2, sib_reg1;
+    int mod, reg1, reg2, sib_reg1, d8 = 0;
 
-    if (op->type & (OP_REG | OP_MMX | OP_SSE)) {
+    if (op->type & (OP_REG | OP_MMX | OP_SSE | OP_YMM)) {
         g(0xc0 + (reg << 3) + op->reg);
     } else if (op->reg == -1 && op->reg2 == -1) {
         /* displacement only: 64-bit code needs the SIB form (modrm 05 is
@@ -739,7 +773,7 @@ static inline int asm_modrm(int reg, Operand *op)
             mod = 0x00;
         } else if (op->e.v == 0 && !op->e.sym && op->reg != 5) {
             mod = 0x00;
-        } else if (op->e.v == (int8_t)op->e.v && !op->e.sym) {
+        } else if (!op->e.sym && disp8_fits(op->e.v, &d8)) {
             mod = 0x40;
         } else {
             mod = 0x80;
@@ -758,7 +792,7 @@ static inline int asm_modrm(int reg, Operand *op)
         }
         /* add offset */
         if (mod == 0x40) {
-            g(op->e.v);
+            g(d8);
         } else if (mod == 0x80 || op->reg == -1) {
 	    gen_expr32(&op->e);
         }
@@ -766,6 +800,34 @@ static inline int asm_modrm(int reg, Operand *op)
     return 0;
 }
 
+/* The VEX or EVEX prefix of an AVX instruction (OPC_VEX / OPC_EVEX
+   entries): map 1/2/3 = 0F/0F38/0F3A, pp 0-3 = none/66/F3/F2, W, L (1 for
+   ymm), the REX-like register extension bits R, X, B (the register fields
+   come stripped of them) and vvvv, the extra source register (-1 when the
+   field is unused).  The fields are stored inverted, as the manual has it. */
+static void asm_vex_prefix(int evex, int map, int pp, int w, int l,
+                           int r, int x, int b, int vvvv)
+{
+    int vv = vvvv < 0 ? 0xf : (~vvvv) & 0xf;
+    if (evex) {
+        /* 62 | R X B R' 0 0 m m | W vvvv 1 pp | z L'L b V' aaa: no masking,
+           no broadcast or rounding, registers below 16 (R' = V' = 1) */
+        g(0x62);
+        g(((r ^ 1) << 7) | ((x ^ 1) << 6) | ((b ^ 1) << 5) | 0x10 | map);
+        g((w << 7) | (vv << 3) | 0x04 | pp);
+        g((l << 5) | 0x08);
+    } else if (map == 1 && !x && !b && !w) {
+        /* C5 | R vvvv L pp */
+        g(0xc5);
+        g(((r ^ 1) << 7) | (vv << 3) | (l << 2) | pp);
+    } else {
+        /* C4 | R X B mmmmm | W vvvv L pp */
+        g(0xc4);
+        g(((r ^ 1) << 7) | ((x ^ 1) << 6) | ((b ^ 1) << 5) | map);
+        g((w << 7) | (vv << 3) | (l << 2) | pp);
+    }
+}
+
 #define REX_W 0x48
 #define REX_R 0x44
 #define REX_X 0x42
@@ -952,13 +1014,15 @@ ST_FUNC void asm_opcode(TCCState *s1, int opcode)
     Operand ops[MAX_OPERANDS], *pop;
     int trunc_type[MAX_OPERANDS];   /* immediates truncated to the operand size */
     uint64_t trunc_val[MAX_OPERANDS];
-    int op_type[3]; /* decoded op type */
+    int op_type[MAX_OPERANDS]; /* decoded op type */
     int alltypes;   /* OR of all operand types */
     int autosize;
     int p66, opsize, addr32, disp16;
     int rex64;
+    int vex, vex_pp, vvvv_index; /* VEX/EVEX entries: OPC_VEX | OPC_EVEX, the pp field, the vvvv operand */
 
     maybe_print_stats();
+    evex_disp8_n = 0;
 #ifndef TCC_TARGET_X86_64
     asm_insn_start = ind;
 #endif
@@ -1145,6 +1209,9 @@ again:
 	    case OPT_MMXSSE:
 		v = OP_MMX | OP_SSE;
 		break;
+            case OPT_VEC:
+                v = OP_SSE | OP_YMM;
+                break;
 	    case OPT_DISP:
 	    case OPT_DISP8:
 		v = OP_ADDR;
@@ -1271,6 +1338,11 @@ again:
     if ((alltypes & (OP_CR | OP_DB | OP_TR)) || (pa->opcode == 0x8e && !(pa->instr_type & OPC_0F))
         || (pa->opcode == 0x8c && !(pa->instr_type & OPC_0F) && (alltypes & OP_EA)))
         opsize = -1;    /* mov %sreg, mem: a 16-bit store, no prefix (GNU as) */
+    /* a VEX/EVEX entry: no operand-size or mandatory prefix, no REX; its
+       0x66/0xf3/0xf2 is the pp field, its 64-bit form the W bit */
+    vex = pa->instr_type & (OPC_VEX | OPC_EVEX);
+    if (vex)
+        opsize = -1;
 
     rex64 = 0;
     if (!CODE64)
@@ -1318,6 +1390,11 @@ again:
             addr32 = 1;
     v = pa->opcode;
     p = v >> 8;  /* possibly prefix byte(s) */
+    vex_pp = 0;
+    if (vex) {
+        vex_pp = p == 0x66 ? 1 : p == 0xf3 ? 2 : p == 0xf2 ? 3 : 0;
+        v &= 0xff, p = 0;
+    }
     /* a 0x66 in the table: the mandatory prefix of an SSE instruction, or
        a 16-bit operation (handled as an operand size) */
     p66 = 0;
@@ -1356,35 +1433,37 @@ again:
         case 0xdc: case 0xdd: case 0xde: case 0xdf: break;
         default: tcc_error("bad prefix 0x%2x in opcode table", p); break;
     }
-    if (pa->instr_type & OPC_0F)
-        v = ((v & ~0xff) << 8) | 0x0f00 | (v & 0xff);
-    else if (pa->instr_type & (OPC_0F38 | OPC_0F3A))
-        /* here, so that the special cases below do not see e.g. pshufb's 0x00 */
-        v |= pa->instr_type & OPC_0F38 ? 0x0f3800 : 0x0f3a00;
-    if ((v == 0x69 || v == 0x6b) && nb_ops == 2) {
-        /* kludge for imul $im, %reg */
-        nb_ops = 3;
-        ops[2] = ops[1];
-        op_type[2] = op_type[1];
-    } else if (v == 0xcd && ops[0].e.v == 3 && !ops[0].e.sym) {
-        v--; /* int $3 case */
-        nb_ops = 0;
-    } else if ((v == 0x06 || v == 0x07)) {
-        if (ops[0].reg >= 4) {
-            /* push/pop %fs or %gs */
-            v = 0x0fa0 + (v - 0x06) + ((ops[0].reg - 4) << 3);
-        } else {
-            if (CODE64)
-                tcc_error("push/pop of %%es, %%cs, %%ss or %%ds in 64-bit code");
-            v += ops[0].reg << 3;
+    if (!vex) {
+        if (pa->instr_type & OPC_0F)
+            v = ((v & ~0xff) << 8) | 0x0f00 | (v & 0xff);
+        else if (pa->instr_type & (OPC_0F38 | OPC_0F3A))
+            /* here, so that the special cases below do not see e.g. pshufb's 0x00 */
+            v |= pa->instr_type & OPC_0F38 ? 0x0f3800 : 0x0f3a00;
+        if ((v == 0x69 || v == 0x6b) && nb_ops == 2) {
+            /* kludge for imul $im, %reg */
+            nb_ops = 3;
+            ops[2] = ops[1];
+            op_type[2] = op_type[1];
+        } else if (v == 0xcd && ops[0].e.v == 3 && !ops[0].e.sym) {
+            v--; /* int $3 case */
+            nb_ops = 0;
+        } else if ((v == 0x06 || v == 0x07)) {
+            if (ops[0].reg >= 4) {
+                /* push/pop %fs or %gs */
+                v = 0x0fa0 + (v - 0x06) + ((ops[0].reg - 4) << 3);
+            } else {
+                if (CODE64)
+                    tcc_error("push/pop of %%es, %%cs, %%ss or %%ds in 64-bit code");
+                v += ops[0].reg << 3;
+            }
+            nb_ops = 0;
+        } else if (v <= 0x05) {
+            /* arith case */
+            v += ((opcode - TOK_ASM_addb) / NBWLX) << 3;
+        } else if ((pa->instr_type & (OPCT_MASK | OPC_MODRM)) == OPC_FARITH) {
+            /* fpu arith case */
+            v += ((opcode - pa->sym) / 6) << 3;
         }
-        nb_ops = 0;
-    } else if (v <= 0x05) {
-        /* arith case */
-        v += ((opcode - TOK_ASM_addb) / NBWLX) << 3;
-    } else if ((pa->instr_type & (OPCT_MASK | OPC_MODRM)) == OPC_FARITH) {
-        /* fpu arith case */
-        v += ((opcode - pa->sym) / 6) << 3;
     }
 
     /* search which operand will be used for modrm */
@@ -1432,8 +1511,56 @@ again:
             }
         }
     }
-    if (CODE64)
+    /* a VEX/EVEX entry, in AT&T order (sources first): ModRM.r/m is the
+       template's memory-capable operand (a register in the register form of
+       a load or store too), else the first register operand; ModRM.reg is
+       the last register operand, the destination, unless the reg field is an
+       opcode extension (OPC_NDD: the destination goes to VEX.vvvv); VEX.vvvv
+       is the register operand left, the first source of a three-operand
+       instruction (the count of shlx, the first source of andn) */
+    vvvv_index = -1;
+    if (vex && (pa->instr_type & OPC_MODRM)) {
+        modrm_index = modreg_index = -1;
+        for(i = 0; i < nb_ops; i++)
+            if (op_type[i] & OP_EA) {
+                modrm_index = i;
+                break;
+            }
+        for(i = 0; modrm_index < 0 && i < nb_ops; i++)
+            if (op_type[i] & (OP_REG | OP_SSE | OP_YMM))
+                modrm_index = i;
+        for(i = nb_ops - 1; i >= 0; i--) {
+            if (i == modrm_index || !(op_type[i] & (OP_REG | OP_SSE | OP_YMM)))
+                continue;
+            if (modreg_index < 0 && !(pa->instr_type & OPC_NDD))
+                modreg_index = i;
+            else if (vvvv_index < 0)
+                vvvv_index = i;
+            else
+                tcc_error("too many register operands");
+        }
+    }
+    if (CODE64 && !vex)
         asm_rex (rex64, ops, nb_ops, op_type, modreg_index, modrm_index);
+    if (vex) {
+        int r = 0, x = 0, b = 0, w, l, map, vv = -1;
+        if (modreg_index >= 0 && ops[modreg_index].reg >= 8)
+            r = 1, ops[modreg_index].reg -= 8;
+        if (modrm_index >= 0) {
+            if (ops[modrm_index].reg >= 8)
+                b = 1, ops[modrm_index].reg -= 8;
+            if ((ops[modrm_index].type & OP_EA) && ops[modrm_index].reg2 >= 8)
+                x = 1, ops[modrm_index].reg2 -= 8;
+        }
+        if (vvvv_index >= 0)
+            vv = ops[vvvv_index].reg;
+        w = (pa->instr_type & (OPC_48 | OPC_VEXW)) || (alltypes & OP_REG64);
+        l = (pa->instr_type & OPC_VEXL) || (alltypes & OP_YMM);
+        map = pa->instr_type & OPC_0F38 ? 2 : pa->instr_type & OPC_0F3A ? 3 : 1;
+        asm_vex_prefix(vex & OPC_EVEX, map, vex_pp, w != 0, l != 0, r, x, b, vv);
+        if (vex & OPC_EVEX)
+            evex_disp8_n = 16 << (l != 0); /* full-vector memory operands (tuple type Full) */
+    }
 
     if (pa->instr_type & OPC_REG) {
         /* mov $im, %reg case */
@@ -1515,6 +1642,7 @@ again:
 	if (modreg_index >= 0)
 	    reg = ops[modreg_index].reg;
         pc = asm_modrm(reg, &ops[modrm_index]);
+        evex_disp8_n = 0;
     }
 
     /* emit constants */
diff --git a/i386-tok.h b/i386-tok.h

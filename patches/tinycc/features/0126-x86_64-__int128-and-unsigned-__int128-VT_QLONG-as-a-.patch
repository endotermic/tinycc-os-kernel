diff --git a/lib/libtcc1.c b/lib/libtcc1.c
index 878f951..7035ee7 100644
--- a/lib/libtcc1.c
+++ b/lib/libtcc1.c
@@ -476,6 +476,89 @@ long long __ashldi3(long long a, int b)
 
 #endif /* __i386__ */
 
+#if defined __x86_64__ && defined __SIZEOF_INT128__
+/* 128-bit division and modulo for tcc's __int128 (x86-64).  A 16-byte
+   structure of two words is passed and returned like unsigned __int128
+   under the SysV ABI (two integer registers, %rax:%rdx for the result),
+   so these are written in 64-bit arithmetic and need no __int128 of
+   their own.  Shifts and multiplies are inline in the compiler. */
+typedef struct { unsigned long long lo, hi; } TWtype;
+
+static TWtype __udivmodti4(TWtype n, TWtype d, TWtype *rem)
+{
+    TWtype q, r;
+    int i;
+
+    q.lo = q.hi = r.lo = r.hi = 0;
+    if (n.hi == 0 && d.hi == 0) {
+        q.lo = n.lo / d.lo;
+        r.lo = n.lo % d.lo;
+    } else {
+        /* binary long division, one bit a step */
+        for (i = 127; i >= 0; i--) {
+            r.hi = (r.hi << 1) | (r.lo >> 63);
+            r.lo = (r.lo << 1) | ((i >= 64 ? n.hi >> (i - 64) : n.lo >> i) & 1);
+            if (r.hi > d.hi || (r.hi == d.hi && r.lo >= d.lo)) {
+                unsigned long long t = r.lo - d.lo;
+                r.hi = r.hi - d.hi - (r.lo < d.lo);
+                r.lo = t;
+                if (i >= 64)
+                    q.hi |= 1ULL << (i - 64);
+                else
+                    q.lo |= 1ULL << i;
+            }
+        }
+    }
+    if (rem)
+        *rem = r;
+    return q;
+}
+
+static TWtype __negti(TWtype a)
+{
+    TWtype r;
+    r.lo = -a.lo;
+    r.hi = ~a.hi + (a.lo == 0);
+    return r;
+}
+
+TWtype __udivti3(TWtype n, TWtype d)
+{
+    return __udivmodti4(n, d, 0);
+}
+
+TWtype __umodti3(TWtype n, TWtype d)
+{
+    TWtype r;
+    __udivmodti4(n, d, &r);
+    return r;
+}
+
+TWtype __divti3(TWtype n, TWtype d)
+{
+    int neg = 0;
+    TWtype q;
+    if ((long long)n.hi < 0)
+        n = __negti(n), neg ^= 1;
+    if ((long long)d.hi < 0)
+        d = __negti(d), neg ^= 1;
+    q = __udivmodti4(n, d, 0);
+    return neg ? __negti(q) : q;
+}
+
+TWtype __modti3(TWtype n, TWtype d)
+{
+    int neg = 0;
+    TWtype r;
+    if ((long long)n.hi < 0)
+        n = __negti(n), neg = 1;
+    if ((long long)d.hi < 0)
+        d = __negti(d);
+    __udivmodti4(n, d, &r);
+    return neg ? __negti(r) : r;
+}
+#endif /* __x86_64__ */
+
 /* XXX: fix tcc's code generator to do this instead */
 float __floatundisf(unsigned long long a)
 {

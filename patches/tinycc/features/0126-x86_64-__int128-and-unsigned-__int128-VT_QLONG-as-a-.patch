 /* normalize values */
 static uint64_t value64(uint64_t l1, int t)
 {
     if ((t & VT_BTYPE) == VT_LLONG
+        || (t & VT_BTYPE) == VT_QLONG
         || (PTR_SIZE == 8 && (t & VT_BTYPE) == VT_PTR))
         return l1;
     else if (t & VT_UNSIGNED)
@@ -2657,6 +2716,105 @@ static int gen_opic_lt(uint64_t a, uint64_t b)
     return (a ^ (uint64_t)1 << 63) < (b ^ (uint64_t)1 << 63);
 }
 
+#ifdef TCC_HAS_INT128
+/* An __int128 constant is kept as its low 64 bits, the high word being
+   their sign (so every constant of long long and below is exact, and an
+   unsigned 128-bit constant at or above 2^63 cannot be one).  Fold the
+   operation of two such constants when the result is exact in that form;
+   return 0 when it is not (or the division is undefined), so that the
+   operation is computed at run time instead. */
+static int fold_int128(int op, uint64_t *pl1, uint64_t l2)
+{
+    uint64_t l1 = *pl1, r;
+    int64_t a = l1, b = l2;
+    int c;
+
+    switch (op) {
+    case '+':
+        r = l1 + l2;
+        if ((int64_t)((l1 ^ r) & (l2 ^ r)) < 0)
+            return 0;
+        break;
+    case '-':
+        r = l1 - l2;
+        if ((int64_t)((l1 ^ l2) & (l1 ^ r)) < 0)
+            return 0;
+        break;
+    case '*':
+        r = l1 * l2;
+        if (b == -1 ? a == INT64_MIN : b && (int64_t)r / b != a)
+            return 0;
+        break;
+    case '&': r = l1 & l2; break;
+    case '^': r = l1 ^ l2; break;
+    case '|': r = l1 | l2; break;
+    case '/':
+    case TOK_PDIV:
+        if (b == 0 || (a == INT64_MIN && b == -1))
+            return 0;
+        r = a / b;
+        break;
+    case '%':
+        if (b == 0)
+            return 0;
+        r = b == -1 ? 0 : a % b;
+        break;
+    case TOK_UDIV:
+    case TOK_UMOD:
+        /* with a negative word the value is above 2^127 */
+        if (b <= 0 || a < 0)
+            return 0;
+        r = op == TOK_UDIV ? l1 / l2 : l1 % l2;
+        break;
+    case TOK_SHL:
+        c = l2 & 127;
+        if (c >= 64) {
+            if (l1)
+                return 0;
+            r = 0;
+        } else {
+            r = l1 << c;
+            if ((int64_t)r >> c != a)
+                return 0;
+        }
+        break;
+    case TOK_SHR:
+        c = l2 & 127;
+        if (c == 0)
+            r = l1;
+        else if (a >= 0)
+            r = c >= 64 ? 0 : l1 >> c;
+        else if (c <= 64) /* the ones of the high word come down */
+            return 0;
+        else
+            r = ~(uint64_t)0 >> (c - 64);
+        break;
+    case TOK_SAR:
+        c = l2 & 127;
+        r = c >= 64 ? -(l1 >> 63) : (uint64_t)(a >> c);
+        break;
+        /* the order of the sign-extended words is the order of the
+           values, signed and unsigned alike */
+    case TOK_ULT: r = l1 < l2; break;
+    case TOK_UGE: r = l1 >= l2; break;
+    case TOK_EQ: r = l1 == l2; break;
+    case TOK_NE: r = l1 != l2; break;
+    case TOK_ULE: r = l1 <= l2; break;

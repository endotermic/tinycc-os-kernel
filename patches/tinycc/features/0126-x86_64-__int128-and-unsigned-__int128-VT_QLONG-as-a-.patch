+/* Two-word integers: on 32-bit targets a long long is held in two int
+   registers (r, r2) and its operations are built from int operations
+   (gen_opw(), lexpand(), lbuild()); on x86-64 the same machinery gives
+   __int128 (VT_QLONG) from two long long words.  VT_WORD2 is the two-word
+   type, VT_WORD1 the type of a word, WORD1_BITS its width. */
+#if PTR_SIZE == 4
+# define TCC_TWO_WORDS 1

+# define WORD1_BITS 64
+# define TOK___divw3 TOK___divti3
+# define TOK___modw3 TOK___modti3
+# define TOK___udivw3 TOK___udivti3
+# define TOK___umodw3 TOK___umodti3
+#endif
+

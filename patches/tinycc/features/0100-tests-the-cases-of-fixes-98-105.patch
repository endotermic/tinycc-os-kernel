 #include <stdio.h>
@@ -18,9 +18,16 @@ static struct pair RP ret_struct(int a, int b) { struct pair p = { a, b }; retur
 static struct triple RP ret_struct3(int a, int b, int c) { struct triple t = { a, b, c }; return t; }
 static int RP recurse(int n, int acc, int step) { return n ? recurse(n - 1, acc + step, step) : acc; }
 static char RP chars(char a, short b, unsigned char c) { return a + b + c; }
+/* fix 105: floating point arguments take no register and stop nothing,
+   variadic functions take everything on the stack */
+static double RP dbl_arg(int a, double d, int b) { return a * 100 + d + b * 10; }
+static float RP flt_arg(float f, int a, long long b, int c) { return f + a + b + c; }
+static long double RP ld_arg(int a, long double x, int b) { return a * x + b; }
+static int RP variadic(int n, ...) { __builtin_va_list ap; int s = 0; __builtin_va_start(ap, n); while (n--) s += __builtin_va_arg(ap, int); __builtin_va_end(ap); return s; }
 
 /* fix 88: indirect regparm calls */
 struct ops { int (RP *read)(int, int, int); int pad; };
+static double (RP *fp_dbl)(int, double, int) = dbl_arg;
 static struct ops ops_global = { add3, 0 };

     printf("x87: %.1Lf %.1Lf %lld", x, r, i);
 #ifdef __x86_64__
-    asm("" : : "X"(d), "X"(k));
     asm("sqrtsd %1, %0" : "=x"(sq) : "x"(d));
     asm("cvtsd2si %1, %0" : "=r"(k) : "x"(sq * 100) : "xmm0", "xmm7");
     printf(" sse: %.2f %d", sq, k);
@@ -217,6 +223,21 @@ static void test_comba(void)
 static void test_comba(void) { printf("comba: 2 fffffffa 3\n"); }
 #endif
 
+/* fix 93, 103, 104: a rel8-only jump to a label defined later (an 8-bit
+   relocation through tcc's linker, from a statement far into .text) */
+static int test_jcxz(int c)
+{
+    int r = 7;
+#ifdef __x86_64__
+    asm volatile("jrcxz 1f\n\tmovl $1, %0\n1:" : "+r"(r) : "c"((long)c));
+    asm volatile("loop 1f\n\tmovl $0, %0\n1:" : "+r"(r) : "c"((long)c + 1));
+#else
+    asm volatile("jecxz 1f\n\tmovl $1, %0\n1:" : "+r"(r) : "c"(c));
+    asm volatile("loop 1f\n\tmovl $0, %0\n1:" : "+r"(r) : "c"(c + 1));
+#endif
+    return r;
+}
+
 int main(void)
 {
     char stack_var;
@@ -233,5 +254,6 @@ int main(void)
     test_fp();
     printf("clobbers: %d\n", test_clobbers(21));
     test_comba();
+    printf("jcxz: %d %d %d\n", test_jcxz(0), test_jcxz(1), test_jcxz(2));
     return 0;
 }

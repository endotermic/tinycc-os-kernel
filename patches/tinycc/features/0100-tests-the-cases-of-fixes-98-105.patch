-/* fix 49, 50, 57: 64-bit immediates */
+/* fix 49, 50, 57: 64-bit immediates; fix 100: a constant prints in the
+   width of its type, signed, as gcc prints it */
 static void test_imm64(void)
 {
+    int e, f;
 #ifdef __x86_64__
-    unsigned long a, b, c;
+    unsigned long a, b, c, d;
     asm("movq %1, %0" : "=r"(a) : "i"(0x0123456789abcdefull));
     asm("movq %1, %0" : "=r"(b) : "i"(0x80000000ul));
     asm("movabsq $0x1122334455667788, %0" : "=r"(c));
-    printf("imm64: %lx %lx %lx\n", a, b, c);
+    asm("movq %1, %0" : "=r"(d) : "i"(0x80000000u));
+    printf("imm64: %lx %lx %lx %lx", a, b, c, d);
 #else
-    printf("imm64: 123456789abcdef 80000000 1122334455667788\n");
+    printf("imm64: 123456789abcdef 80000000 1122334455667788 ffffffff80000000");
 #endif
+    asm("movl %1, %0" : "=r"(e) : "i"((unsigned char)200));
+    asm("movl %1, %0" : "=r"(f) : "i"((unsigned short)40000));

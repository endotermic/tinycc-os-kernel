            fn_global(7, 8, 9), fn_array[i](2, 2, 2), fn_local(3, 3, 3), (*ops_local.read)(1, 1, 1));
+    printf("float args: %.1f %.1f %.1Lf %d %.1f\n", dbl_arg(1, 2.5, 3), flt_arg(0.5f, 1, 1000ll, 2),
+           ld_arg(2, 1.5L, 1), variadic(3, 10, 20, 30), fp_dbl(4, 0.5, 5));
 }
 

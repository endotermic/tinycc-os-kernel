 i386-gen.c | 264 ++++++++++++++++++++++++++++++++++++++++++++++++-----
 tccgen.c   |   7 ++
 2 files changed, 249 insertions(+), 22 deletions(-)

diff --git a/i386-gen.c b/i386-gen.c
index 018165b..1c270d0 100644
--- a/i386-gen.c
+++ b/i386-gen.c
@@ -78,6 +78,11 @@ enum {
    at caller side (for interfacing with non-TCC compilers) */
 #define PROMOTE_RET
 
+/* structure copies are inlined (rep movsl) rather than calls to memmove
+   (the Linux boot code has no libc) */
+#define TCC_TARGET_NATIVE_STRUCT_COPY
+ST_FUNC void gen_struct_copy(int size);
+
 /******************************************************/
 #else /* ! TARGET_DEFS_ONLY */
 /******************************************************/
@@ -105,6 +110,31 @@ ST_DATA const int reg_classes[NB_REGS] = {
 
 static unsigned long func_sub_sp_offset;
 static int func_ret_sub;
+
+/* -m16 (GCC's -m16, GNU as .code16gcc): the code runs in a 16-bit code
+   segment, so it is ordinary 32-bit code where every 32-bit operation
+   carries the 0x66 operand-size prefix, every memory operand the 0x67
+   address-size prefix, and 16-bit operations drop the 0x66 they have in
+   32-bit code.  o66()/o67() emit the prefixes; byte and x87 operations
+   have no operand size. */
+#define M16 (tcc_state->m16)
+static void o66(void) { if (M16) g(0x66); }
+static void o67(void) { if (M16) g(0x67); }
+/* the operand size prefix of an opcode given to gen_modrm()/store():
+   returns the opcode without the 0x66 of a 16-bit operation */
+static int gen_opsize16(int opc)
+{
+    int b;
+    if (!M16)
+        return opc;
+    b = opc & 0xff;
+    if (b == 0x66)
+        return opc >> 8;
+    if (!(b == 0x88 || b == 0x8a || b == 0x86 || b == 0xc6 || b == 0xf6 || b == 0xfe
+          || (b >= 0xd8 && b <= 0xdf)))
+        g(0x66);
+    return opc;
+}
 #ifdef CONFIG_TCC_BCHECK
 static addr_t func_bound_offset;
 static unsigned long func_bound_ind;
@@ -241,6 +271,8 @@ static void gen_modrm(int opc, int op_r2, int r, Sym *sym, int c)
 {
     int op_reg = REG_VALUE(op_r2) << 3;
 
+    o67(); /* all memory operands use 32-bit addressing */
+    opc = gen_opsize16(opc);
     if ((r & VT_SYM) && (sym->type.t & VT_TLS)) {
 #ifdef TCC_TARGET_PE
         Sym *s2 = external_global_sym(TOK___tls_index, &int_type);
@@ -381,6 +413,7 @@ ST_FUNC void load(int r, SValue *sv)
             }
 #endif
         } else if (v == VT_CONST) {
+            o66();
             o(0xb8 + r); /* mov $xx, r */
             gen_addr32(fr, sv->sym, fc);
         } else if (v == VT_LOCAL) {
@@ -388,6 +421,7 @@ ST_FUNC void load(int r, SValue *sv)
                 /* lea xxx(%ebp), r */
                 gen_modrm(0x8d, r, VT_LOCAL, sv->sym, fc);
             } else {
+                o66();
                 o(0x89);
                 o(0xe8 + r); /* mov %ebp, r */
             }
@@ -395,14 +429,18 @@ ST_FUNC void load(int r, SValue *sv)
             o(0x0f); /* setxx %br */
             o(fc);
             o(0xc0 + r);
+            o66();
             o(0xc0b60f + r * 0x90000); /* movzbl %al, %eax */
         } else if (v == VT_JMP || v == VT_JMPI) {
             t = v & 1;
+            o66();
             oad(0xb8 + r, t); /* mov $1, r */
-            o(0x05eb); /* jmp after */
+            o(M16 ? 0x06eb : 0x05eb); /* jmp after */
             gsym(fc);
+            o66();
             oad(0xb8 + r, t ^ 1); /* mov $0, r */
         } else if (v != r) {
+            o66();
             o(0x89);
             o(0xc0 + r + v * 8); /* mov v, r */
         }
@@ -453,6 +491,7 @@ ST_FUNC void store(int r, SValue *v)
     if (fr == VT_CONST || fr == VT_LOCAL || (v->r & VT_LVAL)) {
         gen_modrm(opc, r, v->r, v->sym, fc);
     } else if (fr != r) {
+        opc = gen_opsize16(opc);
 	o(opc);
         o(0xc0 + fr + r * 8); /* mov r, fr */
     }
@@ -460,6 +499,7 @@ ST_FUNC void store(int r, SValue *v)
 
 static void gadd_sp(int val)
 {
+    o66();
     if (val == (signed char)val) {
         o(0xc483);
         g(val);
@@ -479,6 +519,10 @@ static void gen_static_call(int v)
 }
 #endif
 
+/* set while a regparm function is called: its address may not take a
+   register (they carry the arguments) */
+static int regparm_call;
+
 /* 'is_jmp' is '1' if it is a jump */
 static void gcall_or_jmp(int is_jmp)
 {
@@ -493,17 +537,45 @@ static void gcall_or_jmp(int is_jmp)
             return;
 	}
 #endif
+        o66();
         oad(0xe8 + is_jmp, vtop->c.i - 4); /* call/jmp im */
         greloc(cur_text_section, vtop->sym, ind - 4, R_386_PC32);
+    } else if (regparm_call && (vtop->r & VT_LVAL)
+               && ((vtop->r & VT_VALMASK) == VT_LOCAL || (vtop->r & VT_VALMASK) == VT_CONST)) {
+        /* call/jmp *mem: the argument registers stay intact */
+        gen_modrm(0xff, 2 + 2 * is_jmp, vtop->r, vtop->sym, vtop->c.i);
     } else {
         /* otherwise, indirect call */
         r = gv(RC_INT);
+        o66();
         o(0xff); /* call/jmp *r */
         o(0xd0 + r + (is_jmp << 4));
     }
 }
 
 static const uint8_t fastcall_regs[3] = { TREG_EAX, TREG_EDX, TREG_ECX };
+
+/* GCC's regparm(N) register assignment (also the default under
+   -mregparm=N): the arguments are taken in order; an integer, pointer or
+   structure argument of w dwords goes into the next w registers while
+   enough remain, the first one that does not fit and everything after it
+   goes on the stack; floating point arguments are on the stack and do not
+   take registers.  Returns the number of dwords in registers for the
+   argument sizes 'size[]' (in bytes, first argument first). */
+static int regparm_words(int nregs, const int *size, const int *isfloat, int n)
+{
+    int i, w, words = 0;
+    for (i = 0; i < n; i++) {
+        if (isfloat[i])
+            continue;
+        w = (size[i] + 3) / 4;
+        if (w > nregs)
+            break;
+        nregs -= w;
+        words += w;
+    }
+    return words;
+}
 static const uint8_t fastcallw_regs[2] = { TREG_ECX, TREG_EDX };
 
 /* Return the number of registers needed to return the struct, or 0 if
@@ -539,7 +611,7 @@ ST_FUNC int gfunc_sret(CType *vt, int variadic, CType *ret, int *ret_align, int
    parameters and the function address. */
 ST_FUNC void gfunc_call(int nb_args)
 {
-    int size, align, r, args_size, i, func_call;
+    int size, align, r, args_size, i, func_call, regparm_nb;
     Sym *func_sym;
 
 #ifdef CONFIG_TCC_BCHECK
@@ -549,6 +621,39 @@ ST_FUNC void gfunc_call(int nb_args)
 
     save_regs(nb_args + 1);
 
+    /* the register arguments of a regparm function: the argument list is
+       vtop[-(nb_args-1)] (first) .. vtop[0] (last) */
+    func_sym = vtop[-nb_args].type.ref;
+    func_call = func_sym->f.func_call;
+    regparm_nb = 0;
+    if (func_call >= FUNC_FASTCALL1 && func_call <= FUNC_FASTCALL3 && nb_args) {
+        int *asize = tcc_malloc(2 * nb_args * sizeof(int)), *isfloat = asize + nb_args;
+        for (i = 0; i < nb_args; i++) {
+            SValue *sv = &vtop[-(nb_args - 1 - i)];
+            asize[i] = (sv->type.t & VT_BTYPE) == VT_LLONG ? 8
+                     : (sv->type.t & VT_BTYPE) == VT_STRUCT ? type_size(&sv->type, &align) : 4;
+            isfloat[i] = is_float(sv->type.t);
+        }
+        regparm_nb = regparm_words(func_call - FUNC_FASTCALL1 + 1, asize, isfloat, nb_args);
+        tcc_free(asize);
+    }
+    /* regparm: %eax, %edx and %ecx carry arguments, so an indirect call
+       needs its address in memory ("call *disp(%ebp)"): a computed
+       address (a function pointer in a structure) gets a stack slot now,
+       while the registers are still free */
+    regparm_call = func_call >= FUNC_FASTCALL1 && func_call <= FUNC_FASTCALL3;
+    if (regparm_call) {
+        SValue *fn = &vtop[-nb_args];
+        if ((fn->r & (VT_VALMASK | VT_LVAL | VT_SYM)) != (VT_CONST | VT_SYM)
+            && !((fn->r & VT_LVAL)
+                 && ((fn->r & VT_VALMASK) == VT_LOCAL || (fn->r & VT_VALMASK) == VT_CONST))) {
+            vrott(nb_args + 1);
+            r = gv(RC_INT);
+            save_reg(r);
+            vrotb(nb_args + 1);
+        }
+    }
+
     args_size = 0;
     for(i = 0;i < nb_args; i++) {
         if ((vtop->type.t & VT_BTYPE) == VT_STRUCT) {
@@ -567,9 +672,11 @@ ST_FUNC void gfunc_call(int nb_args)
             } else
 #endif

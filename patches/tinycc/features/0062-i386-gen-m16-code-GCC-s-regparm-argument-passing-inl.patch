     }
 #if !defined(TCC_TARGET_PE) && !TARGETOS_FreeBSD || TARGETOS_OpenBSD
+    /* the callee pops the structure return pointer, unless it got it in
+       a register (regparm) */
     else if ((vtop->type.ref->type.t & VT_BTYPE) == VT_STRUCT)
         args_size -= 4;
 #endif
 
     gcall_or_jmp(0);
+    regparm_call = 0;
 
     if (args_size && func_call != FUNC_STDCALL && func_call != FUNC_THISCALL && func_call != FUNC_FASTCALLW)
         gadd_sp(args_size);
     vtop--;
 }
 
+/* push %ebp; mov %esp,%ebp; sub $n,%esp: 3 prefixes more with -m16 */
 #ifdef TCC_TARGET_PE
-#define FUNC_PROLOG_SIZE (10 + !!USE_EBX)

             }
             vset(&vtop->type, r | VT_LVAL, 0);
@@ -584,7 +691,9 @@ ST_FUNC void gfunc_call(int nb_args)
                 size = 8;
             else
                 size = 12;
+            o66();
             oad(0xec81, size); /* sub $xxx, %esp */
+            o67();
             if (size == 12)
                 o(0x7cdb);
             else
@@ -598,57 +707,67 @@ ST_FUNC void gfunc_call(int nb_args)
             r = gv(RC_INT);

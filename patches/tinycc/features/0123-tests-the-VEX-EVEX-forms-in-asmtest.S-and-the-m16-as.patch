From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 4 Nov 2026 15:19:53 +0200
Subject: [PATCH] tests: the VEX/EVEX forms in asmtest.S and the m16-asm lists

asmtest.S: about 390 lines of AVX, AVX2, BMI1/2 and AVX-512VL forms
(register and memory operands, xmm8-15/ymm8-15, r8-r15, rip-relative,
EVEX disp8*N), compared with GNU as by `make test`, and a "##" comment
after an instruction.  tests/m16-asm-32.txt and -64.txt: 25 + 18
snippets for `m16-check.sh asm`, byte-compared in 32-bit i386-tcc,
.code32 in tcc and .code64 in i386-tcc.
---
 tests/asmtest.S      | 389 +++++++++++++++++++++++++++++++++++++++++++
 tests/m16-asm-32.txt |  25 +++
 tests/m16-asm-64.txt |  18 ++
 3 files changed, 432 insertions(+)

diff --git a/tests/asmtest.S b/tests/asmtest.S
index 6e4ffc5..cc75246 100644
--- a/tests/asmtest.S
+++ b/tests/asmtest.S
@@ -26,6 +26,7 @@
 
 # 28 "asmtest.S"        # a line directive (and a line comment)
         movl %eax, %ebx # some more asm comment
+        movl %eax, %ebx ## a comment of the "##" kind (fix 123)
 /* some label tests */
 L1:
         movl %eax, %ebx
@@ -1310,6 +1311,394 @@ TEST_MMX_SSE_I8(psrlq)
     movl $var2@GOTOFF, %eax
     .long var2@GOTOFF
 #endif

+/* 16- and 8-bit absolute values: .word/.byte with a symbol, immediates
+   and displacements of 16-bit code */
+#ifdef TCC_TARGET_X86_64
+#define R_XX_16   R_X86_64_16
+#define R_XX_PC16 R_X86_64_PC16
+#define R_XX_8    R_X86_64_8
+#define R_XX_PC8  R_X86_64_PC8
+#else
+#define R_XX_16   R_386_16
+#define R_XX_PC16 R_386_PC16
+#define R_XX_8    R_386_8
+#define R_XX_PC8  R_386_PC8
+#endif
+
+static void gen_expr_small(ExprValue *pe, int size, int pcrel)
+{
+    int rtype = size == 2 ? (pcrel ? R_XX_PC16 : R_XX_16) : (pcrel ? R_XX_PC8 : R_XX_8);
+    int v = pe->v - (pcrel ? size : 0);
+    if (pe->sym) {
+#if SHT_RELX == SHT_RELA
+        greloca(cur_text_section, pe->sym, ind, rtype, v);
+        v = 0;
+#else
+        greloc(cur_text_section, pe->sym, ind, rtype);
+#endif
+    }
+    if (size == 2)
+        gen_le16(v);
+    else
+        g(v);
+}
+
+ST_FUNC void gen_expr16(ExprValue *pe)
+{
+    gen_expr_small(pe, 2, pe->pcrel);
+}
+
+ST_FUNC void gen_expr8(ExprValue *pe)
+{
+    gen_expr_small(pe, 1, pe->pcrel);
+}
+
+/* A symbol a displacement can be computed against at assembly time: a
+   defined local one in the current section.  Like GNU as, references to
+   global symbols keep their relocation (the symbol may be preempted). */
+static ElfSym *asm_local_sym_here(Sym *sym)
+{
+    ElfSym *esym = elfsym(sym);
+    if (esym && esym->st_shndx == cur_text_section->sh_num
+        && ELFW(ST_BIND)(esym->st_info) == STB_LOCAL)
+        return esym;
+    return NULL;
+}
+
+/* rel16 of 16-bit code's call/jmp/jcc */
+static void gen_disp16(ExprValue *pe)
+{
+    ElfSym *esym = asm_local_sym_here(pe->sym);
+    if (esym) {
+        gen_le16(pe->v + esym->st_value - ind - 2);
+    } else {
+        ExprValue e = *pe;
+        gen_expr_small(&e, 2, 1);
+    }
+}

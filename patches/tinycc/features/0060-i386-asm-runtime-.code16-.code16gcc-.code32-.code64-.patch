+/* REL relocations keep the addend in the relocated field: add to it in the
+   field's width (16- and 8-bit fields exist in the i386's 16-bit code) */
+ST_FUNC void rel_add_addend(int type, unsigned char *ptr, addr_t v)
+{
+#ifdef TCC_TARGET_I386
+    if (type == R_386_16 || type == R_386_PC16) {
+        write16le(ptr, read16le(ptr) + v);
+        return;
+    }
+    if (type == R_386_8 || type == R_386_PC8) {
+        *ptr += v;
+        return;
+    }
+#endif
+    add32le(ptr, v);
+}

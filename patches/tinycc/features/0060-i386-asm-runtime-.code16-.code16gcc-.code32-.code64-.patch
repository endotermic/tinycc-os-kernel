+/* the operand size (0: byte, 1: 16, 2: 32, 3: 64 bits) that an instruction
+   without a size suffix or a sized register operand has, or -1 when it has
+   none that an operand-size prefix could change.  'gcc' names the ones
+   .code16gcc (GCC's -m16 output) makes 32-bit by default. */
+static int default_size(int gcc)
+{
+    if (CODE16)
+        return gcc && tcc_state->code16gcc ? 2 : 1;
+    return 2;
+}
+
+static int sizeless_opsize(int tok, int code)
+{
+    switch (tok) {
+    case TOK_ASM_retl: case TOK_ASM_lretl: case TOK_ASM_iretl:
+    case TOK_ASM_pushfl: case TOK_ASM_popfl: case TOK_ASM_pushal: case TOK_ASM_popal:
+    case TOK_ASM_calll: case TOK_ASM_jmpl: case TOK_ASM_lcalll: case TOK_ASM_ljmpl:
+    case TOK_ASM_lgdtl: case TOK_ASM_lidtl: case TOK_ASM_sgdtl: case TOK_ASM_sidtl:
+    case TOK_ASM_cwtl: case TOK_ASM_cwde: case TOK_ASM_cltd: case TOK_ASM_cdq:
+    case TOK_ASM_movzwl: case TOK_ASM_movsbl: case TOK_ASM_movswl:
+    case TOK_ASM_bswap: case TOK_ASM_bswapl: case TOK_ASM_boundl:
+    case TOK_ASM_lss: case TOK_ASM_lds: case TOK_ASM_les: case TOK_ASM_lfs: case TOK_ASM_lgs:
+        return 2;
+    case TOK_ASM_retw: case TOK_ASM_lretw:
+    case TOK_ASM_pushfw: case TOK_ASM_popfw: case TOK_ASM_pushaw: case TOK_ASM_popaw:
+    case TOK_ASM_callw: case TOK_ASM_jmpw: case TOK_ASM_lcallw: case TOK_ASM_ljmpw:
+    case TOK_ASM_lgdtw: case TOK_ASM_lidtw:
+        return 1;
+    case TOK_ASM_call: case TOK_ASM_lcall: case TOK_ASM_ret: case TOK_ASM_lret:
+    case TOK_ASM_enter: case TOK_ASM_leave:

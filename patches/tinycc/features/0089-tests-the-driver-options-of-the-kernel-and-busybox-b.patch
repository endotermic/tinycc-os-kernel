diff --git a/tests/tests2/158_link_group.c b/tests/tests2/158_link_group.c
new file mode 100644
index 0000000..a5f3d9b
--- /dev/null
+++ b/tests/tests2/158_link_group.c
@@ -0,0 +1,24 @@
+/* -Wl,--start-group ... -Wl,--end-group: archives with circular references
+   are rescanned (fix 53 of the tinycc-os-kernel project; busybox links its
+   per-directory lib.a archives this way).  The Makefile compiles this file
+   as four objects, puts a and a_helper into one archive (as two members) and
+   b into another, and links main with the group. */
+#include <stdio.h>
+
+int a(int);
+int b(int);
+int a_helper(int);
+
+#if PART == 1
+int main(void)
+{
+    printf("group: %d\n", a(1));
+    return 0;
+}
+#elif PART == 2
+int a(int x) { return b(x + 1) * 10; }
+#elif PART == 3
+int b(int x) { return a_helper(x + 1) + 100; }
+#elif PART == 4
+int a_helper(int x) { return x * 1000; }
+#endif

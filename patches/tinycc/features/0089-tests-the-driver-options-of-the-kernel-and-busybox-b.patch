diff --git a/tests/tests2/160_asm_offsets.c b/tests/tests2/160_asm_offsets.c
new file mode 100644
index 0000000..4905500
--- /dev/null
+++ b/tests/tests2/160_asm_offsets.c
@@ -0,0 +1,22 @@
+/* -S writes the asm statements as text: Kbuild generates asm-offsets.h from
+   the .ascii lines of "cc -S" (fix 58 of the tinycc-os-kernel project).  The
+   Makefile runs tcc -S on this file and prints the output. */
+#define DEFINE(sym, val) \
+    asm volatile("\n.ascii \"->" #sym " %0 " #val "\"" : : "i" (val))
+#define BLANK() asm volatile("\n.ascii \"->\"" : : )
+#define COMMENT(x) asm volatile("\n.ascii \"->#" x "\"")
+#define OFFSET(sym, str, mem) DEFINE(sym, __builtin_offsetof(struct str, mem))
+
+struct pt_regs { int ax, bx; char flags, pad[7]; int ip; };
+
+int main(void)
+{
+    COMMENT("register offsets");
+    OFFSET(PT_BX, pt_regs, bx);
+    OFFSET(PT_IP, pt_regs, ip);
+    BLANK();
+    DEFINE(PT_SIZE, sizeof(struct pt_regs));
+    DEFINE(PT_FLAGS_NEG, -(int)sizeof(((struct pt_regs *)0)->flags));
+    DEFINE(BIG, 0x100000000ll);
+    return 0;
+}
diff --git a/tests/tests2/160_asm_offsets.expect b/tests/tests2/160_asm_offsets.expect
new file mode 100644
index 0000000..cce135e
--- /dev/null
+++ b/tests/tests2/160_asm_offsets.expect
@@ -0,0 +1,14 @@
+
+.ascii "->#register offsets"
+
+.ascii "->PT_BX $4 __builtin_offsetof(struct pt_regs, bx)"
+
+.ascii "->PT_IP $16 __builtin_offsetof(struct pt_regs, ip)"
+
+.ascii "->"
+
+.ascii "->PT_SIZE $20 sizeof(struct pt_regs)"
+
+.ascii "->PT_FLAGS_NEG $-1 -(int)sizeof(((struct pt_regs *)0)->flags)"
+
+.ascii "->BIG $4294967296 0x100000000ll"

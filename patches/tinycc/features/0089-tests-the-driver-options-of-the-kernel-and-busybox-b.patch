 tests/tests2/160_asm_offsets.c      | 22 ++++++++++++++++++++++
 tests/tests2/160_asm_offsets.expect | 14 ++++++++++++++
 tests/tests2/Makefile               | 21 +++++++++++++++++++++
 7 files changed, 93 insertions(+)
 create mode 100644 tests/tests2/158_link_group.c
 create mode 100644 tests/tests2/158_link_group.expect
 create mode 100644 tests/tests2/159_depfile.c
 create mode 100644 tests/tests2/159_depfile.expect
 create mode 100644 tests/tests2/160_asm_offsets.c

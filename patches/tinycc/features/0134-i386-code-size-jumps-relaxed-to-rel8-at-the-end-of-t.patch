+/* A comparison of an integer lvalue in memory with a constant without
+   loading the value (gen_op()): vtop[-1] the lvalue (byte, short, int or
+   pointer sized), vtop the constant, op the comparison as gen_op()
+   adjusted it for the operands' common type (an int or a pointer).  `cmp
+   $imm, mem` saves the load and its extension; a byte or a word is
+   compared at its own width when the constant is representable in it: a
+   sign extension preserves both orders, a zero extension gives
+   non-negative values, whose signed order is the unsigned order of the
+   bytes, so the signed conditions become the unsigned ones.  Returns 0,
+   nothing emitted, when the operands do not qualify. */
+ST_FUNC int gen_cmp_mem(int op)
+{
+    SValue *lv = vtop - 1;
+    int r = lv->r, bt = lv->type.t & VT_BTYPE, u = lv->type.t & VT_UNSIGNED;
+    int c, opc;
+
+    if (op < TOK_ULT || op > TOK_GT)
+        return 0;
+    if ((vtop->r & (VT_VALMASK | VT_LVAL | VT_SYM)) != VT_CONST)
+        return 0;
+    if (!(r & VT_LVAL) || (lv->type.t & VT_BITFIELD))
+        return 0;
+    if ((r & VT_VALMASK) >= VT_CONST && (r & VT_VALMASK) != VT_CONST
+        && (r & VT_VALMASK) != VT_LOCAL)
+        return 0; /* VT_LLOCAL: the pointer is on the stack */
+#ifdef CONFIG_TCC_BCHECK
+    if (r & VT_MUSTBOUND)
+        return 0;
+#endif
+    if ((r & VT_SYM) && (lv->sym->type.t & VT_TLS))
+        return 0;
+#if defined CONFIG_TCC_PIC
+    if ((r & (VT_VALMASK | VT_SYM)) == (VT_CONST | VT_SYM)
+        && !(lv->sym->type.t & VT_STATIC))
+        return 0; /* through the GOT */
+#endif

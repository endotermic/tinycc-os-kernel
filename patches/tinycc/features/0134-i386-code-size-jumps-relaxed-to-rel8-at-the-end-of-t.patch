From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 6 Nov 2026 19:08:27 +0200
Subject: [PATCH] i386: code size: jumps relaxed to rel8 at the end of the
 function, zero loads with xor, test, compares in memory, regparm arguments
 without push/pop

The kernel's real-mode setup, compiled by i386-tcc -m16, must fit the
boot protocol's 32 KB (_end <= 0x8000 in setup.ld, .bss included), and
tcc's 16-bit code was twice the size of gcc -Os's (kernel patch 0011
makes the BIOS video mode code optional for that reason).  The code
generator now emits:

 * jumps relaxed to their short forms when the function is complete
   (gfunc_epilog -> relax_function): gjmp()/gjmp_cond() still emit the
   rel32 forms, since a forward target is unknown, and record every jump
   with a target inside the function (and the prologue's `sub $frame,%esp`,
   whose immediate is known only at the end) in rjumps[]; the fixed point
   of "fits rel8 once the jumps before it shrank" is computed, the code
   moved, and the displacements, the relocations and the symbols inside
   the function patched; tccdbg maps its line and scope addresses through
   gen_relax_map().  Not done for a function with inline asm (the
   assembler resolves its own displacements and folds label differences
   into other sections: jump labels, alternatives, exception tables) or
   with bounds checking.  func_asm_seen is complete only at the epilogue,
   so relax_function() tests it there (the first version read it in
   rj_reset() at the prologue, relaxed every asm function and left the
   i386 kernel's recorded label addresses stale: it did not boot), and
   label_pop(), which defines the ELF symbols of the function's labels
   after the epilogue (`static void *tbl[] = { &&l0, ... }`), maps their
   positions through gen_relax_map() too (computed gotos jumped into the
   old layout).
 * a zero loaded with `xor r,r` (load_imm; the two-word arithmetic of
   tccgen loads a constant high word before the low-word operation on
   every target now, since the xor clears the carry).
 * `test r,r` for a comparison with 0.
 * a byte, short, int or pointer lvalue compared with a constant in
   memory (gen_cmp_mem), at its own width when the constant fits, with
   the signed conditions turned unsigned for a zero-extended operand.
 * the register arguments of a regparm call loaded and permuted with
   xchg/mov (gen_reg_args) instead of pushed and popped word by word.

With the vanilla video files the setup is 28 953 bytes, _end 0x84b0
(34 521 and 0x9a70 before; gcc -Os: 15 100, 0x4e80): still 1 200 bytes
over the limit, so kernel patch 0011 stays.
---
 i386-gen.c | 583 ++++++++++++++++++++++++++++++++++++++++++++++-------
 tcc.h      |  13 ++
 tccdbg.c   | 147 +++++++++++---
 tccgen.c   |  38 +++-
 4 files changed, 671 insertions(+), 110 deletions(-)

diff --git a/i386-gen.c b/i386-gen.c
index 23266b5..b20ce16 100644
--- a/i386-gen.c
+++ b/i386-gen.c
@@ -148,10 +148,244 @@ static int gen_opsize16(int opc)
     if (b == 0x66)
         return opc >> 8;
     if (!(b == 0x88 || b == 0x8a || b == 0x86 || b == 0xc6 || b == 0xf6 || b == 0xfe
-          || (b >= 0xd8 && b <= 0xdf)))
+          || b == 0x80 || (b >= 0xd8 && b <= 0xdf)))
         g(0x66);
     return opc;
 }
+
+/* Code size: the jumps of a function are relaxed to their short forms
+   when the function is complete (gfunc_epilog).  gjmp()/gjmp_cond() emit
+   the rel32 forms (5/6 bytes, one more with -m16), since the target of a
+   forward jump is not known when it is emitted, yet most displacements fit
+   a rel8 (2 bytes).  Every jump with a target inside the function (gjmp,
+   gjmp_cond, gjmp_addr) and the `sub $frame,%esp` of the prologue (whose
+   immediate, known only at the end, usually fits a byte, or is 0) are
+   recorded in rjumps[]; relax_function() finds the jumps whose
+   displacement fits once the ones before them have shrunk, moves the code,
+   and patches the displacements, the relocations and the symbols inside the
+   function.  tccdbg.c maps its line and scope addresses through
+   gen_relax_map().  Not done when the function has inline asm (the
+   assembler resolves its own displacements and defines its own symbols:
+   func_asm_seen) or bounds checking (fixed offsets patched later). */
+enum { RJ_JMP, RJ_JCC, RJ_SHORT, RJ_SUB };
+typedef struct RelaxJump {
+    int pos;    /* offset of the instruction (prefix included) */
+    int len;    /* its length */
+    int nlen;   /* its length after relaxation */
+    int kind;
+    int cc;     /* RJ_JCC: the 0x8x condition opcode */
+    int target; /* the target, in the offsets before relaxation */
+    int saved;  /* bytes saved by the jumps before this one */
+} RelaxJump;
+static RelaxJump *rjumps;
+static int nb_rjumps, nb_rjumps_alloc;
+static int relax_off;      /* no relaxation for this function */
+static int relax_start, relax_end, relax_saved; /* of the last relaxed function */
+
+static void rj_reset(void)
+{
+    nb_rjumps = 0;
+    relax_saved = 0;
+    relax_off = func_asm_seen;
+#ifdef CONFIG_TCC_BCHECK
+    if (tcc_state->do_bounds_check)
+        relax_off = 1;
+#endif
+}
+
+static void rj_add(int pos, int len, int kind, int cc)
+{
+    RelaxJump *rj;
+    if (nocode_wanted)
+        return; /* nothing was emitted */
+    if (nb_rjumps && pos < rjumps[nb_rjumps - 1].pos + rjumps[nb_rjumps - 1].len)
+        relax_off = 1; /* not in order: cannot happen */
+    if (nb_rjumps >= nb_rjumps_alloc) {
+        nb_rjumps_alloc = nb_rjumps_alloc ? 2 * nb_rjumps_alloc : 64;
+        rjumps = tcc_realloc(rjumps, nb_rjumps_alloc * sizeof *rjumps);
+    }
+    rj = &rjumps[nb_rjumps++];
+    rj->pos = pos;
+    rj->len = rj->nlen = len;
+    rj->kind = kind;
+    rj->cc = cc;
+    rj->target = 0;
+    rj->saved = 0;
+}
+
+ST_FUNC void gen_relax_free(void)
+{
+    tcc_free(rjumps);
+    rjumps = NULL;
+    nb_rjumps = nb_rjumps_alloc = 0;
+}
+
+/* the offset 'off' of the function before its relaxation, after it (the
+   identity outside the function, or when nothing was relaxed) */
+ST_FUNC int gen_relax_map(int off)
+{
+    int lo, hi, mid;
+    RelaxJump *rj;
+    if (!relax_saved || off <= relax_start || off > relax_end)
+        return off;
+    /* the last recorded instruction that starts before off */
+    lo = 0, hi = nb_rjumps;
+    while (lo < hi) {
+        mid = (lo + hi) / 2;
+        if (rjumps[mid].pos < off)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    if (lo == 0)
+        return off;
+    rj = &rjumps[lo - 1];
+    if (off >= rj->pos + rj->len)
+        return off - rj->saved - (rj->len - rj->nlen);
+    off -= rj->pos; /* inside it: cannot happen for a target or a line */
+    return rj->pos - rj->saved + (off < rj->nlen ? off : rj->nlen);
+}
+
+ST_FUNC int gen_relax_saved(void)
+{
+    return relax_saved;
+}
+
+/* the size of a jump's new form and its displacement */
+static int rj_disp(RelaxJump *rj, int *disp)
+{
+    int np = rj->pos - rj->saved, nt = gen_relax_map(rj->target);
+    *disp = nt - (np + rj->nlen);
+    return rj->nlen;
+}
+
+static void relax_function(int frame)
+{
+    int i, k, n = nb_rjumps, changed, disp, start = func_ind, end = ind;
+    int src, dst, seg;
+    unsigned char *d = cur_text_section->data;
+    RelaxJump *rj;
+    Section *sr;
+    ElfW_Rel *rel;
+    ElfW(Sym) *sym, *sym_end;
+
+    relax_start = start, relax_end = end, relax_saved = 0;
+    if (relax_off || func_asm_seen || n == 0 || nocode_wanted)
+        return;
+    for (i = 0; i < n; i++) {
+        rj = &rjumps[i];
+        if (rj->kind == RJ_SUB) {
+#ifdef TCC_TARGET_PE
+            if (frame >= 4096)
+                continue; /* the __chkstk prologue */
+#endif
+            if (frame == 0)
+                rj->nlen = 0;
+            else if (frame == (signed char)frame)
+                rj->nlen = rj->len - 3; /* sub $imm8,%esp */
+            continue;
+        }
+        if (rj->kind == RJ_SHORT)
+            rj->target = rj->pos + 2 + (signed char)d[rj->pos + 1];
+        else
+            rj->target = rj->pos + rj->len + (int)read32le(d + rj->pos + rj->len - 4);
+        if (rj->target < start || rj->target > end)
+            return; /* not a jump within the function: leave everything */
+    }
+    /* a long jump shrinks when its displacement fits rel8; what the ones
+       before it save moves its target closer, hence the iteration (the
+       displacements only ever shrink, so the result is a fixed point) */
+    do {
+        changed = 0;
+        for (i = 0, k = 0; i < n; i++)
+            rjumps[i].saved = k, k += rjumps[i].len - rjumps[i].nlen;
+        for (i = 0; i < n; i++) {
+            rj = &rjumps[i];
+            if (rj->kind != RJ_JMP && rj->kind != RJ_JCC)
+                continue;
+            if (rj->nlen == 2)
+                continue;
+            rj->nlen = 2, rj_disp(rj, &disp);
+            if (disp == (signed char)disp)
+                changed = 1;
+            else
+                rj->nlen = rj->len;
+        }
+    } while (changed);
+    for (i = 0, k = 0; i < n; i++)
+        rjumps[i].saved = k, k += rjumps[i].len - rjumps[i].nlen;
+    if (k == 0)
+        return;
+    relax_saved = k;
+    /* every short jump still reaches its target (it does: the distances
+       only shrank) */
+    for (i = 0; i < n; i++) {
+        rj = &rjumps[i];
+        if (rj->kind != RJ_SUB && rj->nlen == 2) {
+            rj_disp(rj, &disp);
+            if (disp != (signed char)disp) {
+                relax_saved = 0;
+                return;
+            }
+        }
+    }
+    /* move the code and write the new forms */
+    for (i = 0, src = dst = start; i < n; i++) {
+        rj = &rjumps[i];
+        seg = rj->pos - src;
+        if (dst != src)
+            memmove(d + dst, d + src, seg);
+        dst += seg;
+        src = rj->pos + rj->len;
+        if (rj->kind == RJ_SUB) {
+            if (rj->nlen == rj->len) {
+                memmove(d + dst, d + rj->pos, rj->len);
+            } else if (rj->nlen) {
+                k = dst;
+                if (M16)
+                    d[k++] = 0x66;
+                d[k++] = 0x83; /* sub $imm8,%esp */
+                d[k++] = 0xec;
+                d[k++] = frame;
+            }
+        } else {
+            rj_disp(rj, &disp);
+            k = dst;
+            if (rj->nlen == 2) {
+                d[k++] = rj->kind == RJ_JCC ? rj->cc - 0x10 : 0xeb;
+                d[k++] = disp;
+            } else {
+                if (M16)
+                    d[k++] = 0x66;
+                if (rj->kind == RJ_JCC)
+                    d[k++] = 0x0f, d[k++] = rj->cc;
+                else
+                    d[k++] = 0xe9;
+                write32le(d + k, disp);
+            }
+        }
+        dst += rj->nlen;
+    }
+    seg = end - src;
+    if (dst != src)
+        memmove(d + dst, d + src, seg);
+    dst += seg;
+    memset(d + dst, 0, end - dst);
+    ind = dst;
+    /* the relocations and the symbols of the function */
+    sr = cur_text_section->reloc;
+    if (sr) {
+        for_each_elem(sr, 0, rel, ElfW_Rel)
+            if (rel->r_offset > (unsigned)start && rel->r_offset < (unsigned)end)
+                rel->r_offset = gen_relax_map(rel->r_offset);
+    }
+    sym = (ElfW(Sym) *)symtab_section->data;
+    sym_end = (ElfW(Sym) *)(symtab_section->data + symtab_section->data_offset);
+    for (sym++; sym < sym_end; sym++)
+        if (sym->st_shndx == cur_text_section->sh_num
+            && sym->st_value > (unsigned)start && sym->st_value <= (unsigned)end)
+            sym->st_value = gen_relax_map(sym->st_value);
+}
 #ifdef CONFIG_TCC_BCHECK
 static addr_t func_bound_offset;
 static unsigned long func_bound_ind;
@@ -352,6 +586,21 @@ static void gen_modrm(int opc, int op_r2, int r, Sym *sym, int c)
     }
 }
 
+/* mov $c, r; a zero with xor (2 bytes instead of 5; the flags are
+   clobbered, which tccgen's two-word arithmetic allows for: gen_opl()
+   loads a constant high word before the low-word operation) */
+static void load_imm(int r, int fr, Sym *sym, int c)
+{
+    o66();
+    if (c == 0 && !(fr & VT_SYM)) {
+        o(0x31); /* xor r, r */
+        o(0xc0 + r * 9);
+    } else {
+        o(0xb8 + r); /* mov $xx, r */
+        gen_addr32(fr, sym, c);
+    }
+}
+
 /* load 'r' from value 'sv' */
 ST_FUNC void load(int r, SValue *sv)
 {
@@ -440,9 +689,7 @@ ST_FUNC void load(int r, SValue *sv)
                 o(0x83 | (r << 3));
                 gen_gotoff32(sv->sym, fc);
             } else {
-                o66();
-                o(0xb8 + r); /* mov $xx, r */
-                gen_addr32(fr, sv->sym, fc);
+                load_imm(r, fr, sv->sym, fc);
             }
         } else if (v == VT_LOCAL) {
             if (fc) {
@@ -461,12 +708,11 @@ ST_FUNC void load(int r, SValue *sv)
             o(0xc0b60f + r * 0x90000); /* movzbl %al, %eax */
         } else if (v == VT_JMP || v == VT_JMPI) {
             t = v & 1;
-            o66();
-            oad(0xb8 + r, t); /* mov $1, r */
-            o(M16 ? 0x06eb : 0x05eb); /* jmp after */
+            load_imm(r, 0, NULL, t); /* mov $1, r */
+            o(0xeb); /* jmp after */
+            g((t ^ 1) ? 5 + M16 : 2 + M16);
             gsym(fc);
-            o66();
-            oad(0xb8 + r, t ^ 1); /* mov $0, r */
+            load_imm(r, 0, NULL, t ^ 1); /* mov $0, r */
         } else if (v != r) {
             o66();
             o(0x89);
@@ -722,12 +968,160 @@ ST_FUNC int gfunc_sret(CType *vt, int variadic, CType *ret, int *ret_align, int
 #endif
 }
 
+/* push the argument vtop on the stack; returns its size there */
+static int push_arg(void)
+{
+    int size, align, r;
+    if ((vtop->type.t & VT_BTYPE) == VT_STRUCT) {
+        size = type_size(&vtop->type, &align);
+        /* align to stack align size */
+        size = (size + 3) & ~3;
+        /* allocate the necessary size on stack */
+#ifdef TCC_TARGET_PE
+        if (size >= 4096) {
+            save_reg(TREG_EDX);
+            r = get_reg(RC_EAX);
+            oad(0x68, size); // push size
+            /* cannot call normal 'alloca' with bound checking */
+            gen_static_call(tok_alloc_const("__alloca"));
+            gadd_sp(4);
+        } else
+#endif
+        {
+            o66();
+            oad(0xec81, size); /* sub $xxx, %esp */
+            /* generate structure store */
+            r = get_reg(RC_INT);
+            o66();
+            o(0xe089 + (r << 8)); /* mov %esp, r */
+        }
+        vset(&vtop->type, r | VT_LVAL, 0);
+        vswap();
+        vstore();
+    } else if (is_float(vtop->type.t)) {
+        gv(RC_FLOAT); /* only one float register */
+        if ((vtop->type.t & VT_BTYPE) == VT_FLOAT)
+            size = 4;
+        else if ((vtop->type.t & VT_BTYPE) == VT_DOUBLE)
+            size = 8;
+        else
+            size = 12;
+        o66();
+        oad(0xec81, size); /* sub $xxx, %esp */
+        o67();
+        if (size == 12)
+            o(0x7cdb);
+        else
+            o(0x5cd9 + size - 4); /* fstp[s|l] 0(%esp) */
+        g(0x24);
+        g(0x00);
+    } else {
+        /* simple type (currently always same size) */
+        /* XXX: implicit cast ? */
+        r = gv(RC_INT);
+        if ((vtop->type.t & VT_BTYPE) == VT_LLONG) {
+            size = 8;
+            o66();
+            o(0x50 + vtop->r2); /* push r */
+        } else {
+            size = 4;
+        }
+        o66();
+        o(0x50 + r); /* push r */
+    }
+    vtop--;
+    return size;
+}
+
+/* the value is in registers (both words of a long long) */
+static int arg_in_regs(SValue *sv)
+{
+    if ((sv->r & VT_LVAL) || (sv->r & VT_VALMASK) >= VT_CONST)
+        return 0;
+    if ((sv->type.t & VT_BTYPE) == VT_LLONG && sv->r2 >= VT_CONST)
+        return 0;
+    return 1;
+}
+
+/* The register arguments of a regparm call, A1..An at vtop[-(n-1)]..vtop[0],
+   into regs[0], regs[1], regs[2] in order (a long long takes two) without
+   a push and a pop per word: each argument is loaded into a register, its
+   own when that is free, then the registers are permuted with xchg/mov.
+   Nothing else holds a register (gfunc_call() saved everything below the
+   arguments and put the function address in memory).  Returns 0, with the
+   arguments possibly in other registers, when they could not all be kept
+   in registers (the caller pushes them then). */
+static int gen_reg_args(int n, const uint8_t *regs)
+{
+    int cur[3], tgt[3], owner[3], word[3], nw, i, j, k, w, pass;
+    SValue *sv;
+
+    for (pass = 0; pass < 3; pass++) {
+        for (i = n - 1, w = 0; i >= 0; i--) { /* A1 first */
+            int words = (vtop[-i].type.t & VT_BTYPE) == VT_LLONG ? 2 : 1;
+            vrotb(i + 1);
+            if (!arg_in_regs(vtop)) {
+                int rc = RC_INT;
+                if (words == 1 && !reg_in_use(regs[w]))
+                    rc = reg_classes[regs[w]] & ~RC_INT;
+                gv(rc);
+            }
+            vrott(i + 1);
+            w += words;
+        }
+        for (i = 0; i < n; i++)
+            if (!arg_in_regs(&vtop[-i]))
+                break;
+        if (i == n)
+            break;
+    }
+    if (pass == 3)
+        return 0;
+    for (i = n - 1, nw = 0; i >= 0; i--) {
+        sv = &vtop[-i];
+        owner[nw] = i, word[nw] = 0, cur[nw] = sv->r & VT_VALMASK, tgt[nw] = regs[nw], nw++;
+        if ((sv->type.t & VT_BTYPE) == VT_LLONG)
+            owner[nw] = i, word[nw] = 1, cur[nw] = sv->r2, tgt[nw] = regs[nw], nw++;
+    }
+    for (;;) {
+        for (k = 0; k < nw && cur[k] == tgt[k]; k++)
+            ;
+        if (k == nw)
+            break;
+        for (j = 0; j < nw && cur[j] != tgt[k]; j++)
+            ;
+        o66();
+        if (j == nw) {
+            o(0x89); /* mov cur, tgt: the target register is free */
+            g(0xc0 | cur[k] << 3 | tgt[k]);
+        } else {
+            /* the target holds word j: exchange */
+            if (cur[k] == TREG_EAX)
+                g(0x90 + cur[j]); /* xchg %eax, r */
+            else if (cur[j] == TREG_EAX)
+                g(0x90 + cur[k]);
+            else
+                o(0x87), g(0xc0 | cur[k] << 3 | cur[j]);
+            cur[j] = cur[k];
+        }
+        cur[k] = tgt[k];
+    }
+    for (k = 0; k < nw; k++) {
+        sv = &vtop[-owner[k]];
+        if (word[k])
+            sv->r2 = cur[k];
+        else
+            sv->r = (sv->r & ~VT_VALMASK) | cur[k];
+    }
+    return 1;
+}

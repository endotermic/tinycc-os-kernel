+    } else if (bt == VT_SHORT) {
+        if (u ? (c < 0 || c > 65535) : c != (short)c)
+            return 0;
+        opc = c == (signed char)c ? 0x8366 : 0x8166; /* cmpw $imm, mem */
+    } else if (bt == VT_INT || bt == VT_PTR) {
+        u = 0;
+        opc = c == (signed char)c ? 0x83 : 0x81; /* cmpl $imm, mem */
+    } else {

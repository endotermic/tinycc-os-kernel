From d2d3180e20d2f361ef8784071b86999c7e7c0130 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Thu, 22 Oct 2026 11:18:38 +0300
Subject: [PATCH] libtcc, tccasm: -S writes the text of the asm statements

tcc has no assembly output, but the one thing the Linux kernel reads
from "cc -S" is the text of the asm statements of asm-offsets.c and
bounds.c: `.ascii "->SYMBOL $value comment"` lines, from
asm volatile("\n.ascii \"->" #sym " %0 " #val "\"" : : "i" (val)),
which Kbuild turns into #defines with sed.

Accept -S (like -c for the compiler action, so that the "i" operands are
evaluated), and in that mode write each asm statement, operands
substituted, to the output file instead of assembling it.  The output
of the kernel's asm-offsets pattern is identical to gcc's .ascii lines.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 libtcc.c | 9 +++++++++
 tcc.c    | 4 ++--
 tcc.h    | 1 +
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/libtcc.c b/libtcc.c
index ad64e4a..207d670 100644
--- a/libtcc.c
+++ b/libtcc.c
@@ -1593,6 +1593,7 @@ enum {
     TCC_OPTION_rstdin,
     TCC_OPTION_w,
     TCC_OPTION_E,
+    TCC_OPTION_S,
     TCC_OPTION_M,
     TCC_OPTION_MD,
     TCC_OPTION_MF,
@@ -1676,6 +1677,7 @@ static const TCCOption tcc_options[] = {
     { "print-search-dirs", TCC_OPTION_print_search_dirs, 0 },
     { "w", TCC_OPTION_w, 0 },
     { "E", TCC_OPTION_E, 0},
+    { "S", TCC_OPTION_S, 0},
     { "M", TCC_OPTION_M, 0},
     { "MM", TCC_OPTION_MM, 0},
     { "MD", TCC_OPTION_MD, TCC_OPTION_HAS_ARG | TCC_OPTION_NOSEP },
@@ -2170,6 +2172,13 @@ PUB_FUNC int tcc_parse_args(TCCState *s, int *pargc, char ***pargv)
         case TCC_OPTION_E:
             x = TCC_OUTPUT_PREPROCESS;
             goto set_output_type;
+        case TCC_OPTION_S:
+            /* no assembly output exists for tcc's code; what -S writes is the
+               text of the asm statements, which is all that the Linux kernel's
+               asm-offsets mechanism (".ascii \"->SYM $value\"") reads */
+            s->asm_text_only = 1;
+            x = TCC_OUTPUT_OBJ;
+            goto set_output_type;
         case TCC_OPTION_P:
             s->Pflag = atoi(optarg) + 1;
             break;
diff --git a/tcc.c b/tcc.c
index ffb04bf..0f5b9d8 100644
--- a/tcc.c
+++ b/tcc.c
@@ -334,7 +334,7 @@ redo:
         }
         if (s->nb_files == 0) {
             tcc_error_noabort("no input files");
-        } else if (s->output_type == TCC_OUTPUT_PREPROCESS) {
+        } else if (s->output_type == TCC_OUTPUT_PREPROCESS || s->asm_text_only) {
             if (s->outfile && 0!=strcmp("-",s->outfile)) {
                 ppfp = tcc_fopen(s->outfile, "wb");
                 if (!ppfp)
@@ -403,7 +403,7 @@ redo:
 
     if (s->run_test) {
         t = 0;
-    } else if (s->output_type == TCC_OUTPUT_PREPROCESS) {
+    } else if (s->output_type == TCC_OUTPUT_PREPROCESS || s->asm_text_only) {
         ;
     } else if (0 == ret) {
         if (s->output_type == TCC_OUTPUT_MEMORY) {
diff --git a/tcc.h b/tcc.h
index dcbe141..5f6db07 100644
--- a/tcc.h
+++ b/tcc.h
@@ -800,6 +800,7 @@ struct TCCState {
 
     unsigned char dflag; /* -dX value */
     unsigned char Pflag; /* -P switch (LINE_MACRO_OUTPUT_FORMAT) */
+    unsigned char asm_text_only; /* -S: write the asm statements as text instead of an object (asm-offsets) */
 
 #ifdef TCC_TARGET_X86_64
     unsigned char nosse; /* For -mno-sse support. */

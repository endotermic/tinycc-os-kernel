diff --git a/tests/tests2/169_cleanup_assign.c b/tests/tests2/169_cleanup_assign.c
new file mode 100644
index 0000000..8fe39f5
--- /dev/null
+++ b/tests/tests2/169_cleanup_assign.c
@@ -0,0 +1,103 @@
+/* Fix 127: the destination of an assignment whose right-hand side is a
+   statement expression that ends a scope with a cleanup call.  The lvalue
+   waits on the value stack while the right-hand side is parsed, and the
+   cleanup call copied it into a temporary (save_lvalues(), so that the
+   cleanup function cannot change an operand already read) -- the store
+   then went to the copy and the variable kept its old value.  The kernel:
+   get_user_inline() is a statement expression around a scoped user access
+   (a __cleanup variable). */
+#include <stdio.h>
+
+static int ends;
+static void endf(int **p) { ends++; }
+static void endi(int *p) { ends += 10; }
+
+struct s { int a, b; };
+static struct s gs;
+static int g = 99;
+
+static int asg(int *from)
+{
+    int r = 99;
+    r = ({ int *q __attribute__((cleanup(endf))) = from; 5; });
+    return r;
+}
+static int asgv(int *from)
+{
+    int r = 99;
+    r = ({ int *q __attribute__((cleanup(endf))) = from; *q + 1; });
+    return r;
+}
+static int compound(int *from)
+{
+    int r = 100;
+    r += ({ int *q __attribute__((cleanup(endf))) = from; *q; });
+    r -= ({ int x __attribute__((cleanup(endi))) = 2; x; });
+    return r;
+}
+static int member(int *from)
+{
+    struct s l = { 1, 2 };
+    l.b = ({ int *q __attribute__((cleanup(endf))) = from; *q * 2; });
+    gs.a = ({ int *q __attribute__((cleanup(endf))) = from; *q * 3; });
+    return l.a * 1000 + l.b * 100 + gs.a;
+}
+static int global(int *from)
+{
+    g = ({ int *q __attribute__((cleanup(endf))) = from; *q + 10; });
+    return g;
+}
+static int chained(int *from)
+{
+    int a = 1, b = 2;
+    a = b = ({ int *q __attribute__((cleanup(endf))) = from; *q; });
+    return a * 10 + b;
+}
+static int in_loop(int *from)
+{
+    int r = 99;
+    r = ({ int x = 0;
+           for (int *q __attribute__((cleanup(endf))) = from; !x; x = 1)
+               ;
+           x + *from; });
+    return r;
+}
+static int ret(int *from)
+{
+    return ({ int *q __attribute__((cleanup(endf))) = from; *q + 20; });
+}
+static int cond(int *from)
+{
+    if (({ int *q __attribute__((cleanup(endf))) = from; *q; }) == 7)
+        return 1;
+    return 0;
+}
+static int operand(int *from)
+{
+    int x = 3;
+    return x + ({ int *q __attribute__((cleanup(endf))) = from; *q; });
+}
+static int arg2(int a, int b) { return a * 10 + b; }
+static int argument(int *from)
+{
+    int x = 4;
+    return arg2(x, ({ int *q __attribute__((cleanup(endf))) = from; *q; }));
+}
+
+int main(void)
+{
+    int v = 7;
+    printf("asg %d\n", asg(&v));
+    printf("asgv %d\n", asgv(&v));
+    printf("compound %d\n", compound(&v));
+    printf("member %d\n", member(&v));
+    printf("global %d\n", global(&v));
+    printf("chained %d\n", chained(&v));
+    printf("in_loop %d\n", in_loop(&v));
+    printf("ret %d\n", ret(&v));
+    printf("cond %d\n", cond(&v));
+    printf("operand %d\n", operand(&v));
+    printf("argument %d\n", argument(&v));
+    printf("ends %d\n", ends);
+    return 0;
+}

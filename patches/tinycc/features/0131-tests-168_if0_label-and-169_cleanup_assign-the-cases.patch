diff --git a/tests/tests2/168_if0_label.c b/tests/tests2/168_if0_label.c
new file mode 100644
index 0000000..02576a9
--- /dev/null
+++ b/tests/tests2/168_if0_label.c
@@ -0,0 +1,121 @@
+/* Fix 126: constant propagation through locals after an if with a constant
+   condition whose dead branch holds a label.  The label makes the end of
+   the branch reachable (from a goto or an asm goto), and what the branch
+   assigned must join the state of the path the condition selected, not
+   replace it: the kernel's get_user_inline() ends with
+   "if (0) { efault: ret = -EFAULT; }" and returned -EFAULT for every
+   successful read (the futex wait loop never ended, pthread_join hung). */
+#include <stdio.h>
+
+static int fwd(int fail)
+{
+    int ret = 0;
+    if (fail)
+        goto efault;
+    if (0) {
+    efault:
+        ret = -14;
+    }
+    return ret;
+}
+
+static int with_else(int fail)
+{
+    int ret = 0;
+    if (fail)
+        goto bad;
+    if (0) {
+    bad:
+        ret = -1;
+    } else {
+        ret = ret + 2;
+    }
+    return ret;
+}
+
+static int else_dead(int fail)
+{
+    int ret = 0;
+    if (fail)
+        goto bad;
+    if (1) {
+        ret = ret + 2;
+    } else {
+    bad:
+        ret = -1;
+    }
+    return ret;
+}
+
+static int nested(int fail)
+{
+    int ret = 0, x = 5;
+    if (fail)
+        goto bad;
+    if (0) {
+        if (0) {
+        bad:
+            ret = -1;
+            x = 6;
+        }
+        x = x + 1;
+    }
+    return ret * 100 + x;
+}
+
+static int after_return(int fail)
+{
+    int ret = 0;
+    if (fail)
+        goto bad;
+    if (0) {
+    bad:
+        ret = -1;
+        return ret;
+    }
+    return ret;
+}
+
+#if defined __x86_64__ || defined __i386__
+/* the kernel's shape: a statement expression with a local label that an
+   asm goto names, the error path under if (0) */
+static int get_user_like(int *dest, int *from, int fail)
+{
+    int ret;
+    ret = ({
+        __label__ efault;
+        int _ret = 0;
+        if (fail)
+            goto efault;
+        __asm__ goto("mov %1,%0" : "=r"(*dest) : "m"(*from) : : efault);
+        if (0) {
+        efault:
+            _ret = -14;
+        }
+        _ret;
+    });
+    return ret;
+}
+#else
+static int get_user_like(int *dest, int *from, int fail)
+{
+    if (fail)
+        return -14;
+    *dest = *from;
+    return 0;
+}
+#endif
+
+int main(void)
+{
+    int v = 7, d = 0;
+    printf("fwd %d %d\n", fwd(0), fwd(1));
+    printf("with_else %d %d\n", with_else(0), with_else(1));
+    printf("else_dead %d %d\n", else_dead(0), else_dead(1));
+    printf("nested %d %d\n", nested(0), nested(1));
+    printf("after_return %d %d\n", after_return(0), after_return(1));
+    printf("get_user_like %d", get_user_like(&d, &v, 0));
+    printf(" %d", d);
+    printf(" %d\n", get_user_like(&d, &v, 1));
+    return 0;
+}

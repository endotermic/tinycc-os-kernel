From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@visma.com>
Date: Tue, 3 Nov 2026 18:59:56 +0200
Subject: [PATCH] i386: regparm(n) combined with stdcall keeps the register
 arguments and the callee pops the rest

GCC's __attribute__((regparm(3),stdcall)) (busybox's FAST_FUNC) passes the
first three integer arguments in eax, edx, ecx and has the callee pop what is
left on the stack.  tcc kept one calling convention per function, so the
attribute parsed last won: with stdcall after regparm every argument went to
the stack, and busybox's SHA-NI assembly, which reads the context from eax,
wrote through a code address (sha1sum and sha256sum segfaulted in the i386
guest on a CPU with SHA-NI; the C callers and callees agreed with each other,
so nothing else noticed).  A new FuncAttr bit func_stdcall records the
callee-pops property apart from the register convention, in either attribute
order; gfunc_call and gfunc_prolog honour it, merge_funcattr and
is_compatible_func carry it.  Test in 157_i386_regparm_pic (an asm callee).
---
 i386-gen.c                               |  13 ++++++---
 tcc.h                                    |   3 ++-
 tccgen.c                                 |  12 ++++++++-
 tests/tests2/157_i386_regparm_pic.c      |  32 +++++++++++++++++++++++
 tests/tests2/157_i386_regparm_pic.expect | Bin 604 -> 800 bytes
 5 files changed, 55 insertions(+), 5 deletions(-)

diff --git a/i386-gen.c b/i386-gen.c
index 3d44f10..d564d20 100644
--- a/i386-gen.c
+++ b/i386-gen.c
@@ -902,7 +902,10 @@ ST_FUNC void gfunc_call(int nb_args)
     gcall_or_jmp(0);
     regparm_call = 0;
 
-    if (args_size && func_call != FUNC_STDCALL && func_call != FUNC_THISCALL && func_call != FUNC_FASTCALLW)
+    /* the callee pops its stack arguments: stdcall (also combined with
+       regparm(n), GCC's regparm(3),stdcall), fastcall, thiscall */
+    if (args_size && func_call != FUNC_STDCALL && func_call != FUNC_THISCALL && func_call != FUNC_FASTCALLW
+        && !(func_sym->f.func_stdcall && func_call != FUNC_CDECL))
         gadd_sp(args_size);
     vtop--;
 }
@@ -921,7 +924,7 @@ ST_FUNC void gfunc_prolog(Sym *func_sym)
 {
     CType *func_type = &func_sym->type;
     int addr, align, size, func_call, fastcall_nb_regs;
-    int param_index, param_addr, regparm, regparm_stack = 0, regi = 0, w, k;
+    int param_index, param_addr, regparm, regparm_stack = 0, regi = 0, w, k, callee_pops;
     const uint8_t *fastcall_regs_ptr;
     Sym *sym;
     CType *type;
@@ -931,6 +934,9 @@ ST_FUNC void gfunc_prolog(Sym *func_sym)
     if (func_call >= FUNC_FASTCALL1 && func_call <= FUNC_FASTCALL3
         && sym->f.func_type == FUNC_ELLIPSIS)
         func_call = FUNC_CDECL; /* see gfunc_call */
+    /* stdcall combined with regparm(n): the callee pops the stack
+       arguments (sym walks the parameters below, so noted here) */
+    callee_pops = sym->f.func_stdcall && func_call != FUNC_CDECL;
     addr = 8;
     loc = 0;
     func_vc = 0;
@@ -1021,7 +1027,8 @@ ST_FUNC void gfunc_prolog(Sym *func_sym)
     }
     func_ret_sub = 0;
     /* pascal type call or fastcall ? */
-    if (func_call == FUNC_STDCALL || func_call == FUNC_FASTCALLW || func_call == FUNC_THISCALL)
+    if (func_call == FUNC_STDCALL || func_call == FUNC_FASTCALLW || func_call == FUNC_THISCALL
+        || callee_pops)
         func_ret_sub = addr - 8;
 #if !defined(TCC_TARGET_PE) && !TARGETOS_FreeBSD || TARGETOS_OpenBSD
     else if (func_vc > 0) /* the structure return pointer on the stack */
diff --git a/tcc.h b/tcc.h
index 251081f..5171fcd 100644
--- a/tcc.h
+++ b/tcc.h
@@ -524,7 +524,8 @@ struct FuncAttr {
     func_fold   : 2, /* trivial body: 1 empty (void), 2 'return <const>' */
     func_fval   : 12, /* the constant + 2048 (see inline_fold_check) */
     func_used   : 1, /* attribute((used)) */
-    func_cdecl  : 1; /* an explicit cdecl/regparm(0): -mregparm does not apply */
+    func_cdecl  : 1, /* an explicit cdecl/regparm(0): -mregparm does not apply */
+    func_stdcall : 1; /* the callee pops its stack arguments: stdcall, also with regparm(n) */
 };
 
 /* symbol management */
diff --git a/tccgen.c b/tccgen.c
index a46a7a8..b50a21b 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -1268,6 +1268,8 @@ static void merge_funcattr(struct FuncAttr *fa, struct FuncAttr *fa1)
       fa->func_cdecl = 1, fa->func_call = FUNC_CDECL;
     if (fa1->func_used)
       fa->func_used = 1;
+    if (fa1->func_stdcall)
+      fa->func_stdcall = 1;
 }
 
 /* Merge attributes.  */
@@ -2953,6 +2955,8 @@ static int is_compatible_func(CType *type1, CType *type2)
         && !(s1->f.func_cdecl && is_default_regparm(&s2->f))
         && !(s2->f.func_cdecl && is_default_regparm(&s1->f)))
         return 0;
+    if (s1->f.func_stdcall != s2->f.func_stdcall)
+        return 0;
     if (s1->f.func_type != s2->f.func_type
         && s1->f.func_type != FUNC_OLD
         && s2->f.func_type != FUNC_OLD)
@@ -4265,7 +4269,11 @@ redo:
         case TOK_STDCALL1:
         case TOK_STDCALL2:
         case TOK_STDCALL3:
-            ad->f.func_call = FUNC_STDCALL;
+            /* with regparm(n) (either order) the registers stay and the
+               callee pops the rest: GCC's regparm(3),stdcall */
+            ad->f.func_stdcall = 1;
+            if (!(ad->f.func_call >= FUNC_FASTCALL1 && ad->f.func_call <= FUNC_FASTCALL3))
+                ad->f.func_call = FUNC_STDCALL;
             break;
 #ifdef TCC_TARGET_I386
         case TOK_REGPARM1:
@@ -4278,6 +4286,8 @@ redo:
                 n = 0;
             if (n > 0)
                 ad->f.func_call = FUNC_FASTCALL1 + n - 1;
+            else if (ad->f.func_stdcall)
+                ad->f.func_call = FUNC_STDCALL;
             else
                 /* regparm(0), the kernel's asmlinkage: the stack even
                    under -mregparm (the asm callee reads it there) */
diff --git a/tests/tests2/157_i386_regparm_pic.c b/tests/tests2/157_i386_regparm_pic.c
index b0ff5f8..35e1bf0 100644
--- a/tests/tests2/157_i386_regparm_pic.c
+++ b/tests/tests2/157_i386_regparm_pic.c
@@ -120,8 +120,40 @@ static void test_regvar_pair(void)
            pair_rw_eax(0xffffffffULL));
 }
 
+/* fix 116: regparm(3) combined with stdcall (busybox's FAST_FUNC): the first
+   three arguments in eax, edx, ecx and the callee pops the rest, as GCC does;
+   tcc let stdcall win and put everything on the stack, so busybox's SHA-NI
+   assembly, which reads the context from eax, wrote through a code address.
+   The callee here is assembly that records what it got and returns with
+   "ret $4"; the caller's stack pointer must be the same after the call. */
+unsigned fast_got[4];
+__asm__(".text\n\t.globl fast_asm\nfast_asm:\n"
+        "\tmovl %eax, fast_got\n\tmovl %edx, fast_got+4\n\tmovl %ecx, fast_got+8\n"
+        "\tmovl 4(%esp), %eax\n\tmovl %eax, fast_got+12\n\tret $4\n");
+void __attribute__((regparm(3),stdcall)) fast_asm(unsigned a, unsigned b, unsigned c, unsigned d);
+void __attribute__((stdcall,regparm(3))) fast_asm2(unsigned a, unsigned b, unsigned c, unsigned d) __asm__("fast_asm");
+static void __attribute__((regparm(3),stdcall)) fast_c(unsigned a, unsigned b, unsigned c, unsigned d)
+{
+    fast_got[0] = a; fast_got[1] = b; fast_got[2] = c; fast_got[3] = d;
+}
+static void test_regparm_stdcall(void)
+{
+    unsigned sp1, sp2, sp3;
+    void (__attribute__((regparm(3),stdcall)) *fp)(unsigned, unsigned, unsigned, unsigned) = fast_c;
+    asm volatile("movl %%esp, %0" : "=r"(sp1));
+    fast_asm(1, 2, 3, 4);
+    asm volatile("movl %%esp, %0" : "=r"(sp2));
+    printf("regparm stdcall asm: %u %u %u %u sp %d\n", fast_got[0], fast_got[1], fast_got[2], fast_got[3], sp1 == sp2);
+    fast_asm2(5, 6, 7, 8);
+    printf("stdcall regparm asm: %u %u %u %u\n", fast_got[0], fast_got[1], fast_got[2], fast_got[3]);
+    fp(9, 10, 11, 12);
+    asm volatile("movl %%esp, %0" : "=r"(sp3));
+    printf("regparm stdcall c: %u %u %u %u sp %d\n", fast_got[0], fast_got[1], fast_got[2], fast_got[3], sp1 == sp3);
+}
+
 int main(void)
 {
+    test_regparm_stdcall();
     test_regvar_pair();
     struct { char pre; struct lock l; char post; } __attribute__((packed)) s;
     memset(&s, 0x55, sizeof s);

From 979e2554af3c3850b240deace3119aa73e18f383 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:20:09 +0300
Subject: [PATCH] tccelf: drop assembler local labels from the output symbol
 table

Numeric local labels ("1:", named L..<n> by tccasm) and ".L*" labels
that are LOCAL NOTYPE and defined are not written to the output symbol
table, as GNU as does.  A referenced one is replaced by an STT_SECTION
symbol of its section (created on demand, one per section per file)
with the label value added to the addend (RELA) or in place (REL).
The input symbols are processed from a copy because the table is
rewritten in place and the added section symbols would overtake
entries not read yet.

The two-pass inline assembler rolls back section data but not the
symbol table, so every discarded pass left its labels behind, some
pointing into the middle of an instruction (objtool: "L..773(): can't
find starting instruction").  tcc's own anonymous symbols "L.<n>" are
untouched.
---
 tccelf.c | 88 ++++++++++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 80 insertions(+), 8 deletions(-)

diff --git a/tccelf.c b/tccelf.c
index 9e2d136..8c1a6d4 100644
--- a/tccelf.c
+++ b/tccelf.c
@@ -179,14 +179,39 @@ ST_FUNC void tccelf_begin_file(TCCState *s1)
 #endif
 }
 
-static void update_relocs(TCCState *s1, Section *s, int *old_to_new_syms, int first_sym);
+static void update_relocs(TCCState *s1, Section *s, int *old_to_new_syms,
+                          addr_t *addend_adj, int first_sym);
+
+/* Local labels of the assembler: numeric ones ("1:", named "L..<n>" by
+   tccasm) and ".L*".  Like GNU as, tcc does not keep them in the output
+   symbol table; relocations against them go through the section symbol.
+   (Among other things this removes the labels of discarded passes of the
+   inline assembler, which may point into the middle of an instruction.) */
+static int is_asm_local_label(ElfSym *sym, const char *name)
+{
+    if (ELFW(ST_BIND)(sym->st_info) != STB_LOCAL
+        || ELFW(ST_TYPE)(sym->st_info) != STT_NOTYPE
+        || sym->st_shndx == SHN_UNDEF || sym->st_shndx >= SHN_LORESERVE)
+        return 0;
+    if (name[0] == '.' && name[1] == 'L')
+        return 1;
+    if (name[0] == 'L' && name[1] == '.' && name[2] == '.' && isnum(name[3])) {
+        name += 3;
+        while (isnum(*name))
+            name++;
+        return *name == 0;
+    }
+    return 0;
+}
 
 /* At the end of compilation, convert any UNDEF syms to global, and merge
    with previously existing symbols */
 ST_FUNC void tccelf_end_file(TCCState *s1)
 {
     Section *s = s1->symtab;
-    int first_sym, nb_syms, *tr, i;
+    int first_sym, nb_syms, *tr, *secsym, i;
+    addr_t *adj;
+    ElfSym *syms;
 
     first_sym = s->sh_offset / sizeof (ElfSym);
     nb_syms = s->data_offset / sizeof (ElfSym) - first_sym;
@@ -194,9 +219,42 @@ ST_FUNC void tccelf_end_file(TCCState *s1)
     s->link->data_offset = s->link->sh_offset;
     s->hash = s->reloc, s->reloc = NULL;
     tr = tcc_mallocz(nb_syms * sizeof *tr);
+    adj = tcc_mallocz(nb_syms * sizeof *adj);
+    secsym = tcc_mallocz(s1->nb_sections * sizeof *secsym);
+    /* the symbols are rewritten in place; section symbols added for local
+       labels would overtake the ones not read yet, so work from a copy */
+    syms = tcc_malloc(nb_syms * sizeof *syms);
+    memcpy(syms, (ElfSym*)s->data + first_sym, nb_syms * sizeof *syms);
+    /* which symbols have relocations (a local label without any needs no
+       section symbol); adj doubles as the mark */
+    for (i = 1; i < s1->nb_sections; i++) {
+        Section *sr = s1->sections[i];
+        ElfW_Rel *rel;
+        if (sr->sh_type == SHT_RELX && sr->link == s)
+            for_each_elem(sr, 0, rel, ElfW_Rel) {
+                int si = ELFW(R_SYM)(rel->r_info) - first_sym;
+                if (si >= 0 && si < nb_syms)
+                    adj[si] = 1;
+            }
+    }
 
     for (i = 0; i < nb_syms; ++i) {
-        ElfSym *sym = (ElfSym*)s->data + first_sym + i;
+        ElfSym *sym = syms + i;
+        const char *name = (char*)s->link->data + sym->st_name;
+        if (is_asm_local_label(sym, name)) {
+            int shndx = sym->st_shndx;
+            if (!adj[i]) {
+                tr[i] = 0; /* unreferenced: just drop it */
+                continue;
+            }
+            if (!secsym[shndx])
+                secsym[shndx] = set_elf_sym(s, 0, 0,
+                    ELFW(ST_INFO)(STB_LOCAL, STT_SECTION), 0, shndx, NULL);
+            tr[i] = secsym[shndx];
+            adj[i] = sym->st_value;
+            continue;
+        }
+        adj[i] = 0;
         if (sym->st_shndx == SHN_UNDEF) {
             int sym_bind = ELFW(ST_BIND)(sym->st_info);
             int sym_type = ELFW(ST_TYPE)(sym->st_info);
@@ -214,10 +272,13 @@ ST_FUNC void tccelf_end_file(TCCState *s1)
             sym->st_info = ELFW(ST_INFO)(sym_bind, sym_type);
         }
         tr[i] = set_elf_sym(s, sym->st_value, sym->st_size, sym->st_info,
-            sym->st_other, sym->st_shndx, (char*)s->link->data + sym->st_name);
+            sym->st_other, sym->st_shndx, name);
     }
     /* now update relocations */
-    update_relocs(s1, s, tr, first_sym);
+    update_relocs(s1, s, tr, adj, first_sym);
+    tcc_free(syms);
+    tcc_free(secsym);
+    tcc_free(adj);
     tcc_free(tr);
     /* record text/data/bss output for -bench info */
     for (i = 0; i < 4; ++i) {
@@ -843,7 +904,8 @@ ST_FUNC struct sym_attr *get_sym_attr(TCCState *s1, int index, int alloc)
     return &s1->sym_attrs[index];
 }
 
-static void update_relocs(TCCState *s1, Section *s, int *old_to_new_syms, int first_sym)
+static void update_relocs(TCCState *s1, Section *s, int *old_to_new_syms,
+                          addr_t *addend_adj, int first_sym)
 {
     int i, type, sym_index;
     Section *sr;
@@ -857,6 +919,16 @@ static void update_relocs(TCCState *s1, Section *s, int *old_to_new_syms, int fi
                 type = ELFW(R_TYPE)(rel->r_info);
                 if ((sym_index -= first_sym) < 0)
                     continue; /* zero sym_index in reloc (can happen with asm) */
+                if (addend_adj && addend_adj[sym_index]) {
+                    /* symbol replaced by its section symbol */
+#if SHT_RELX == SHT_RELA
+                    rel->r_addend += addend_adj[sym_index];
+#else
+                    /* REL: the addend lives in the relocated data */
+                    add32le(s1->sections[sr->sh_info]->data + rel->r_offset,
+                            addend_adj[sym_index]);
+#endif
+                }
                 sym_index = old_to_new_syms[sym_index];
                 rel->r_info = ELFW(R_INFO)(sym_index, type);
             }
@@ -907,7 +979,7 @@ static void sort_syms(TCCState *s1, Section *s)
     memcpy(s->data, new_syms, nb_syms * sizeof(ElfW(Sym)));
     tcc_free(new_syms);
 
-    update_relocs(s1, s, old_to_new_syms, 0);
+    update_relocs(s1, s, old_to_new_syms, NULL, 0);
     tcc_free(old_to_new_syms);
 }
 
@@ -1055,7 +1127,7 @@ static void update_gnu_hash(TCCState *s1, Section *gnu_hash)
     tcc_free(buck);
     tcc_free(nextbuck);
 
-    update_relocs(s1, dynsym, old_to_new_syms, 0);
+    update_relocs(s1, dynsym, old_to_new_syms, NULL, 0);
 
     /* modify the versions */
     vs = versym_section;

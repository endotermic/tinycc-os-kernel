From 775dd3f074b583fc0c44b0b856ddf93e799dc76d Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Thu, 22 Oct 2026 11:49:50 +0300
Subject: [PATCH] tccgen: an initialized definition after a tentative one in a
 named section

"static __videocard video_vga;" followed by "static __videocard video_vga
= { ... }" (arch/x86/boot/video-*.c, both in section ".videocards")
crashed: the tentative definition made the new section NOBITS, so the
initializer wrote into a section without data.  The initialized object
turns the section back into PROGBITS (allocating what was reserved so
far) and, when the tentative definition is still the last object there,
takes its place, so that the table does not keep a zeroed copy (the
kernel iterates .videocards as an array).

Verified: a two-definition test object has one 16-byte symbol in .foo;
the three video-*.c files compile; make test passes.
---
 tccgen.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/tccgen.c b/tccgen.c
index 5598f71..7ccb432 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -9289,12 +9289,32 @@ static void decl_initializer_alloc(CType *type, AttributeDef *ad, int r,
                 if (!has_init)
                     sec->sh_type = SHT_NOBITS;
             }
+        } else if (has_init && sec->sh_type == SHT_NOBITS) {
+            /* the section's first object had no initializer (a tentative
+               definition: the kernel's "static __videocard video_vga;"
+               before its initialized definition), so it became NOBITS;
+               an initialized object makes it PROGBITS again, with the
+               bytes of what was allocated so far */
+            sec->sh_type = SHT_PROGBITS;
+            section_realloc(sec, sec->data_offset);
         }
 
 #ifdef CONFIG_TCC_BCHECK
         if (bcheck)
             size = size + 1; /* add padding */
 #endif
+        if (sec && v && ad->section) {
+            /* a tentative definition in the same named section that is
+               still the last object there: the definition takes its place
+               (otherwise the kernel's "static __videocard x; ... static
+               __videocard x = {..}" would leave a zeroed copy in the
+               .videocards table) */
+            Sym *ps = sym_find(v);
+            ElfSym *es;
+            if (ps && ps->c && !(ps->type.t & VT_EXTERN) && (es = elfsym(ps))
+                && es->st_shndx == sec->sh_num && es->st_value + es->st_size == sec->data_offset)
+                sec->data_offset = es->st_value;
+        }
         if (sec) {
 	    addr = section_add(sec, size, align);
         } else {

From 647865d6e11be52a2857fde722617e0d1fbd2281 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:20:09 +0300
Subject: [PATCH] x86_64-asm: "mov $imm,%r64" with an immediate in 2^31..2^32-1

Such a value is an imm32 for 32-bit instructions but was sign-extended
by the imm32 form of a 64-bit mov ("mov $0x80000000,%rdi" gave
0xffffffff80000000).  Give it the OP_IM64 bit too and never select the
generic register-sized 0xb0 mov entry for a 64-bit destination: values
that fit a signed 32-bit immediate take the 0xc7 form, the others the
imm64 (movabs) entry, as GNU as does.
---
 i386-asm.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/i386-asm.c b/i386-asm.c
index 7d6d3b7..2afe86a 100644
--- a/i386-asm.c
+++ b/i386-asm.c
@@ -431,6 +431,11 @@ static void parse_operand(TCCState *s1, Operand *op)
 #ifdef TCC_TARGET_X86_64
             if (op->e.v != (int32_t)op->e.v && op->e.v != (uint32_t)op->e.v)
                 op->type = OP_IM64;
+            else if (op->e.v != (int32_t)op->e.v)
+                /* 2^31..2^32-1: an imm32 for 32-bit operations, but a
+                   mov to a 64-bit register needs the imm64 form (the
+                   imm32 one sign-extends), as GNU as does */
+                op->type |= OP_IM64;
 #endif
         }
     } else {
@@ -799,11 +804,12 @@ again:
         if (pa->nb_ops != nb_ops)
             continue;
 #ifdef TCC_TARGET_X86_64
-	/* Special case for moves.  Selecting the IM64->REG64 form
-	   should only be done if we really have an >32bit imm64, and that
-	   is hardcoded.  Ignore it here.  */
-	if (pa->opcode == 0xb0 && ops[0].type != OP_IM64
-	    && (ops[1].type & OP_REG) == OP_REG64
+	/* Special case for moves to a 64-bit register: never through the
+	   generic 0xb0 form (it would size the immediate by the register:
+	   4 bytes after a b8+r opcode); an immediate that fits a signed
+	   32-bit value takes the 0xc7 form, anything else the dedicated
+	   imm64 (movabs) entry below.  */
+	if (pa->opcode == 0xb0 && (ops[1].type & OP_REG) == OP_REG64
 	    && !(pa->instr_type & OPC_0F))
 	    continue;
 #endif

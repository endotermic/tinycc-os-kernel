From 3e70529c3fd4d1bdaf4bf66031ed92f7c9267ec2 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Thu, 22 Oct 2026 12:19:41 +0300
Subject: [PATCH] i386-asm: 64-bit addends on immediates; tccdbg: no .eh_frame
 without functions

"addq $(init_top_pgt - __START_KERNEL_map), %rax" in the kernel's
head_64.S is init_top_pgt + 0x80000000; the addend went through
gen_addr32()'s int and became init_top_pgt - 0x80000000, which does not
fit the R_X86_64_32S relocation at link time.  The 64-bit assembler
emits the relocation with the addend as computed (GNU as's result).

The .eh_frame section and its CIE are created when the first FDE is
written, so an assembler file (no functions) has no .eh_frame; GNU as
emits none either, and the kernel's linker script has no place for it
(an orphan section warning on every .S object).  C output is unchanged.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 i386-asm.c |  6 ++++++
 tccdbg.c   | 10 ++++++++++
 2 files changed, 16 insertions(+)

diff --git a/i386-asm.c b/i386-asm.c
index 0d7931c..0ad86cc 100644
--- a/i386-asm.c
+++ b/i386-asm.c
@@ -517,6 +517,12 @@ ST_FUNC void gen_expr32(ExprValue *pe)
            sign-extended one of the kernel code model) */
         greloca(cur_text_section, pe->sym, ind, R_X86_64_32, pe->v);
         gen_le32(0);
+    } else if (pe->sym) {
+        /* the 64-bit addend as computed: "$(init_top_pgt - __START_KERNEL_map)"
+           in the kernel's head_64.S is sym + 0x80000000, which gen_addr32's
+           int would turn into sym - 0x80000000 */
+        greloca(cur_text_section, pe->sym, ind, R_X86_64_32S, pe->v);
+        gen_le32(0);
     }
 #endif
     else
diff --git a/tccdbg.c b/tccdbg.c
index b0e9409..dcc51d2 100644
--- a/tccdbg.c
+++ b/tccdbg.c
@@ -805,7 +805,15 @@ static void dwarf_sleb128_op (TCCState *s1, long long value)
 }
 
 #if TCC_EH_FRAME
+/* The .eh_frame section and its CIE are made when the first function's
+   FDE is written: a unit without functions (an assembler file) gets no
+   .eh_frame at all, like with GNU as. */
 ST_FUNC void tcc_eh_frame_start(TCCState *s1)
+{
+    eh_frame_section = NULL;
+}
+
+static void tcc_eh_frame_cie(TCCState *s1)
 {
     if (!s1->unwind_tables)
         return;
@@ -882,6 +890,8 @@ static void tcc_debug_frame_end(TCCState *s1, int size)
     int eh_section_sym;
     unsigned long fde_start;
 
+    if (!eh_frame_section)
+        tcc_eh_frame_cie(s1);
     if (!eh_frame_section)
 	return;
     eh_section_sym = dwarf_get_section_sym(text_section);

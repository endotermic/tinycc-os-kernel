From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:20:08 +0300
Subject: [PATCH] tests/Makefile: search the source tree for sources only

The blanket "VPATH = $(TOPSRC)/tests $(TOPSRC)" also matched generated
files (test.ref, libtcc_test, libtcc_test_mt, asm-c-connect) left behind
in the source directory by an earlier in-tree "make test".  make then
treated them as up to date and an out-of-tree "make test" failed with
exit 127 or "diff: test.ref: No such file".

Use "vpath %.c" and "vpath %.S" so that only sources are looked up in
the source tree.
---
 tests/Makefile | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/Makefile b/tests/Makefile
index adb5733..413698e 100644
--- a/tests/Makefile
+++ b/tests/Makefile
@@ -4,7 +4,11 @@
 
 TOP = ..
 include $(TOP)/Makefile
-VPATH = $(TOPSRC)/tests $(TOPSRC)
+# Search the source tree for sources only.  A plain VPATH would also find
+# generated files (test.ref, libtcc_test, ...) left behind by an in-tree
+# run and make an out-of-tree 'make test' use/miss them.
+vpath %.c $(TOPSRC)/tests $(TOPSRC)
+vpath %.S $(TOPSRC)/tests $(TOPSRC)
 CFLAGS := $(filter-out -g% -O%,$(CFLAGS)) -I$(TOPSRC) -I$(TOP) $(LDFLAGS)
 
 # what tests to run

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 23 Oct 2026 15:38:11 +0300
Subject: [PATCH] include/limits.h: take the C library's limits first, fill in
 only what it leaves out

musl's <limits.h> defines every ISO limit itself, with other spellings than
this file, so every program including <limits.h> on a musl system got
"CHAR_MIN redefined" and a dozen more warnings (tests2/118_switch).  The C
library's file is now included first (glibc skips its own #include_next
because _GCC_LIMITS_H_ is already defined, and leaves the ISO limits to us
when __GNUC__ is defined) and the limits are defined afterwards under
#ifndef, so a library that has them keeps its own.
---
 include/limits.h | 41 +++++++++++++++++++++++++++++++++++++----
 1 file changed, 37 insertions(+), 4 deletions(-)

diff --git a/include/limits.h b/include/limits.h
index bc9d092..2ab6cee 100644
--- a/include/limits.h
+++ b/include/limits.h
@@ -5,15 +5,36 @@
    expects the compiler's file to define them and #include_next's it,
    looking for GCC's _GCC_LIMITS_H_ guard.  This file is found first on
    the include path (it may even be there twice, through -I and -B, so
-   it has no guard of its own and always passes on to the next one), and
-   the C library's file adds the POSIX limits. */
+   the #include_next is outside the guard and always passes on to the
+   next one), and the C library's file adds the POSIX limits.
+
+   The C library's file comes first and the ISO limits are filled in
+   afterwards, only where it left them out: glibc does (with __GNUC__,
+   and it skips its own #include_next because _GCC_LIMITS_H_ is already
+   defined), musl defines them all itself, with other spellings, which
+   would otherwise be "redefined" warnings in every program including
+   <limits.h> on a musl system (tcc tests2/118_switch). */
 #ifndef _GCC_LIMITS_H_
 #define _GCC_LIMITS_H_
+#define _TCC_LIMITS_DEFINE
+#endif
+#include_next <limits.h>
+#ifdef _TCC_LIMITS_DEFINE
+#undef _TCC_LIMITS_DEFINE
 
+#ifndef CHAR_BIT
 #define CHAR_BIT 8
+#endif
+#ifndef SCHAR_MAX
 #define SCHAR_MAX 127
+#endif
+#ifndef SCHAR_MIN
 #define SCHAR_MIN (-128)
+#endif
+#ifndef UCHAR_MAX
 #define UCHAR_MAX 255
+#endif
+#ifndef CHAR_MIN
 #ifdef __CHAR_UNSIGNED__
 #define CHAR_MIN 0
 #define CHAR_MAX UCHAR_MAX
@@ -21,12 +42,18 @@
 #define CHAR_MIN SCHAR_MIN
 #define CHAR_MAX SCHAR_MAX
 #endif
+#endif
+#ifndef SHRT_MAX
 #define SHRT_MAX 32767
 #define SHRT_MIN (-32768)
 #define USHRT_MAX 65535
+#endif
+#ifndef INT_MAX
 #define INT_MAX 2147483647
 #define INT_MIN (-INT_MAX - 1)
 #define UINT_MAX 4294967295U
+#endif
+#ifndef LONG_MAX
 #if __SIZEOF_LONG__ == 8
 #define LONG_MAX 9223372036854775807L
 #define ULONG_MAX 18446744073709551615UL
@@ -35,13 +62,19 @@
 #define ULONG_MAX 4294967295UL
 #endif
 #define LONG_MIN (-LONG_MAX - 1L)
+#endif
+#ifndef LLONG_MAX
 #define LLONG_MAX 9223372036854775807LL
 #define LLONG_MIN (-LLONG_MAX - 1LL)
 #define ULLONG_MAX 18446744073709551615ULL
+#endif
+#ifndef LONG_LONG_MAX
 #define LONG_LONG_MAX LLONG_MAX
 #define LONG_LONG_MIN LLONG_MIN
 #define ULONG_LONG_MAX ULLONG_MAX
+#endif
+#ifndef MB_LEN_MAX
 #define MB_LEN_MAX 16
+#endif
 
-#endif /* _GCC_LIMITS_H_ */
-#include_next <limits.h>
+#endif /* _TCC_LIMITS_DEFINE */

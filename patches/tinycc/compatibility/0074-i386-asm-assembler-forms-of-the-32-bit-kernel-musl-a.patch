             /* we load the got offset */
             add32le(ptr, get_sym_attr(s1, sym_index, 0)->got_offset);
             return;
+        /* the 8- and 16-bit relocations of the assembler (".word sym",
+           "jecxz 1f" and the other rel8-only jumps, 16-bit code): applied

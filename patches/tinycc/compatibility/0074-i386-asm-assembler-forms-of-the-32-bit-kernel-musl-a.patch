             return;
         case R_386_PC16:
-            if (s1->output_format != TCC_OUTPUT_FORMAT_BINARY)
-                goto output_file;
-            write16le(ptr, read16le(ptr) + val - addr);
+            val += (int16_t)read16le(ptr) - addr;
+            if ((int32_t)val != (int16_t)val)
+                goto overflow;
+            write16le(ptr, val);
+            return;
+        case R_386_8:
+            val += *ptr;
+            if (val + 0x80 > 0x17f)
+                goto overflow;
+            *ptr = val;
+            return;
+        case R_386_PC8:
+            val += (int8_t)*ptr - addr;
+            if ((int32_t)val != (int8_t)val) {
+            overflow:
+                tcc_error_noabort("relocation %d at %x truncated to fit (value %x)", type, (unsigned)addr, (unsigned)val);
+            }
+            *ptr = val;
             return;

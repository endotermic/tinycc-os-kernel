From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 27 Nov 2026 16:13:30 +0200
Subject: [PATCH] tests: 188_asm_small_pcrel, the case of the previous commit

---
 tests/tests2/188_asm_small_pcrel.c      | 146 ++++++++++++++++++++++++
 tests/tests2/188_asm_small_pcrel.expect |   8 ++
 tests/tests2/Makefile                   |   4 +
 3 files changed, 158 insertions(+)
 create mode 100644 tests/tests2/188_asm_small_pcrel.c
 create mode 100644 tests/tests2/188_asm_small_pcrel.expect

diff --git a/tests/tests2/188_asm_small_pcrel.c b/tests/tests2/188_asm_small_pcrel.c
new file mode 100644
index 0000000..322aa8f
--- /dev/null
+++ b/tests/tests2/188_asm_small_pcrel.c
@@ -0,0 +1,146 @@
+/* i386, x86_64 (tinycc-os-kernel fix 148): like GNU as, an 8- or 16-bit
+   PC-relative field whose label is a local one of the same section is
+   resolved by the assembler, also for a forward branch: tcc left an
+   R_X86_64_PC16 (R_386_PC16/PC8) relocation, which GRUB's module loader
+   does not implement ("relocation 0xd is not implemented yet" for the
+   forward branches of its relocator16.S).  The test is compiled with -c
+   and then reads its own object: the local branches must have no
+   relocation and must land on their labels; the branches to a label of
+   another section and to a global symbol keep theirs. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <elf.h>
+
+#ifdef __x86_64__
+typedef Elf64_Ehdr Ehdr; typedef Elf64_Shdr Shdr; typedef Elf64_Sym Esym;
+#define R_TYPE(i) ELF64_R_TYPE(i)
+#define R_SYM(i) ELF64_R_SYM(i)
+#define PC16 R_X86_64_PC16
+#define PC8 R_X86_64_PC8
+#else
+typedef Elf32_Ehdr Ehdr; typedef Elf32_Shdr Shdr; typedef Elf32_Sym Esym;
+#define R_TYPE(i) ELF32_R_TYPE(i)
+#define R_SYM(i) ELF32_R_SYM(i)
+#define PC16 R_386_PC16
+#define PC8 R_386_PC8
+#endif
+
+__asm__(
+    "  .section .text16,\"ax\"\n"
+    "  .code16\n"
+    "  .globl g16\n"
+    "g16:\n"
+    "s_jmp:   jmp L_done\n"          /* e9 rel16 */
+    "s_jnz:   jnz L_mid\n"           /* 0f 85 rel16 */
+    "s_call:  call L_far\n"          /* e8 rel16 */
+    "s_loop:  loop L_near\n"         /* e2 rel8 */
+    "  nop\n"
+    "L_near:  nop\n"
+    "L_mid:   nop\n"
+    "  .space 200\n"
+    "L_far:   ret\n"
+    "  .space 300\n"
+    "L_done:  ret\n"
+    "s_ext:   jmp ext16\n"           /* local, another section: keeps it */
+    "s_glob:  jmp g16\n"             /* global: keeps it, as with GNU as */
+    "  .code32\n"
+    "s_jecxz: jecxz L_end32\n"       /* e3 rel8 */
+    "s_loop32: loop L_end32\n"       /* e2 rel8 */
+    "  nop\n"
+    "L_end32: ret\n"
+#ifdef __x86_64__
+    "  .code64\n"
+#endif
+    "  .text\n"
+    "ext16: ret\n");
+
+static unsigned char *obj;
+static Shdr *sh;
+static int nsh;
+
+static Esym *symtab(int *n, char **str)
+{
+    int i;
+    for (i = 0; i < nsh; i++)
+        if (sh[i].sh_type == SHT_SYMTAB) {
+            *n = sh[i].sh_size / sizeof(Esym);
+            *str = (char *)obj + sh[sh[i].sh_link].sh_offset;
+            return (Esym *)(obj + sh[i].sh_offset);
+        }
+    return NULL;
+}
+
+static long sym_value(const char *name, int *sec)
+{
+    int i, n;
+    char *str;
+    Esym *s = symtab(&n, &str);
+    for (i = 0; i < n; i++)
+        if (!strcmp(str + s[i].st_name, name)) {
+            *sec = s[i].st_shndx;
+            return s[i].st_value;
+        }
+    printf("no symbol %s\n", name);
+    exit(1);
+    return 0;
+}
+
+/* the target of the branch at label 'site': opcode length 'op', a 'size'-byte displacement */
+static void check(const char *site, int op, int size, const char *label)
+{
+    int sec, sec2;
+    long at = sym_value(site, &sec), to = sym_value(label, &sec2), d;
+    unsigned char *p = obj + sh[sec].sh_offset + at + op;
+    d = size == 2 ? (short)(p[0] | p[1] << 8) : (signed char)p[0];
+    printf("%-9s -> %-8s %s\n", site, label,
+           sec == sec2 && at + op + size + d == to ? "ok" : "WRONG TARGET");
+}
+
+int main(int argc, char **argv)
+{
+    FILE *f;
+    long len;
+    int i, n, nsym;
+    char *str;
+    Esym *syms;
+
+    if (argc < 2 || !(f = fopen(argv[1], "rb")))
+        return printf("usage: %s OBJ\n", argv[0]), 1;
+    fseek(f, 0, SEEK_END);
+    len = ftell(f);
+    rewind(f);
+    obj = malloc(len);
+    if (fread(obj, 1, len, f) != (size_t)len)
+        return 1;
+    fclose(f);
+    sh = (Shdr *)(obj + ((Ehdr *)obj)->e_shoff);
+    nsh = ((Ehdr *)obj)->e_shnum;
+    syms = symtab(&nsym, &str);
+
+    for (i = 0; i < nsh; i++) {
+        unsigned char *r;
+        int entsize = sh[i].sh_entsize;
+        if (sh[i].sh_type != SHT_REL && sh[i].sh_type != SHT_RELA)
+            continue;
+        for (r = obj + sh[i].sh_offset, n = 0; n < (int)(sh[i].sh_size / entsize); n++, r += entsize) {
+            unsigned long info = sh[i].sh_type == SHT_RELA
+#ifdef __x86_64__
+                ? ((Elf64_Rela *)r)->r_info : ((Elf64_Rel *)r)->r_info;
+#else
+                ? ((Elf32_Rela *)r)->r_info : ((Elf32_Rel *)r)->r_info;
+#endif
+            int type = R_TYPE(info);
+            if (type == PC16 || type == PC8)
+                printf("relocation %s against %s\n", type == PC16 ? "PC16" : "PC8",
+                       str + syms[R_SYM(info)].st_name);
+        }
+    }
+    check("s_jmp", 1, 2, "L_done");
+    check("s_jnz", 2, 2, "L_mid");
+    check("s_call", 1, 2, "L_far");
+    check("s_loop", 1, 1, "L_near");
+    check("s_jecxz", 1, 1, "L_end32");
+    check("s_loop32", 1, 1, "L_end32");
+    return 0;
+}
diff --git a/tests/tests2/188_asm_small_pcrel.expect b/tests/tests2/188_asm_small_pcrel.expect
new file mode 100644
index 0000000..41a6707
--- /dev/null
+++ b/tests/tests2/188_asm_small_pcrel.expect
@@ -0,0 +1,8 @@
+relocation PC16 against ext16
+relocation PC16 against g16
+s_jmp     -> L_done   ok
+s_jnz     -> L_mid    ok
+s_call    -> L_far    ok
+s_loop    -> L_near   ok
+s_jecxz   -> L_end32  ok
+s_loop32  -> L_end32  ok
diff --git a/tests/tests2/Makefile b/tests/tests2/Makefile
index 80acfe2..2059c52 100644
--- a/tests/tests2/Makefile
+++ b/tests/tests2/Makefile
@@ -25,6 +25,7 @@ ifeq (,$(filter i386 x86_64,$(ARCH)))
  SKIP += 127_asm_goto.test    # hardcodes x86 asm
  SKIP += 155_x86_inline_asm.test # x86 inline asm
  SKIP += 160_asm_offsets.test # x86 asm text
+ SKIP += 188_asm_small_pcrel.test # x86 asm, ELF objects
 endif
 ifeq ($(CONFIG_backtrace),no)
  SKIP += 113_btdll.test
@@ -192,6 +193,9 @@ endif
 162_i386_mregparm.test: GEN = $(GEN-TCC)
 186_i386_regparm0_fnptr.test: T1 = ( $(TCC) -mregparm=3 -run $1 )
 186_i386_regparm0_fnptr.test: GEN = $(GEN-TCC)
+# the asm test reads its own object: compiled with -c first
+188_asm_small_pcrel.test: T1 = ( $(TCC) -c $1 -o $*.o && $(TCC) -run $1 $*.o && rm -f $*.o )
+188_asm_small_pcrel.test: GEN = $(GEN-TCC)
 
 # archives with circular references inside -Wl,--start-group/--end-group:
 # a and a_helper in one archive (two members), b in another

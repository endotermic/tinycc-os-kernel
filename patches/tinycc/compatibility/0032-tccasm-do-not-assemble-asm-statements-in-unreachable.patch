From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:20:09 +0300
Subject: [PATCH] tccasm: do not assemble asm statements in unreachable code

GCC never assembles an asm statement after return/goto, in a dead arm
of a constant condition or inside sizeof/typeof, and code relies on
that (32-bit only "pushfl" after an early return on 64-bit).  When
nocode_wanted is set, consume the statement syntactically instead of
assembling it.
---
 tccasm.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/tccasm.c b/tccasm.c
index e5ef30c..e48a4e4 100644
--- a/tccasm.c
+++ b/tccasm.c
@@ -1919,6 +1919,27 @@ ST_FUNC void asm_instr(void)
         next();
     }
 
+    if (nocode_wanted) {
+        /* Unreachable code (after return/goto, dead branches of constant
+           conditions) or sizeof/typeof: GCC never assembles such a
+           statement, and code relies on that (e.g. 32-bit only asm after
+           an early return on 64-bit).  Consume it without assembling. */
+        int depth = 0;
+        skip('(');
+        for (;;) {
+            if (tok == TOK_EOF)
+                expect("')'");
+            if (tok == '(')
+                depth++;
+            else if (tok == ')' && depth-- == 0)
+                break;
+            next();
+        }
+        next();
+        skip(';');
+        return;
+    }
+
     astr1 = parse_asm_str();
     cstr_new_s(&astr);
     cstr_cat(&astr, astr1->data, astr1->size);

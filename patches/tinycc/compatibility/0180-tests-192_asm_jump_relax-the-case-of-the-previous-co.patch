     "  .globl g16\n"
     "g16:\n"
     "s_jmp:   jmp L_done\n"          /* e9 rel16 */
-    "s_jnz:   jnz L_mid\n"           /* 0f 85 rel16 */
+    "s_jnz:   jnz L_far\n"           /* 0f 85 rel16 (L_mid would be rel8) */
     "s_call:  call L_far\n"          /* e8 rel16 */
     "s_loop:  loop L_near\n"         /* e2 rel8 */

---
 tests/tests2/194_i386_mrtd.c      | 108 ++++++++++++++++++++++++++++++
 tests/tests2/194_i386_mrtd.expect |   9 +++
 tests/tests2/Makefile             |   4 +-
 3 files changed, 120 insertions(+), 1 deletion(-)

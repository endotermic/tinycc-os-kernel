---
 tests/tests2/189_asm_pass_code_mode.c      | 59 ++++++++++++++++++++++
 tests/tests2/189_asm_pass_code_mode.expect |  2 +
 tests/tests2/Makefile                      |  1 +
 3 files changed, 62 insertions(+)

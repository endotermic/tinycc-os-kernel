From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Sat, 28 Nov 2026 15:43:08 +0200
Subject: [PATCH] i386: -mrtd, the callee pops its stack arguments unless the
 function is variadic or cdecl, with the registers of -mregparm or regparm(n)
 kept; cdecl now only means that the caller pops, as with GCC (registers of
 -mregparm or regparm(n) stay: "cdecl, regparm(3)"), and only regparm(0)
 (func_noregparm) puts the arguments on the stack; the conventions of two
 declarations combine (norm_funcall) (GRUB's i386-pc code is built with -mrtd
 -mregparm=3: tcc ignored -mrtd, and passed grub_setjmp's argument on the
 stack)

---
 libtcc.c |  5 +++
 tcc.h    |  4 ++-
 tccgen.c | 96 ++++++++++++++++++++++++++++++++++++++++----------------
 3 files changed, 77 insertions(+), 28 deletions(-)

diff --git a/libtcc.c b/libtcc.c
index c212813..ae52f89 100644
--- a/libtcc.c
+++ b/libtcc.c
@@ -2179,6 +2179,11 @@ PUB_FUNC int tcc_parse_args(TCCState *s, int *pargc, char ***pargv)
                 s->regparm = x;
                 break;
             }
+            if (!strcmp(optarg, "rtd") || !strcmp(optarg, "no-rtd")) {
+                /* -mrtd: stdcall by default (GRUB's i386-pc code) */
+                s->rtd = optarg[0] == 'r';
+                break;
+            }
             if (!strncmp(optarg, "preferred-stack-boundary=", 25)
                 || !strncmp(optarg, "arch=", 5) || !strncmp(optarg, "tune=", 5)
                 || !strncmp(optarg, "cmodel=", 7) || !strcmp(optarg, "no-red-zone")
diff --git a/tcc.h b/tcc.h
index 3c81a72..1b3ee4f 100644
--- a/tcc.h
+++ b/tcc.h
@@ -531,7 +531,8 @@ struct FuncAttr {
     func_fold   : 2, /* trivial body: 1 empty (void), 2 'return <const>' */
     func_fval   : 12, /* the constant + 2048 (see inline_fold_check) */
     func_used   : 1, /* attribute((used)) */
-    func_cdecl  : 1, /* an explicit cdecl/regparm(0): -mregparm does not apply */
+    func_cdecl  : 1, /* an explicit cdecl: the caller pops (beats stdcall and -mrtd) */
+    func_noregparm : 1, /* an explicit regparm(0): -mregparm does not apply */
     func_stdcall : 1; /* the callee pops its stack arguments: stdcall, also with regparm(n) */
 };
 
@@ -854,6 +855,7 @@ struct TCCState {
     unsigned char code16gcc;
     unsigned char m16;      /* -m16: generate 16-bit (.code16gcc) code */
     unsigned char regparm;  /* -mregparm=N: default calling convention */
+    unsigned char rtd;      /* -mrtd: the callee pops the stack arguments (i386) */
 #endif
     unsigned char pic;      /* -fPIC/-fpic (2), -fPIE/-fpie (1): i386 position-independent
                                code, every symbol addressed sym@GOTOFF(%ebx) (no GOT);
diff --git a/tccgen.c b/tccgen.c
index 5614963..742c60c 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -1384,10 +1384,32 @@ static void merge_symattr(struct SymAttr *sa, struct SymAttr *sa1)
     sa->regvar |= sa1->regvar;
 }
 
+/* the calling convention from its parts, as GCC combines them: regparm(0)
+   takes the registers away (also those of -mregparm), cdecl the popping by
+   the callee (also that of -mrtd); registers and popping are independent */
+static void norm_funcall(struct FuncAttr *fa)
+{
+#ifdef TCC_TARGET_I386
+    int regs = fa->func_call >= FUNC_FASTCALL1 && fa->func_call <= FUNC_FASTCALL3;
+    if (fa->func_noregparm && regs)
+        fa->func_call = FUNC_CDECL, regs = 0;
+    if (fa->func_cdecl) {
+        fa->func_stdcall = 0;
+        if (fa->func_call == FUNC_STDCALL)
+            fa->func_call = FUNC_CDECL;
+    } else if (fa->func_stdcall && fa->func_call == FUNC_CDECL) {
+        fa->func_call = FUNC_STDCALL;
+    }
+#endif
+}
+
 /* Merge function attributes.  */
 static void merge_funcattr(struct FuncAttr *fa, struct FuncAttr *fa1)
 {
-    if (fa1->func_call && !fa->func_call && !fa->func_cdecl)
+    /* the calling convention: the newer or more explicit fa1 wins, flags
+       add up (see norm_funcall) */
+    if (fa1->func_call && !(fa1->func_call == FUNC_STDCALL /* stdcall keeps regparm(n) */
+            && fa->func_call >= FUNC_FASTCALL1 && fa->func_call <= FUNC_FASTCALL3))
       fa->func_call = fa1->func_call;
     if (fa1->func_type && !fa->func_type)
       fa->func_type = fa1->func_type;
@@ -1399,14 +1421,17 @@ static void merge_funcattr(struct FuncAttr *fa, struct FuncAttr *fa1)
       fa->func_ctor = 1;
     if (fa1->func_dtor)
       fa->func_dtor = 1;
+    /* an explicit regparm(0) or cdecl in either declaration wins over the
+       -mregparm or -mrtd default of the other */
     if (fa1->func_cdecl)
-      /* an explicit regparm(0) in either declaration wins over the
-         -mregparm default of the other */
-      fa->func_cdecl = 1, fa->func_call = FUNC_CDECL;
+      fa->func_cdecl = 1;
+    if (fa1->func_noregparm)
+      fa->func_noregparm = 1;
     if (fa1->func_used)
       fa->func_used = 1;
     if (fa1->func_stdcall)
       fa->func_stdcall = 1;
+    norm_funcall(fa);
 }
 
 /* Merge attributes.  */
@@ -3413,7 +3438,7 @@ static inline int is_null_pointer(SValue *p)
 static int is_default_regparm(struct FuncAttr *f)
 {
 #ifdef TCC_TARGET_I386
-    return tcc_state->regparm && !f->func_cdecl
+    return tcc_state->regparm && !f->func_noregparm
         && f->func_call == FUNC_FASTCALL1 + tcc_state->regparm - 1;
 #else
     return 0;
@@ -3426,11 +3451,19 @@ static int is_compatible_func(CType *type1, CType *type2)
 
     s1 = type1->ref;
     s2 = type2->ref;
+    /* an explicit regparm(0) or cdecl is compatible with the -mregparm or
+       -mrtd default of the other declaration, and wins (merge_funcattr) */
+#ifdef TCC_TARGET_I386
+    int cdecl_rtd = (s1->f.func_cdecl || s2->f.func_cdecl) && tcc_state->rtd;
+#else
+    int cdecl_rtd = 0;
+#endif
     if (s1->f.func_call != s2->f.func_call
-        && !(s1->f.func_cdecl && is_default_regparm(&s2->f))
-        && !(s2->f.func_cdecl && is_default_regparm(&s1->f)))
+        && !(s1->f.func_noregparm && is_default_regparm(&s2->f))
+        && !(s2->f.func_noregparm && is_default_regparm(&s1->f))
+        && !(cdecl_rtd && (s1->f.func_call | s2->f.func_call) == FUNC_STDCALL))
         return 0;
-    if (s1->f.func_stdcall != s2->f.func_stdcall)
+    if (s1->f.func_stdcall != s2->f.func_stdcall && !cdecl_rtd)
         return 0;
     if (s1->f.func_type != s2->f.func_type
         && s1->f.func_type != FUNC_OLD
@@ -5523,8 +5556,10 @@ redo:
         case TOK_CDECL1:
         case TOK_CDECL2:
         case TOK_CDECL3:
-            ad->f.func_call = FUNC_CDECL;
+            /* the caller pops; registers of regparm(n) or -mregparm stay,
+               as with GCC ("cdecl, regparm(3)": GRUB's grub_setjmp) */
             ad->f.func_cdecl = 1;
+            norm_funcall(&ad->f);
             break;
         case TOK_STDCALL1:
         case TOK_STDCALL2:
@@ -5544,14 +5579,14 @@ redo:
                 n = 3;
             else if (n < 0)
                 n = 0;
-            if (n > 0)
+            if (n > 0) {
                 ad->f.func_call = FUNC_FASTCALL1 + n - 1;
-            else if (ad->f.func_stdcall)
-                ad->f.func_call = FUNC_STDCALL;
-            else
+            } else {
                 /* regparm(0), the kernel's asmlinkage: the stack even
                    under -mregparm (the asm callee reads it there) */
-                ad->f.func_call = FUNC_CDECL, ad->f.func_cdecl = 1;
+                ad->f.func_noregparm = 1;
+                norm_funcall(&ad->f);
+            }
             skip(')');
             break;
         case TOK_FASTCALL1:
@@ -6676,9 +6711,19 @@ static int post_type(CType *type, AttributeDef *ad, int storage, int td)
         /* -mregparm=N: the calling convention of every function that
            does not name one; variadic functions keep their arguments on
            the stack, as with GCC */
-        if (tcc_state->regparm && !ad->f.func_call && !ad->f.func_cdecl
-            && l != FUNC_ELLIPSIS)
+        if (tcc_state->regparm && !ad->f.func_noregparm && l != FUNC_ELLIPSIS
+            && (ad->f.func_call == FUNC_CDECL || ad->f.func_call == FUNC_STDCALL))
             ad->f.func_call = FUNC_FASTCALL1 + tcc_state->regparm - 1;
+        /* -mrtd: and the callee pops the stack arguments (stdcall, with
+           the registers of -mregparm or regparm(n) kept), unless the
+           function is variadic or declared cdecl, as with GCC */
+        if (tcc_state->rtd && l != FUNC_ELLIPSIS && !ad->f.func_cdecl
+            && (ad->f.func_call == FUNC_CDECL
+                || (ad->f.func_call >= FUNC_FASTCALL1 && ad->f.func_call <= FUNC_FASTCALL3))) {
+            ad->f.func_stdcall = 1;
+            if (ad->f.func_call == FUNC_CDECL)
+                ad->f.func_call = FUNC_STDCALL;
+        }
 #endif
         sr->type = *type, s = sr;
         s->a = ad->a;
@@ -6896,29 +6941,26 @@ static CType *type_decl(CType *type, AttributeDef *ad, int *v, int td)
        "void (*process_block)(ctx*) __attribute__((regparm(3),stdcall))"
        (busybox); it was left on the variable, and calls through the
        pointer used the default convention.
-       regparm(0) is FUNC_CDECL == 0 with func_cdecl set: it replaces the
+       regparm(0) (func_noregparm) replaces the
        -mregparm default the function type got in post_type ("efi_get_time_t
        __attribute__((regparm(0))) *get_time", Linux i386 EFI runtime calls,
        which passed their arguments in registers).  The function type can be
        a typedef's, shared by every declaration using the typedef: the
        convention goes on a copy */
     if ((type->t & VT_BTYPE) == VT_PTR
-        && (ad->f.func_call || ad->f.func_stdcall || ad->f.func_cdecl)) {
+        && (ad->f.func_call || ad->f.func_stdcall || ad->f.func_cdecl
+            || ad->f.func_noregparm)) {
         CType *pt = pointed_type(type);
         if ((pt->t & VT_BTYPE) == VT_FUNC) {
             Sym *f = pt->ref, *s;
-            int fc = ad->f.func_call ? ad->f.func_call
-                   : ad->f.func_cdecl ? FUNC_CDECL : f->f.func_call;
-            if (fc != f->f.func_call
-                || (ad->f.func_stdcall && !f->f.func_stdcall)
-                || (ad->f.func_cdecl && !f->f.func_cdecl)) {
+            struct FuncAttr fa = f->f;
+            merge_funcattr(&fa, &ad->f);
+            if (fa.func_call != f->f.func_call || fa.func_stdcall != f->f.func_stdcall
+                || fa.func_cdecl != f->f.func_cdecl || fa.func_noregparm != f->f.func_noregparm) {
                 s = sym_push(SYM_FIELD, &f->type, f->r, f->c);
                 s->a = f->a;
-                s->f = f->f;
+                s->f = fa;
                 s->next = f->next;
-                s->f.func_call = fc;
-                s->f.func_stdcall |= ad->f.func_stdcall;
-                s->f.func_cdecl |= ad->f.func_cdecl;
                 pt->ref = s;
             }
         }

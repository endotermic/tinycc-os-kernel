From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Fri, 27 Nov 2026 18:39:26 +0200
Subject: [PATCH] asm: 16-bit addressing, (%bx), (%bp), (%si), (%di) and %bx or
 %bp with %si or %di, with no, 8- or 16-bit displacement, encoded with the
 16-bit ModRM byte, with the 0x67 prefix in 32-bit code and an error in 64-bit
 code, like GNU as; invalid pairs, a scale and mixed sizes are errors; (%dx)
 stays the port operand (GRUB relocator16.S "movb %es:(%di), %al" and the
 i386-pc boot code stopped with "register expected")

---
 i386-asm.c | 76 +++++++++++++++++++++++++++++++++++++++++-------------
 1 file changed, 58 insertions(+), 18 deletions(-)

diff --git a/i386-asm.c b/i386-asm.c
index ac4ba5b..78f5456 100644
--- a/i386-asm.c
+++ b/i386-asm.c
@@ -178,6 +178,7 @@ typedef struct Operand {
     int8_t  reg; /* register, -1 if none */
     int8_t  reg2; /* second register, -1 if none */
     uint8_t shift;
+    uint8_t ea16; /* a 16-bit address: (%bx), (%bp), (%si), (%di), (%bx,%si) ... */
     ExprValue e;
 } Operand;
 
@@ -355,10 +356,11 @@ static int asm_parse_reg(unsigned int *type)
         reg = tok - TOK_ASM_rax;
 	*type = OP_REG64;
         check_reg64(tok);
-    } else if (tok == TOK_ASM_dx) {
-        /* "(%dx)": GAS's spelling of the port operand of in/out
-           ("inl (%dx), %eax"); parse_operand() turns it into %dx */
-        reg = TREG_XDX;
+    } else if (tok >= TOK_ASM_ax && tok <= TOK_ASM_di) {
+        /* 16-bit address registers ("(%bx,%si)", "6(%bp)"), checked by
+           parse_operand(); "(%dx)" is GAS's spelling of the port operand of
+           in/out ("inl (%dx), %eax"), which parse_operand() turns into %dx */
+        reg = tok - TOK_ASM_ax;
         *type = OP_REG16;
     } else if (tok == TOK_ASM_rip) {
         reg = -2; /* Probably should use different escape code. */
@@ -437,6 +439,7 @@ static void parse_operand(TCCState *s1, Operand *op)
     const char *p;
 
     indir = 0;
+    op->ea16 = 0;
     if (tok == '*') {
         next();
         indir = OP_INDIR;
@@ -543,10 +546,11 @@ static void parse_operand(TCCState *s1, Operand *op)
             }
         }
         if (tok == '(') {
-	    unsigned int type = 0;
+	    unsigned int type = 0, type1 = 0;
             next();
             if (tok != ',') {
                 op->reg = asm_parse_reg(&type);
+                type1 = type;
             }
             if (tok == ',') {
                 next();
@@ -566,18 +570,30 @@ static void parse_operand(TCCState *s1, Operand *op)
                     }
                 }
             }
-	    if (type & OP_REG32)
+	    if ((type | type1) & OP_REG32)
 	        op->type |= OP_EA32;
             skip(')');
-            if (type == OP_REG16) {
-                if (op->reg != TREG_XDX || op->reg2 != -1 || op->e.v || op->e.sym)
-                    expect("register");
+            if (type1 == OP_REG16 && op->reg == TREG_XDX && op->reg2 == -1
+                && !op->e.v && !op->e.sym) {
                 /* OP_DX alone, not OP_REG16: only the port operand of
                    in/out/ins/outs matches ("movl (%dx), %eax" stays an error) */
                 op->type = OP_DX;
-                op->reg = TREG_XDX;
                 goto done;
             }
+            if (type1 == OP_REG16 || (op->reg2 != -1 && type == OP_REG16)) {
+                /* 16-bit addressing: %bx, %bp, %si or %di alone, or %bx/%bp
+                   with %si/%di (scale 1), as the 16-bit ModRM byte allows */
+                int b = op->reg, x = op->reg2;
+                if (type1 != OP_REG16 || (x != -1 && type != OP_REG16)
+                    || !(b == 3 || b == 5 || b == 6 || b == 7)
+                    || (x != -1 && !((b == 3 || b == 5) && (x == 6 || x == 7)))
+                    || op->shift)
+                    tcc_error("invalid 16-bit address: only (%%bx), (%%bp), (%%si), (%%di) and "
+                              "%%bx or %%bp with %%si or %%di");
+                if (CODE64)
+                    tcc_error("16-bit addressing is not available in 64-bit code");
+                op->ea16 = 1;
+            }
         }
         if (op->reg == -1 && op->reg2 == -1)
             op->type |= OP_ADDR;
@@ -790,6 +806,26 @@ static inline int asm_modrm(int reg, Operand *op)
         g(0x05 + (reg << 3));
         gen_addrpc32(pe->sym ? VT_SYM : 0, pe->sym, pe->v);
         return ind;
+    } else if (op->ea16) {
+        /* the 16-bit ModRM byte: rm 0-3 = bx+si, bx+di, bp+si, bp+di,
+           4-7 = si, di, bp, bx; rm 6 with mod 00 is disp16 alone, so (%bp)
+           takes a zero disp8 */
+        int rm, v = (int)op->e.v;
+        if (op->reg2 == -1)
+            rm = op->reg == 6 ? 4 : op->reg == 7 ? 5 : op->reg == 5 ? 6 : 7;
+        else
+            rm = (op->reg == 5 ? 2 : 0) + (op->reg2 == 7 ? 1 : 0);
+        if (!op->e.sym && !v && rm != 6)
+            mod = 0x00;
+        else if (!op->e.sym && v == (int8_t)v)
+            mod = 0x40;
+        else
+            mod = 0x80;
+        g(mod + (reg << 3) + rm);
+        if (mod == 0x40)
+            g(v);
+        else if (mod == 0x80)
+            gen_expr16(&op->e);
     } else {
         sib_reg1 = op->reg;
         /* fist compute displacement encoding */
@@ -977,11 +1013,12 @@ static int op0_mode_ok(int tok, int code)
 
 /* the size prefixes (0x66 for the operand size: 16-bit operations outside
    16-bit code, 32-bit ones in it) and a prefix given on the same line */
-static void gen_size_prefixes(int opsize, int addr32)
+static void gen_size_prefixes(int opsize, int addr32, int addr16)
 {
-    if (CODE16 || CODE64 ? (addr32 || pending_addr) : pending_addr)
+    /* addr16: a 16-bit address, which needs 0x67 outside 16-bit code */
+    if (addr16 ? !CODE16 : CODE16 || CODE64 ? (addr32 || pending_addr) : pending_addr)
         g(0x67);
-    cur_addr32 = addr32 || pending_addr;
+    cur_addr32 = !addr16 && (addr32 || pending_addr);
     if (pending_data)
         opsize = CODE16 ? 2 : 1;
     if ((opsize == 1 && !CODE16) || (opsize == 2 && CODE16))
@@ -1042,7 +1079,7 @@ ST_FUNC void asm_opcode(TCCState *s1, int opcode)
     int op_type[MAX_OPERANDS]; /* decoded op type */
     int alltypes;   /* OR of all operand types */
     int autosize;
-    int p66, opsize, addr32, disp16;
+    int p66, opsize, addr32, addr16, disp16;
     int rex64;
     int vex, vex_pp, vvvv_index; /* VEX/EVEX entries: OPC_VEX | OPC_EVEX, the pp field, the vvvv operand */
 
@@ -1286,7 +1323,7 @@ again:
                 tcc_error("'%s' is not available in %d-bit code",
                           get_tok_str(opcode, NULL), tcc_state->seg_size);
             opsize = sizeless_opsize(opcode, b);
-            gen_size_prefixes(opsize, 0);
+            gen_size_prefixes(opsize, 0, 0);
             if ((b & 0xff00) && (b >> 8) != 0x66)
                 g(b >> 8);
             g(b);
@@ -1409,10 +1446,13 @@ again:
         g(seg_prefix);
     /* the address size: 32-bit address registers need the 0x67 prefix in
        16- and 64-bit code (asm_modrm picks the displacement size) */
-    addr32 = 0;
-    for(i = 0; i < nb_ops; i++)
+    addr32 = addr16 = 0;
+    for(i = 0; i < nb_ops; i++) {
         if (ops[i].type & OP_EA32)
             addr32 = 1;
+        if (ops[i].ea16)
+            addr16 = 1;
+    }
     v = pa->opcode;
     p = v >> 8;  /* possibly prefix byte(s) */
     vex_pp = 0;
@@ -1443,7 +1483,7 @@ again:
     if (v == 0xe3 && pa->op_type[0] == OPT_DISP8
         && (opcode == TOK_ASM_jcxz ? !CODE16 : opcode == TOK_ASM_jecxz && !(!CODE16 && !CODE64)))
         pending_addr = 1;
-    gen_size_prefixes(opsize, addr32);
+    gen_size_prefixes(opsize, addr32, addr16);
     if (p66)
         g(0x66);
 

+static const char *asm_skip_blanks(const char *p)
+{
+    while (*p == ' ' || *p == '\t')
+        p++;
+    return p;
+}
+
+/* remove the quotes of a quoted string (in place) */
+static void asm_unquote(char *p)
+{
+    int n = strlen(p);
+    if (n >= 2 && p[0] == '"' && p[n - 1] == '"') {
+        memmove(p, p + 1, n - 2);
+        p[n - 2] = 0;
+    }
+}
+
+/* Split arguments like GNU as: separated by blanks or commas, except
+   inside quotes or parentheses; the quotes of a quoted argument go.
+   Returns the number of arguments (strings to free). */
+static int asm_split_args(const char *p, char **args, int max)
+{
+    int n = 0;
+    for (;;) {
+        CString a;
+        int depth = 0;
+        p = asm_skip_blanks(p);
+        if (!*p)
+            break;
+        if (n >= max)
+            tcc_error("too many macro arguments");
+        cstr_new(&a);
+        if (*p == '"') {
+            for (p++; *p && *p != '"'; p++) {
+                if (*p == '\\' && p[1] == '"')
+                    p++;
+                cstr_ccat(&a, *p);
+            }
+            if (*p == '"')
+                p++;
+        } else {
+            while (*p && !((*p == ',' || *p == ' ' || *p == '\t') && depth == 0)) {
+                if (*p == '(' || *p == '[')
+                    depth++;
+                else if ((*p == ')' || *p == ']') && depth > 0)
+                    depth--;
+                else if (*p == '"') {
+                    cstr_ccat(&a, *p++);
+                    while (*p && *p != '"')
+                        cstr_ccat(&a, *p++);
+                    if (!*p)
+                        break;
+                }
+                cstr_ccat(&a, *p++);
+            }
+        }
+        cstr_ccat(&a, 0);
+        args[n++] = tcc_strdup(a.data);
+        cstr_free(&a);
+        p = asm_skip_blanks(p);
+        if (*p == ',')
+            p++;
+    }
+    return n;
+}
+
+static void asm_free_args(char **args, int n)
+{
+    while (n > 0)
+        tcc_free(args[--n]);
+}

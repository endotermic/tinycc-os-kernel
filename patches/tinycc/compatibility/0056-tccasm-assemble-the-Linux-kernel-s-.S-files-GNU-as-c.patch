+/* .macro name p1[:req|:vararg][=default] p2 ... : the parameter list */
+static void asm_macro_params(AsmMacro *m, const char *text)
+{
+    char *pieces[ASM_MAX_PARAMS];
+    int n, i;
+
+    n = asm_split_args(text, pieces, ASM_MAX_PARAMS);
+    for (i = 0; i < n; i++) {
+        char *q = pieces[i];
+        int k = 0;
+        while (isid((unsigned char)q[k]) || isnum((unsigned char)q[k]))
+            k++;
+        if (k == 0)
+            tcc_error("invalid macro parameter '%s'", q);
+        m->params[i] = tok_alloc(q, k)->tok;
+        q += k;
+        while (*q == ':') {
+            q++;
+            if (!strncmp(q, "req", 3))
+                m->required[i] = 1, q += 3;
+            else if (!strncmp(q, "vararg", 6))
+                m->vararg = i + 1, q += 6;
+            else
+                tcc_error("invalid macro parameter qualifier ':%s'", q);
+        }
+        if (*q == '=') {
+            q++;
+            asm_unquote(q);
+            m->defaults[i] = tcc_strdup(q);
+        } else if (*q) {
+            tcc_error("invalid macro parameter '%s'", pieces[i]);
+        }
+    }
+    m->nb_params = n;
+    asm_free_args(pieces, n);
+}

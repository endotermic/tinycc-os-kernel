+/* .comm/.lcomm name, size[, align]: space in .bss */
+static void asm_comm(TCCState *s1, int local)
+{
+    int name, size, align = 1;
+    unsigned long offset;
+    Sym *sym;
+
+    if (tok < TOK_IDENT)
+        expect("symbol");
+    name = tok;
+    next();
+    skip(',');
+    size = asm_int_expr(s1);
+    if (tok == ',') {
+        next();
+        align = asm_int_expr(s1);
+        if (align <= 0 || (align & (align - 1)))
+            tcc_error("alignment must be a positive power of two");
+    } else {
+        /* GNU as: the natural alignment of the size, up to the pointer size */
+        while (align < PTR_SIZE && align < size)
+            align <<= 1;
+    }
+    if (cur_text_section == bss_section)
+        bss_section->data_offset = ind;
+    offset = (bss_section->data_offset + align - 1) & -align;
+    bss_section->data_offset = offset + size;
+    if (bss_section->sh_addralign < align)
+        bss_section->sh_addralign = align;
+    if (cur_text_section == bss_section)
+        ind = bss_section->data_offset;
+    sym = asm_new_label1(s1, name, 0, bss_section->sh_num, offset);
+    elfsym(sym)->st_size = size;
+    if (!local) {
+        sym->type.t &= ~VT_STATIC;
+        update_storage(sym);
+    }
+}

+/* is the symbol defined (a label, .set or .comm; a mere reference is not) */
+static int asm_symbol_defined(int v)
+{
+    Sym *sym = asm_label_find(v);
+    ElfSym *esym;
+    if (!sym)
+        return 0;
+    esym = elfsym(sym);
+    return esym && esym->st_shndx != SHN_UNDEF;

+/* .uleb128 / .sleb128 */
+static void asm_leb128(TCCState *s1, int is_signed)
+{
+    for (;;) {
+        int64_t v = asm_int_expr(s1);
+        for (;;) {
+            int b = v & 0x7f;
+            v >>= 7;
+            if (is_signed ? (v == 0 && !(b & 0x40)) || (v == -1 && (b & 0x40)) : v == 0) {
+                g(b);
+                break;
+            }
+            g(b | 0x80);
+        }
+        if (tok != ',')
+            break;
+        next();
+    }
+}

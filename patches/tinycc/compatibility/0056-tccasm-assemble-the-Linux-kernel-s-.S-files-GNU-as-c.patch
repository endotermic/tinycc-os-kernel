+/* the two text operands of .ifc/.ifnc/.ifeqs/.ifnes: up to the first
+   top-level comma, and the rest; quotes removed, blanks trimmed */
+static int asm_cmp_texts(const char *line)
+{
+    char *a, *b, *e;
+    const char *p = line;
+    int depth = 0, eq;
+    while (*p && !(*p == ',' && depth == 0)) {
+        if (*p == '"') {
+            for (p++; *p && *p != '"'; p++);
+            if (!*p)
+                break;
+        } else if (*p == '(')
+            depth++;
+        else if (*p == ')')
+            depth--;
+        p++;
     }
+    a = tcc_strdup(line);
+    a[p - line] = 0;
+    b = tcc_strdup(*p == ',' ? asm_skip_blanks(p + 1) : "");
+    for (e = a + strlen(a); e > a && (e[-1] == ' ' || e[-1] == '\t'); e--)
+        e[-1] = 0;
+    for (e = b + strlen(b); e > b && (e[-1] == ' ' || e[-1] == '\t'); e--)
+        e[-1] = 0;
+    asm_unquote(a), asm_unquote(b);
+    eq = !strcmp(a, b);
+    tcc_free(a), tcc_free(b);
+    return eq;
+}

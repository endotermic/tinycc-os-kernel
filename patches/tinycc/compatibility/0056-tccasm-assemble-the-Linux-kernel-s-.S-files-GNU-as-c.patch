+/* .section name[,"flags"[,@type[,entsize]]]: the flags GNU as gives a new
+   section whose flags are not spelled out depend on its name */
+static int asm_section_default_flags(const char *name, int *sh_type)
+{
+    *sh_type = SHT_PROGBITS;
+    if (!strcmp(name, ".text") || !strncmp(name, ".text.", 6)
+        || !strcmp(name, ".init") || !strcmp(name, ".fini"))
+        return SHF_ALLOC | SHF_EXECINSTR;
+    if (!strcmp(name, ".data") || !strncmp(name, ".data.", 6)
+        || !strcmp(name, ".init_array") || !strcmp(name, ".fini_array")
+        || !strcmp(name, ".preinit_array") || !strcmp(name, ".ctors")
+        || !strcmp(name, ".dtors"))
+        return SHF_ALLOC | SHF_WRITE;
+    if (!strcmp(name, ".bss") || !strncmp(name, ".bss.", 5)) {
+        *sh_type = SHT_NOBITS;
+        return SHF_ALLOC | SHF_WRITE;
+    }
+    if (!strcmp(name, ".tdata"))
+        return SHF_ALLOC | SHF_WRITE | SHF_TLS;
+    if (!strcmp(name, ".tbss")) {
+        *sh_type = SHT_NOBITS;
+        return SHF_ALLOC | SHF_WRITE | SHF_TLS;
+    }
+    if (!strcmp(name, ".rodata") || !strncmp(name, ".rodata.", 8)
+        || !strcmp(name, ".rodata1") || !strcmp(name, ".eh_frame"))
+        return SHF_ALLOC;
+    if (!strncmp(name, ".note", 5)) {
+        *sh_type = SHT_NOTE;
+        return 0;
+    }
+    return 0;
 }
 

+/* .incbin "file"[,skip[,count]]: the file is searched in the current
+   directory and the -I directories, like GNU as */
+static void asm_incbin(TCCState *s1)
+{
+    char *name, buf[1024];
+    int fd = -1, i, skip = 0, count = -1, n;
+    Section *sec = cur_text_section;
+    uint8_t *ptr;
+
+    if (tok != TOK_STR)
+        expect("file name");
+    name = tcc_strdup(tokc.str.data);
     next();
+    if (tok == ',') {
+        next();
+        skip = asm_int_expr(s1);
+        if (tok == ',') {
+            next();
+            count = asm_int_expr(s1);
+        }
+    }
+    fd = open(name, O_RDONLY | O_BINARY);
+    for (i = 0; fd < 0 && i < s1->nb_include_paths; i++) {
+        snprintf(buf, sizeof buf, "%s/%s", s1->include_paths[i], name);
+        fd = open(buf, O_RDONLY | O_BINARY);
+    }
+    if (fd < 0)
+        tcc_error(".incbin: cannot open '%s'", name);
+    n = lseek(fd, 0, SEEK_END);
+    if (n < 0 || skip > n)
+        tcc_error(".incbin: cannot read '%s'", name);
+    n -= skip;
+    if (count >= 0 && count < n)
+        n = count;
+    lseek(fd, skip, SEEK_SET);
+    if (sec->sh_type != SHT_NOBITS) {
+        sec->data_offset = ind;
+        ptr = section_ptr_add(sec, n);
+        if (read(fd, ptr, n) != n)
+            tcc_error(".incbin: cannot read '%s'", name);
+    }
+    ind += n;
+    close(fd);
+    tcc_free(name);
+}

 /* store vtop in lvalue pushed on stack */
+/* ------------------------------------------------------------------------- */
+/* constant propagation through local scalars, see KSnap above */
+
+static int kprop_on(void)
+{
+#ifdef CONFIG_TCC_BCHECK
+    return !tcc_state->do_bounds_check;
+#else
+    return 1;
+#endif
+}
+
+/* a local variable whose value can be known: a scalar that nothing but
+   its own stores can change */
+static int ktrackable(Sym *s)
+{
+    int bt;
+    if ((s->r & (VT_VALMASK | VT_LVAL)) != (VT_LOCAL | VT_LVAL)
+        || s->a.addrtaken || s->a.regvar
+        || (s->type.t & (VT_VOLATILE | VT_ARRAY | VT_VLA | VT_BITFIELD)))
+        return 0;
+    bt = s->type.t & VT_BTYPE;
+    return is_integer_btype(bt) || bt == VT_PTR;
+}
+
+/* the variable that a stack value reads or stores as a whole, if any */
+static Sym *klocal(SValue *sv)
+{
+    Sym *s = sv->sym;
+    if ((sv->r & (VT_VALMASK | VT_LVAL | VT_SYM)) != (VT_LOCAL | VT_LVAL)
+        || !s || sv->c.i != s->c
+        || ((sv->type.t ^ s->type.t) & (VT_BTYPE | VT_UNSIGNED))
+        || (sv->type.t & (VT_BITFIELD | VT_ARRAY))
+        || !ktrackable(s))
+        return NULL;
+    return s;
+}
+
+/* the value of a store to a variable of type t as the variable holds it */
+static long long knorm(int t, long long v)
+{
+    switch (t & VT_BTYPE) {
+    case VT_BOOL:
+        return v != 0;
+    case VT_BYTE:
+        return (t & VT_UNSIGNED) ? (long long)(unsigned char)v : (signed char)v;
+    case VT_SHORT:
+        return (t & VT_UNSIGNED) ? (long long)(unsigned short)v : (short)v;
+    case VT_INT:
+        return (t & VT_UNSIGNED) ? (long long)(unsigned)v : (int)v;
+    }
+    return v;
+}
+
+/* a read of a variable with a known value is the value (VT_NONCONST: it
+   is not a constant expression of the language) */
+ST_FUNC void kval(SValue *sv)
+{
+    Sym *s;
+    if (!kprop_on() || !(s = klocal(sv)) || s->kst != 1)
+        return;
+    sv->r = VT_CONST | VT_NONCONST;
+    sv->r2 = VT_CONST;
+    sv->c.i = s->kval;
+    sv->sym = NULL;
+}
+
+/* the variable may now hold anything (an asm output) */
+ST_FUNC void kinval(SValue *sv)
+{
+    Sym *s = klocal(sv);
+    if (s)
+        s->kst = 0;
+}
+
+/* a store: vtop[-1] the destination, vtop the value (already kval()ed) */
+static void krecord(void)
+{
+    SValue *src = vtop, *dst = vtop - 1;
+    Sym *s;
+    int bt;
+    if (!kprop_on() || nocode_wanted || !(s = klocal(dst)))
+        return;
+    bt = src->type.t & VT_BTYPE;
+    /* a plain constant: not the address of a symbol, whose Sym (a string
+       literal's, a static local's) may be gone when the variable is read */
+    if ((src->r & (VT_VALMASK | VT_LVAL | VT_SYM)) == VT_CONST
+        && !is_float(src->type.t) && bt != VT_STRUCT && bt != VT_VOID) {
+        s->kst = 1;
+        s->kval = knorm(s->type.t, src->c.i);
+    } else
+        s->kst = 0;
+}
+
+/* the known variables and their values, NULL when there are none */
+static KSnap *ksnap_take(void)
+{
+    Sym *s;
+    KSnap *k;
+    int n = 0;
+    for (s = local_stack; s; s = s->prev)
+        n += s->kst == 1;
+    if (!n)
+        return NULL;
+    k = tcc_malloc(sizeof *k + (n - 1) * sizeof k->e[0]);
+    k->n = 0;
+    for (s = local_stack; s; s = s->prev)
+        if (s->kst == 1) {
+            k->e[k->n].s = s, k->e[k->n].v = s->kval;
+            k->n++;
+        }
+    return k;
+}
+
+/* the entry of s in k, or -1.  s is compared as a pointer only: an entry
+   may name a variable that has gone out of scope since (it is then of no
+   concern at the point where k is used) */
+static int ksnap_find(KSnap *k, Sym *s)
+{
+    int i;
+    if (k)
+        for (i = 0; i < k->n; i++)
+            if (k->e[i].s == s)
+                return i;
+    return -1;
+}
+
+/* where the current path and the path of k join: only what is known now
+   and was known the same in k stays known */
+static void ksnap_merge(KSnap *k)
+{
+    Sym *s;
+    int i;
+    for (s = local_stack; s; s = s->prev)
+        if (s->kst == 1 && ((i = ksnap_find(k, s)) < 0 || k->e[i].v != s->kval))
+            s->kst = 0;
+}
+
+/* back to the state k, for a path that starts where k was taken */
+static void ksnap_restore(KSnap *k)
+{
+    Sym *s;
+    int i;
+    for (s = local_stack; s; s = s->prev) {
+        if ((i = ksnap_find(k, s)) >= 0 && ktrackable(s))
+            s->kst = 1, s->kval = k->e[i].v;
+        else if (s->kst == 1)
+            s->kst = 0;
+    }
+}
+
+/* the current state leaves (break, continue) to the point of a */
+static void kacc_add(struct kacc *a)
+{
+    if (!kprop_on() || nocode_wanted)
+        return;
+    if (!a->have)
+        a->k = ksnap_take(), a->have = 1;
+    else if (a->k) {
+        /* intersection: keep the entries the current state agrees with;
+           a variable out of scope now is dropped (it is out of scope at
+           the join too) */
+        Sym *s;
+        int i, n = 0;
+        for (i = 0; i < a->k->n; i++) {
+            for (s = local_stack; s; s = s->prev)
+                if (s == a->k->e[i].s)
+                    break;
+            if (s && s->kst == 1 && s->kval == a->k->e[i].v)
+                a->k->e[n++] = a->k->e[i];
+        }
+        a->k->n = n;
+    }
+}
+
+/* the paths of a (if any) and, when alive, the current one meet here */
+static void kacc_join(struct kacc *a, int alive)
+{
+    if (kprop_on() && a->have) {
+        if (alive)
+            ksnap_merge(a->k);
+        else
+            ksnap_restore(a->k);
+    }
+    tcc_free(a->k), a->k = NULL, a->have = 0;
+}
+
+static void kkill_all(void)
+{
+    Sym *s;
+    for (s = local_stack; s; s = s->prev)
+        if (s->kst == 1)
+            s->kst = 0;
+}
+
+/* at a loop's head: the variables the loop may assign (n < 0: any).  The
+   identifiers are resolved here, after a for loop's init declared its
+   variable */
+static void kkill(int *kills, int n)
+{
+    Sym *s;
+    int i;
+    if (n < 0)
+        kkill_all();
+    for (i = 0; i < n; i++)
+        if ((s = sym_find(kills[i])) && s->kst == 1)
+            s->kst = 0;
+    tcc_free(kills);
+}
+
+/* loop_tokens(): the identifier v may be assigned in the loop */
+static void kadd(int **kills, int *n, int v)
+{
+    int i;
+    if (*n < 0)
+        return;
+    for (i = 0; i < *n; i++)
+        if ((*kills)[i] == v)
+            return;
+    if (*n >= 64)
+        *n = -1; /* too many: all of them (kkill) */
+    else {
+        *kills = tcc_realloc(*kills, (*n + 1) * sizeof **kills);
+        (*kills)[(*n)++] = v;
+    }
+}
+
+/* after a loop: the paths out of it are the failing condition (the state
+   kx, unless the condition is constant true) and the breaks */
+static void kloop_exit(int kc, KSnap *kx, struct kacc *kb)
+{
+    if (kprop_on()) {
+        if (kc != 1) {
+            ksnap_restore(kx);
+            kacc_join(kb, 1);
+        } else
+            kacc_join(kb, 0);
+    }
+    tcc_free(kx);
+}
+
+/* a case label: the switch's dispatch (the head's state) and, when the
+   previous case falls through, its end meet here */
+static void kcase(void)
+{
+    if (!kprop_on())
+        return;
+    if (!nocode_wanted)
+        ksnap_merge(cur_switch->khead);
+    else
+        ksnap_restore(cur_switch->khead);
+}
+
+/* after a switch: the breaks, and the head's state when no case may be
+   taken (miss) */
+static void kswitch_exit(struct switch_t *sw, int miss)
+{
+    if (kprop_on()) {
+        if (miss) {
+            ksnap_restore(sw->khead);
+            kacc_join(&sw->kbrk, 1);
+        } else
+            kacc_join(&sw->kbrk, 0);
+    }
+    tcc_free(sw->khead), sw->khead = NULL;
+}
+
+/* the condition on vtop: 0 or 1 when it is constant, -1 otherwise */
+static int kcond(void)
+{
+    kval(vtop);
+    if ((vtop->r & (VT_VALMASK | VT_LVAL | VT_SYM)) == VT_CONST
+        && !is_float(vtop->type.t))
+        return vtop->c.i != 0;
+    return -1;
+}
+
+/* The labels of the function being compiled, from a scan of its tokens
+   before it is parsed (kscan_labels()).  A label that only earlier gotos
+   reach joins their states (a) with the fall-through; one that a later
+   goto or a computed goto (&&label) reaches is the head of a loop, where
+   everything is unknown. */
+static struct klab { int v, back, defined; struct kacc a; } *klabs;
+static int nb_klabs;
+
+static struct klab *klab_find(int v)
+{
+    int i;
+    for (i = 0; i < nb_klabs; i++)
+        if (klabs[i].v == v)
+            return &klabs[i];
+    return NULL;
+}
+
+static struct klab *klab_add(int v)
+{
+    struct klab *l = klab_find(v);
+    if (!l) {
+        klabs = tcc_realloc(klabs, (nb_klabs + 1) * sizeof *klabs);
+        l = &klabs[nb_klabs++];
+        memset(l, 0, sizeof *l);
+        l->v = v;
+    }
+    return l;
+}
+
+static void klabs_free(void)
+{
+    int i;
+    for (i = 0; i < nb_klabs; i++)
+        tcc_free(klabs[i].a.k);
+    tcc_free(klabs), klabs = NULL, nb_klabs = 0;
+}
+
+/* scan a function body (a token string ending with TOK_EOF; the current
+   token has been given back with unget_tok()) for its labels and gotos:
+   a label is an identifier followed by ':' at the start of a statement
+   (not after 'case' or '?'; more is a statement start than listed, which
+   only makes a label a loop head when it is not one) */
+static void kscan_labels(TokenString *str)
+{
+    int prev = 0, prev2 = 0, i;
+    struct klab *l;
+    klabs_free();
+    begin_macro(str, 0);
+    next();
+    for (; tok != TOK_EOF; prev2 = prev, prev = tok, next()) {
+        if (tok >= TOK_UIDENT) {
+            if (prev == TOK_GOTO) {
+                l = klab_add(tok);
+                if (l->defined)
+                    l->back = 1;
+            } else if (prev == TOK_LAND) /* &&label */
+                klab_add(tok)->back = 1;
+        } else if (tok == ':' && prev >= TOK_UIDENT
+                   && (prev2 == ';' || prev2 == '{' || prev2 == '}'
+                       || prev2 == ':' || prev2 == ')' || prev2 == TOK_ELSE
+                       || prev2 == TOK_DO || prev2 == 0)) {
+            klab_add(prev)->defined = 1;
+        }
+    }
+    end_macro();
+    for (i = 0; i < nb_klabs; i++)
+        if (!klabs[i].defined)
+            klabs[i].back = 1;
+}
+
+/* a goto to the label v: its state reaches the label */
+static void klabel_goto(int v)
+{
+    struct klab *l = klab_find(v);
+    if (l && !l->back)
+        kacc_add(&l->a);
+}
+
+/* the definition of the label v */
+static void klabel_def(int v)
+{
+    struct klab *l = klab_find(v);
+    if (!kprop_on())
+        return;
+    if (l && !l->back)
+        kacc_join(&l->a, !nocode_wanted);
+    else
+        kkill_all(); /* a goto may come from anywhere */
+}
+

+/* Constant propagation through local scalars ("kprop").  A local variable
+   (integer or pointer, not volatile, address never taken) whose last store
+   was a constant is known to hold it: kval() replaces a read of such a
+   variable by the constant, so that a condition on it folds like a
+   literal constant.  The Linux kernel relies on this: an IS_ENABLED()
+   value that passes through a local, or through the return value of a
+   stub, guards code that references functions which do not exist in that
+   configuration (an optimizing compiler drops the dead branch).  Stores
+   are always generated; only reads are folded.  The knowledge (Sym kst,
+   kval) follows the parse: a store of a constant makes the variable
+   known, any other store (an asm output too) makes it unknown, and the
+   control flow is treated conservatively: where two paths join, only
+   what both agree on stays known (KSnap snapshots and kacc accumulators
+   of the paths that break/continue to a point), the variables that a
+   loop may assign are unknown throughout the loop (its tokens are scanned
+   at the head, loop_tokens()), and a label makes everything unknown.
+   Dead code records nothing. */
+typedef struct KSnap {
+    int n;
+    struct { Sym *s; long long v; } e[1];
+} KSnap;
+struct kacc { KSnap *k; int have; };
+static struct kacc *cur_kbrk, *cur_kcont; /* of the innermost loop */
+static Sym *kinit_sym; /* the local whose initializer is being stored */
+static void klabs_free(void);
+

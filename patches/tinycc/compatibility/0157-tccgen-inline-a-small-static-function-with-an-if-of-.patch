From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 18 Nov 2026 13:19:28 +0200
Subject: [PATCH] tccgen: inline a small static function with an if of constant
 condition (IS_ENABLED() helpers), as gcc, so that the code it guards goes
 (Linux efi_is_mixed() without CONFIG_EFI_MIXED: __efi64_thunk undefined)

---
 tcc.h    |  1 +
 tccgen.c | 46 +++++++++++++++++++++++++++++++++++++++-------
 2 files changed, 40 insertions(+), 7 deletions(-)

diff --git a/tcc.h b/tcc.h
index 452d182..e1b3de0 100644
--- a/tcc.h
+++ b/tcc.h
@@ -711,6 +711,7 @@ typedef struct InlineFunc {
     char busy; /* being compiled or inlined: no inlining into itself */
     signed char inlinable; /* 0 not looked at, 1 yes, -1 no (inline_call()) */
     char sret; /* the body is one return statement (kscan_labels()) */
+    char kcond; /* the body has an if whose condition is constant (kscan_labels()) */
     unsigned cond; /* bit i: the body tests parameter i (kscan_labels()) */
     char filename[1];
 } InlineFunc;
diff --git a/tccgen.c b/tccgen.c
index 65b99fe..e6344fd 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -146,6 +146,9 @@ static int kscan_static; /* kscan_labels(): the body declares something static *
 static Sym *kscan_params; /* kscan_labels(): the parameters to look for ... */
 static unsigned kscan_cond; /* ... in conditions: bit i = parameter i is tested */
 static int kscan_sret; /* kscan_labels(): the body is "{ return ...; }" */
+static int kscan_kcond; /* kscan_labels(): an if of the body has a constant
+                           condition (no identifier once macros expanded:
+                           "if (!IS_ENABLED(CONFIG_X)) return false;") */
 
 /* The call being inlined (inline_call()): the body of an always_inline
    function, or of a static function given a constant argument, is
@@ -177,6 +180,8 @@ static int inl_loc_min; /* the lowest loc of the function: inline_call()
 #define INL_STATIC_LEN 1024 /* tokens: a merely static function inlined */
 #define INL_SRET_LEN 64 /* tokens: one whose body is a single return statement */
 #define inl_sret_ok(fn) ((fn)->sret && (fn)->len <= INL_SRET_LEN)
+#define INL_KCOND_LEN 192 /* tokens: one with an if of constant condition */
+#define inl_kcond_ok(fn) ((fn)->kcond && (fn)->len <= INL_KCOND_LEN)
 static int inline_call(Sym *fs, int nb_args);
 
 static struct switch_t {
@@ -4944,11 +4949,13 @@ static void kscan_labels(TokenString *str)
     int prev = 0, prev2 = 0, i, asm_goto = 0, level = 0, colons = 0;
     int cond = 0, clevel = 0, plevel = 0, ntok = 0, nsemi = 0, nbrace = 0, sret = 0;
     int pend = 0, prevp = 0, in_asm = 0, depth = 0;
+    int kc_depth = 0, kc_ok = 0, kc_n = 0;
     struct klab *l;
     Sym *sa;
     klabs_free();
     kscan_static = 0;
     kscan_cond = 0;
+    kscan_kcond = 0;
     begin_macro(str, 0);
     next();
     for (; tok != TOK_EOF; prev2 = prev, prev = tok, next()) {
@@ -4957,6 +4964,19 @@ static void kscan_labels(TokenString *str)
         if (ntok++ == 1 && tok == TOK_RETURN)
             sret = 1;
         nsemi += tok == ';', nbrace += tok == '{';
+        /* an if whose condition is made of numbers and operators only */
+        if (kc_depth) {
+            if (tok == '(')
+                kc_depth++;
+            else if (tok == ')' && --kc_depth == 0) {
+                if (kc_ok && kc_n)
+                    kscan_kcond = 1;
+            } else if (tok >= TOK_IDENT || tok == TOK_STR || tok == TOK_LSTR)
+                kc_ok = 0;
+            else
+                kc_n++;
+        } else if (tok == '(' && prev == TOK_IF)
+            kc_depth = 1, kc_ok = 1, kc_n = 0;
         /* the assignments, as loop_tokens() finds them: an identifier
            followed (after closing parentheses) by an assignment operator
            or ++/--, preceded by ++/-- or &, or anywhere in an asm
@@ -8792,10 +8812,13 @@ static int inline_call(Sym *fs, int nb_args)
            body tests (fn->cond, from the first scan below) or a body of
            one return statement (a small accessor, which gcc inlines and
            folds: the kernel's ieee80211_tu_to_usec(SLOT_TU) divides a
-           u64 by it), not from within such an inlined body, and not a
-           big one */
+           u64 by it), not a big one, and from within such an inlined body
+           only the one-return accessor (a static function inlined for its
+           constant if may divide by ieee80211_tu_to_usec(512), which must
+           still fold: __udivdi3 on i386) */
         if (!(fsym->type.t & VT_STATIC) || fn->len > INL_STATIC_LEN
-            || inl_static)
+            || (inl_static && (fn->len > INL_SRET_LEN
+                               || (fn->inlinable && !fn->sret))))
             return 0;
         for (i = 0; i < np; i++) {
             kval(&vtop[-i]);
@@ -8803,7 +8826,14 @@ static int inline_call(Sym *fs, int nb_args)
                 && np - 1 - i < 32)
                 cst |= 1u << (np - 1 - i);
         }
-        if (!cst || (fn->inlinable && !(cst & fn->cond) && !inl_sret_ok(fn)))
+        /* or one of a few tokens that tests a constant condition (an
+           IS_ENABLED() helper: gcc inlines it, and the code under the
+           condition, which may name what that configuration leaves out,
+           goes; the kernel's efi_is_mixed() without CONFIG_EFI_MIXED) */
+        if (fn->inlinable && !inl_kcond_ok(fn)
+            && (!cst || (!(cst & fn->cond) && !inl_sret_ok(fn))))
+            return 0;
+        if (!fn->inlinable && !cst && fn->len > INL_KCOND_LEN)
             return 0;
     }
 
@@ -8816,10 +8846,12 @@ static int inline_call(Sym *fs, int nb_args)
     kscan_params = fn->inlinable ? NULL : fs->next;
     kscan_labels(fn->func_str);
     if (!fn->inlinable)
-        fn->cond = kscan_cond, fn->sret = kscan_sret;
+        fn->cond = kscan_cond, fn->sret = kscan_sret, fn->kcond = kscan_kcond;
     kscan_params = NULL;
-    if (kscan_static || (!fs->f.func_alwinl && !(cst & fn->cond)
-                         && !inl_sret_ok(fn))) {
+    if (kscan_static || (!fs->f.func_alwinl
+                         && ((!(cst & fn->cond) && !inl_sret_ok(fn)
+                              && !inl_kcond_ok(fn))
+                             || (inl_static && !inl_sret_ok(fn))))) {
         if (kscan_static)
             fn->inlinable = -1;
         else

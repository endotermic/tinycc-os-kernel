diff --git a/tests/tests2/186_i386_regparm0_fnptr.c b/tests/tests2/186_i386_regparm0_fnptr.c
new file mode 100644
index 0000000..af65267
--- /dev/null
+++ b/tests/tests2/186_i386_regparm0_fnptr.c
@@ -0,0 +1,42 @@
+/* i386, compiled with -mregparm=3 (tinycc-os-kernel fix 146): regparm(0)
+   named on a pointer to a function, here to a typedef'd function type, is
+   the convention of the calls through the pointer, as with GCC: Linux i386
+   declares the EFI runtime services "efi_get_time_t __efiapi *get_time"
+   with __efiapi = regparm(0), and the calls passed their arguments in
+   registers to the firmware, which read them from the stack.  The typedef
+   itself keeps the -mregparm default for the declarations that do not
+   name a convention. */
+#include <stdio.h>
+
+typedef int fn_t(int a, int b, int c);
+typedef int __attribute__((regparm(0))) fn0_t(int a, int b, int c);
+
+int __attribute__((regparm(0))) stack3(int a, int b, int c) { return a * 100 + b * 10 + c; }
+int reg3(int a, int b, int c) { return a * 100 + b * 10 + c; }
+
+struct tbl {
+    fn_t __attribute__((regparm(0))) *m0;   /* the kernel's placement */
+    fn_t *m3;                               /* after it: the default */
+    __attribute__((regparm(0))) fn_t *m0b;
+    fn_t * __attribute__((regparm(0))) m0c;
+    int (*m0d)(int, int, int) __attribute__((regparm(0)));
+    fn0_t *m0e;
+};
+
+fn_t __attribute__((regparm(0))) *g0 = (void *)stack3;
+fn_t *g3 = reg3;
+
+int main(void)
+{
+    struct tbl t = { (void *)stack3, reg3, (void *)stack3, (void *)stack3,
+                     (void *)stack3, stack3 };
+    struct tbl *p = &t;
+    fn_t __attribute__((regparm(0))) *l0 = (void *)stack3;
+    fn_t *l3 = reg3;
+
+    printf("members: %d %d %d %d %d %d\n", p->m0(1, 2, 3), p->m3(4, 5, 6),
+           p->m0b(7, 8, 9), p->m0c(1, 3, 5), p->m0d(2, 4, 6), p->m0e(3, 6, 9));
+    printf("globals: %d %d\n", g0(9, 8, 7), g3(6, 5, 4));
+    printf("locals: %d %d\n", l0(3, 2, 1), l3(5, 5, 5));
+    return 0;
+}

---
 tests/tests2/186_i386_regparm0_fnptr.c      | 42 +++++++++++++++++++++
 tests/tests2/186_i386_regparm0_fnptr.expect |  3 ++
 tests/tests2/Makefile                       |  4 +-
 3 files changed, 48 insertions(+), 1 deletion(-)

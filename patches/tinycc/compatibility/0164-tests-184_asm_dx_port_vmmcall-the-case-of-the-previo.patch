---
 tests/tests2/184_asm_dx_port_vmmcall.c      | 26 +++++++++++++++++++++
 tests/tests2/184_asm_dx_port_vmmcall.expect |  1 +
 2 files changed, 27 insertions(+)
 create mode 100644 tests/tests2/184_asm_dx_port_vmmcall.c
 create mode 100644 tests/tests2/184_asm_dx_port_vmmcall.expect

diff --git a/tests/tests2/184_asm_dx_port_vmmcall.c b/tests/tests2/184_asm_dx_port_vmmcall.c
new file mode 100644
index 0000000..5d50339
--- /dev/null
+++ b/tests/tests2/184_asm_dx_port_vmmcall.c
@@ -0,0 +1,26 @@
+/* "(%dx)" as the port operand of in/out (GNU as accepts it for %dx; the
+   Linux VMware hypercall has "inl (%%dx), %%eax") and AMD's vmmcall
+   (0f 01 d9), the other instruction of that hypercall.  The bytes are only
+   printed, never run. */
+#include <stdio.h>
+
+extern unsigned char c0[], c1[];
+
+__asm__(".text\n"
+        "c0: inl (%dx), %eax\n"     /* ed */
+        "    inb (%dx), %al\n"      /* ec */
+        "    inw (%dx)\n"           /* 66 ed */
+        "    outb %al, (%dx)\n"     /* ee */
+        "    outl %eax, (%dx)\n"    /* ef */
+        "    inl %dx, %eax\n"       /* ed */
+        "    vmcall\n"              /* 0f 01 c1 */
+        "    vmmcall\n"             /* 0f 01 d9 */
+        "c1: ret\n");
+
+int main(void)
+{
+    unsigned char *p;
+    for (p = c0; p < c1; p++)
+        printf("%02x%s", *p, p + 1 < c1 ? " " : "\n");
+    return 0;
+}
diff --git a/tests/tests2/184_asm_dx_port_vmmcall.expect b/tests/tests2/184_asm_dx_port_vmmcall.expect
new file mode 100644
index 0000000..6ac1aaa
--- /dev/null
+++ b/tests/tests2/184_asm_dx_port_vmmcall.expect
@@ -0,0 +1 @@
+ed ec 66 ed ee ef ed 0f 01 c1 0f 01 d9

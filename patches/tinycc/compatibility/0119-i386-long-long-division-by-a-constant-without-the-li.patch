-            gen_opl(TOK_SHR);
-        } else {
-            vtop->c.i = m - 1;
-            gen_opl('&');
-        }
+        && gen_opl_divc(op))
         return;
-    }
 
     switch(op) {
     case '/':
@@ -4339,7 +4473,7 @@ static void klabs_free(void)

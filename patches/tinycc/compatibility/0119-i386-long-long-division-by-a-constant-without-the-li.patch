 #if PTR_SIZE == 4
+static void gen_opl(int op);
+
+/* A long long division or modulo (op) of vtop[-1] by the constant vtop,
+   without the libtcc1 helper (freestanding code such as the Linux kernel
+   has none; gcc strength-reduces every division by a constant, so a
+   gcc-built 32-bit kernel never links __divdi3 and its kin).  A power of
+   two gives a shift or a mask, with gcc's bias for a signed dividend
+   (q = (x + ((x >> 63) & (2^k - 1))) >> k, r = ((x + bias) & (2^k - 1))
+   - bias); on i386 any other divisor of at most 32 bits gives two divl
+   (TOK_UDIVL, gen_opi()): q_hi = hi / d, then (hi % d : lo) / d, both
+   with the high word below the divisor; a signed division goes through
+   the unsigned one of |x|, the result negated when x and d differ in
+   sign (the remainder takes the sign of x).  Returns 0 when the helper
+   is to be called: a divisor above 32 bits, zero, or another target. */
+static int gen_opl_divc(int op)
+{
+    uint64_t m = vtop->c.i;
+    int t = vtop[-1].type.t;
+    int sign = op == '/' || op == TOK_PDIV || op == '%';
+    int c, neg = 0;
+
+    if (!sign && m && !(m & (m - 1))) {
+        /* unsigned by 2^c: a shift or a mask */
+        for (c = 0; m > 1; m >>= 1)
+            c++;
+        if (op == TOK_UDIV) {
+            vtop->c.i = c;
+            gen_opl(TOK_SHR);
+        } else {
+            vtop->c.i = (1ULL << c) - 1;
+            gen_opl('&');
+        }
+        return 1;
+    }
+    if (sign && (int64_t)m > 1 && !(m & (m - 1))) {
+        /* signed by 2^c, c >= 1 */
+        for (c = 0; m > 1; m >>= 1)
+            c++;
+        vpop();
+        if (op == TOK_PDIV) {
+            /* the rounding does not matter */
+            vpushi(c);
+            gen_op(TOK_SAR);
+            return 1;
+        }
+        gv_dup();                       /* x x */
+        vpushi(63);
+        gen_op(TOK_SAR);                /* x s     (s = -1 or 0) */
+        vpush64(VT_LLONG, (1ULL << c) - 1);
+        gen_op('&');                    /* x b     (the bias) */
+        if (op == '/') {
+            gen_op('+');                /* x+b */
+            vpushi(c);
+            gen_op(TOK_SAR);
+        } else {
+            gv_dup();                   /* x b b */
+            vrott(3);                   /* b x b */
+            gen_op('+');                /* b x+b */
+            vpush64(VT_LLONG, (1ULL << c) - 1);
+            gen_op('&');                /* b (x+b)&(2^c-1) */
+            vswap();
+            gen_op('-');
+        }
+        vtop->type.t = t;
+        return 1;
+    }
+#ifdef TCC_TARGET_I386
+    if (sign && (int64_t)m < 0)
+        neg = 1, m = 0 - m;
+    if (m == 0 || (m >> 32))
+        return 0;
+    vpop();
+    if (sign) {
+        /* |x| and the sign s of x: |x| = (x ^ s) - s */
+        gv_dup();                       /* x x */
+        vpushi(63);
+        gen_op(TOK_SAR);                /* x s */
+        gv_dup();
+        gv_dup();                       /* x s s s */
+        vrotb(4);
+        vswap();                        /* s s x s */
+        gen_op('^');                    /* s s x^s */
+        vswap();
+        gen_op('-');                    /* s |x| */
+        vtop->type.t = VT_LLONG | VT_UNSIGNED;
+    }
+    /* the unsigned division of (hi:lo), on top, by m */
+    lexpand();                          /* lo hi */
+    vpushi(0);
+    lbuild(VT_LLONG | VT_UNSIGNED);     /* lo (0:hi) */
+    vpushi((int)m);
+    gen_opi(TOK_UDIVL);                 /* lo (qh:r1) */
+    lexpand();                          /* lo qh r1 */
+    vrotb(3);
+    vswap();                            /* qh lo r1 */
+    lbuild(VT_LLONG | VT_UNSIGNED);     /* qh (r1:lo) */
+    vpushi((int)m);
+    gen_opi(TOK_UDIVL);                 /* qh (ql:r2) */
+    lexpand();                          /* qh ql r2 */
+    if (op == '%' || op == TOK_UMOD) {
+        vrotb(3);
+        vpop();
+        vswap();
+        vpop();                         /* r2 */
+        vpushi(0);
+    } else {
+        vpop();
+        vswap();                        /* ql qh */
+    }
+    lbuild(VT_LLONG | VT_UNSIGNED);     /* [s] q */
+    if (sign) {
+        if (neg && op != '%') {
+            /* the quotient of a negative divisor: s becomes ~s */
+            vswap();
+            vpush64(VT_LLONG, -1);
+            gen_op('^');
+            vswap();
+        }
+        vswap();                        /* q s */
+        gv_dup();                       /* q s s */
+        vrott(3);                       /* s q s */
+        gen_op('^');                    /* s q^s */
+        vswap();
+        gen_op('-');                    /* (q^s)-s */
+    }
+    vtop->type.t = t;
+    return 1;
+#else
+    return 0;
+#endif
+}
+
 /* generate CPU independent (unsigned) long long operations */
 static void gen_opl(int op)
 {
@@ -2250,24 +2396,12 @@ static void gen_opl(int op)
     unsigned short reg_lret = REG_IRE2;
     SValue tmp;
 

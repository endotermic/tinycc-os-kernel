@@ -8083,8 +8226,11 @@ static int inline_call(Sym *fs, int nb_args)
     cst = 0;
     if (!fs->f.func_alwinl) {
         /* a merely static function: given a constant argument that the
-           body tests (fn->cond, from the first scan below), not from
-           within such an inlined body, and not a big one */
+           body tests (fn->cond, from the first scan below) or a body of
+           one return statement (a small accessor, which gcc inlines and

                switch, for, or next to !, ?, &&, ||, ==, != */
@@ -4421,6 +4558,7 @@ static void kscan_labels(TokenString *str)
         }
     }
     end_macro();
+    kscan_sret = sret && nsemi == 1 && nbrace == 1;
     for (i = 0; i < nb_klabs; i++)
         if (!klabs[i].defined)
             klabs[i].back = 1;
@@ -4451,7 +4589,12 @@ ST_FUNC void vstore(void)
 {
     int sbt, dbt, ft, r, size, align, bit_size, bit_pos, delayed_cast;
 

+/* An expression statement without an effect is dropped, as gcc drops it.
+   The Linux kernel has such statements: block/badblocks.c's
+   `rounddown(s, 1 << bb->shift);` (its value unused) is a statement
+   expression whose 64-bit modulo would call __umoddi3 on i386, which a
+   gcc-built kernel never links.  Called with tok the first token of a
+   statement whose value is unused: returns 1 with tok at the ';' when the
+   statement is dropped, 0 with the tokens given back otherwise.  Only a
+   statement made of expressions, with the declarations of a statement
+   expression, is considered: a scan of its tokens refuses assignments
+   (except a declaration's initializer), calls (except the builtins that
+   are keywords), ++ and --, jumps, asm, control statements, labels,
+   attributes and storage classes; the rest is parsed without code at
+   nocode_wanted == fold_probe_level (as fold_probe_expr()) and kept when
+   anything with an effect is met: a store, except to a local of the
+   statement itself (dead_probe_loc), a call, a volatile read.  The tokens
+   are read into a string and replayed (as loop_tokens() does), so the
+   position in the body does not matter (an unget_tok() buffer may be in
+   use). */
+static int dead_expr_stmt(void)
+{
+    TokenString *str, *save0;
+    int t, prev = 0, prev2 = 0, level = 0, quest = 0, ok = 1, len;
+    int saved_nocode, saved_loc, saved_warn;
+    Sym *ltop, *gtop;
+    SValue *vt0;
+    struct scope *sc0;
+    KSnap *k;
+
+    if (nocode_wanted || debug_modes || !macro_ptr)
+        return 0;
+#ifdef CONFIG_TCC_BCHECK
+    if (tcc_state->do_bounds_check)
+        return 0;
+#endif
+    str = tok_str_alloc();
+    save0 = cur_save_str, cur_save_str = str;
+    for (;;) {
+        t = tok;
+        if (t == TOK_EOF || (level == 0 && (t == ';' || t == '}')))
+            break;
+        if (t == '{' ? prev != '('
+            : (t == TOK_ASM1 || t == TOK_ASM2 || t == TOK_ASM3 || t == TOK_GOTO
+               || t == TOK_RETURN || t == TOK_BREAK || t == TOK_CONTINUE
+               || t == TOK_IF || t == TOK_ELSE || t == TOK_WHILE || t == TOK_FOR
+               || t == TOK_DO || t == TOK_SWITCH || t == TOK_CASE
+               || t == TOK_DEFAULT || t == TOK_LABEL || t == TOK_STATIC
+               || t == TOK_EXTERN || t == TOK_TYPEDEF || t == TOK_ATTRIBUTE1
+               || t == TOK_ATTRIBUTE2 || t == TOK_INC || t == TOK_DEC
+               || TOK_ASSIGN(t)
+               || (t == '(' && prev >= TOK_UIDENT)
+               || (t == ':' && quest == 0)
+               || (t == '=' && !(prev >= TOK_UIDENT
+                                 && (prev2 >= TOK_IDENT || prev2 == '*'
+                                     || prev2 == ')' || prev2 == ']'))))) {
+            ok = 0;
+            break;
+        }
+        if (t == '(' || t == '{' || t == '[')
+            level++;
+        else if (t == ')' || t == '}' || t == ']')
+            level--;
+        else if (t == '?')
+            quest++;
+        else if (t == ':')
+            quest--;
+        tok_str_add_tok(str);
+        prev2 = prev, prev = t;
+        next();
+    }
+    cur_save_str = save0;
+    len = str->len;
+    tok_str_add(str, 0); /* the string ends by itself */
+    if (!ok || tok != ';' || !len)
+        goto back;
+    len = str->len;

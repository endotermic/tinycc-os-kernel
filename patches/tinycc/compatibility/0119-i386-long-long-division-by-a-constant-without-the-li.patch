 include/tccdefs.h |  20 ++-
 tcc.h             |   4 +
 tccgen.c          | 319 ++++++++++++++++++++++++++++++++++++++++++----
 tccpp.c           |   8 +-
 5 files changed, 337 insertions(+), 32 deletions(-)

diff --git a/i386-gen.c b/i386-gen.c
index d564d20..23266b5 100644
--- a/i386-gen.c
+++ b/i386-gen.c
@@ -1304,6 +1304,24 @@ ST_FUNC void gen_opi(int op)
         }
         vtop->r = r;
         break;
+    case TOK_UDIVL:
+        /* vtop[-1] is a 64-bit unsigned dividend whose high word is
+           below the 32-bit divisor vtop (so that divl cannot fault): the
+           quotient (low word) and the remainder (high word) make up the
+           64-bit result in %edx:%eax.  gen_opl() divides a long long by
+           a constant with two of these. */
+        gv2(RC_EAX, RC_ECX);
+        fr = vtop[0].r;
+        vtop--;
+        /* other values in %eax or %edx (below the dividend) are saved */
+        save_reg_upstack(TREG_EAX, 1);
+        save_reg_upstack(TREG_EDX, 1);
+        o66();
+        o(0xf7); /* div fr, %edx:%eax */
+        o(0xf0 + fr);
+        vtop->r = TREG_EAX;
+        vtop->r2 = TREG_EDX;
+        break;
     default:
         opc = 7;
         goto gen_op8;
diff --git a/include/tccdefs.h b/include/tccdefs.h
index 22d635e..7d7777a 100644
--- a/include/tccdefs.h
+++ b/include/tccdefs.h
@@ -219,14 +219,22 @@
         if (__m == 0) __n = 0; \
         __tcc_ovf_store(__n, __m, __big, r); })
     /* mul: the 64-bit product of two magnitudes of at most 32 bits cannot
-       overflow, so the division that detects the overflow (a libtcc1 call
-       on 32-bit targets) is only compiled for wider operands */
+       overflow; wider ones are checked through their 32-bit halves (no
+       division: a 32-bit target has no helper for it in freestanding code,
+       and gcc checks a 64-bit multiplication without one too) */
     #define __builtin_mul_overflow(a, b, r) __extension__ ({ \
         __typeof__(a) __a = (a); __typeof__(b) __b = (b); \
-        unsigned long long __ma = __tcc_ovf_mag(__a), __mb = __tcc_ovf_mag(__b); \
-        unsigned long long __m = __ma * __mb; \
-        int __big = sizeof(__a) + sizeof(__b) > 8 && __ma != 0 && __m / __ma != __mb; \
-        int __n = __m != 0 && (__tcc_ovf_neg(__a) != __tcc_ovf_neg(__b)); \
+        unsigned long long __ma = __tcc_ovf_mag(__a), __mb = __tcc_ovf_mag(__b), __m, __mx; \
+        int __big = 0, __n; \
+        if (sizeof(__a) + sizeof(__b) > 8 && ((__ma | __mb) >> 32)) { \
+            __mx = (__ma >> 32) * (unsigned)__mb + (unsigned)__ma * (__mb >> 32); \
+            __m = (unsigned long long)(unsigned)__ma * (unsigned)__mb; \
+            __big = ((__ma >> 32) && (__mb >> 32)) || (__mx >> 32) != 0 \
+                    || __m + (__mx << 32) < __m; \
+            __m += __mx << 32; \
+        } else \
+            __m = __ma * __mb; \
+        __n = __m != 0 && (__tcc_ovf_neg(__a) != __tcc_ovf_neg(__b)); \
         __tcc_ovf_store(__n, __m, __big, r); })
     /* the typed forms: __builtin_{s,u}{add,sub,mul}{,l,ll}_overflow */
     #define __tcc_ovf_typed(op, t, a, b, r) __builtin_##op##_overflow((t)(a), (t)(b), (t *)(r))

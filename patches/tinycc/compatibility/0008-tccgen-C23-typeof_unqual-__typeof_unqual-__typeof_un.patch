From c0e2c1a4cf7a221d186c1dc494b5ac2a5a3bc9ad Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:20:08 +0300
Subject: [PATCH] tccgen: C23 typeof_unqual, __typeof_unqual, __typeof_unqual__

Shares the typeof code and additionally removes const, volatile and
restrict from the result.  Previously the keywords were unknown
identifiers, so a configure probe for them passed (implicit
declaration warning only) and real uses then failed.
---
 tccgen.c | 9 ++++++++-
 tcctok.h | 3 +++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/tccgen.c b/tccgen.c
index 337771f..104f0b8 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -4967,14 +4967,21 @@ static int parse_btype(CType *type, AttributeDef *ad, int ignore_label)
                 t = (t & ~(VT_BTYPE|VT_LONG)) | u;
             }
             continue;
-            /* GNUC typeof */
+            /* GNUC typeof, C23 typeof_unqual */
         case TOK_TYPEOF1:
         case TOK_TYPEOF2:
         case TOK_TYPEOF3:
+        case TOK_TYPEOF_UNQUAL1:
+        case TOK_TYPEOF_UNQUAL2:
+        case TOK_TYPEOF_UNQUAL3:
+            u = tok;
             next();
             parse_expr_type(&type1);
             /* remove all storage modifiers except typedef */
             type1.t &= ~(VT_STORAGE&~VT_TYPEDEF);
+            /* typeof_unqual: also remove the qualifiers */
+            if (u >= TOK_TYPEOF_UNQUAL1)
+                type1.t &= ~(VT_CONSTANT | VT_VOLATILE | VT_RESTRICT);
             if (type1.ref) {
                 sym_to_attr(ad, type1.ref);
                 if (type1.t & VT_ARRAY)
diff --git a/tcctok.h b/tcctok.h
index 51676ee..a327bac 100644
--- a/tcctok.h
+++ b/tcctok.h
@@ -68,6 +68,9 @@
      DEF(TOK_TYPEOF2, "__typeof")
      DEF(TOK_TYPEOF3, "__typeof__")
      DEF(TOK___AUTO_TYPE, "__auto_type")
+     DEF(TOK_TYPEOF_UNQUAL1, "typeof_unqual")
+     DEF(TOK_TYPEOF_UNQUAL2, "__typeof_unqual")
+     DEF(TOK_TYPEOF_UNQUAL3, "__typeof_unqual__")
      DEF(TOK_LABEL, "__label__")
 
 /*********************************************************************/

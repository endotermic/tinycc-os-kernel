From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Sat, 28 Nov 2026 15:25:04 +0200
Subject: [PATCH] -S: the object as assembler source (sections, labels with
 .globl/.weak/.hidden/.type/.size, the bytes as .byte, each relocated field as
 .long/.quad/.word/.byte of its symbol and addend, the value in place
 included; a call to a global symbol of the same section as sym@PLT so that it
 keeps its relocation), then the text of the asm statements in a comment for
 the kernel's asm-offsets; the asm statements are now assembled with -S too;
 tcc's assembler takes sym@GOTPCREL (x86_64, .long and rip operands) and .long
 sym@PLT as a PC-relative PLT32 (it was an absolute address) (GRUB's i386-pc
 rs_decoder.h is made with -S and #included in startup_raw.S: tcc wrote only
 the asm text, an empty file)

---
 i386-asm.c |  28 +++++-
 libtcc.c   |   1 +
 tcc.c      |   3 +
 tcc.h      |   8 +-
 tccasm.c   |  33 +++---
 tccelf.c   | 289 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 6 files changed, 346 insertions(+), 16 deletions(-)

diff --git a/i386-asm.c b/i386-asm.c
index 9d647d2..8d92813 100644
--- a/i386-asm.c
+++ b/i386-asm.c
@@ -629,8 +629,20 @@ ST_FUNC void gen_expr32(ExprValue *pe)
         /* If PC-relative, always set VT_SYM, even without symbol,
 	   so as to force a relocation to be emitted.  */
 	gen_addrpc32(VT_SYM, pe->sym, pe->v + (ind + 4));
+    else if (pe->sym && pe->gotoff == 3) {
+        /* .long sym@PLT+addend: PC-relative through the PLT, as GNU as
+           has it (tcc -S writes calls to a global function of the same
+           section that way, so that they keep their relocation) */
+#ifdef TCC_TARGET_X86_64
+        greloca(cur_text_section, pe->sym, ind, R_X86_64_PLT32, pe->v);
+        gen_le32(0);
+#else
+        greloc(cur_text_section, pe->sym, ind, R_386_PLT32);
+        gen_le32(pe->v);
+#endif
+    }
 #ifndef TCC_TARGET_X86_64
-    else if (pe->sym && pe->gotoff) {
+    else if (pe->sym && pe->gotoff == 1) {
         greloc(cur_text_section, pe->sym, ind, R_386_GOTOFF);
         gen_le32(pe->v);
     } else if (is_got_sym(pe->sym)) {
@@ -639,7 +651,11 @@ ST_FUNC void gen_expr32(ExprValue *pe)
     }
 #endif
 #ifdef TCC_TARGET_X86_64
-    else if (pe->sym && !CODE64) {
+    else if (pe->sym && pe->gotoff == 2) {
+        /* .long sym@GOTPCREL+addend */
+        greloca(cur_text_section, pe->sym, ind, R_X86_64_GOTPCREL, pe->v);
+        gen_le32(0);
+    } else if (pe->sym && !CODE64) {
         /* 32-bit code in a 64-bit object: a zero-extended address, as
            GNU as relocates it (the code generator's R_X86_64_32S is the
            sign-extended one of the kernel code model) */
@@ -804,6 +820,14 @@ static inline int asm_modrm(int reg, Operand *op)
     } else if (op->reg == -2) {
         ExprValue *pe = &op->e;
         g(0x05 + (reg << 3));
+#ifdef TCC_TARGET_X86_64
+        if (pe->sym && pe->gotoff == 2) {
+            /* sym@GOTPCREL(%rip): the GOT entry; asm_opcode() adjusts the
+               addend for an immediate after it, as for a plain symbol */
+            greloca(cur_text_section, pe->sym, ind, R_X86_64_GOTPCREL, pe->v - 4);
+            gen_le32(0);
+        } else
+#endif
         gen_addrpc32(pe->sym ? VT_SYM : 0, pe->sym, pe->v);
         return ind;
     } else if (op->ea16) {

From 3de5f5be4f232924654cd5be3388e791c73a1cc6 Mon Sep 17 00:00:00 2001
From: Nikolajs Agafonovs <nikolajs.agafonovs@gmail.com>
Date: Wed, 21 Oct 2026 16:20:09 +0300
Subject: [PATCH] tccgen: loops in unreachable code without labels stay without
 code

tcc resumes code generation at a loop head (gind()) because a label in
the body may be the target of a goto from live code.  An optimizing
compiler never emits such a loop, and code relies on that: the Linux
kernel's "if (IS_ENABLED(CONFIG_X)) while (...) foo();" references
symbols that only exist with the option.

When a loop starts in dead code, the rest of the statement is saved
(head; body by a recursive statement grammar; do-while tail), scanned
for labels, and if there are none (or only labels targeted by gotos
inside the loop and referenced nowhere before) the loop stays dead:
the tokens are then parsed from the saved copy.  When the statement
cannot be delimited the tokens read so far are given back as a
self-ending macro and the loop is generated as before.

end_macro_to() unwinds the macro stack to a replayed string, dropping
exhausted unget_tok() levels above it (a string literal in a replay
leaves one behind).
---
 tcc.h    |   1 +
 tccgen.c | 230 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 tccpp.c  |   9 +++
 3 files changed, 240 insertions(+)

diff --git a/tcc.h b/tcc.h
index a3f331b..0937dfb 100644
--- a/tcc.h
+++ b/tcc.h
@@ -1384,6 +1384,7 @@ ST_FUNC int tok_alloc_const(const char *str);
 ST_FUNC const char *get_tok_str(int v, CValue *cv);
 ST_FUNC void begin_macro(TokenString *str, int alloc);
 ST_FUNC void end_macro(void);
+ST_FUNC void end_macro_to(TokenString *str);
 ST_FUNC int set_idnum(int c, int val);
 ST_INLN void tok_str_new(TokenString *s);
 ST_FUNC TokenString *tok_str_alloc(void);
diff --git a/tccgen.c b/tccgen.c
index ead8511..8c54e58 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -158,6 +158,8 @@ static int gvtst(int inv, int t);
 static void gen_inline_functions(TCCState *s);
 static void free_inline_functions(TCCState *s);
 static void skip_or_save_block(TokenString **str);
+static void replay_end(TokenString *str);
+static TokenString *dead_loop_tokens(int kind, int *dead);
 static void gv_dup(void);
 static int get_temp_local_var(int size,int align,int *r2);
 static void cast_error(CType *st, CType *dt);
@@ -7110,6 +7112,207 @@ static void check_func_return(void)
 /* ------------------------------------------------------------------------- */
 /* switch/case */
 
+/* ------------------------------------------------------------------------- */
+/* Dead code elimination helpers: tcc has no optimizer, but code that is
+   never generated by an optimizing compiler may reference symbols which do
+   not exist (link-time assertions, stubs of disabled subsystems in the
+   Linux kernel).  The cases below are handled at parse time. */
+
+/* end the replay of the saved tokens 'str' (ending with TOK_EOF); the
+   token pushed back before it is current again.  Levels above it are
+   exhausted unget_tok() ones (popped only by the next read, e.g. after
+   a string literal) and are dropped first. */
+static void replay_end(TokenString *str)
+{
+    end_macro_to(str);
+    next();
+}
+
+
+/* Loops in unreachable code.  tcc resumes code generation at a loop head
+   (gind()) because a label in the body may be the target of a goto from
+   live code (tests2/87_dead_code.c).  A loop without any label can stay
+   without code instead, which also avoids references to symbols that only
+   exist when the code is live (the Linux kernel's IS_ENABLED() guards).
+   Called at the token after 'while (' / 'for (' / 'do': saves the rest of
+   the statement when its end can be found (the body a block or a simple
+   statement), looks for labels in it, and returns the tokens, already
+   begun as a macro for the parser (the current token is pushed back; end
+   with replay_end()), or NULL when the statement could not be delimited
+   (the tokens read so far are given back, nothing to end).  *dead tells
+   whether the loop may stay dead. */
+/* append '( ... )' to str; the current token is the one after it */
+static void save_paren_tokens(TokenString *str)
+{
+    int level = 0, t;
+    for (;; next()) {
+        t = tok;
+        if (t == TOK_EOF)
+            tcc_error("unexpected end of file");
+        tok_str_add_tok(str);
+        if (t == '(')
+            level++;
+        else if (t == ')' && --level == 0)
+            break;
+    }
+    next();
+}
+
+/* append one statement to str; 0 when its end cannot be found */
+static int save_stmt_tokens(TokenString *str, int depth)
+{
+    int t, level;
+    if (depth > 24)
+        return 0;
+    switch (tok) {
+    case '{':
+        for (level = 0;;) {
+            t = tok;
+            if (t == TOK_EOF)
+                tcc_error("unexpected end of file");
+            tok_str_add_tok(str), next();
+            if (t == '{')
+                level++;
+            else if (t == '}' && --level == 0)
+                return 1;
+        }
+    case TOK_IF: case TOK_WHILE: case TOK_FOR: case TOK_SWITCH:
+        t = tok;
+        tok_str_add_tok(str), next();
+        if (tok != '(')
+            return 0;
+        save_paren_tokens(str);
+        if (!save_stmt_tokens(str, depth + 1))
+            return 0;
+        if (t == TOK_IF && tok == TOK_ELSE) {
+            tok_str_add_tok(str), next();
+            return save_stmt_tokens(str, depth + 1);
+        }
+        return 1;
+    case TOK_DO:
+        tok_str_add_tok(str), next();
+        if (!save_stmt_tokens(str, depth + 1) || tok != TOK_WHILE)
+            return 0;
+        tok_str_add_tok(str), next();
+        if (tok != '(')
+            return 0;
+        save_paren_tokens(str);
+        if (tok != ';')
+            return 0;
+        tok_str_add_tok(str), next();
+        return 1;
+    case TOK_ELSE: case TOK_CASE: case TOK_DEFAULT: case TOK_LABEL:
+        return 0;
+    default:
+        /* expression, return, goto, break, continue, asm, declaration */
+        for (level = 0;; next()) {
+            t = tok;
+            if (t == TOK_EOF)
+                tcc_error("unexpected end of file");
+            if (level == 0 && t == ';')
+                break;
+            tok_str_add_tok(str);
+            if (t == '(' || t == '[' || t == '{')
+                level++;
+            else if (t == ')' || t == ']' || t == '}')
+                level--;
+        }
+        tok_str_add_tok(str), next();
+        return 1;
+    }
+}
+
+static TokenString *dead_loop_tokens(int kind, int *dead)
+{
+    TokenString *str = tok_str_alloc();
+    int t, prev, level;
+
+    *dead = 0;
+    if (kind != TOK_DO) {
+        /* the head up to the closing ')' */
+        for (level = 0;; next()) {
+            t = tok;
+            if (t == TOK_EOF)
+                tcc_error("unexpected end of file");
+            if (level == 0 && t == ')')
+                break;
+            tok_str_add_tok(str);
+            if (t == '(' || t == '[' || t == '{')
+                level++;
+            else if (t == ')' || t == ']' || t == '}')
+                level--;
+        }
+        tok_str_add_tok(str), next();
+    }
+    /* the body */
+    if (!save_stmt_tokens(str, 0))
+        goto giveup;
+    if (kind == TOK_DO) {
+        /* 'while ( ... ) ;' */
+        if (tok != TOK_WHILE)
+            goto giveup;
+        for (level = 0;; next()) {
+            t = tok;
+            if (t == TOK_EOF)
+                tcc_error("unexpected end of file");
+            if (level == 0 && t == ';')
+                break;
+            tok_str_add_tok(str);
+            if (t == '(' || t == '[' || t == '{')
+                level++;
+            else if (t == ')' || t == ']' || t == '}')
+                level--;
+        }
+        tok_str_add_tok(str), next();
+    }
+    tok_str_add(str, TOK_EOF);
+    unget_tok(0);
+    /* a label is an identifier followed by ':' (also in 'a ? b : c',
+       which merely keeps the loop as it was).  A label that only a goto
+       inside the loop targets and that nothing before referenced keeps
+       the loop dead (the kernel's scoped_cond_guard() has one). */
+    {
+        int labels[8], gotos[8], nl = 0, ng = 0, i, k;
+        begin_macro(str, 0);
+        next();
+        for (prev = 0, *dead = 1; tok != TOK_EOF; prev = tok, next()) {
+            if (tok == TOK_LABEL) {
+                *dead = 0;
+                break;
+            }
+            if (tok == ':' && prev >= TOK_UIDENT) {
+                if (nl == 8 || label_find(prev)) {
+                    *dead = 0;
+                    break;
+                }
+                labels[nl++] = prev;
+            } else if (tok == TOK_GOTO) {
+                next();
+                if (tok >= TOK_UIDENT && ng < 8)
+                    gotos[ng++] = tok;
+            }
+        }
+        for (i = 0; *dead && i < nl; i++) {
+            for (k = 0; k < ng && gotos[k] != labels[i]; k++)
+                ;
+            if (k == ng)
+                *dead = 0;
+        }
+        end_macro();
+    }
+    begin_macro(str, 0);
+    next();
+    return str;
+giveup:
+    /* only part of the statement was read: give it back as a macro that
+       ends by itself (0), the parser goes on with the file after it */
+    tok_str_add(str, 0);
+    unget_tok(0);
+    begin_macro(str, 1);
+    next();
+    return NULL;
+}
+
 static int case_cmp(uint64_t a, uint64_t b)
 {
     if (cur_switch->sv.type.t & VT_UNSIGNED)
@@ -7427,14 +7630,22 @@ again:
         prev_scope_s(&o);
 
     } else if (t == TOK_WHILE) {
+        TokenString *str = NULL;
+        int dead = nocode_wanted == CODE_OFF_BIT;
         new_scope_s(&o);
         d = gind();
         skip('(');
+        if (dead)
+            str = dead_loop_tokens(TOK_WHILE, &dead);
+        if (dead)
+            CODE_OFF(); /* unreachable loop without labels: stays dead */
         gexpr();
         a = gvtst(1, 0);
         skip(')');
         b = 0;
         lblock(&a, &b);
+        if (str)
+            replay_end(str), tok_str_free(str);
         gjmp_addr(d);
         gsym_addr(b, d);
         gsym(a);
@@ -7520,9 +7731,13 @@ again:
         skip(';');
 
     } else if (t == TOK_FOR) {
+        TokenString *str = NULL;
+        int dead = nocode_wanted == CODE_OFF_BIT;
         new_scope(&o);
 
         skip('(');
+        if (dead)
+            str = dead_loop_tokens(TOK_FOR, &dead);
         if (tok != ';') {
             /* c99 for-loop init decl? */
             if (!decl(VT_JMP)) {
@@ -7534,6 +7749,8 @@ again:
         skip(';');
         a = b = 0;
         c = d = gind();
+        if (dead)
+            CODE_OFF(); /* unreachable loop without labels, see TOK_WHILE */
         if (tok != ';') {
             gexpr();
             a = gvtst(1, 0);
@@ -7542,6 +7759,8 @@ again:
         if (tok != ')') {
             e = gjmp(0);
             d = gind();
+            if (dead)
+                CODE_OFF();
             gexpr();
             vpop();
             gjmp_addr(c);
@@ -7549,15 +7768,23 @@ again:
         }
         skip(')');
         lblock(&a, &b);
+        if (str)
+            replay_end(str), tok_str_free(str);
         gjmp_addr(d);
         gsym_addr(b, d);
         gsym(a);
         prev_scope(&o, 0);
 
     } else if (t == TOK_DO) {
+        TokenString *str = NULL;
+        int dead = nocode_wanted == CODE_OFF_BIT;
         new_scope_s(&o);
         a = b = 0;
+        if (dead)
+            str = dead_loop_tokens(TOK_DO, &dead);
         d = gind();
+        if (dead)
+            CODE_OFF(); /* unreachable loop without labels, see TOK_WHILE */
         lblock(&a, &b);
         gsym(b);
         skip(TOK_WHILE);
@@ -7566,12 +7793,15 @@ again:
         c = gvtst(0, 0);
         skip(')');
         skip(';');
+        if (str)
+            replay_end(str), tok_str_free(str);
 	gsym_addr(c, d);
         gsym(a);
         prev_scope_s(&o);
 
     } else if (t == TOK_SWITCH) {
         struct switch_t *sw;
+        TokenString *body = NULL;
 
         sw = tcc_mallocz(sizeof *sw);
         sw->bsym = &a;
diff --git a/tccpp.c b/tccpp.c
index 4fab38c..e2ee456 100644
--- a/tccpp.c
+++ b/tccpp.c
@@ -1060,6 +1060,15 @@ ST_FUNC void begin_macro(TokenString *str, int alloc)
     macro_stack = str;
 }
 
+/* end the macro levels down to and including 'str' (the ones above are
+   exhausted unget_tok() levels, popped only by the next read) */
+ST_FUNC void end_macro_to(TokenString *str)
+{
+    while (macro_stack != str)
+        end_macro();
+    end_macro();
+}
+
 ST_FUNC void end_macro(void)
 {
     TokenString *str = macro_stack;

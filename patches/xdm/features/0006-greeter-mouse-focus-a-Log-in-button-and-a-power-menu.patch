 draw_it (LoginWidget w)
 {
@@ -900,6 +1235,8 @@ draw_it (LoginWidget w)
     }
     RedrawFail (w);
     DrawFocus (w);
+    DrawButtons (w);
+    DrawPowerMenu (w);
     XorCursor (w);
     XSetInputFocus (XtDisplay (w), XtWindow (w),
 		    RevertToPointerRoot, CurrentTime);
@@ -1796,6 +2133,14 @@ static void Initialize (
     valuemask = GCForeground | GCBackground;
     w->login.focusGC = XtGetGC(gnew, valuemask, &myXGCV);
 
+    myXGCV.foreground = w->login.activepixel;
+    w->login.activeGC = XtGetGC(gnew, valuemask, &myXGCV);
+    myXGCV.foreground = w->login.menupixel;
+    w->login.menuGC = XtGetGC(gnew, valuemask, &myXGCV);
+    w->login.powerOpen = False;
+    w->login.powerHover = -1;
+    XtAddEventHandler (gnew, KeyPressMask, False, KeyClosesPowerMenu, NULL);
+
     myXGCV.foreground = w->login.shdpixel;
     myXGCV.background = w->core.background_pixel;
     valuemask = GCForeground | GCBackground;
@@ -1951,6 +2296,8 @@ SkipXpmLoad:
 
 #ifndef XPM
 	w->core.height = fy + pady;	/* for stupid compilers */
+	if (HAS_BUTTONS(w))     /* the row of buttons below the message */
+	    w->core.height = BUTTON_ROW_Y(w) + BUTTON_H(w) + Y_INC(w);
 #else
 /*	w->core.height = fy + pady;	* for stupid compilers */
 
@@ -2087,6 +2434,8 @@ static void Destroy (Widget gw)
 #endif
     XtReleaseGC(gw, w->login.hiGC);
     XtReleaseGC(gw, w->login.focusGC);
+    XtReleaseGC(gw, w->login.activeGC);
+    XtReleaseGC(gw, w->login.menuGC);
     XtReleaseGC(gw, w->login.shdGC);
     XtReleaseGC(gw, w->login.inpGC);
 
@@ -2229,6 +2578,8 @@ char defaultLoginTranslations [] =
 #endif
 "<Key>Return:	finish-field() \n"
 "<Key>Tab:	tab-field() \n"
+"<Btn1Down>:	pointer-press() \n"
+"<Motion>:	pointer-motion() \n"
 "<KeyPress>:	insert-char()"
 ;
 
@@ -2244,6 +2595,8 @@ XtActionsRec loginActionsTable [] = {
   {"erase-line",		EraseLine},
   {"finish-field", 		FinishField},

+	/* buttons along the bottom of the box: Log in (loginButtonLabel), and
+	   a power menu (powerLabel) with Restart and Shut down, each shown
+	   when its command is set; the menu opens upwards over the box */
+	char	       *loginButtonLabel;
+	char	       *powerLabel;
+	char	       *rebootLabel;
+	char	       *shutdownLabel;
+	char	       *rebootCommand;

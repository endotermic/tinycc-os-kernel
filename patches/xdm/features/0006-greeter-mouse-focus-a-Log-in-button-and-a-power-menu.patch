+
+/*
+ * The buttons along the bottom of the box (loginButtonLabel, and the power
+ * menu when rebootCommand or shutdownCommand is set): Log in on the right,
+ * under the right edge of the input fields, filled with activeColor; Power
+ * on the left, under the prompts, an outline with a down arrow, which opens
+ * a menu of Restart and Shut down upwards over the box.  The mouse also
+ * moves the focus between the input fields (PointerPress).
+ */
+
+static void
+LoginButtonRect (LoginWidget w, XRectangle *r)
+{
+    const char *l = w->login.loginButtonLabel;
+    r->width = TEXT_WIDTH (prompt, l, strlen (l)) + 2 * Y_INC(w);
+    r->height = BUTTON_H(w);
+    r->x = FIELD_RIGHT(w) - r->width;
+    r->y = BUTTON_ROW_Y(w);
+}
+
+static void
+PowerButtonRect (LoginWidget w, XRectangle *r)
+{
+    const char *l = w->login.powerLabel ? w->login.powerLabel : "";
+    r->width = TEXT_WIDTH (prompt, l, strlen (l)) + 2 * Y_INC(w) + ARROW_W(w) + 4;
+    r->height = BUTTON_H(w);
+    r->x = PROMPT_X(w);
+    r->y = BUTTON_ROW_Y(w);
+}
+
+/* the power menu's entries: 0 Restart, 1 Shut down, those with a command */
+static int
+PowerEntries (LoginWidget w, const char **labels, const char **commands)
+{
+    int n = 0;
+    if (HAS_REBOOT(w)) {
+	labels[n] = w->login.rebootLabel ? w->login.rebootLabel : "";
+	commands[n++] = w->login.rebootCommand;
+    }
+    if (HAS_SHUTDOWN(w)) {
+	labels[n] = w->login.shutdownLabel ? w->login.shutdownLabel : "";
+	commands[n++] = w->login.shutdownCommand;
+    }
+    return n;
+}
+
+static void
+PowerMenuRect (LoginWidget w, XRectangle *r, int *itemh)
+{
+    const char *labels[2], *commands[2];
+    XRectangle b;
+    int i, n = PowerEntries (w, labels, commands), width;
+
+    PowerButtonRect (w, &b);
+    *itemh = BUTTON_H(w);
+    r->width = b.width;
+    for (i = 0; i < n; i++) {
+	width = TEXT_WIDTH (prompt, labels[i], strlen (labels[i])) + 2 * Y_INC(w);
+	if (width > r->width)
+	    r->width = width;
+    }
+    r->height = n * *itemh + 2;
+    r->x = b.x;
+    r->y = b.y - 4 - r->height;
+}
+
+static Boolean
+InRect (const XRectangle *r, int x, int y)
+{
+    return x >= r->x && y >= r->y && x < r->x + r->width && y < r->y + r->height;
+}
+
+/* a label centred in a rectangle, in the prompt face and colour */
+static void
+DrawCentred (LoginWidget w, const XRectangle *r, const char *text, int dx)
+{
+    int len = strlen (text);
+    int x = r->x + (r->width - dx - TEXT_WIDTH (prompt, text, len)) / 2;
+    int y = r->y + (r->height + F_ASCENT(prompt) - F_DESCENT(prompt)) / 2;
+    DRAW_STRING (prompt, x, y, text, len);
+}
+
+static void
+DrawButtons (LoginWidget w)
+{
+    XRectangle r;
+
+    if (HAS_LOGIN_BUTTON(w)) {
+	LoginButtonRect (w, &r);
+	XFillRectangle (XtDisplay (w), XtWindow (w), w->login.activeGC,
+			r.x, r.y, r.width, r.height);
+	DrawCentred (w, &r, w->login.loginButtonLabel, 0);
+    }
+    if (HAS_POWER(w)) {
+	XPoint arrow[3];
+	int a = ARROW_W(w), ax, ay;
+
+	PowerButtonRect (w, &r);
+	XDrawRectangle (XtDisplay (w), XtWindow (w), w->login.hiGC,
+			r.x, r.y, r.width - 1, r.height - 1);
+	DrawCentred (w, &r, w->login.powerLabel ? w->login.powerLabel : "", a + 4);
+	ax = r.x + r.width - Y_INC(w) / 2 - a;
+	ay = r.y + (r.height - a / 2) / 2;
+	arrow[0].x = ax;	 arrow[0].y = ay;
+	arrow[1].x = ax + a;	 arrow[1].y = ay;
+	arrow[2].x = ax + a / 2; arrow[2].y = ay + a / 2;
+	XFillPolygon (XtDisplay (w), XtWindow (w), w->login.hiGC, arrow, 3,
+		      Convex, CoordModeOrigin);
+    }
+}
+
+static void
+DrawPowerMenu (LoginWidget w)
+{
+    const char *labels[2], *commands[2];
+    XRectangle r, item;
+    int i, n, itemh;
+
+    if (!w->login.powerOpen)
+	return;
+    n = PowerEntries (w, labels, commands);
+    PowerMenuRect (w, &r, &itemh);
+    XFillRectangle (XtDisplay (w), XtWindow (w), w->login.menuGC,
+		    r.x, r.y, r.width, r.height);
+    XDrawRectangle (XtDisplay (w), XtWindow (w), w->login.hiGC,
+		    r.x, r.y, r.width - 1, r.height - 1);
+    for (i = 0; i < n; i++) {
+	item.x = r.x + 1;
+	item.y = r.y + 1 + i * itemh;
+	item.width = r.width - 2;
+	item.height = itemh;
+	if (i == w->login.powerHover)
+	    XFillRectangle (XtDisplay (w), XtWindow (w), w->login.activeGC,
+			    item.x, item.y, item.width, item.height);
+	DrawCentred (w, &item, labels[i], 0);
+    }
+}
+
+static void draw_it (LoginWidget w);
+
+/* everything again (the menu covered part of the box) */
+static void
+RedrawAll (LoginWidget w)
+{
+    XClearArea (XtDisplay (w), XtWindow (w), 0, 0, 0, 0, False);
+    draw_it (w);
+}
+
+static void
+ClosePowerMenu (LoginWidget w)
+{
+    if (!w->login.powerOpen)
+	return;
+    w->login.powerOpen = False;
+    w->login.powerHover = -1;
+    RedrawAll (w);
+}
+
+/* run a power command: detached, through the shell (the greeter is root) */
+static void
+RunPowerCommand (const char *command)
+{
+    pid_t pid = fork ();
+    if (pid == 0) {
+	setsid ();
+	execl ("/bin/sh", "sh", "-c", command, (char *) NULL);
+	_exit (127);
+    }
+}
+
+/* Log in: with no name yet, the name field takes the keys; else the same
+   as Enter in the last input field (the password) */
+static void
+LoginButtonPressed (LoginWidget w, XEvent *event)
+{
+    int p;
+
+    if (w->login.state != PROMPTING)
+	return;
+    for (p = LAST_PROMPT; p >= 0; p--)
+	if (PROMPT_STATE(w, p) == LOGIN_PROMPT_ECHO_ON ||
+	    PROMPT_STATE(w, p) == LOGIN_PROMPT_ECHO_OFF)
+	    break;
+    if (p < 0)
+	return;
+    XorCursor (w);
+    if (PROMPT_STATE(w, 0) == LOGIN_PROMPT_ECHO_ON && VALUE_TEXT(w, 0)[0] == '\0') {
+	w->login.activePrompt = 0;
+	DrawFocus (w);
+	XorCursor (w);
+	return;
+    }
+    w->login.activePrompt = p;
+    DrawFocus (w);
+    XorCursor (w);
+    FinishField ((Widget) w, event, NULL, NULL);    /* its cursor toggles too */
+}
+
+/*ARGSUSED*/
+static void
+PointerPress (Widget gw, XEvent *event, String *params, Cardinal *num_params)
+{
+    LoginWidget w = (LoginWidget) gw;
+    XRectangle r;
+    int x = event->xbutton.x, y = event->xbutton.y, p, itemh;
+
+    if (event->type != ButtonPress || event->xbutton.button != Button1)
+	return;
+    if (w->login.powerOpen) {
+	const char *labels[2], *commands[2];
+	int n = PowerEntries (w, labels, commands);
+
+	PowerMenuRect (w, &r, &itemh);
+	if (InRect (&r, x, y)) {
+	    int i = (y - r.y - 1) / itemh;
+	    if (i >= 0 && i < n) {
+		ClosePowerMenu (w);
+		RunPowerCommand (commands[i]);
+		return;
+	    }
+	}
+	ClosePowerMenu (w);
+	return;
+    }
+    if (HAS_POWER(w)) {
+	PowerButtonRect (w, &r);
+	if (InRect (&r, x, y)) {
+	    RemoveFail (w);
+	    w->login.powerOpen = True;
+	    w->login.powerHover = -1;
+	    DrawPowerMenu (w);
+	    return;
+	}
+    }
+    if (HAS_LOGIN_BUTTON(w)) {
+	LoginButtonRect (w, &r);
+	if (InRect (&r, x, y)) {
+	    RemoveFail (w);
+	    LoginButtonPressed (w, event);
+	    return;
+	}
+    }
+    /* a click in an input field gives it the keys */
+    if (w->login.state != PROMPTING)
+	return;
+    for (p = 0; p < NUM_PROMPTS; p++) {
+	r.x = VALUE_X(w,p) - w->login.inframeswidth - 3;
+	r.y = PROMPT_Y(w,p) - w->login.inframeswidth - 1 - TEXT_Y_INC(w);
+	r.width = PROMPT_W(w) - VALUE_X(w,p) - LOGO_W(w);
+	r.height = PROMPT_H(w) + w->login.inframeswidth + 2;
+	if (InRect (&r, x, y) &&
+	    (PROMPT_STATE(w, p) == LOGIN_PROMPT_ECHO_ON ||
+	     PROMPT_STATE(w, p) == LOGIN_PROMPT_ECHO_OFF)) {
+	    if (p != w->login.activePrompt) {
+		XorCursor (w);
+		w->login.activePrompt = p;
+		DrawFocus (w);
+		XorCursor (w);
+	    }
+	    return;
+	}
+    }
+}
+
+/*ARGSUSED*/
+static void
+PointerMotion (Widget gw, XEvent *event, String *params, Cardinal *num_params)
+{
+    LoginWidget w = (LoginWidget) gw;
+    XRectangle r;
+    int itemh, hover = -1;
+    const char *labels[2], *commands[2];
+    int n;
+
+    if (!w->login.powerOpen || event->type != MotionNotify)
+	return;
+    n = PowerEntries (w, labels, commands);
+    PowerMenuRect (w, &r, &itemh);
+    if (InRect (&r, event->xmotion.x, event->xmotion.y)) {
+	hover = (event->xmotion.y - r.y - 1) / itemh;
+	if (hover >= n)
+	    hover = -1;
+    }
+    if (hover != w->login.powerHover) {
+	w->login.powerHover = hover;
+	DrawPowerMenu (w);
+    }
+}
+
+/* a key while the power menu is open closes it (the key itself has been
+   handled by the translations already, under the menu) */
+/*ARGSUSED*/
+static void
+KeyClosesPowerMenu (Widget gw, XtPointer closure, XEvent *event, Boolean *cont)
+{
+    LoginWidget w = (LoginWidget) gw;
+    if (event->type == KeyPress && w->login.powerOpen)
+	ClosePowerMenu (w);
+}

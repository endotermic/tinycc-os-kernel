+/** The tray window's own background (its border and the gaps between the
+ * components): the frosted wallpaper under it, else the tray colour. */
+void SetTrayBackground(TrayType *tp)
+{
+   Pixmap p;
+
+   if(tp->window == None) {
+      return;
+   }
+   if(GetFrostedPixmap() == None) {
+      JXSetWindowBackground(display, tp->window, colors[COLOR_TRAY_BG2]);
+   } else {
+      p = JXCreatePixmap(display, tp->window, tp->width, tp->height,
+                         rootDepth);
+      DrawFrosted(p, tp->x, tp->y, 0, 0, tp->width, tp->height);
+      JXSetWindowBackgroundPixmap(display, tp->window, p);
+      JXFreePixmap(display, p);
+   }
+   JXClearWindow(display, tp->window);
+}
+
+/** The wallpaper changed: every tray takes its new piece of glass (the
+ * components redraw on the resize). */
+void UpdateTrayBackgrounds(void)
+{
+   TrayType *tp;
+   for(tp = trays; tp; tp = tp->next) {
+      ResizeTray(tp);
+   }
+}
+
 /** Draw the tray background on a drawable. */
 void ClearTrayDrawable(const TrayComponentType *cp)
 {
    const Drawable d = cp->pixmap != None ? cp->pixmap : cp->window;
+   if(DrawFrosted(d, cp->screenx, cp->screeny, 0, 0, cp->width, cp->height)) {
+      return;
+   }
    if(colors[COLOR_TRAY_BG1] == colors[COLOR_TRAY_BG2]) {
       JXSetForeground(display, rootGC, colors[COLOR_TRAY_BG1]);
       JXFillRectangle(display, d, rootGC, 0, 0, cp->width, cp->height);

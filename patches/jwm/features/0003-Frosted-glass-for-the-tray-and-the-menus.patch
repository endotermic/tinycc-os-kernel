+ * backgrounds from it, so they read as frosted glass over the desktop.
+ * None when there is none.
+ */
+Pixmap GetFrostedPixmap(void);
+
+/** Forget the frosted pixmap (the property changed). */
+void InvalidateFrostedPixmap(void);
+
+/** Copy the frosted wallpaper under the screen area (sx, sy, width, height)
+ * to (x, y) of a drawable.
+ * @return 1 if done, 0 if there is no frosted wallpaper.
+ */
+char DrawFrosted(Drawable d, int sx, int sy, int x, int y,
+                 int width, int height);
+
 #endif /* BACKGROUND_H */
 

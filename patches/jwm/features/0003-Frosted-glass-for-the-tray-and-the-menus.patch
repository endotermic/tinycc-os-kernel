diff --git a/src/background.c b/src/background.c
index 09dbafd..9d818a0 100644
--- a/src/background.c
+++ b/src/background.c
@@ -50,6 +50,65 @@ static void LoadGradientBackground(BackgroundNode *bp);
 static void LoadImageBackground(BackgroundNode *bp);
 
 /** Initialize any data needed for background support. */
+static Pixmap frostedPixmap = None;
+static char frostedRead = 0;
+
+/** Get the frosted wallpaper (read once, after each change). */
+Pixmap GetFrostedPixmap(void)
+{
+   Atom type;
+   int format;
+   unsigned long count, after;
+   unsigned char *data = NULL;
+   Window root;
+   int x, y;
+   unsigned int width, height, border, depth;
+
+   if(frostedRead) {
+      return frostedPixmap;
+   }
+   frostedRead = 1;
+   frostedPixmap = None;
+   if(JXGetWindowProperty(display, rootWindow,
+                          atoms[ATOM_WALLPAPER_FROSTED_PMAP_ID], 0, 1, False,
+                          XA_PIXMAP, &type, &format, &count, &after,
+                          &data) == Success
+      && type == XA_PIXMAP && format == 32 && count == 1 && data) {
+      frostedPixmap = *(Pixmap*)data;
+   }
+   if(data) {
+      JXFree(data);
+   }
+   /* The pixmap belongs to another client and may be gone (the error
+    * handler only logs). */
+   if(frostedPixmap != None
+      && (!JXGetGeometry(display, frostedPixmap, &root, &x, &y, &width,
+                         &height, &border, &depth)
+          || depth != rootDepth)) {
+      frostedPixmap = None;
+   }
+   return frostedPixmap;
+}
+
+/** Forget the frosted wallpaper. */
+void InvalidateFrostedPixmap(void)
+{
+   frostedRead = 0;
+   frostedPixmap = None;
+}
+
+/** Copy a piece of the frosted wallpaper to a drawable. */
+char DrawFrosted(Drawable d, int sx, int sy, int x, int y,
+                 int width, int height)
+{
+   const Pixmap p = GetFrostedPixmap();
+   if(p == None || width <= 0 || height <= 0) {
+      return 0;
+   }
+   JXCopyArea(display, p, d, rootGC, sx, sy, width, height, x, y);
+   return 1;
+}
+
 void InitializeBackgrounds(void)
 {
    backgrounds = NULL;

# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment of the opt-in Android kernel (scripts/build.sh kernel-android, merged after
# tcc.config into build/<arch>/linux-android): the kernel features an Android userspace needs
# when it runs in a container on this system (the Waydroid way: Android's own /init in its own
# namespaces on our kernel).  tests/android/run.sh boots the result with tests/android/probe.c,
# which checks each group below.  Not in the default kernel or the images.

# ---- Android's event loops (libutils Looper, init, lmkd): epoll with eventfd/timerfd/signalfd ----
CONFIG_EXPERT=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_FUTEX=y

# ---- Binder, Android's IPC; binderfs gives the container its own binder, hwbinder and vndbinder
# (the default ANDROID_BINDER_DEVICES).  Ashmem left mainline in 5.18: Android uses memfd ----
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# ---- The container: every namespace (IPC_NS needs System V IPC or POSIX message queues) ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# ---- cgroup v2 with the controllers Android's init and lmkd use, and pressure stall info ----
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_PSI=y

# ---- eBPF: bpfloader and netd attach cgroup programs (traffic accounting) since Android 12.
# No DEBUG_INFO_BTF (needs pahole): scripts/build.sh gives btf.o kernels/linux/tcc-btf.h ----
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# ---- seccomp filters: Android's zygote installs one in every app process ----
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---- Images and storage: system/vendor images on loop devices (ext4, erofs, squashfs),
# overlays, and FUSE for the emulated shared storage (Android 11+) ----
CONFIG_BLK_DEV_LOOP=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS_XATTR=y

# ---- The container's network: a veth pair on a bridge with NAT (nftables; the legacy
# iptables backend cannot be selected in this kernel, iptables-nft works), and tun ----
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_TUN=y

# ---- Input and graphics buffers: uinput for injected input, dma-buf heaps and udmabuf for
# gralloc buffers shared with a host display ----
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y

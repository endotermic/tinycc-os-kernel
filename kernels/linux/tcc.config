# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment applied on top of minimal.config only for the tcc build (scripts/build.sh).
# tcc does not inline static inline helpers, so __init-only helpers end up in .text and
# reference .init.*; modpost reports those as section mismatches. Keep them warnings.
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# tcc's 16-bit code is about twice the size of gcc -Os's; the real-mode setup must stay under
# 32 KB, so the BIOS video mode setting (vga=, menu, VESA EDID: ~11 KB) is left out.  The
# firmware's text mode is kept; GRUB's gfxpayload (the ISO) still gives the framebuffer console.
# CONFIG_X86_BOOT_VIDEO_MODES is not set

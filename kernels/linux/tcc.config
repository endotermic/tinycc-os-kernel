# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment applied on top of minimal.config only for the tcc build (scripts/build.sh).
# tcc does not inline static inline helpers, so __init-only helpers end up in .text and
# reference .init.*; modpost reports those as section mismatches. Keep them warnings.
CONFIG_SECTION_MISMATCH_WARN_ONLY=y

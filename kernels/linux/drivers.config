# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment of the device drivers, merged after minimal.config (scripts/build.sh,
# userland/selfhost/build-kernel): PCI, networking (Ethernet, Wi-Fi, Bluetooth), sound, USB,
# mouse and a KMS display at the screen's native resolution.  Everything is built in (no
# modules), as the rest of the kernel.  What QEMU emulates of it is attached by run.sh
# (--devices, the default); the rest is for real hardware.

# ---- PCI: every device below but the PS/2 mouse hangs off it ----
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ---- Real hardware, group 1 of docs/HARDWARE.md: ACPI, internal storage, real-time clock ----
# ACPI: the CPUs of firmware without MP tables (most since ~2010), PCI interrupt routing, power
# off, the power and lid buttons, AC adapter, battery and thermal zones (/sys/class/power_supply,
# /sys/class/thermal).  QEMU's pc machine has ACPI tables too.
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
# DMI: the BIOS identity (/sys/class/dmi/id) that the quirk tables of ACPI, i8042, HDA and the
# touchpads match on
CONFIG_DMI=y
CONFIG_DMIID=y
# the internal disks: SATA (AHCI; PIIX for older Intel boards and QEMU's IDE), NVMe; SD cards
# (SDHCI on PCI and the Realtek card readers of most laptops); GPT is on already (EFI_PARTITION)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MMC_REALTEK_PCI=y
# USB Attached SCSI (fast USB 3 disks), exFAT (SD cards over 32 GB), CDs and ISO images,
# UTF-8 file names on FAT/exFAT
CONFIG_USB_UAS=y
CONFIG_EXFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_NLS_UTF8=y
# the battery-backed clock: the system time at boot (without it 1970, and TLS certificate
# checks fail)
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
# hardware monitoring (/sys/class/hwmon): the temperatures of ACPI thermal zones, NVMe drives
# and Wi-Fi cards; ath12k's thermal code calls hwmon_device_unregister() behind a label that
# only dead code jumps to, so without HWMON the link fails
CONFIG_HWMON=y

# ---- Networking: TCP/IP over Ethernet ----
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
# Intel (QEMU's default e1000, the e1000e of most Intel boards), Realtek (RTL8139 of QEMU,
# RTL8169/8168 of most consumer boards), virtio (QEMU/KVM -nic model=virtio-net-pci)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
# USB Ethernet adapters and phone tethering (CDC Ethernet, RNDIS)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y

# ---- Wi-Fi: cfg80211/mac80211 with Atheros ath9k (PCI, needs no firmware file) and the
# mac80211_hwsim virtual radios QEMU tests run on (there is no emulated Wi-Fi card) ----
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
# The regulatory database (firmware file regulatory.db) is not in the image, so cfg80211 uses
# the world domain; its signature check is left out: it would pull in X.509, RSA, ASN.1 and
# the OID registry, whose table is generated by a Perl script that the self-hosting guest
# does not have (the option has a prompt only under CERTIFICATION_ONUS).
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_MAC80211_HWSIM=y
# Real hardware, group 2 of docs/HARDWARE.md: the PCIe Wi-Fi cards of laptops since ~2013.
# Each one loads firmware files at probe time (FW_LOADER, from the firmware image the ISO
# loads as a second initrd: scripts/build.sh firmware).
# Intel: DVM (Wi-Fi 4/5 up to the 6000/2000 series), MVM (7260 .. AX211), MLD (BE200 and later)
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_IWLMLD=y
# Realtek: rtw88 (Wi-Fi 5: 8821CE, 8822BE/CE, 8723DE) and rtw89 (Wi-Fi 6/6E/7)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW89=y
CONFIG_RTW89_8851BE=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8852BTE=y
CONFIG_RTW89_8852CE=y
CONFIG_RTW89_8922AE=y
# MediaTek: MT7921/MT7922 (Wi-Fi 6/6E, also sold as AMD RZ608/RZ616) and MT7925 (Wi-Fi 7)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
CONFIG_MT7925E=y
# Qualcomm Atheros: ath10k (QCA6174/QCA9377, Wi-Fi 5), ath11k (WCN6855/QCA6390, Wi-Fi 6/6E),
# ath12k (WCN7850, Wi-Fi 7); ath11k/ath12k talk to the card over MHI and QRTR
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH12K=y
# Broadcom FullMAC on PCIe (BCM43602, BCM4350/4356 ...): firmware plus a board nvram file
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y

# ---- Bluetooth: the stack with USB dongles (btusb), UART controllers (H4) and the virtual
# controller /dev/vhci that the QEMU tests use ----
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIVHCI=y

# ---- Sound: ALSA with Intel HD Audio (QEMU -device intel-hda + hda-duplex, most boards),
# AC'97 (QEMU -device AC97) and USB audio; the OSS /dev/dsp and /dev/mixer emulation so
# that a raw write plays (busybox has no ALSA tools) ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_OSSEMUL=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ---- Mouse: PS/2 (i8042 aux port, touchpads), USB HID mice through hid-generic, the
# /dev/input/mice and /dev/input/eventN interfaces ----
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- USB: the four host controller types, HID (keyboards, mice), mass storage with the
# SCSI disk layer and the FAT and ext4 filesystems a stick carries ----
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_BLOCK=y
# deadline and kyber are enough; BFQ is pinned off because a fresh tinyconfig (the guest's
# build-kernel) turned it on while the incrementally merged host tree had it off, and the
# pruned self-hosting source (from the host build's dependency lists) lacks block/bfq-*.c
# CONFIG_IOSCHED_BFQ is not set
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- Video: KMS at the native resolution, with fbcon on top (DRM_FBDEV_EMULATION).
# simpledrm takes over the firmware's framebuffer (UEFI GOP: the panel's native mode;
# GRUB's gfxpayload=auto picks the EDID-preferred mode on BIOS); bochs-drm drives QEMU's
# standard VGA and sets the mode the display's EDID prefers (run.sh: -device VGA,xres=,yres=),
# virtio-gpu QEMU's -vga virtio.  simpledrm replaces minimal.config's simplefb. ----
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
# CONFIG_FB_SIMPLE is not set

# ---- Real hardware, group 3 of docs/HARDWARE.md: the GPUs of PCs and laptops ----
# Intel: i915 (gen2 .. Meteor Lake/Arrow Lake) and xe (Lunar Lake and later, Arc); AMD:
# amdgpu (GCN 1.0 .. RDNA, with the DC display engine; SI and CIK too instead of radeon) and
# radeon (the R100 .. Northern Islands cards amdgpu does not drive); NVIDIA: nouveau.  They
# take the display from simpledrm when they probe; amdgpu, radeon, nouveau and xe need
# firmware files to light the screen (the firmware image), i915 only for power saving.
CONFIG_DRM_I915=y
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=y
CONFIG_DRM_NOUVEAU=y
# the panel's brightness (/sys/class/backlight; the keys through ACPI video), and the
# memory types of the CPU (MTRR, PAT) that make the framebuffer write-combined: without them
# a 4K console scrolls at uncached speed
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y

# ---- Real hardware, group 4 of docs/HARDWARE.md: touchpads and touchscreens ----
# I2C precision touchpads (nearly every laptop since ~2016) and touchscreens: HID over I2C,
# found through ACPI (PNP0C50), on the I2C controller of the chipset (Synopsys DesignWare:
# Intel LPSS from Haswell on, AMD from Carrizo on, AMDI0010), interrupting through a GPIO
# pin of the chipset's pin controller (the Intel and AMD pinctrl drivers); hid-multitouch
# turns their reports into multitouch events, and mousedev makes /dev/input/mice of them for
# TinyX.  UHID lets devices-test create such a touchpad from user space.
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_UHID=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_LYNXPOINT=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
# AMD laptops whose touchpad sits behind the sensor hub's PCIe I2C bridge
CONFIG_I2C_AMD_MP2=y
# PS/2 touchpads in their native (absolute, multi-finger) mode, and the Synaptics and Elan
# touchpads that move to SMBus once the PS/2 driver has found them (RMI4 over the chipset's
# SMBus controller: Intel i801, AMD piix4)
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_I2C_I801=y
CONFIG_I2C_PIIX4=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_HID_RMI=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y
# touchscreens that are not HID: Goodix (tablets, 2-in-1s)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# ---- Real hardware, group 5 of docs/HARDWARE.md: Ethernet, PCIe ports, USB4/Thunderbolt ----
# The wired Ethernet of PCs and laptops beyond e1000e and r8169 (above): Intel igb (82575/6,
# I210/I211/I350; QEMU's -device igb) and igc (I225/I226, the 2.5G ports of recent boards),
# Broadcom tg3 (business laptops and desktops), Qualcomm Atheros alx/atl1c/atl1e (consumer
# laptops), Marvell sky2 (older laptops), JMicron jme, Aquantia AQtion (the 5G/10G ports of
# high-end boards); USB adapters and docks: Realtek r8152 (RTL8152/8153/8156, most USB-C
# dongles and docks), Microchip LAN78xx, SMSC LAN95xx, Aquantia AQC111.  The rtl_nic firmware
# r8169 and r8152 load comes through the firmware image.
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_ATL1E=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=y
CONFIG_JME=y
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y
CONFIG_USB_RTL8152=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_AQC111=y
# PCIe port services: the ports' own driver (power management, AER error reports) and
# hotplug (ExpressCard, Thunderbolt/USB4 docks and eGPUs: PCIe native and ACPI hotplug)
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
# USB4 and Thunderbolt 3/4 controllers (Intel Titan Ridge and later, AMD USB4 hosts): the
# connection manager that sets up the PCIe and DisplayPort tunnels of docks, and networking
# between two machines over the cable; the USB-C ports' manager through ACPI (UCSI: role and
# alternate-mode state)
CONFIG_USB4=y
CONFIG_USB4_NET=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y

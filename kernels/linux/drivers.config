# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment of the device drivers, merged after minimal.config (scripts/build.sh,
# userland/selfhost/build-kernel): PCI, networking (Ethernet, Wi-Fi, Bluetooth), sound, USB,
# mouse and a KMS display at the screen's native resolution.  Everything is built in (no
# modules), as the rest of the kernel.  What QEMU emulates of it is attached by run.sh
# (--devices, the default); the rest is for real hardware.

# ---- PCI: every device below but the PS/2 mouse hangs off it (no ACPI: PCI_DIRECT) ----
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ---- Networking: TCP/IP over Ethernet ----
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
# Intel (QEMU's default e1000, the e1000e of most Intel boards), Realtek (RTL8139 of QEMU,
# RTL8169/8168 of most consumer boards), virtio (QEMU/KVM -nic model=virtio-net-pci)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
# USB Ethernet adapters and phone tethering (CDC Ethernet, RNDIS)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y

# ---- Wi-Fi: cfg80211/mac80211 with Atheros ath9k (PCI, needs no firmware file) and the
# mac80211_hwsim virtual radios QEMU tests run on (there is no emulated Wi-Fi card) ----
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
# The regulatory database (firmware file regulatory.db) is not in the image, so cfg80211 uses
# the world domain; its signature check is left out: it would pull in X.509, RSA, ASN.1 and
# the OID registry, whose table is generated by a Perl script that the self-hosting guest
# does not have (the option has a prompt only under CERTIFICATION_ONUS).
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_MAC80211_HWSIM=y

# ---- Bluetooth: the stack with USB dongles (btusb), UART controllers (H4) and the virtual
# controller /dev/vhci that the QEMU tests use ----
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIVHCI=y

# ---- Sound: ALSA with Intel HD Audio (QEMU -device intel-hda + hda-duplex, most boards),
# AC'97 (QEMU -device AC97) and USB audio; the OSS /dev/dsp and /dev/mixer emulation so
# that a raw write plays (busybox has no ALSA tools) ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_OSSEMUL=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ---- Mouse: PS/2 (i8042 aux port, touchpads), USB HID mice through hid-generic, the
# /dev/input/mice and /dev/input/eventN interfaces ----
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- USB: the four host controller types, HID (keyboards, mice), mass storage with the
# SCSI disk layer and the FAT and ext4 filesystems a stick carries ----
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- Video: KMS at the native resolution, with fbcon on top (DRM_FBDEV_EMULATION).
# simpledrm takes over the firmware's framebuffer (UEFI GOP: the panel's native mode;
# GRUB's gfxpayload=auto picks the EDID-preferred mode on BIOS); bochs-drm drives QEMU's
# standard VGA and sets the mode the display's EDID prefers (run.sh: -device VGA,xres=,yres=),
# virtio-gpu QEMU's -vga virtio.  simpledrm replaces minimal.config's simplefb. ----
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
# CONFIG_FB_SIMPLE is not set

# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment applied on top of 'make tinyconfig' (x86), see scripts/build.sh; the
# word size comes from the per-architecture fragment (x86_64.config, i386.config) merged
# after this one.
# Goal: the smallest kernel that boots an initramfs under QEMU and talks on
# the serial console and on the VGA/framebuffer console.  Everything below "Trim defaults" switches off options
# that olddefconfig would otherwise turn on as defaults.

# Console output
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# two UARTs: ttyS0 is the console, ttyS1 the file transfer channel of the self-hosting image
# (QEMU -serial file:..., see run.sh --selfhost and userland/selfhost/send-file)
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2

# Load the initramfs passed by the bootloader (-initrd) and exec /init
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y

# ---- VGA / framebuffer console and keyboard ----
# tty0 on the VGA text console (BIOS, or QEMU -kernel) or on the linear framebuffer the
# bootloader set up (GRUB gfxpayload: VESA on BIOS, GOP on UEFI; sysfb hands it to the
# framebuffer driver of drivers.config), with a PS/2 (i8042) keyboard; the serial console
# stays the second console.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
# (the framebuffer driver itself, the mouse and the other devices: drivers.config)
# CONFIG_SERIO_SERPORT is not set
# CONFIG_FB_VESA is not set
# CONFIG_LOGO is not set

# ---- Trim defaults ----
# No pseudo terminals or legacy tty ioctls
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_LEGACY_TIOCSTI is not set
# (SERIAL_EARLYCON stays on: selected by SERIAL_8250_CONSOLE)
# The initramfs is an uncompressed cpio: no decompressors
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_INITRAMFS_PRESERVE_MTIME is not set
# x86 extras not needed to boot.  Forced on and therefore not listed:
# X86_DIRECT_GBPAGES, HPET_TIMER, X86_MPPARSE (no prompt without ACPI),
# VDSO_GETRANDOM, X86_LOCAL_APIC/X86_IO_APIC.
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set

# ---- Interactive shell (static busybox in the initramfs) ----
# /init is a shell script that mounts these and execs busybox sh on ttyS0.
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
# static glibc (busybox) uses futexes for its internal locks
CONFIG_FUTEX=y
# alarm(), setitimer() and the POSIX timers: tinyconfig leaves them out (their syscalls
# return ENOSYS, and a program that sleeps in pause() for its alarm waits forever)
CONFIG_POSIX_TIMERS=y

# ---- Self-hosting (rebuilding the kernel inside the guest) ----
# SMP so that make -j uses every virtual CPU (run.sh -smp); tmpfs for the build tree, with a
# size limit instead of ramfs' unbounded growth (df shows the usage)
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# gzip instead of tinyconfig's xz for the kernel image: the guest has busybox's gzip, but
# busybox's xz is only a decompressor (the image grows by about 350 KB)
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_XZ is not set

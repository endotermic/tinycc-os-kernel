# Kconfig fragment of the i386 target (ARCH=i386, the 32-bit x86 kernel), merged after
# minimal.config (scripts/build.sh).  The processor family stays tinyconfig's default
# (M686: cmpxchg8b, no PAE); no highmem, the guest has at most 1 GB.
# CONFIG_64BIT is not set
# CONFIG_HIGHMEM4G is not set

# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment of the i386 target (ARCH=i386, the 32-bit x86 kernel), merged after
# minimal.config (scripts/build.sh).  The processor family stays tinyconfig's default
# (M686: cmpxchg8b, no PAE); no highmem, the guest has at most 1 GB.
# CONFIG_64BIT is not set
# CONFIG_HIGHMEM4G is not set
# The 32-bit time_t system calls (utimensat, clock_gettime, ...; numbers below 403), which
# tinyconfig leaves out: musl calls them whenever the values fit in 32 bits and only falls
# back to the time64 ones on ENOSYS, so without them busybox's touch (utimensat) fails with
# "Function not implemented" and the self-hosting kernel build stops at its first touch.
CONFIG_COMPAT_32BIT_TIME=y

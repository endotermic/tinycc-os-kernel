# SPDX-License-Identifier: BSD-2-Clause
# Kconfig fragment of the i386 target (ARCH=i386, the 32-bit x86 kernel), merged after
# minimal.config (scripts/build.sh).  The processor family stays tinyconfig's default
# (M686: cmpxchg8b, no PAE).
# CONFIG_64BIT is not set
# Memory above the 896 MB the kernel maps directly (HIGHMEM4G, up to 4 GB): the self-hosting
# guest's build tree (tmpfs) and the final link of the kernel with the Wi-Fi drivers needed
# more than that (ld killed by the OOM killer at vmlinux.o, 2026-11-17), and 32-bit laptops
# have more too
CONFIG_HIGHMEM4G=y
# The 32-bit time_t system calls (utimensat, clock_gettime, ...; numbers below 403), which
# tinyconfig leaves out: musl calls them whenever the values fit in 32 bits and only falls
# back to the time64 ones on ENOSYS, so without them busybox's touch (utimensat) fails with
# "Function not implemented" and the self-hosting kernel build stops at its first touch.
CONFIG_COMPAT_32BIT_TIME=y
# No amdgpu and no xe on the 32-bit kernel (docs/HARDWARE.md group 3): their GPUs (GCN and
# later, Lunar Lake and Arc) came long after 32-bit-only PCs, and amdgpu's display code (DC)
# converts doubles to 64-bit integers, which tcc's i386 back end does through __fixdfdi /
# __fixsfdi of its runtime library, which the kernel does not link (3 700 references); i915,
# radeon and nouveau drive the GPUs of the machines a 32-bit kernel runs on.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_XE is not set
# (and with amdgpu its options)
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_AMD_DC is not set
